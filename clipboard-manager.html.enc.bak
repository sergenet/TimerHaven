<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Clipboard Manager â€” TimerHaven</title>

  <!-- Redirect (unchanged) -->
  <script>
    (function(){
      try {
        const langRaw = localStorage.getItem('timerhavenLang') || '';
        const lang = (langRaw || '').toString().slice(0,2).toLowerCase();
        if (!lang || lang === 'en') return;
        const path = location.pathname || '';
        const filename = path.split('/').pop().toLowerCase();
        if (filename && filename.includes('-' + lang + '.html')) return;
        const localized = path.replace(/(clipboard-manager)(\.html)?$/i, '$1-' + lang + '.html');
        const localizedUrl = (localized === path) ? ('/clipboard-manager-' + lang + '.html') : localized;
        if (localizedUrl && localizedUrl !== location.pathname + location.search + location.hash) {
          location.replace(localizedUrl + location.search + location.hash);
        }
      } catch (e) {
        console && console.warn && console.warn('locale redirect failed', e);
      }
    })();
  </script>

  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Save, manage, and organize multiple clipboard snippets." />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
  <style>
    :root {
      --card-bg: #fff;
      --page-bg: #f4f7fb;
      --accent: #185a9d;
      --accent-2: #43cea2;
    }
    html,body { height: 100%; margin:0; }
    body { background: var(--page-bg); font-family: 'Montserrat', Arial, sans-serif; color:#1f2937; }

    /* Ensure the language indicator is always hidden (forceful) */
    .language-indicator { display: none !important; visibility: hidden !important; opacity: 0 !important; height: 0 !important; width: 0 !important; }

    .main-container { max-width: 1200px; margin: 1.5em auto; padding: 0 12px; box-sizing: border-box; }
    .center-row { display:flex; gap:1.5em; align-items: stretch; }
    .center-row > .col { flex: 1 1 0; display:flex; min-width: 220px; }

    /* Make each card stretch to full column height via flexbox */
    .card-base {
      background: var(--card-bg);
      border-radius: 16px;
      box-shadow: 0 2px 12px rgba(224,231,239,1);
      padding: 1.6em;
      display:flex;
      flex-direction: column;
      box-sizing: border-box;
      width:100%;
      height: 100%;
    }

    .card-inner { display:flex; flex-direction:column; flex:1 1 auto; }
    .card-content { flex: 1 1 auto; }
    .card-actions { margin-top: 1rem; }

    h2, h3 { color: var(--accent); margin: 0 0 0.5rem 0; font-weight:700; }
    .article-card h2, .tool-card h3 { font-size:1.4rem; line-height:1.05; display:flex; gap:.4rem; align-items:center; }

    .clips-section { display:flex; flex-direction:column; gap:.6rem; }
    .clips-form { display:flex; gap:.6rem; align-items:center; }
    .clips-form input[type="text"] { flex:1 1 auto; min-width:0; }

    .clips-list { margin-top: .4rem; max-height:260px; overflow-y:auto; padding-right:6px; }

    .clip-item { background:#f7fafc; border-radius:8px; padding:.6rem; margin-bottom:.6rem; display:flex; gap:.6rem; align-items:center; }
    .clip-text { flex:1; word-break:break-word; }

    .faq-section { margin-top:8px; background:#fbfdff; border-radius:8px; padding:.8rem; box-shadow: inset 0 1px 0 rgba(0,0,0,0.02); }
    details[open] summary::after { content: " â–²"; }
    details summary::after { content: " â–¼"; }
    details summary { cursor:pointer; font-weight:600; }

    .back-link { color:var(--accent); font-weight:700; text-decoration:none; display:inline-block; margin-bottom:.6rem; }
    .back-link i { margin-right:.35rem; }

    .btn-outline-primary { border-radius:10px; padding: .55rem 1rem; }
    .btn-success { border-radius:8px; padding:.45rem .85rem; }

    footer { text-align:center; color:#666; padding: 1.4rem 0 2rem; font-size:.9rem; }

    @media (max-width: 900px) {
      .center-row { flex-direction: column; }
      .center-row > .col { min-width: auto; }
    }
  </style>
<script>

</script>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <div class="main-container" id="page-main">
    <div class="center-row">
      <div class="col">
        <article class="card-base article-card" id="left-article">
          <div class="card-inner">
            <header class="card-content">
              <h2 id="howto-title"><i class="fa fa-clipboard"></i> How to Use Clipboard Manager</h2>
              <ol id="howto-steps">
                <li><b>Add a clip:</b> Type or paste your text, then click <b>Add Clip</b>.</li>
                <li><b>Copy a clip:</b> Click the <b>Copy</b> button next to any clip to copy instantly.</li>
                <li><b>Remove/Pin:</b> Use <b>Remove</b> or <b>Pin</b> to manage your clips.</li>
                <li><b>Clips are saved:</b> All your clips are stored in your browser and remain after reload.</li>
              </ol>
            </header>
            <div class="card-actions">
              <a id="left-article-btn" class="btn btn-outline-primary w-100" href="clipboard-how-to.html">Read Full Article</a>
            </div>
          </div>
        </article>
      </div>

      <div class="col tool-col">
        <section class="card-base tool-card" id="tool-card" aria-labelledby="tool-title">
          <div class="card-inner">
            <div class="card-content">
              <a class="back-link" id="back-link" href="index.html"><i class="fa fa-arrow-left"></i><span id="back-link-text">Back to Main Menu</span></a>
              <h3 id="tool-title"><i class="fa fa-clipboard"></i> Clipboard Manager</h3>

              <div class="tool-top-actions" role="toolbar" aria-label="Tool actions">
                <button id="btn-about" class="btn about" type="button" aria-controls="tool-info" aria-expanded="false">About the Clipboard Manager</button>
              </div>

              <article class="tool-info" id="tool-info" aria-hidden="true">
                <h2 style="margin-top:0; margin-bottom:0.4rem; font-size:1.1rem; color:var(--accent);">About the Clipboard Manager</h2>
                <p style="margin-bottom:0.6rem;">
                  The Clipboard Manager is a lightweight, privacyâ€‘first tool for storing and reusing text snippets.
                </p>
              </article>

              <div class="clips-section">
                <form id="clipboardForm" class="clips-form" aria-label="Add clip form">
                  <input type="text" id="clipInput" class="form-control" placeholder="Type or paste clip..." />
                  <button type="submit" class="btn btn-success" id="add-btn">Add Clip</button>
                </form>

                <div id="clipsList" class="clips-list" aria-live="polite"></div>

                <details class="faq-section" id="faq-details">
                  <summary id="faq-summary">FAQs</summary>
                  <ul id="faq-list" style="padding-left:1em;">
                    <li><b>Are my notes saved?</b> Yes! Notes are saved in your browser and remain until you clear them.</li>
                  </ul>
                </details>
              </div>
            </div>

            <div class="card-actions" aria-hidden="true"></div>
          </div>
        </section>
      </div>

      <div class="col">
        <aside class="card-base article-card" id="right-article">
          <div class="card-inner">
            <header class="card-content">
              <h2 id="tips-title"><i class="fa fa-lightbulb" style="color:var(--accent-2)"></i> Clipboard Tips</h2>
              <ul id="tips-list">
                <li><b>Keep clips short:</b> Easier to scan and reuse.</li>
                <li><b>Pin important:</b> Keep frequent items on top.</li>
                <li><b>Remove old:</b> Clean up outdated clips regularly.</li>
              </ul>
            </header>

            <div class="card-actions">
              <a id="right-article-btn" class="btn btn-outline-primary w-100" href="clipboard-tips.html">Read Full Article</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <footer>
    &copy; 2025 TimerHaven. All tools are free and privacy-friendly.<br />
    <a href="privacy.html">Privacy Policy</a> &bull; <a href="terms.html">Terms</a> &bull; <a href="contact.html">Contact</a>
  </footer>

  <script>
    // update article links based on timerhavenLang (unchanged mapping approach)
    const articleMap = {
      howto: { en:'clipboard-how-to.html', fr:'clipboard-how-to-fr.html', de:'clipboard-how-to-de.html', es:'clipboard-how-to-es.html', ru:'clipboard-how-to-ru.html', el:'clipboard-how-to-el.html', ar:'clipboard-how-to-ar.html' },
      tips:  { en:'clipboard-tips.html',     fr:'clipboard-tips-fr.html',    de:'clipboard-tips-de.html',    es:'clipboard-tips-es.html',    ru:'clipboard-tips-ru.html',    el:'clipboard-tips-el.html',    ar:'clipboard-tips-ar.html' }
    };

    function getLang(){ try { return (localStorage.getItem('timerhavenLang')||'en').slice(0,2); } catch(e){ return 'en'; } }

    function updateArticleLinks(){
      const lang = getLang();
      const howto = (articleMap.howto[lang] || articleMap.howto.en);
      const tips = (articleMap.tips[lang] || articleMap.tips.en);
      const leftBtn = document.getElementById('left-article-btn');
      const rightBtn = document.getElementById('right-article-btn');
      if (leftBtn) leftBtn.href = howto;
      if (rightBtn) rightBtn.href = tips;
    }

    // Equalize card heights robustly:
    function equalizeCardHeights(){
      const cols = Array.from(document.querySelectorAll('.center-row > .col'));
      if (!cols.length) return;
      cols.forEach(col => { const card = col.querySelector('.card-base'); if (card) card.style.height = ''; });
      let maxh = 0;
      cols.forEach(col => {
        const card = col.querySelector('.card-base');
        if (card) {
          const h = Math.round(card.getBoundingClientRect().height);
          if (h > maxh) maxh = h;
        }
      });
      if (maxh > 0) {
        cols.forEach(col => {
          const card = col.querySelector('.card-base');
          if (card) card.style.height = maxh + 'px';
        });
      }
    }

    // MutationObserver to detect language/content changes and re-run equalize
    (function(){
      const container = document.getElementById('page-main');
      if (!container) return;

      // resume equalize for a short period after mutations to catch async text replacement
      let retryTimer = null;
      const runEqualizeWithRetries = () => {
        equalizeCardHeights();
        // do a couple of delayed retries to handle fonts/async rendering
        clearTimeout(retryTimer);
        retryTimer = setTimeout(equalizeCardHeights, 120);
        setTimeout(equalizeCardHeights, 420);
      };

      const observer = new MutationObserver((mutations) => {
        runEqualizeWithRetries();
      });
      observer.observe(container, { childList: true, subtree: true, characterData: true });

      // run on load and language changes
      window.addEventListener('load', runEqualizeWithRetries);
      window.addEventListener('resize', runEqualizeWithRetries);
      window.addEventListener('storage', function(e){
        if (e.key === 'timerhavenLang') {
          // update links, direction, and re-run equalize after DOM updates
          const lang = (e.newValue || 'en').slice(0,2);
          document.documentElement.lang = lang;
          document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
          updateArticleLinks();
          runEqualizeWithRetries();
        }
      });

      // also trigger once on DOMContentLoaded
      document.addEventListener('DOMContentLoaded', function(){
        // apply UI direction and links for current selection
        const lang = getLang();
        document.documentElement.lang = lang;
        document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
        updateArticleLinks();
        runEqualizeWithRetries();
      });
    })();

    // Clips logic (unchanged)
    (function(){
      function safeGet(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }
      function safeSet(k,v){ try { localStorage.setItem(k,v); return true; } catch(e){ return false; } }

      window.clips = JSON.parse(safeGet('clipboardClips') || '[]');
      var clips = window.clips || [];

      function escapeHtml(s){ return String(s||'').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

      function renderClips(){
        var list = document.getElementById('clipsList');
        if (!list) return;
        list.innerHTML = '';
        var noClipsText = 'No clips yet.';
        if (!clips || clips.length === 0) {
          list.innerHTML = '<div style="color:#888;">' + noClipsText + '</div>';
          return;
        }
        for (var i=0;i<clips.length;i++){
          var c = clips[i];
          var div = document.createElement('div');
          div.className = 'clip-item';
          var pinned = c.pinned ? '<span style="font-weight:700;color:var(--accent);margin-right:.5em;"><i class="fa fa-thumbtack"></i></span>' : '';
          div.innerHTML = '<div class="clip-text">' + pinned + escapeHtml(c.text) + (c.date ? (' <span class="clip-meta" style="color:#888;margin-left:.6em;">' + escapeHtml(c.date) + '</span>') : '') + '</div>'
                        + '<div style="display:flex;gap:.4rem;align-items:center;">'
                        +   '<button class="btn btn-outline-info btn-sm" data-idx="'+i+'" data-action="pin" title="Pin/unpin"><i class="fa fa-thumbtack"></i></button>'
                        +   '<button class="btn btn-outline-success btn-sm" data-idx="'+i+'" data-action="copy" title="Copy"><i class="fa fa-copy"></i></button>'
                        +   '<button class="btn btn-outline-danger btn-sm" data-idx="'+i+'" data-action="remove" title="Remove"><i class="fa fa-trash"></i></button>'
                        + '</div>';
          list.appendChild(div);
        }

        Array.from(list.querySelectorAll('button[data-idx]')).forEach(function(btn){
          var idx = parseInt(btn.getAttribute('data-idx'), 10);
          var action = btn.getAttribute('data-action');
          btn.onclick = function(){
            if (action === 'copy') {
              try { navigator.clipboard.writeText(clips[idx].text); } catch(e){}
            } else if (action === 'remove') {
              clips.splice(idx,1); window.clips = clips; safeSet('clipboardClips', JSON.stringify(clips)); renderClips();
            } else if (action === 'pin') {
              clips[idx].pinned = !clips[idx].pinned;
              if (clips[idx].pinned) { var p = clips.splice(idx,1)[0]; clips.unshift(p); }
              safeSet('clipboardClips', JSON.stringify(clips)); renderClips();
            }
          };
        });
      }

      function addClipFromInput(){
        var input = document.getElementById('clipInput');
        var text = (input && input.value || '').trim();
        if (!text) return;
        clips = clips || [];
        clips.unshift({ text: text, date: new Date().toLocaleString(), pinned: false });
        window.clips = clips;
        safeSet('clipboardClips', JSON.stringify(clips));
        if (input) input.value = '';
        renderClips();
      }

      var form = document.getElementById('clipboardForm');
      if (form) {
        form.addEventListener('submit', function(e){
          e.preventDefault();
          addClipFromInput();
        });
      }

      window.addClipFromInput = addClipFromInput;
      window.lhShowClips = function(){ console.log('window.clips', window.clips); return window.clips; };

      window.addEventListener('pagehide', function(){ safeSet('clipboardClips', JSON.stringify(window.clips || [])); });
      window.addEventListener('beforeunload', function(){ safeSet('clipboardClips', JSON.stringify(window.clips || [])); });

      document.addEventListener('DOMContentLoaded', function(){ clips = window.clips || []; renderClips(); });
    })();
  </script>
</body>
</html>


