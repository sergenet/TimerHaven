<script>
/*
  Patched RU world clock:
  - tolerant city loader (dedupe/sort, locale 'ru')
  - accessible native select kept visible
  - Awesomplete visible chooser
  - localized error messages
*/

const { DateTime } = luxon;

function normalizeKey(s) {
  if (!s) return '';
  try { return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim(); }
  catch(e){ return String(s).toLowerCase().trim(); }
}
function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

let cityList = [], cityToZone = {}, cityNames = [], awesompleteInstance = null;

// tolerant loader
(async function loadCities(){
  const dropdown = document.getElementById('cityDropdown');
  const input = document.getElementById('cityInput');
  const PATHS = ['/world-cities.json','/assets/data/world-cities.json','/ru/world-cities.json','/world-cities.json?cachebust='+Date.now()];
  async function tryFetch(paths, timeoutMs=4500){
    const start = Date.now();
    for (const p of paths){
      if (Date.now()-start > timeoutMs) break;
      try {
        const r = await fetch(p, { cache: 'no-cache' });
        if (!r.ok) continue;
        const txt = await r.text();
        try { return JSON.parse(txt); } catch(e){ continue; }
      } catch(e){ continue; }
    }
    return null;
  }

  try {
    const raw = await tryFetch(PATHS);
    const list = Array.isArray(raw) ? raw : (raw && Array.isArray(raw.cities) ? raw.cities : []);
    const map = new Map();
    (list||[]).forEach(item => {
      if (!item) return;
      const name = (item.name||item.city||'').trim();
      const tz = (item.timezone||item.tz||item.zone||'').trim();
      if (!name) return;
      const key = normalizeKey(name);
      if (!map.has(key)) map.set(key, { name, timezone: tz||'' });
    });
    const entries = Array.from(map.values()).sort((a,b)=> a.name.localeCompare(b.name,'ru',{sensitivity:'base'}));
    cityList = entries;
    cityToZone = {}; cityNames = [];
    if (dropdown) {
      const placeholder = dropdown.querySelector('option[value=""]') ? dropdown.querySelector('option[value=""]').outerHTML : '<option value="">Ð’Ñ‹Ð±ÐµÑ€Ð¸Ñ‚Ðµ Ð³Ð¾Ñ€Ð¾Ð´...</option>';
      dropdown.innerHTML = placeholder;
    }
    entries.forEach(e => {
      cityToZone[normalizeKey(e.name)] = e.timezone || '';
      cityNames.push(e.name);
      if (dropdown && (e.name||'').toLowerCase() !== 'tokyo') {
        const opt = document.createElement('option'); opt.value = e.timezone||''; opt.textContent = e.name; dropdown.appendChild(opt);
      }
    });
    if (typeof Awesomplete !== 'undefined' && input) {
      const awList = cityNames.slice();
      if (input.awesomplete) input.awesomplete.list = awList;
      else awesompleteInstance = new Awesomplete(input, { list: awList, minChars:1, maxItems:12, autoFirst:true });
    }
    console.info('world-cities: populated', entries.length);
  } catch(err){
    console.warn('world-cities load failed', err);
    const fallback = [{name:'London',timezone:'Europe/London'},{name:'Moscow',timezone:'Europe/Moscow'},{name:'Paris',timezone:'Europe/Paris'}];
    cityList = fallback; cityToZone = {}; cityNames = fallback.map(f=>f.name);
    if (dropdown) {
      const placeholder = dropdown.querySelector('option[value=""]') ? dropdown.querySelector('option[value=""]').outerHTML : '<option value="">Ð’Ñ‹Ð±ÐµÑ€Ð¸Ñ‚Ðµ Ð³Ð¾Ñ€Ð¾Ð´...</option>';
      dropdown.innerHTML = placeholder + fallback.map(e=>`<option value="${escapeHtml(e.timezone)}">${escapeHtml(e.name)}</option>`).join('');
    }
    if (typeof Awesomplete !== 'undefined' && input) { awesompleteInstance = new Awesomplete(input, { list: cityNames, minChars:1, maxItems:12, autoFirst:true }); }
  }
})();

// clocks
let clocks = JSON.parse(localStorage.getItem('worldClocks')||'[]');
function saveClocks(){ localStorage.setItem('worldClocks', JSON.stringify(clocks)); }

function renderClocks(){
  const list = document.getElementById('clockList'); list.innerHTML='';
  if (!clocks || clocks.length===0){ list.innerHTML = '<div style="color:#888;">Ð§Ð°ÑÑ‹ Ð½Ðµ Ð´Ð¾Ð±Ð°Ð²Ð»ÐµÐ½Ñ‹.</div>'; return; }
  clocks.forEach((clock, idx) => {
    let timeStr='...'; let error=false;
    try {
      const now = DateTime.now().setZone(clock.tz);
      if (!now.isValid) throw new Error('Invalid zone');
      timeStr = now.toFormat('cccc, dd LLL yyyy<br>HH:mm:ss');
    } catch { timeStr = 'ÐÐµÐ²ÐµÑ€Ð½Ð°Ñ Ð²Ñ€ÐµÐ¼ÐµÐ½Ð½Ð°Ñ Ð·Ð¾Ð½Ð°'; error=true; }
    const div = document.createElement('div'); div.className='clock-item';
    div.innerHTML = `
      <div style="display:flex;gap:0.9rem;align-items:center;">
        <span style="background:#0b2545;color:#fff;border-radius:50%;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;"><i class="fa fa-clock"></i></span>
        <div style="min-width:0;">
          <div style="font-weight:700;">${escapeHtml(clock.label)}</div>
          <div style="font-size:.95rem;color:#444;">${timeStr}${error ? ' <span style="color:#b00;">(ÐŸÑ€Ð¾Ð²ÐµÑ€ÑŒÑ‚Ðµ Ð¾Ñ€Ñ„Ð¾Ð³Ñ€Ð°Ñ„Ð¸ÑŽ Ð¸Ð»Ð¸ Ð¸ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐ¹Ñ‚Ðµ ÐºÐ¾Ñ€Ñ€ÐµÐºÑ‚Ð½ÑƒÑŽ IANAâ€‘Ð·Ð¾Ð½Ñƒ)</span>' : ''}</div>
        </div>
      </div>
      <div><button class="btn btn-outline-danger btn-sm" onclick="deleteClock(${idx})" aria-label="Ð£Ð´Ð°Ð»Ð¸Ñ‚ÑŒ"><i class="fa fa-trash"></i></button></div>
    `;
    list.appendChild(div);
  });
}

function normalizeInput(input){ return input.trim().toLowerCase().replace(/[\s\-_]+/g,' '); }

function resolveZoneFromInput(val){
  if (!val) return '';
  if (/^[A-Za-z]+\/[A-Za-z_]+$/.test(val)) return val;
  const k = normalizeKey(val);
  return cityToZone[k] || '';
}

function addClock(label,tz){ clocks.push({label,tz}); saveClocks(); renderClocks(); }

document.getElementById('addClockBtn').addEventListener('click', function(){
  document.getElementById('errorMsg').textContent='';
  const inputVal = document.getElementById('cityInput').value.trim();
  let label='', zone='';
  if (inputVal) {
    zone = resolveZoneFromInput(inputVal);
    if (!zone) { document.getElementById('errorMsg').innerText = 'Ð“Ð¾Ñ€Ð¾Ð´ Ð½Ðµ Ñ€Ð°ÑÐ¿Ð¾Ð·Ð½Ð°Ð½. ÐŸÐ¾Ð¿Ñ€Ð¾Ð±ÑƒÐ¹Ñ‚Ðµ Ð°Ð²Ñ‚Ð¾Ð·Ð°Ð¿Ð¾Ð»Ð½ÐµÐ½Ð¸Ðµ Ð¸Ð»Ð¸ Ð²Ð²ÐµÐ´Ð¸Ñ‚Ðµ IANAâ€‘Ð·Ð¾Ð½Ñƒ.'; return; }
    const canonical = cityList.find(c => normalizeKey(c.name) === normalizeKey(inputVal));
    label = canonical ? canonical.name : inputVal;
  } else {
    const sel = document.getElementById('cityDropdown');
    if (sel && sel.value) { zone = sel.value; label = sel.options[sel.selectedIndex].text || zone; }
    else { document.getElementById('errorMsg').textContent = 'ÐŸÐ¾Ð¶Ð°Ð»ÑƒÐ¹ÑÑ‚Ð°, Ð²Ñ‹Ð±ÐµÑ€Ð¸Ñ‚Ðµ Ð¸Ð»Ð¸ Ð²Ð²ÐµÐ´Ð¸Ñ‚Ðµ Ð³Ð¾Ñ€Ð¾Ð´ Ð¸Ð»Ð¸ Ð²Ñ€ÐµÐ¼ÐµÐ½Ð½ÑƒÑŽ Ð·Ð¾Ð½Ñƒ.'; return; }
  }
  addClock(label, zone);
  document.getElementById('cityInput').value = '';
  document.getElementById('cityDropdown').selectedIndex = 0;
});

document.getElementById('cityInput').addEventListener('keydown', function(e){ if (e.key === 'Enter'){ e.preventDefault(); document.getElementById('addClockBtn').click(); } });

window.deleteClock = function(idx){ clocks.splice(idx,1); saveClocks(); renderClocks(); }

setInterval(renderClocks,1000); renderClocks();
</script>

<!-- Embedded unified header language selector + defensive localizer JS (left in DOM but hidden visually) -->
<script>
  (function(){
    const LANGS = [
      { code: 'en', name: 'English' },
      { code: 'fr', name: 'FranÃ§ais' },
      { code: 'es', name: 'EspaÃ±ol' },
      { code: 'de', name: 'Deutsch' },
      { code: 'ru', name: 'Ð ÑƒÑÑÐºÐ¸Ð¹' },
      { code: 'el', name: 'Î•Î»Î»Î·Î½Î¹ÎºÎ¬' },
      { code: 'ar', name: 'Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©' }
    ];

    function detectPageInfo() {
      const path = (location.pathname || '').split('/').pop() || '';
      const m = path.match(/^world-(clock|how-to|tips)-([a-z]{2})\.html$/i);
      if (m) return { type: m[1], lang: m[2].toLowerCase() };
      if (/^world-clock\.html$/i.test(path)) return { type: 'clock', lang: 'ru' };
      const m2 = path.match(/^world-(clock|how-to|tips)\.html$/i);
      if (m2) return { type: m2[1], lang: 'ru' };
      return { type: 'clock', lang: 'ru' };
    }

    function removeInCardSelectors() {
      document.querySelectorAll('.tool-card .lang-wrap, .tool-card #language-select-top').forEach(function(el){ try{ el.remove(); }catch(e){} });
    }

    function buildHeaderSelector(selectedLang) {
      let top = document.querySelector('.page-wrap .top-row') || document.querySelector('.top-row');
      if (!top) {
        top = document.createElement('div');
        top.className = 'top-row';
        const pw = document.querySelector('.page-wrap') || document.body;
        pw.insertBefore(top, pw.firstChild);
      }

      top.querySelectorAll('label[for="language-select-top"], #language-select-top').forEach(function(n){ try{ n.remove(); }catch(e){} });

      const label = document.createElement('label');
      label.setAttribute('for','language-select-top');
      label.textContent = 'Language:';
      label.style.fontWeight = '600';
      label.style.marginRight = '.5rem';

      const sel = document.createElement('select');
      sel.id = 'language-select-top';
      sel.className = 'language-select';
      sel.setAttribute('aria-label','Language selector');

      LANGS.forEach(function(l){
        const o = document.createElement('option');
        o.value = l.code;
        o.textContent = l.name;
        if (l.code === selectedLang) o.selected = true;
        sel.appendChild(o);
      });

      top.appendChild(label);
      top.appendChild(sel);
      sel.style.display = 'inline-flex';
      sel.style.visibility = 'visible';
      return sel;
    }

    function hookSelector(sel) {
      if (!sel) return;
      if (sel._handler) sel.removeEventListener('change', sel._handler);
      sel._handler = function() {
        const code = this.value || 'ru';
        const info = detectPageInfo();
        if ((location.pathname || '').match(/world-clock\.html$/i)) {
          window.location.href = 'world-clock-' + code + '.html';
          return;
        }
        window.location.href = 'world-' + info.type + '-' + code + '.html';
      };
      sel.addEventListener('change', sel._handler);
    }

    document.addEventListener('DOMContentLoaded', function(){
      removeInCardSelectors();
      const info = detectPageInfo();
      const sel = buildHeaderSelector(info.lang);
      hookSelector(sel);

      const observer = new MutationObserver(function(muts){
        muts.forEach(function(m){
          if (m.addedNodes) {
            m.addedNodes.forEach(function(n){
              try {
                if (n.querySelectorAll) {
                  n.querySelectorAll('.tool-card .lang-wrap, .tool-card #language-select-top').forEach(function(el){ try{ el.remove(); }catch(e){} });
                }
                if (n.matches && (n.matches('.tool-card .lang-wrap') || n.matches('.tool-card #language-select-top'))) {
                  try{ n.remove(); }catch(e){}
                }
              } catch(e){}
            });
          }
        });
      });
      observer.observe(document.documentElement || document.body, { childList: true, subtree: true });
      setTimeout(function(){ try{ observer.disconnect(); }catch(e){} }, 6000);
    });
  })();
  </script>

