# Redirects must run before Passenger — put canonical redirects at the top.<IfModule mod_rewrite.c>  RewriteEngine On  # 1) If the host is www.timerhaven.com, redirect to https://timerhaven.com (preserve path)  RewriteCond %{HTTP_HOST} ^www\.timerhaven\.com$ [NC]  RewriteRule ^ https://timerhaven.com%{REQUEST_URI} [L,R=301]  # 2) If request is not HTTPS (and not already www→non‑www handled above), redirect to https://timerhaven.com  RewriteCond %{HTTPS} !=on  RewriteCond %{HTTP_HOST} !^www\. [NC]  RewriteRule ^ https://timerhaven.com%{REQUEST_URI} [L,R=301]</IfModule># DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGINPassengerAppRoot "/home/sergbcqk/TimerHavenWeatherProxy"PassengerBaseURI "/"PassengerNodejs "/home/sergbcqk/nodevenv/TimerHavenWeatherProxy/18/bin/node"PassengerAppType nodePassengerStartupFile server.js# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END# Preserve the specific world-clock redirect you previously had:Redirect 301 /world-clock.html https://timerhaven.com/world-clock-en.html# ensure HTML files are served as UTF-8AddDefaultCharset UTF-8<IfModule mod_mime.c>  AddCharset UTF-8 .html .htm</IfModule># If mod_headers is available, explicitly add charset for .html/.htm responses.# This makes the HTTP Content-Type header include charset=utf-8 (helps CLI tools and proxies).<IfModule mod_headers.c>  <FilesMatch "\.(html|htm)$">    Header always set Content-Type "text/html; charset=utf-8"  </FilesMatch></IfModule># DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN<IfModule Litespeed></IfModule># DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END