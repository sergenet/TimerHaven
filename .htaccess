# Ensure directory requests serve index.html
DirectoryIndex index.html

# Redirects must run before Passenger — put canonical redirects at the top.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # 1) If the host is www.timerhaven.com, redirect to https://timerhaven.com (preserve path)
  RewriteCond %{HTTP_HOST} ^www\.timerhaven\.com$ [NC]
  RewriteRule ^ https://timerhaven.com%{REQUEST_URI} [L,R=301]
  # 2) If request is not HTTPS (and not already www→non‑www handled above), redirect to https://timerhaven.com
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://timerhaven.com%{REQUEST_URI} [L,R=301]
  
  # Exclude api folder from further processing (so Passenger doesn't capture it)
  RewriteRule ^api/ - [L]
</IfModule># DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGINPassengerAppRoot "/home/sergbcqk/TimerHavenWeatherProxy"PassengerBaseURI "/"PassengerNodejs "/home/sergbcqk/nodevenv/TimerHavenWeatherProxy/18/bin/node"PassengerAppType nodePassengerStartupFile server.js# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END# Preserve the specific tool redirects
