  <script>
    // Keep language detection in place and prefer 'ru' for this file
    (function setLangFromPath(){
      try {
        var path = window.location.pathname || '';
        var m = path.match(/[-\/]([a-z]{2})(?:\.html|\/|$)/i);
        if (m && m[1]) {
          var candidate = m[1].toLowerCase();
          var supported = ['en','fr','es','de','ru','el','ar'];
          if (supported.indexOf(candidate) !== -1) {
            localStorage.setItem('timerhavenLang', candidate);
            return;
          }
        }
        if (!localStorage.getItem('timerhavenLang')) localStorage.setItem('timerhavenLang','ru');
      } catch (err) { console.warn('lang detection error', err); }
    })();

    // Notes persistence and calendar state
    let notes = JSON.parse(localStorage.getItem('calendarNotes') || '{}');
    let currentYear, currentMonth, selectedDay;

    function getLang() {
      return localStorage.getItem('timerhavenLang') || 'ru';
    }

    const translations = {
      en: {
        "back-link": "Back to Main Menu",
