        "faq-title": "Ð§Ð°ÑÑ‚Ð¾ Ð·Ð°Ð´Ð°Ð²Ð°ÐµÐ¼Ñ‹Ðµ Ð²Ð¾Ð¿Ñ€Ð¾ÑÑ‹",
        "faq-list": `<li><b>Ð¡Ð¾Ñ…Ñ€Ð°Ð½ÑÑŽÑ‚ÑÑ Ð»Ð¸ Ð¼Ð¾Ð¸ Ð·Ð°Ð¼ÐµÑ‚ÐºÐ¸?</b> Ð”Ð°! Ð—Ð°Ð¼ÐµÑ‚ÐºÐ¸ ÑÐ¾Ñ…Ñ€Ð°Ð½ÑÑŽÑ‚ÑÑ Ð² Ð²Ð°ÑˆÐµÐ¼ Ð±Ñ€Ð°ÑƒÐ·ÐµÑ€Ðµ Ð¸ Ð¾ÑÑ‚Ð°ÑŽÑ‚ÑÑ Ð´Ð¾ ÑƒÐ´Ð°Ð»ÐµÐ½Ð¸Ñ.</li>
          <li><b>ÐœÐ¾Ð³Ñƒ Ð»Ð¸ Ñ Ð´Ð¾Ð±Ð°Ð²Ð¸Ñ‚ÑŒ Ð½ÐµÑÐºÐ¾Ð»ÑŒÐºÐ¾ Ð·Ð°Ð¼ÐµÑ‚Ð¾Ðº?</b> Ð”Ð° â€” Ð¼Ð¾Ð¶Ð½Ð¾ Ð´Ð¾Ð±Ð°Ð²Ð»ÑÑ‚ÑŒ Ð»ÑŽÐ±Ð¾Ðµ ÐºÐ¾Ð»Ð¸Ñ‡ÐµÑÑ‚Ð²Ð¾ Ð·Ð°Ð¼ÐµÑ‚Ð¾Ðº Ð´Ð»Ñ ÐºÐ°Ð¶Ð´Ð¾Ð³Ð¾ Ð´Ð½Ñ.</li>
          <li><b>ÐœÐ¾Ð³Ñƒ Ð»Ð¸ Ñ ÑƒÐ´Ð°Ð»Ð¸Ñ‚ÑŒ Ð·Ð°Ð¼ÐµÑ‚ÐºÐ¸?</b> Ð”Ð° â€” ÑƒÐ´Ð°Ð»ÑÐ¹Ñ‚Ðµ Ð¾Ñ‚Ð´ÐµÐ»ÑŒÐ½Ñ‹Ðµ Ð·Ð°Ð¼ÐµÑ‚ÐºÐ¸ Ñ Ð¿Ð¾Ð¼Ð¾Ñ‰ÑŒÑŽ Ð¸ÐºÐ¾Ð½ÐºÐ¸ ÐºÐ¾Ñ€Ð·Ð¸Ð½Ñ‹.</li>
          <li><b>Ð¡Ð¸Ð½Ñ…Ñ€Ð¾Ð½Ð¸Ð·Ð¸Ñ€ÑƒÑŽÑ‚ÑÑ Ð»Ð¸ Ð·Ð°Ð¼ÐµÑ‚ÐºÐ¸ Ð½Ð° Ð´Ñ€ÑƒÐ³Ð¸Ñ… ÑƒÑÑ‚Ñ€Ð¾Ð¹ÑÑ‚Ð²Ð°Ñ…?</b> ÐŸÐ¾ÐºÐ° Ð½ÐµÑ‚ â€” Ð·Ð°Ð¼ÐµÑ‚ÐºÐ¸ ÑÐ¾Ñ…Ñ€Ð°Ð½ÑÑŽÑ‚ÑÑ Ð² ÐºÐ¾Ð½ÐºÑ€ÐµÑ‚Ð½Ð¾Ð¼ Ð±Ñ€Ð°ÑƒÐ·ÐµÑ€Ðµ. Ð”Ð»Ñ Ð´Ð¾ÑÑ‚ÑƒÐ¿Ð° Ñ Ñ€Ð°Ð·Ð½Ñ‹Ñ… ÑƒÑÑ‚Ñ€Ð¾Ð¹ÑÑ‚Ð² Ð¸ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐ¹Ñ‚Ðµ Ð¾Ð±Ð»Ð°Ñ‡Ð½Ñ‹Ðµ Ð¿Ñ€Ð¸Ð»Ð¾Ð¶ÐµÐ½Ð¸Ñ.</li>`
      }
    };

    function updateLanguage(lang) {
      lang = lang || getLang();
      document.body.dir = (lang === "ar") ? "rtl" : "ltr";
      const t = translations[lang] || translations['ru'];
      const el = id => document.getElementById(id);
      if (el("back-link")) el("back-link").textContent = t["back-link"];
      if (el("tool-title")) el("tool-title").innerHTML = `<i class="fa fa-calendar-days"></i> ${t["tool-title"]}`;
      if (el("tool-help")) el("tool-help").textContent = t["tool-help"];
      if (el("faq-title")) el("faq-title").textContent = t["faq-title"];
      if (el("faq-list")) el("faq-list").innerHTML = t["faq-list"];
      if (el("noteModalLabel")) el("noteModalLabel").innerHTML = `Ð—Ð°Ð¼ÐµÑ‚ÐºÐ¸ Ð´Ð»Ñ <span id="modal-date-label"></span>`;
      if (el("noteInput")) el("noteInput").placeholder = "Ð”Ð¾Ð±Ð°Ð²Ð¸Ñ‚ÑŒ Ð½Ð¾Ð²ÑƒÑŽ Ð·Ð°Ð¼ÐµÑ‚ÐºÑƒ Ð½Ð° ÑÑ‚Ð¾Ñ‚ Ð´ÐµÐ½ÑŒ...";
      if (el("note-close-btn")) el("note-close-btn").textContent = "Ð—Ð°ÐºÑ€Ñ‹Ñ‚ÑŒ";
      if (el("note-add-btn")) el("note-add-btn").textContent = "Ð”Ð¾Ð±Ð°Ð²Ð¸Ñ‚ÑŒ Ð·Ð°Ð¼ÐµÑ‚ÐºÑƒ";
      if (typeof currentYear === 'number' && typeof currentMonth === 'number') {
        renderCalendar(currentYear, currentMonth, lang);
      }
    }

    window.addEventListener('storage', function(e) {
      if (e.key === 'timerhavenLang') {
        const newLang = e.newValue || 'ru';
        updateLanguage(newLang);
      }
    });

    function renderCalendar(year, month, lang) {
      currentYear = year;
      currentMonth = month;
      lang = lang || getLang();
      const table = document.getElementById('calendar-table');
      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      let html = `<thead><tr>`;
      const dayNames = (translations[lang] && translations[lang]["days"]) ? translations[lang]["days"] : ["Ð’Ñ","ÐŸÐ½","Ð’Ñ‚","Ð¡Ñ€","Ð§Ñ‚","ÐŸÑ‚","Ð¡Ð±"];
      dayNames.forEach(day => { html += `<th>${day}</th>`; });
      html += `</tr></thead><tbody><tr>`;

      for (let i = 0; i < firstDay; i++) html += `<td></td>`;

      const now = new Date();
      const todayYear = now.getFullYear();
      const todayMonth = now.getMonth();
      const todayDay = now.getDate();

      for (let d = 1; d <= daysInMonth; d++) {
        const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const dayNotes = notes[dateStr] || [];
        const hasNote = dayNotes.length > 0;
        if ((firstDay + d - 1) % 7 === 0 && d !== 1) html += `</tr><tr>`;
        const isToday = (d === todayDay && month === todayMonth && year === todayYear);
        html += `<td class="day-cell${hasNote ? ' has-note' : ''}${isToday ? ' calendar-today' : ''}" data-date="${dateStr}">${d}${hasNote ? ' <span title="Ð—Ð°Ð¼ÐµÑ‚ÐºÐ¸ ÑÐ¾Ñ…Ñ€Ð°Ð½ÐµÐ½Ñ‹">ðŸ“</span>' : ''}</td>`;
      }
      html += `</tr></tbody>`;
      table.innerHTML = html;

      Array.from(document.getElementsByClassName('day-cell')).forEach(cell => {
        cell.addEventListener('click', function() {
          selectedDay = this.getAttribute('data-date');
          showNoteModal(selectedDay);
        });
      });
    }

    function showNoteModal(dateStr) {
      const modalDateLabel = document.getElementById('modal-date-label');
      if (modalDateLabel) modalDateLabel.textContent = dateStr;
      renderNoteList(dateStr);
      document.getElementById('noteInput').value = '';
      let modal = new bootstrap.Modal(document.getElementById('noteModal'));
      modal.show();
    }

    function renderNoteList(dateStr) {
      const list = document.getElementById('noteList');
      list.innerHTML = '';
      const lang = getLang();
      const dayNotes = notes[dateStr] || [];
      if (dayNotes.length === 0) {
        list.innerHTML = `<li style="color:#888;">Ð”Ð»Ñ ÑÑ‚Ð¾Ð³Ð¾ Ð´Ð½Ñ Ð·Ð°Ð¼ÐµÑ‚Ð¾Ðº ÐµÑ‰Ñ‘ Ð½ÐµÑ‚.</li>`;
        return;
      }
      dayNotes.forEach((note, idx) => {
        list.innerHTML += `
          <li>
            <span class="note-text">${escapeHtml(note.text)}</span>
            <span class="note-meta">${new Date(note.ts).toLocaleString()}</span>
            <button class="delete-note-btn" title="Ð£Ð´Ð°Ð»Ð¸Ñ‚ÑŒ ÑÑ‚Ñƒ Ð·Ð°Ð¼ÐµÑ‚ÐºÑƒ" onclick="deleteNote('${dateStr}',${idx})"><i class="fa fa-trash"></i></button>
          </li>
        `;
      });
    }

    function escapeHtml(s) {
      if (!s) return '';
      return s.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;');
    }

    // Attach note handler (form exists in DOM before this script runs)
    (function() {
      const form = document.getElementById('noteForm');
      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          if (!selectedDay) return;
          const text = document.getElementById('noteInput').value.trim();
          if (!text) return;
          if (!notes[selectedDay]) notes[selectedDay] = [];
          notes[selectedDay].push({ text, ts: Date.now() });
          try { localStorage.setItem('calendarNotes', JSON.stringify(notes)); } catch(e) {}
          document.getElementById('noteInput').value = '';
          renderNoteList(selectedDay);
          renderCalendar(currentYear, currentMonth, getLang());
        });
      } else {
        console.warn('noteForm not found; form handler not attached');
      }
    })();

    window.deleteNote = function(dateStr, idx) {
      if (!notes[dateStr]) return;
      notes[dateStr].splice(idx, 1);
      if (notes[dateStr].length === 0) delete notes[dateStr];
      try { localStorage.setItem('calendarNotes', JSON.stringify(notes)); } catch(e) {}
      renderNoteList(dateStr);
      renderCalendar(currentYear, currentMonth, getLang());
    };

    document.addEventListener('DOMContentLoaded', function() {
      const now = new Date();
      const monthInput = document.getElementById('calendar-month');
      if (monthInput) {
        monthInput.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2,'0')}`;
      }

      // Ensure language is applied before rendering the calendar UI
      updateLanguage(getLang());
      updateCalendar();
    });

    function updateCalendar() {
      const input = document.getElementById('calendar-month');
      if (!input) return;
      const val = (input.value || '').split('-');
      if (val.length < 2) return;
      const year = parseInt(val[0],10);
      const month = parseInt(val[1],10) - 1;
      renderCalendar(year, month, getLang());
    }

    const monthEl = document.getElementById('calendar-month');
    if (monthEl) monthEl.addEventListener('change', updateCalendar);
  </script>

