  <a href="/unit-converter-ru.html" class="return-to-tool" id="returnToToolUnit" aria-label="ÐŸÐµÑ€ÐµÐ¹Ñ‚Ð¸ Ðº ÐºÐ¾Ð½Ð²ÐµÑ€Ñ‚ÐµÑ€Ñƒ">
    <span class="icon" aria-hidden="true">â†©</span>
    <span class="label">Ðš ÐºÐ¾Ð½Ð²ÐµÑ€Ñ‚ÐµÑ€Ñƒ</span>
  </a>

  <script>
    (function(){
      var btn = document.getElementById('returnToToolUnit');
      if (!btn) return;
      btn.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); btn.click(); }});
      function toggleOpacity(){ try { btn.style.opacity = (window.scrollY < 80) ? '0.85' : '0.98'; } catch(e){} }
      window.addEventListener('scroll', toggleOpacity);
      toggleOpacity();
    })();
  </script>
</body>
</html>
