<script>
    const cities = [
      {value:"", label:"Ð’Ñ‹Ð±ÐµÑ€Ð¸Ñ‚Ðµ Ð³Ð¾Ñ€Ð¾Ð´ Ð¸Ð»Ð¸ Ñ‡Ð°ÑÐ¾Ð²Ð¾Ð¹ Ð¿Ð¾ÑÑ"},
      {value:"America/New_York", label:"ÐÑŒÑŽ-Ð™Ð¾Ñ€Ðº ðŸ‡ºðŸ‡¸"},
      {value:"America/Chicago", label:"Ð§Ð¸ÐºÐ°Ð³Ð¾ ðŸ‡ºðŸ‡¸"},
      {value:"America/Los_Angeles", label:"Ð›Ð¾Ñ-ÐÐ½Ð´Ð¶ÐµÐ»ÐµÑ ðŸ‡ºðŸ‡¸"},
      {value:"America/Toronto", label:"Ð¢Ð¾Ñ€Ð¾Ð½Ñ‚Ð¾ ðŸ‡¨ðŸ‡¦"},
      {value:"Europe/London", label:"Ð›Ð¾Ð½Ð´Ð¾Ð½ ðŸ‡¬ðŸ‡§"},
      {value:"Europe/Paris", label:"ÐŸÐ°Ñ€Ð¸Ð¶ ðŸ‡«ðŸ‡·"},
      {value:"Europe/Berlin", label:"Ð‘ÐµÑ€Ð»Ð¸Ð½ ðŸ‡©ðŸ‡ª"},
      {value:"Europe/Moscow", label:"ÐœÐ¾ÑÐºÐ²Ð° ðŸ‡·ðŸ‡º"},
      {value:"Europe/Istanbul", label:"Ð¡Ñ‚Ð°Ð¼Ð±ÑƒÐ» ðŸ‡¹ðŸ‡·"},
      {value:"Asia/Dubai", label:"Ð”ÑƒÐ±Ð°Ð¹ ðŸ‡¦ðŸ‡ª"},
      {value:"Asia/Kolkata", label:"ÐšÐ°Ð»ÑŒÐºÑƒÑ‚Ñ‚Ð° ðŸ‡®ðŸ‡³"},
      {value:"Asia/Shanghai", label:"Ð¨Ð°Ð½Ñ…Ð°Ð¹ ðŸ‡¨ðŸ‡³"},
      {value:"Asia/Tokyo", label:"Ð¢Ð¾ÐºÐ¸Ð¾ ðŸ‡¯ðŸ‡µ"},
      {value:"Asia/Singapore", label:"Ð¡Ð¸Ð½Ð³Ð°Ð¿ÑƒÑ€ ðŸ‡¸ðŸ‡¬"},
      {value:"Asia/Jakarta", label:"Ð”Ð¶Ð°ÐºÐ°Ñ€Ñ‚Ð° ðŸ‡®ðŸ‡©"},
      {value:"Australia/Sydney", label:"Ð¡Ð¸Ð´Ð½ÐµÐ¹ ðŸ‡¦ðŸ‡º"},
      {value:"Pacific/Auckland", label:"ÐžÐºÐ»ÐµÐ½Ð´ ðŸ‡³ðŸ‡¿"},
      {value:"America/Sao_Paulo", label:"Ð¡Ð°Ð½-ÐŸÐ°ÑƒÐ»Ñƒ ðŸ‡§ðŸ‡·"},
      {value:"America/Mexico_City", label:"ÐœÐµÑ…Ð¸ÐºÐ¾ ðŸ‡²ðŸ‡½"},
      {value:"Africa/Johannesburg", label:"Ð™Ð¾Ñ…Ð°Ð½Ð½ÐµÑÐ±ÑƒÑ€Ð³ ðŸ‡¿ðŸ‡¦"},
      {value:"Africa/Cairo", label:"ÐšÐ°Ð¸Ñ€ ðŸ‡ªðŸ‡¬"},
      {value:"Africa/Nairobi", label:"ÐÐ°Ð¹Ñ€Ð¾Ð±Ð¸ ðŸ‡°ðŸ‡ª"},
      {value:"Asia/Seoul", label:"Ð¡ÐµÑƒÐ» ðŸ‡°ðŸ‡·"},
      {value:"Asia/Hong_Kong", label:"Ð“Ð¾Ð½ÐºÐ¾Ð½Ð³ ðŸ‡­ðŸ‡°"},
      {value:"Asia/Bangkok", label:"Ð‘Ð°Ð½Ð³ÐºÐ¾Ðº ðŸ‡¹ðŸ‡­"},
      {value:"Asia/Manila", label:"ÐœÐ°Ð½Ð¸Ð»Ð° ðŸ‡µðŸ‡­"},
      {value:"Europe/Madrid", label:"ÐœÐ°Ð´Ñ€Ð¸Ð´ ðŸ‡ªðŸ‡¸"},
      {value:"Europe/Rome", label:"Ð Ð¸Ð¼ ðŸ‡®ðŸ‡¹"},
      {value:"Europe/Warsaw", label:"Ð’Ð°Ñ€ÑˆÐ°Ð²Ð° ðŸ‡µðŸ‡±"},
      {value:"Europe/Amsterdam", label:"ÐÐ¼ÑÑ‚ÐµÑ€Ð´Ð°Ð¼ ðŸ‡³ðŸ‡±"},
      {value:"Europe/Athens", label:"ÐÑ„Ð¸Ð½Ñ‹ ðŸ‡¬ðŸ‡·"},
      {value:"America/Vancouver", label:"Ð’Ð°Ð½ÐºÑƒÐ²ÐµÑ€ ðŸ‡¨ðŸ‡¦"}
    ];

    function populateCities() {
      const sel = document.getElementById('participantCity');
      sel.innerHTML = '';
      cities.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.value;
        opt.textContent = c.label;
        sel.appendChild(opt);
      });
    }

    const LS_KEY = 'meetingPlannerParticipants';
    function loadParticipants() {
      try { const raw = localStorage.getItem(LS_KEY); window.participants = raw ? JSON.parse(raw) : []; } catch(e){ window.participants = []; }
    }
    function saveParticipants() { try { localStorage.setItem(LS_KEY, JSON.stringify(window.participants || [])); } catch(e){} }
    function renderParticipants() {
      const container = document.getElementById('participantList');
      container.innerHTML = '';
      if (!window.participants || window.participants.length === 0) {
        container.innerHTML = '<div style="color:#888;">ÐŸÐ¾ÐºÐ° Ð½ÐµÑ‚ ÑƒÑ‡Ð°ÑÑ‚Ð½Ð¸ÐºÐ¾Ð².</div>';
        return;
      }
      window.participants.forEach((p, idx) => {
        const el = document.createElement('div');
        el.className = 'participant-item';
        el.innerHTML = `<div style="min-width:0;"><div style="font-weight:700;">${escapeHtml(p.name)}</div><div style="font-size:.9em;color:#666;">${escapeHtml(p.city)}</div></div>
          <div style="display:flex;gap:.5rem;"><button class="btn btn-outline-danger btn-sm" onclick="removeParticipant(${idx})" aria-label="Remove participant"><i class="fa fa-trash"></i></button></div>`;
        container.appendChild(el);
      });
    }
    function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

    document.getElementById('addParticipant').addEventListener('click', function(){
      const name = document.getElementById('participantName').value.trim();
      const city = document.getElementById('participantCity').value;
      if (!name) { alert('ÐŸÐ¾Ð¶Ð°Ð»ÑƒÐ¹ÑÑ‚Ð° Ð²Ð²ÐµÐ´Ð¸Ñ‚Ðµ Ð¸Ð¼Ñ ÑƒÑ‡Ð°ÑÑ‚Ð½Ð¸ÐºÐ°.'); return; }
      if (!city) { alert('ÐŸÐ¾Ð¶Ð°Ð»ÑƒÐ¹ÑÑ‚Ð° Ð²Ñ‹Ð±ÐµÑ€Ð¸Ñ‚Ðµ Ð³Ð¾Ñ€Ð¾Ð´ / Ñ‡Ð°ÑÐ¾Ð²Ð¾Ð¹ Ð¿Ð¾ÑÑ.'); return; }
      window.participants = window.participants || [];
      window.participants.push({ name, city });
      saveParticipants();
      document.getElementById('participantName').value = '';
      document.getElementById('participantCity').selectedIndex = 0;
      renderParticipants();
      updateMeetingTimes();
    });

    document.getElementById('clearParticipants').addEventListener('click', function(){
      if (!window.participants || window.participants.length === 0) return;
      if (!confirm('ÐžÑ‡Ð¸ÑÑ‚Ð¸Ñ‚ÑŒ Ð²ÑÐµÑ… ÑƒÑ‡Ð°ÑÑ‚Ð½Ð¸ÐºÐ¾Ð²?')) return;
      window.participants = [];
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    });

    window.removeParticipant = function(idx){
      if (!window.participants) return;
      window.participants.splice(idx,1);
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    };

    const { DateTime } = luxon;
    function updateMeetingTimes(){
      const date = document.getElementById('meetingDate').value;
      const time = document.getElementById('meetingTime').value;
      const out = document.getElementById('meetingTimes');
      const tlang = {
        noDateTime: "ÐŸÐ¾Ð¶Ð°Ð»ÑƒÐ¹ÑÑ‚Ð° Ð²Ñ‹Ð±ÐµÑ€Ð¸Ñ‚Ðµ Ð´Ð°Ñ‚Ñƒ Ð¸ Ð²Ñ€ÐµÐ¼Ñ.",
        noParticipants: "ÐŸÐ¾ÐºÐ° Ð½ÐµÑ‚ ÑƒÑ‡Ð°ÑÑ‚Ð½Ð¸ÐºÐ¾Ð².",
        heading: "Ð’Ñ€ÐµÐ¼Ñ Ð²ÑÑ‚Ñ€ÐµÑ‡Ð¸ (Ð¾Ñ€Ð³Ð°Ð½Ð¸Ð·Ð°Ñ‚Ð¾Ñ€ â†’ Ð¼ÐµÑÑ‚Ð½Ð¾Ðµ Ð²Ñ€ÐµÐ¼Ñ ÑƒÑ‡Ð°ÑÑ‚Ð½Ð¸ÐºÐ¾Ð²)"
      };
      if (!date || !time) { out.innerHTML = `<div style="color:#888;">${tlang.noDateTime}</div>`; return; }
      if (!window.participants || window.participants.length === 0) { out.innerHTML = `<div style="color:#888;">${tlang.noParticipants}</div>`; return; }
      const localISO = `${date}T${time}`;
      let organizer = DateTime.fromISO(localISO);
      if (!organizer.isValid) { out.innerHTML = `<div style="color:#b00;">${tlang.noDateTime}</div>`; return; }
      let html = `<div style="font-weight:700;margin-bottom:.4rem;">${tlang.heading}</div><div class="meeting-times-grid">`;
      html += `<div class="time-suggestion"><div><b>ÐžÑ€Ð³Ð°Ð½Ð¸Ð·Ð°Ñ‚Ð¾Ñ€</b> (${escapeHtml(organizer.zoneName)})</div><div>${escapeHtml(organizer.toLocaleString(DateTime.DATETIME_FULL))}</div></div>`;
      window.participants.forEach(p => {
        let dt;
        try { dt = organizer.setZone(p.city); } catch(e) { dt = null; }
        const label = dt ? dt.toLocaleString(DateTime.DATETIME_FULL) : 'ÐÐµÐ²ÐµÑ€Ð½Ð°Ñ Ð·Ð¾Ð½Ð°';
        html += `<div class="time-suggestion"><div><b>${escapeHtml(p.name)}</b> <span style="color:#666;">(${escapeHtml(p.city)})</span></div><div>${escapeHtml(label)}</div></div>`;
      });
      html += `</div>`;
      out.innerHTML = html;
    }

    document.getElementById('calcTimes').addEventListener('click', updateMeetingTimes);

    document.addEventListener('DOMContentLoaded', function(){
      populateCities();
      loadParticipants();
      renderParticipants();
      try {
        const savedDate = localStorage.getItem('meetingPlannerDate');
        const savedTime = localStorage.getItem('meetingPlannerTime');
        if (savedDate) document.getElementById('meetingDate').value = savedDate;
        if (savedTime) document.getElementById('meetingTime').value = savedTime;
      } catch(e){}
    });

    document.getElementById('meetingDate').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerDate', this.value); }catch(e){} });
    document.getElementById('meetingTime').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerTime', this.value); }catch(e){} });

  </script>
