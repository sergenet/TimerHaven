  <script>
  // RU page: unified fixes â€” instant DOM conversion, robust unit binding, reverse geocoding for location
  const PAGE_LANG = 'ru';
  const TEMP_UNIT_KEY = 'timerhavenTempUnit';
  const DEFAULT_UNIT = 'C';
  let LAST_QUERY = null;

  function getStoredUnit() { try { const u = localStorage.getItem(TEMP_UNIT_KEY); if (u === 'C' || u === 'F') return u; } catch(e){} return DEFAULT_UNIT; }
  function setStoredUnit(u) { try { localStorage.setItem(TEMP_UNIT_KEY, u); } catch(e){} }

  function applyUnitUI() {
    try {
      const u = getStoredUnit();
      const c = document.getElementById('unitC'), f = document.getElementById('unitF');
      if (!c || !f) return;
      if (u === 'C') { c.classList.add('active'); c.setAttribute('aria-pressed','true'); f.classList.remove('active'); f.setAttribute('aria-pressed','false'); }
      else { f.classList.add('active'); f.setAttribute('aria-pressed','true'); c.classList.remove('active'); c.setAttribute('aria-pressed','false'); }
    } catch(e){ console.warn('applyUnitUI error', e); }
  }

  // Convert displayed temperatures/wind client-side (fast)
  function convertDisplayedUnits(targetUnit){
    try {
      const el = document.getElementById('weatherResult');
      if (!el) return false;
      const prevHTML = el.innerHTML;
      const hasC = /Â°\s*C/i.test(prevHTML);
      const hasF = /Â°\s*F/i.test(prevHTML);
      if (!hasC && !hasF) return false;
      let html = prevHTML;
      if (targetUnit === 'F') {
        html = html.replace(/(-?\d+)\s*Â°\s*C/gi, function(_, n){ const c = parseInt(n,10); return Math.round((c * 9/5) + 32) + 'Â°F'; });
        html = html.replace(/(\d+(?:\.\d+)?)\s*m\/s/gi, function(_, v){ const mps = parseFloat(v); return Math.round(mps * 2.23694) + ' mph'; });
      }
      if (targetUnit === 'C') {
        html = html.replace(/(-?\d+)\s*Â°\s*F/gi, function(_, n){ const f = parseInt(n,10); return Math.round((f - 32) * 5/9) + 'Â°C'; });
        html = html.replace(/(\d+(?:\.\d+)?)\s*mph/gi, function(_, v){ const mph = parseFloat(v); return Math.round((mph / 2.23694)) + ' m/s'; });
      }
      if (html !== prevHTML) { el.innerHTML = html; setStoredUnit(targetUnit); applyUnitUI(); return true; }
      return false;
    } catch (err) { console.warn('convertDisplayedUnits error', err); return false; }
  }

  // Reapply last query (network preferred when LAST_QUERY exists), otherwise conversion then safe fetch
  function reapplyLastQuery() {
    if (LAST_QUERY) {
      if (LAST_QUERY.type === 'coords' && LAST_QUERY.lat != null && LAST_QUERY.lon != null) {
        fetchOpenMeteoForecast(LAST_QUERY.lat, LAST_QUERY.lon).then(fore => { try { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(fore, LAST_QUERY.placeName || ''); } catch(e){} }).catch(()=>{});
      } else if (LAST_QUERY.type === 'city' && LAST_QUERY.city) { fetchWeather(LAST_QUERY.city); }
      else if (LAST_QUERY.type === 'backend' && LAST_QUERY.city) { fetchBackendCity(LAST_QUERY.city); }
      return;
    }

    const desiredUnit = getStoredUnit();
    const converted = convertDisplayedUnits(desiredUnit);
    if (converted) return;

    // Safe fetch fallback (preserve current HTML on failure)
    try {
      const resultEl = document.getElementById('weatherResult');
      if (!resultEl) return;
      const prevHTML = resultEl.innerHTML;
      let place = null;
      const bold = resultEl.querySelector('b, strong');
      if (bold && bold.textContent) place = bold.textContent.trim();
      if (!place) {
        const lines = (resultEl.textContent || '').split(/\n/).map(s=>s.trim()).filter(Boolean);
        if (lines.length) {
          for (const line of lines) {
            if (/,/.test(line) || /[A-Za-z]/.test(line)) { place = line; break; }
          }
          if (!place) place = lines[0];
        }
      }
      if (!place) return;
      resultEl.innerHTML = 'Ð—Ð°Ð³Ñ€ÑƒÐ·ÐºÐ°...';
      geocodeCity(place).then(geo => {
        if (geo && geo.latitude != null && geo.longitude != null) {
          LAST_QUERY = { type: 'coords', lat: geo.latitude, lon: geo.longitude, placeName: geo.name, city: place };
          fetchOpenMeteoForecast(geo.latitude, geo.longitude).then(fore => {
            if (!fore) { resultEl.innerHTML = prevHTML; return; }
            try { resultEl.innerHTML = renderOpenMeteo(fore, geo.name || place); } catch(e){ resultEl.innerHTML = prevHTML; }
          }).catch(()=> { resultEl.innerHTML = prevHTML; });
        } else { resultEl.innerHTML = prevHTML; }
      }).catch(()=> { resultEl.innerHTML = prevHTML; });
    } catch (err) { console.warn('reapplyLastQuery fallback error', err); }
  }

  // Robust unit toggle binder
  (function bindUnitToggles() {
    function findButtons(){
      const byIdC = document.getElementById('unitC'), byIdF = document.getElementById('unitF');
      if (byIdC || byIdF) return { c:byIdC, f:byIdF };
      const byDataC = document.querySelector('button[data-unit="C"], button[data-unit="Â°C"]');
      const byDataF = document.querySelector('button[data-unit="F"], button[data-unit="Â°F"]');
      if (byDataC || byDataF) return { c:byDataC, f:byDataF };
      const container = document.querySelector('.unit-toggle') || document.body;
      let c=null,f=null;
      container.querySelectorAll('button, [role="button"]').forEach(btn=>{
        const txt = (btn.textContent||'').trim();
        if (!c && /Â°\s*C|Celsius|C$/i.test(txt)) c = btn;
        if (!f && /Â°\s*F|Fahrenheit|F$/i.test(txt)) f = btn;
      });
      return { c,f };
    }

    function attach(btn, unit) {
      if (!btn) return;
      const handler = function(e) {
        try {
          setStoredUnit(unit);
          if (!LAST_QUERY) {
            const conv = convertDisplayedUnits(unit);
            if (conv) return;
          }
          applyUnitUI();
          setTimeout(reapplyLastQuery, 50);
        } catch(err){ console.warn('unit handler error', err); }
      };
      btn.addEventListener('click', handler);
      try { btn.addEventListener('touchend', function(e){ e.preventDefault(); handler(); }, { passive:false }); } catch(e){}
      btn.addEventListener('keydown', function(ev){ if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); handler(); } });
    }

    function init(){
      const { c, f } = findButtons();
      attach(c, 'C'); attach(f, 'F');
      applyUnitUI();
      if (!(c && f)) {
        setTimeout(()=>{ const again = findButtons(); attach(again.c,'C'); attach(again.f,'F'); applyUnitUI(); }, 350);
      }

      document.addEventListener('click', function(e){
        try {
          const t = e.target;
          const unitBtn = t.closest && t.closest('#unitC, #unitF');
          if (unitBtn) {
            e.preventDefault();
            const id = unitBtn.id;
            const unit = (id === 'unitC') ? 'C' : (id === 'unitF') ? 'F' : null;
            if (unit) { setStoredUnit(unit); applyUnitUI(); setTimeout(reapplyLastQuery, 50); }
          }
        } catch(_) {}
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();

  // --- Weather rendering & helpers (language-specific) ---
  const UI_STRINGS = {
    ru: {
      PLEASE_SELECT: "ÐŸÐ¾Ð¶Ð°Ð»ÑƒÐ¹ÑÑ‚Ð°, Ð²Ñ‹Ð±ÐµÑ€Ð¸Ñ‚Ðµ Ð¸Ð»Ð¸ Ð²Ð²ÐµÐ´Ð¸Ñ‚Ðµ Ð³Ð¾Ñ€Ð¾Ð´.",
      GEO_UNSUPPORTED: "Ð“ÐµÐ¾Ð»Ð¾ÐºÐ°Ñ†Ð¸Ñ Ð½Ðµ Ð¿Ð¾Ð´Ð´ÐµÑ€Ð¶Ð¸Ð²Ð°ÐµÑ‚ÑÑ.",
      UNABLE_LOCATION: "ÐÐµ ÑƒÐ´Ð°Ð»Ð¾ÑÑŒ Ð¿Ð¾Ð»ÑƒÑ‡Ð¸Ñ‚ÑŒ Ð²Ð°ÑˆÐµ Ð¼ÐµÑÑ‚Ð¾Ð¿Ð¾Ð»Ð¾Ð¶ÐµÐ½Ð¸Ðµ.",
      FETCH_ERROR: "ÐžÑˆÐ¸Ð±ÐºÐ° Ð¿Ñ€Ð¸ Ð¿Ð¾Ð»ÑƒÑ‡ÐµÐ½Ð¸Ð¸ Ð´Ð°Ð½Ð½Ñ‹Ñ… Ð¾ Ð¿Ð¾Ð³Ð¾Ð´Ðµ.",
      NOT_FOUND_TEMPLATE: "ÐÐµ ÑƒÐ´Ð°Ð»Ð¾ÑÑŒ Ð½Ð°Ð¹Ñ‚Ð¸ Ð¿Ð¾Ð³Ð¾Ð´Ñƒ Ð´Ð»Ñ \"{city}\"."
    }
  };

  const WEATHERCODE_DESC = {
    0:{ ru:"Ð¯ÑÐ½Ð¾" },1:{ ru:"ÐŸÑ€ÐµÐ¸Ð¼ÑƒÑ‰ÐµÑÑ‚Ð²ÐµÐ½Ð½Ð¾ ÑÑÐ½Ð¾" },2:{ ru:"ÐœÐ°Ð»Ð¾Ð¾Ð±Ð»Ð°Ñ‡Ð½Ð¾" },3:{ ru:"ÐŸÐ°ÑÐ¼ÑƒÑ€Ð½Ð¾" },
    45:{ ru:"Ð¢ÑƒÐ¼Ð°Ð½" },48:{ ru:"Ð¢ÑƒÐ¼Ð°Ð½ Ñ Ð¸Ð·Ð¼Ð¾Ñ€Ð¾Ð·ÑŒÑŽ" },51:{ ru:"Ð›ÐµÐ³ÐºÐ°Ñ Ð¼Ð¾Ñ€Ð¾ÑÑŒ" },53:{ ru:"Ð£Ð¼ÐµÑ€ÐµÐ½Ð½Ð°Ñ Ð¼Ð¾Ñ€Ð¾ÑÑŒ" },
    55:{ ru:"Ð¡Ð¸Ð»ÑŒÐ½Ð°Ñ Ð¼Ð¾Ñ€Ð¾ÑÑŒ" },56:{ ru:"Ð›ÐµÐ³ÐºÐ°Ñ Ð»ÐµÐ´ÑÐ½Ð°Ñ Ð¼Ð¾Ñ€Ð¾ÑÑŒ" },57:{ ru:"Ð¡Ð¸Ð»ÑŒÐ½Ð°Ñ Ð»ÐµÐ´ÑÐ½Ð°Ñ Ð¼Ð¾Ñ€Ð¾ÑÑŒ" },
    61:{ ru:"ÐÐµÐ±Ð¾Ð»ÑŒÑˆÐ¾Ð¹ Ð´Ð¾Ð¶Ð´ÑŒ" },63:{ ru:"Ð£Ð¼ÐµÑ€ÐµÐ½Ð½Ñ‹Ð¹ Ð´Ð¾Ð¶Ð´ÑŒ" },65:{ ru:"Ð¡Ð¸Ð»ÑŒÐ½Ñ‹Ð¹ Ð´Ð¾Ð¶Ð´ÑŒ" },
    71:{ ru:"ÐÐµÐ±Ð¾Ð»ÑŒÑˆÐ¾Ð¹ ÑÐ½ÐµÐ³" },73:{ ru:"Ð£Ð¼ÐµÑ€ÐµÐ½Ð½Ñ‹Ð¹ ÑÐ½ÐµÐ³" },75:{ ru:"Ð¡Ð¸Ð»ÑŒÐ½Ñ‹Ð¹ ÑÐ½ÐµÐ³" },
    80:{ ru:"ÐÐµÐ±Ð¾Ð»ÑŒÑˆÐ¸Ðµ Ð»Ð¸Ð²Ð½Ð¸" },81:{ ru:"Ð£Ð¼ÐµÑ€ÐµÐ½Ð½Ñ‹Ðµ Ð»Ð¸Ð²Ð½Ð¸" },82:{ ru:"Ð¡Ð¸Ð»ÑŒÐ½Ñ‹Ðµ Ð»Ð¸Ð²Ð½Ð¸" },
    95:{ ru:"Ð“Ñ€Ð¾Ð·Ð°" },96:{ ru:"Ð“Ñ€Ð¾Ð·Ð° Ñ Ð½ÐµÐ±Ð¾Ð»ÑŒÑˆÐ¸Ð¼ Ð³Ñ€Ð°Ð´Ð¾Ð¼" },99:{ ru:"Ð“Ñ€Ð¾Ð·Ð° Ñ ÑÐ¸Ð»ÑŒÐ½Ñ‹Ð¼ Ð³Ñ€Ð°Ð´Ð¾Ð¼" }
  };

  function t(key, vars) {
    const dict = UI_STRINGS[PAGE_LANG] || UI_STRINGS['ru'] || {};
    let s = dict[key] || '';
    if (vars && typeof vars === 'object') { Object.keys(vars).forEach(k => { s = s.replace('{'+k+'}', vars[k]); }); }
    return s;
  }

  function describeWeatherCode(code) {
    const obj = WEATHERCODE_DESC[code];
    if (!obj) return String(code);
    return obj[PAGE_LANG] || obj['ru'] || String(code);
  }

  function localizedWeekday(dateStr) {
    try { const d = new Date(dateStr); return new Intl.DateTimeFormat(PAGE_LANG, { weekday: 'short' }).format(d); } catch(e){ return dateStr; }
  }

  function getWeatherEmoji(code) {
    if (code === null || code === undefined) return 'â€¢';
    if (code === 0) return 'â˜€ï¸';
    if (code === 1 || code === 2) return 'ðŸŒ¤ï¸';
    if (code === 3) return 'â˜ï¸';
    if ([45,48].includes(code)) return 'ðŸŒ«ï¸';
    if ([51,53,55,56,57].includes(code)) return 'ðŸŒ¦ï¸';
    if ([61,63,65,80,81,82].includes(code)) return 'ðŸŒ§ï¸';
    if ([71,73,75].includes(code)) return 'â„ï¸';
    if ([95,96,99].includes(code)) return 'â›ˆï¸';
    return 'ðŸŒ¤ï¸';
  }

  function renderOpenMeteo(forecast, placeName) {
    const unit = getStoredUnit();
    const tempSymbol = (unit === 'F') ? 'Â°F' : 'Â°C';
    const speedUnit = (unit === 'F') ? 'mph' : 'm/s';
    const cw = forecast.current_weather || {};
    const daily = forecast.daily || {};
    const parts = [];
    const title = `<div style="font-weight:700; margin-bottom:6px;">${placeName || ''}</div>`;
    const weatherLabel = describeWeatherCode(cw.weathercode);
    const currentHtml = `<div style="display:flex;gap:.6rem;align-items:center;">
      <div style="flex:1"><div style="font-weight:700;font-size:1.05rem;">${weatherLabel}</div></div>
      <div style="text-align:right;min-width:110px">
        <div style="font-size:1.45rem;font-weight:700;">${typeof cw.temperature === 'number' ? Math.round(cw.temperature) + tempSymbol : 'N/A'}</div>
        <div style="color:#6b7280;">Ð’ÐµÑ‚ÐµÑ€ ${typeof cw.windspeed === 'number' ? Math.round(cw.windspeed) + ' ' + speedUnit : 'N/A'}</div>
      </div>
    </div>`;
    parts.push(title + currentHtml);

    if (daily.time && daily.time.length) {
      const days = daily.time.map((d,i) => {
        const maxT = daily.temperature_2m_max && daily.temperature_2m_max[i] !== undefined ? Math.round(daily.temperature_2m_max[i]) : 'â€”';
        const minT = daily.temperature_2m_min && daily.temperature_2m_min[i] !== undefined ? Math.round(daily.temperature_2m_min[i]) : 'â€”';
        const code = daily.weathercode && daily.weathercode[i] !== undefined ? daily.weathercode[i] : null;
        const desc = code !== null ? describeWeatherCode(code) : '';
        return { date: d, maxT, minT, code, desc };
      }).slice(0,7);

      let grid = '<div class="forecast-grid">';
      days.forEach(day => {
        grid += `<div class="forecast-day">
                    <div class="day">${localizedWeekday(day.date)}</div>
                    <div class="weather-icon">${getWeatherEmoji(day.code)}</div>
                    <div class="desc">${day.desc}</div>
                    <div class="temp"><span style="font-weight:700;">${day.maxT}${tempSymbol}</span> / ${day.minT}${tempSymbol}</div>
                 </div>`;
      });
      grid += '</div>';
      parts.push(grid);
    }

    return parts.join('');
  }

  function geocodeCity(city) {
    const url = `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=${PAGE_LANG}`;
    return fetch(url).then(r => r.json()).then(j => {
      if (j && Array.isArray(j.results) && j.results.length > 0) {
        const r0 = j.results[0];
        return { latitude: r0.latitude, longitude: r0.longitude, name: r0.name + (r0.country ? ', ' + r0.country : '') };
      }
      return null;
    }).catch(()=>null);
  }

  function fetchOpenMeteoForecast(lat, lon) {
    const unit = getStoredUnit();
    const temperature_unit = (unit === 'F') ? 'fahrenheit' : 'celsius';
    const windspeed_unit = (unit === 'F') ? 'mph' : 'ms';
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&daily=temperature_2m_max,temperature_2m_min,weathercode&current_weather=true&timezone=auto&forecast_days=7&temperature_unit=${temperature_unit}&windspeed_unit=${windspeed_unit}`;
    return fetch(url).then(r => r.json());
  }

  function fetchBackendCity(city) {
    const resultEl = document.getElementById('weatherResult');
    return fetch(`/weather?city=${encodeURIComponent(city)}`)
      .then(r => r.json())
      .then(data => {
        if (!data || (data.cod && parseInt(data.cod,10) !== 200)) {
          const err = (data && (data.error || data.message)) || t('NOT_FOUND_TEMPLATE', { city });
          resultEl.innerHTML = `<span style="color:#b00;">${err}</span>`;
          return null;
        }
        LAST_QUERY = { type: 'backend', city };
        resultEl.innerHTML = renderWeatherData(data);
        return data;
      })
      .catch(() => {
        resultEl.innerHTML = '<span style="color:#b00;">' + t('FETCH_ERROR') + '</span>';
        return null;
      });
  }

  function renderWeatherData(data) {
    const unit = getStoredUnit();
    let tempStr = (data.main && typeof data.main.temp === 'number') ? Math.round(data.main.temp) + 'Â°C' : 'N/A';
    if (unit === 'F' && data.main && typeof data.main.temp === 'number') tempStr = Math.round((data.main.temp * 9/5)+32) + 'Â°F';
    const windUnit = (unit === 'F') ? 'mph' : 'm/s';
    let wind = data.wind ? data.wind.speed : 'N/A';
    if (unit === 'F' && data.wind && typeof data.wind.speed === 'number') wind = Math.round(data.wind.speed * 2.23694);
    return `<b>${data.name}${data.sys && data.sys.country ? ', ' + data.sys.country : ''}</b><br>
            ÐŸÐ¾Ð³Ð¾Ð´Ð°: ${data.weather && data.weather[0] ? data.weather[0].description : 'N/A'}<br>
            Ð¢ÐµÐ¼Ð¿ÐµÑ€Ð°Ñ‚ÑƒÑ€Ð°: ${tempStr}<br>
            Ð’Ð»Ð°Ð¶Ð½Ð¾ÑÑ‚ÑŒ: ${data.main ? data.main.humidity : 'N/A'}%<br>
            Ð’ÐµÑ‚ÐµÑ€: ${wind} ${windUnit}`;
  }

  function fetchWeather(city) {
    const resultEl = document.getElementById('weatherResult');
    if (!city) { resultEl.innerHTML = '<span style="color:#b00;">' + t('PLEASE_SELECT') + '</span>'; return; }
    resultEl.innerHTML = 'Ð—Ð°Ð³Ñ€ÑƒÐ·ÐºÐ°...';
    geocodeCity(city).then(geo => {
      if (geo && geo.latitude != null && geo.longitude != null) {
        LAST_QUERY = { type: 'coords', lat: geo.latitude, lon: geo.longitude, placeName: geo.name, city: city };
        fetchOpenMeteoForecast(geo.latitude, geo.longitude).then(fore => {
          if (!fore) return fetchBackendCity(city);
          try { resultEl.innerHTML = renderOpenMeteo(fore, geo.name || city); } catch (e) { console.error('renderOpenMeteo error', e); resultEl.innerHTML = '<span style="color:#b00;">' + t('FETCH_ERROR') + '</span>'; }
        }).catch(()=> fetchBackendCity(city));
      } else fetchBackendCity(city);
    }).catch(()=> fetchBackendCity(city));
  }

  // UI wiring
  try {
    document.getElementById('cityDropdown').addEventListener('change', function () { document.getElementById('cityInput').value = this.value; if (this.value) fetchWeather(this.value); });
    document.getElementById('cityInput').addEventListener('input', function () {
      const val = this.value.trim(); const dd = document.getElementById('cityDropdown'); let found=false;
      for (let i=0;i<dd.options.length;i++){ if (dd.options[i].value.toLowerCase()===val.toLowerCase()){ dd.selectedIndex=i; found=true; break; } }
      if (!found) dd.selectedIndex=0;
    });
    document.getElementById('weatherForm').addEventListener('submit', function(e){ e.preventDefault(); const city = document.getElementById('cityInput').value.trim() || document.getElementById('cityDropdown').value; fetchWeather(city); });
  } catch(e){ console.warn(e); }

  try { if (!localStorage.getItem(TEMP_UNIT_KEY)) localStorage.setItem(TEMP_UNIT_KEY, DEFAULT_UNIT); } catch(e){}
  applyUnitUI();

  // Reverse geocode helper
  function reverseGeocode(lat, lon) {
    const url = `https://geocoding-api.open-meteo.com/v1/reverse?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&count=1&language=${PAGE_LANG}`;
    return fetch(url).then(r => r.ok ? r.json() : null).then(j => {
      if (j && Array.isArray(j.results) && j.results.length > 0) {
        const r0 = j.results[0];
        return (r0.name || '') + (r0.country ? ', ' + r0.country : '');
      }
      return '';
    }).catch(()=> '');
  }

  // Exposed helper for native/external injection (sets LAST_QUERY and renders place name where possible)
  window._injectedFetchByCoords = window._injectedFetchByCoords || async function(lat, lon, placeName){
    try {
      if (typeof fetchOpenMeteoForecast === 'function' && typeof renderOpenMeteo === 'function') {
        let resolvedName = placeName || '';
        if (!resolvedName) { try { resolvedName = await reverseGeocode(lat, lon); } catch(e){ resolvedName = ''; } }
        const q = { type:'coords', lat: lat, lon: lon, placeName: resolvedName || '' };
        LAST_QUERY = q;
        try { window.LAST_QUERY = q; } catch(e){}
        const fore = await fetchOpenMeteoForecast(lat, lon);
        if (fore) {
          try { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(fore, resolvedName || ''); }
          catch(e){ console.error('renderOpenMeteo error', e); document.getElementById('weatherResult').innerHTML = '<span style="color:#b00;">ÐžÑˆÐ¸Ð±ÐºÐ° Ð¾Ñ‚Ð¾Ð±Ñ€Ð°Ð¶ÐµÐ½Ð¸Ñ</span>'; }
        } else {
          document.getElementById('weatherResult').innerHTML = '<span style="color:#b00;">ÐžÑˆÐ¸Ð±ÐºÐ° Ð¿Ð¾Ð»ÑƒÑ‡ÐµÐ½Ð¸Ñ Ð¿Ñ€Ð¾Ð³Ð½Ð¾Ð·Ð°</span>';
        }
      } else {
        console.log('Coordinates available:', lat, lon);
      }
    } catch(e){ console.error(e); }
  };

  // Robust geolocation IIFE (reverse-geocode & set place name)
  (function(){
    const TIMEOUT_MS = 25000;
    const useBtn = document.getElementById('useLocationBtn');
    const resultEl = document.getElementById('weatherResult');

    function log(msg){ try { console.debug('[geo] '+msg); } catch(e){} }
    function show(msg, isError){ if (!resultEl) return; resultEl.innerHTML = isError ? ('<span style="color:#b00;">' + msg + '</span>') : msg; }

    function getPositionWithTimeout(opts){
      return new Promise((resolve, reject) => {
        if (!navigator.geolocation) { const err = new Error('Geolocation unavailable'); err.code = 0; return reject(err); }
        let finished=false;
        const timer = setTimeout(()=> { if (finished) return; finished=true; const err = new Error('Timeout'); err.code = 3; reject(err); }, TIMEOUT_MS);
        navigator.geolocation.getCurrentPosition(pos => { if (finished) return; finished=true; clearTimeout(timer); resolve(pos); }, err => { if (finished) return; finished=true; clearTimeout(timer); reject(err); }, opts || { enableHighAccuracy:false, maximumAge:0, timeout:TIMEOUT_MS });
      });
    }

    async function queryPermission(){
      if (!navigator.permissions || !navigator.permissions.query) return null;
      try { const p = await navigator.permissions.query({ name: 'geolocation' }); return p.state; } catch(e){ log('permissions.query failed: '+e); return null; }
    }

    function permissionHelpText(){
      return `
        <div style="font-size:0.95rem;line-height:1.3;">
          Ð”Ð¾ÑÑ‚ÑƒÐ¿ Ðº Ð³ÐµÐ¾Ð»Ð¾ÐºÐ°Ñ†Ð¸Ð¸ Ð·Ð°Ð±Ð»Ð¾ÐºÐ¸Ñ€Ð¾Ð²Ð°Ð½. Ð§Ñ‚Ð¾Ð±Ñ‹ Ð²ÐºÐ»ÑŽÑ‡Ð¸Ñ‚ÑŒ:
          <ul>
            <li>ÐžÑ‚ÐºÑ€Ð¾Ð¹Ñ‚Ðµ Ð¼ÐµÐ½ÑŽ Ð±Ñ€Ð°ÑƒÐ·ÐµÑ€Ð° â†’ ÐÐ°ÑÑ‚Ñ€Ð¾Ð¹ÐºÐ¸ ÑÐ°Ð¹Ñ‚Ð° â†’ ÐœÐµÑÑ‚Ð¾Ð¿Ð¾Ð»Ð¾Ð¶ÐµÐ½Ð¸Ðµ â†’ Ñ€Ð°Ð·Ñ€ÐµÑˆÐ¸Ñ‚ÑŒ Ð´Ð»Ñ timerhaven.com</li>
            <li>Ð£Ð±ÐµÐ´Ð¸Ñ‚ÐµÑÑŒ, Ñ‡Ñ‚Ð¾ Ð² Android Ð²ÐºÐ»ÑŽÑ‡ÐµÐ½Ð¾: ÐÐ°ÑÑ‚Ñ€Ð¾Ð¹ÐºÐ¸ â†’ ÐœÐµÑÑ‚Ð¾Ð¿Ð¾Ð»Ð¾Ð¶ÐµÐ½Ð¸Ðµ</li>
            <li>ÐÐµ Ð¸ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐ¹Ñ‚Ðµ Ñ€ÐµÐ¶Ð¸Ð¼ Ð¸Ð½ÐºÐ¾Ð³Ð½Ð¸Ñ‚Ð¾</li>
          </ul>
          Ð˜Ð»Ð¸ Ð²ÑÑ‚Ð°Ð²ÑŒÑ‚Ðµ ÐºÐ¾Ð¾Ñ€Ð´Ð¸Ð½Ð°Ñ‚Ñ‹ Ð¸Ð· Ð¿Ñ€Ð¸Ð»Ð¾Ð¶ÐµÐ½Ð¸Ñ Â«ÐšÐ°Ñ€Ñ‚Ñ‹Â» (ÐŸÐ¾Ð´ÐµÐ»Ð¸Ñ‚ÑŒÑÑ â†’ ÐšÐ¾Ð¿Ð¸Ñ€Ð¾Ð²Ð°Ñ‚ÑŒ ÐºÐ¾Ð¾Ñ€Ð´Ð¸Ð½Ð°Ñ‚Ñ‹).
        </div>
      `;
    }

    async function handleUseLocation(e){
      e && e.preventDefault && e.preventDefault();
      show('ÐžÐ¿Ñ€ÐµÐ´ÐµÐ»ÐµÐ½Ð¸Ðµ Ð¼ÐµÑÑ‚Ð¾Ð¿Ð¾Ð»Ð¾Ð¶ÐµÐ½Ð¸Ñ...');
      log('User requested location');

      const perm = await queryPermission().catch(()=>null);
      log('permission state: '+perm);
      if (perm === 'denied'){ show(permissionHelpText(), true); return; }

      const attempts = [
        { enableHighAccuracy:false, maximumAge: 60 * 1000, timeout: TIMEOUT_MS },
        { enableHighAccuracy:true, maximumAge: 0, timeout: TIMEOUT_MS + 5000 }
      ];

      for (const opts of attempts) {
        try {
          const pos = await getPositionWithTimeout(opts);
          log('got coords: '+pos.coords.latitude+','+pos.coords.longitude);
          show('' + pos.coords.latitude.toFixed(4) + ', ' + pos.coords.longitude.toFixed(4) + ' â€” Ð·Ð°Ð³Ñ€ÑƒÐ¶Ð°ÐµÐ¼ Ð¿Ñ€Ð¾Ð³Ð½Ð¾Ð·...');
          const placeName = await reverseGeocode(pos.coords.latitude, pos.coords.longitude).catch(()=>'');

          LAST_QUERY = { type:'coords', lat: pos.coords.latitude, lon: pos.coords.longitude, placeName: placeName || '' };
          try { window.LAST_QUERY = LAST_QUERY; } catch(e){}

          try {
            const fore = await fetchOpenMeteoForecast(pos.coords.latitude, pos.coords.longitude);
            if (fore) { try { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(fore, placeName || ''); } catch(err) { console.error('renderOpenMeteo error', err); show('ÐžÑˆÐ¸Ð±ÐºÐ° Ð¾Ñ‚Ð¾Ð±Ñ€Ð°Ð¶ÐµÐ½Ð¸Ñ', true); } }
            else { if (placeName) fetchBackendCity(placeName); else show('ÐžÑˆÐ¸Ð±ÐºÐ° Ð¿Ð¾Ð»ÑƒÑ‡ÐµÐ½Ð¸Ñ Ð¿Ñ€Ð¾Ð³Ð½Ð¾Ð·Ð°', true); }
          } catch (err) {
            console.error('fetchOpenMeteoForecast error', err);
            if (placeName) fetchBackendCity(placeName); else show('ÐžÑˆÐ¸Ð±ÐºÐ° Ð¿Ð¾Ð»ÑƒÑ‡ÐµÐ½Ð¸Ñ Ð¿Ñ€Ð¾Ð³Ð½Ð¾Ð·Ð°', true);
          }
          return;
        } catch (err) {
          log('getPosition attempt failed: ' + (err && err.code) + ' / ' + (err && err.message));
        }
      }
      show('ÐœÐµÑÑ‚Ð¾Ð¿Ð¾Ð»Ð¾Ð¶ÐµÐ½Ð¸Ðµ Ð½ÐµÐ´Ð¾ÑÑ‚ÑƒÐ¿Ð½Ð¾ â€” Ð¿Ñ€Ð¾Ð²ÐµÑ€ÑŒÑ‚Ðµ Ñ€Ð°Ð·Ñ€ÐµÑˆÐµÐ½Ð¸Ñ/GPS Ð¸ Ð¿Ð¾Ð¿Ñ€Ð¾Ð±ÑƒÐ¹Ñ‚Ðµ ÑÐ½Ð¾Ð²Ð°.', true);
    }

    if (useBtn) {
      try { useBtn.removeEventListener && useBtn.removeEventListener('click', handleUseLocation); } catch(e){}
      useBtn.addEventListener('click', handleUseLocation);
    }

    // Receiver for native apps
    window.receiveNativeLocation = function(obj){
      try {
        const lat = parseFloat(obj.latitude || obj.lat);
        const lon = parseFloat(obj.longitude || obj.lon || obj.lng);
        if (!isNaN(lat) && !isNaN(lon)) {
          window._injectedFetchByCoords(lat, lon, obj.name || obj.place || '');
        }
      } catch(e){ log(e); }
    };
  })();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js"></script>
</body>
</html>


