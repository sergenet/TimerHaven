<input class="form-control" id="clipInput" placeholder="Î Î»Î·ÎºÏ„ÏÎ¿Î»Î¿Î³Î®ÏƒÏ„Îµ Î® ÎµÏ€Î¹ÎºÎ¿Î»Î»Î®ÏƒÏ„Îµ ÎµÎ´ÏŽ Ï„Î· ÏƒÎ·Î¼ÎµÎ¯Ï‰ÏƒÎ·..." type="text"/>
<button class="btn btn-success" id="add-btn" type="submit">Î ÏÎ¿ÏƒÎ¸Î®ÎºÎ·</button>
</form>
