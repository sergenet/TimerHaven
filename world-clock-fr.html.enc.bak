<script>
/*
  Clean, focused world-clock-fr.js logic:
  - Loads /world-cities.json (tolerant)
  - Normalizes, dedupes and sorts Aâ†’Z (locale 'fr')
  - Populates #cityDropdown and Awesomplete on #cityInput
  - Uses safe apostrophe escaping (&#39;) in displayed strings
  - Keeps native select visible (we did not hide it)
*/

const { DateTime } = luxon;

let cityList = [];
let cityToZone = {};
let cityNames = [];
let awesompleteInstance = null;

function normalizeKey(s) {
  if (!s) return '';
  try {
    return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  } catch (e) {
    return String(s).toLowerCase().trim();
  }
}

function escapeHtml(s){
  if (!s) return '';
  return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;');
}

// --- REPLACED CITY LOADER START ---
(function loadAndPopulateCities(){
  const dropdown = document.getElementById('cityDropdown');
  const input = document.getElementById('cityInput');

  // tolerant fetch: accept array or wrapper, dedupe and sort (fr locale)
  fetch('/world-cities.json', { cache: 'no-cache' })
    .then(r => r.json())
    .then(raw => {
      // normalize into array
      let list = Array.isArray(raw) ? raw : (raw && Array.isArray(raw.cities) ? raw.cities : []);
      if (!Array.isArray(list)) list = [];

      // build map keyed by normalized name (diacritics removed) to dedupe
      const map = new Map();
      list.forEach(item => {
        if (!item) return;
        const name = (item.name || item.city || '').trim();
        const tz = (item.timezone || item.tz || item.zone || '').trim();
        if (!name) return;
        const key = name.normalize ? name.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase() : name.toLowerCase();
        if (!map.has(key)) map.set(key, { name, timezone: tz || '' });
      });

      // Convert and sort Aâ†’Z (French locale)
      const entries = Array.from(map.values()).sort((a,b) => a.name.localeCompare(b.name, 'fr', { sensitivity: 'base' }));

      // Populate global structures (matches your existing vars)
      cityList = entries;
      cityToZone = {};
      cityNames = [];

      // Build dropdown preserving the original placeholder
      if (dropdown) {
        const placeholder = dropdown.querySelector('option[value=""]') ? dropdown.querySelector('option[value=""]').outerHTML : '<option value="">SÃ©lectionnez une ville...</option>';
        dropdown.innerHTML = placeholder;
      }

      entries.forEach(e => {
        const key = (e.name || '').toLowerCase().trim();
        cityToZone[key] = e.timezone || '';
        cityNames.push(e.name);
        // keep same behavior as original: skip Tokyo in native dropdown if present
        if (dropdown && (e.name || '').toLowerCase() !== 'tokyo') {
          const opt = document.createElement('option');
          opt.value = e.timezone || '';
          opt.textContent = e.name;
          dropdown.appendChild(opt);
        }
      });

      // Awesomplete initialization (visible autocomplete)
      try {
        if (typeof Awesomplete !== 'undefined' && input) {
          const awList = cityNames.filter(n => (n||'').toLowerCase() !== 'tokyo');
          if (input.awesomplete) input.awesomplete.list = awList;
          else awesompleteInstance = new Awesomplete(input, { list: awList, minChars: 1, maxItems: 12, autoFirst: true });
        }
      } catch (e) {
        console.warn('awesomplete init error', e);
      }
    })
    .catch(err => {
      console.warn('Failed to load world-cities.json, falling back to a small sample', err);
      // minimal fallback â€” keeps the UI usable
      const sample = [
        { name: 'London', timezone: 'Europe/London' },
        { name: 'Paris', timezone: 'Europe/Paris' },
        { name: 'New York', timezone: 'America/New_York' },
        { name: 'Tokyo', timezone: 'Asia/Tokyo' },
        { name: 'Sydney', timezone: 'Australia/Sydney' }
      ];
      // reuse the same logic to populate from sample
      cityList = sample;
      cityToZone = {};
      cityNames = sample.map(s => s.name);
      if (dropdown) {
        const placeholder = dropdown.querySelector('option[value=""]') ? dropdown.querySelector('option[value=""]').outerHTML : '<option value="">SÃ©lectionnez une ville...</option>';
        dropdown.innerHTML = placeholder + sample.map(e => `<option value="${e.timezone}">${e.name}</option>`).join('');
      }
      try { if (typeof Awesomplete !== 'undefined' && input) { if (input.awesomplete) input.awesomplete.list = cityNames; else awesompleteInstance = new Awesomplete(input, { list: cityNames, minChars: 1, maxItems: 12, autoFirst: true }); } } catch(e){}
    });
})();
// --- REPLACED CITY LOADER END ---
</script>

<script>
/* Clock storage & rendering (kept close to original) */
let clocks = JSON.parse(localStorage.getItem('worldClocks') || '[]');
function saveClocks() { localStorage.setItem('worldClocks', JSON.stringify(clocks)); }

function renderClocks() {
  const list = document.getElementById('clockList');
  list.innerHTML = '';
  if (!clocks || clocks.length === 0) {
    list.innerHTML = '<div style="color:#888;">Aucune horloge ajoutÃ©e.</div>';
    return;
  }
  clocks.forEach((clock, idx) => {
    let timeStr = '...';
    let error = false;
    try {
      let now = DateTime.now().setZone(clock.tz);
      if (!now.isValid) throw new Error("Invalid zone");
      timeStr = now.toFormat('cccc, dd LLL yyyy<br>HH:mm:ss');
    } catch {
      timeStr = 'Fuseau invalide';
      error = true;
    }
    const div = document.createElement('div');
    div.className = 'clock-item';
    div.innerHTML = `
      <div style="display:flex;gap:0.9rem;align-items:center;">
        <span style="background:#0b2545;color:#fff;border-radius:50%;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;"><i class="fa fa-clock"></i></span>
        <div style="min-width:0;">
          <div style="font-weight:700;">${escapeHtml(clock.label)}</div>
          <div style="font-size:.95rem;color:#444;">${timeStr}${error ? ' <span style="color:#b00;">(vÃ©rifiez l&#39;orthographe ou utilisez un fuseau IANA)</span>' : ''}</div>
        </div>
      </div>
      <div><button class="btn btn-outline-danger btn-sm" onclick="deleteClock(${idx})" aria-label="Supprimer"><i class="fa fa-trash"></i></button></div>
    `;
    list.appendChild(div);
  });
}

function normalizeInput(input) { return input.trim().toLowerCase().replace(/[\s\-_]+/g, " "); }

function addClock(label, tz) {
  clocks.push({ label, tz });
  saveClocks();
  renderClocks();
}

document.getElementById('addClockBtn').addEventListener('click', function() {
  document.getElementById('errorMsg').textContent = '';
  const cityInput = document.getElementById('cityInput').value.trim();
  const dropdown = document.getElementById('cityDropdown');
  const dropdownVal = dropdown ? dropdown.value : '';
  let label = '', zone = '';
  if (dropdownVal && !cityInput) {
    label = dropdown.options[dropdown.selectedIndex].text;
    zone = dropdownVal;
  } else if (cityInput) {
    label = cityInput;
    if (/^[A-Za-z]+\/[A-Za-z_]+$/.test(cityInput)) {
      zone = cityInput;
    } else {
      const norm = normalizeInput(cityInput);
      if (cityToZone[norm]) zone = cityToZone[norm];
      else {
        document.getElementById('errorMsg').innerHTML = 'Ville non reconnue. Essayez la suggestion ou saisissez un fuseau IANA (ex. Europe/Paris).';
        return;
      }
    }
  } else {
    document.getElementById('errorMsg').textContent = 'Veuillez sÃ©lectionner ou saisir une ville ou un fuseau horaire.';
    return;
  }
  addClock(label, zone);
  document.getElementById('cityInput').value = '';
  if (dropdown) dropdown.selectedIndex = 0;
});

document.getElementById('addClockBtn').addEventListener('keydown', function(e){
  if(e.key === 'Enter') { e.preventDefault(); document.getElementById('addClockBtn').click(); }
});

document.getElementById('clearClocksBtn')?.addEventListener('click', function() {
  if (!clocks || clocks.length === 0) return;
  if (!confirm('Effacer toutes les horloges ?')) return;
  clocks = [];
  saveClocks();
  renderClocks();
});

window.deleteClock = function(idx) {
  clocks.splice(idx, 1);
  saveClocks();
  renderClocks();
}

setInterval(renderClocks, 1000);
renderClocks();
</script>

<!-- Embedded unified header language selector + defensive localizer JS (left in DOM but hidden visually) -->
<script>
  (function(){
    const LANGS = [
      { code: 'en', name: 'English' },
      { code: 'fr', name: 'FranÃ§ais' },
      { code: 'es', name: 'EspaÃ±ol' },
      { code: 'de', name: 'Deutsch' },
      { code: 'ru', name: 'Ð ÑƒÑÑÐºÐ¸Ð¹' },
      { code: 'el', name: 'Î•Î»Î»Î·Î½Î¹ÎºÎ¬' },
      { code: 'ar', name: 'Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©' }
    ];

    function detectPageInfo() {
      const path = (location.pathname || '').split('/').pop() || '';
      const m = path.match(/^world-(clock|how-to|tips)-([a-z]{2})\.html$/i);
      if (m) return { type: m[1], lang: m[2].toLowerCase() };
      if (/^world-clock\.html$/i.test(path)) return { type: 'clock', lang: 'fr' };
      const m2 = path.match(/^world-(clock|how-to|tips)\.html$/i);
      if (m2) return { type: m2[1], lang: 'fr' };
      return { type: 'clock', lang: 'fr' };
    }

    function removeInCardSelectors() {
      document.querySelectorAll('.tool-card .lang-wrap, .tool-card #language-select-top').forEach(function(el){ try{ el.remove(); }catch(e){} });
    }

    function buildHeaderSelector(selectedLang) {
      let top = document.querySelector('.page-wrap .top-row') || document.querySelector('.top-row');
      if (!top) {
        top = document.createElement('div');
        top.className = 'top-row';
        const pw = document.querySelector('.page-wrap') || document.body;
        pw.insertBefore(top, pw.firstChild);
      }

      top.querySelectorAll('label[for="language-select-top"], #language-select-top').forEach(function(n){ try{ n.remove(); }catch(e){} });

      const label = document.createElement('label');
      label.setAttribute('for','language-select-top');
      label.textContent = 'Language:';
      label.style.fontWeight = '600';
      label.style.marginRight = '.5rem';

      const sel = document.createElement('select');
      sel.id = 'language-select-top';
      sel.className = 'language-select';
      sel.setAttribute('aria-label','Language selector');

      LANGS.forEach(function(l){
        const o = document.createElement('option');
        o.value = l.code;
        o.textContent = l.name;
        if (l.code === selectedLang) o.selected = true;
        sel.appendChild(o);
      });

      top.appendChild(label);
      top.appendChild(sel);
      sel.style.display = 'inline-flex';
      sel.style.visibility = 'visible';
      return sel;
    }

    function hookSelector(sel) {
      if (!sel) return;
      if (sel._handler) sel.removeEventListener('change', sel._handler);
      sel._handler = function() {
        const code = this.value || 'fr';
        const info = detectPageInfo();
        if ((location.pathname || '').match(/world-clock\.html$/i)) {
          window.location.href = 'world-clock-' + code + '.html';
          return;
        }
        window.location.href = 'world-' + info.type + '-' + code + '.html';
      };
      sel.addEventListener('change', sel._handler);
    }

    document.addEventListener('DOMContentLoaded', function(){
      removeInCardSelectors();
      const info = detectPageInfo();
      const sel = buildHeaderSelector(info.lang);
      hookSelector(sel);

      // Defensive: temporarily remove any in-card selectors inserted by other scripts
      const observer = new MutationObserver(function(muts){
        muts.forEach(function(m){
          if (m.addedNodes) {
            m.addedNodes.forEach(function(n){
              try {
                if (n.querySelectorAll) {
                  n.querySelectorAll('.tool-card .lang-wrap, .tool-card #language-select-top').forEach(function(el){ try{ el.remove(); }catch(e){} });
                }
                if (n.matches && (n.matches('.tool-card .lang-wrap') || n.matches('.tool-card #language-select-top'))) {
                  try{ n.remove(); }catch(e){}
                }
              } catch(e){}
            });
          }
        });
      });
      observer.observe(document.documentElement || document.body, { childList: true, subtree: true });
      setTimeout(function(){ try{ observer.disconnect(); }catch(e){} }, 6000);
    });
  })();
  </script>

