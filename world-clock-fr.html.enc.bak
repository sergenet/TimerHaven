<div class="world-section">
<form class="clock-form" id="clockForm">
  <select class="form-select city-dropdown" id="cityDropdown">
    <option value="">SÃ©lectionnez une ville...</option>
  </select>

  <div class="visible-chooser" style="margin-top:.6rem;">
    <input autocomplete="off" class="form-control awesomplete" id="cityInput" placeholder="Ou saisissez une ville ou fuseau (ex. Paris, Europe/Paris, GMT+2)" type="text"/>
