          "<b>Ù‡Ù„ ØªØ­ÙØ¸ Ø§Ù„Ù…Ù„Ø§Ø­Ø¸Ø§ØªØŸ</b> Ù†Ø¹Ù…ØŒ ÙÙŠ Ø§Ù„Ù…ØªØµÙØ­ Ø­ØªÙ‰ ÙŠØªÙ… Ø­Ø°ÙÙ‡Ø§.",
          "<b>Ù‡Ù„ ÙŠÙ…ÙƒÙ† ØªØ«Ø¨ÙŠØª Ø§Ù„Ù…Ù„Ø§Ø­Ø¸Ø§Øª Ø§Ù„Ù…Ù‡Ù…Ø©ØŸ</b> Ù†Ø¹Ù…ØŒ Ø§Ø³ØªØ®Ø¯Ù… Ù…ÙŠØ²Ø© Ø§Ù„ØªØ«Ø¨ÙŠØª Ø¥Ø°Ø§ ÙƒØ§Ù†Øª Ù…ØªØ§Ø­Ø©.",
          "<b>Ù‡Ù„ Ù‡Ù†Ø§Ùƒ Ø­Ø¯ØŸ</b> Ù„Ø§ØŒ Ø£Ø¶Ù Ø¹Ø¯Ø¯Ù‹Ø§ ØºÙŠØ± Ù…Ø­Ø¯ÙˆØ¯ Ù…Ù† Ø§Ù„Ù…Ù„Ø§Ø­Ø¸Ø§Øª."
        ],
        tipsTitle: "Ù†ØµØ§Ø¦Ø­ Ø­ÙˆÙ„ Ø§Ù„Ù…Ù„Ø§Ø­Ø¸Ø§Øª",
        tipsLink: "Ø§Ù‚Ø±Ø£ Ø§Ù„Ù…Ù‚Ø§Ù„ Ø§Ù„ÙƒØ§Ù…Ù„",
        tipsItems: [
          "<b>Ø§Ø¬Ø¹Ù„ Ø§Ù„Ù…Ù„Ø§Ø­Ø¸Ø§Øª Ù‚ØµÙŠØ±Ø©:</b> Ø±ÙƒØ² Ø¹Ù„Ù‰ Ø§Ù„Ø£ÙÙƒØ§Ø± ÙˆØ§Ù„ØªØ°ÙƒÙŠØ±Ø§Øª Ø§Ù„Ø£Ø³Ø§Ø³ÙŠØ©.",
          "<b>Ø«Ø¨Ù‘Øª Ø§Ù„Ø¹Ù†Ø§ØµØ± Ø§Ù„Ù…Ù‡Ù…Ø©:</b> Ù…ÙŠÙ‘Ø² Ø§Ù„Ù…Ù„Ø§Ø­Ø¸Ø§Øª Ø§Ù„Ù‡Ø§Ù…Ø© Ù„Ù„ÙˆØµÙˆÙ„ Ø§Ù„Ø³Ø±ÙŠØ¹.",
          "<b>Ø±Ø§Ø¬Ø¹ Ø¨Ø§Ù†ØªØ¸Ø§Ù…:</b> Ø§Ø­Ø°Ù Ø§Ù„Ù…Ù„Ø§Ø­Ø¸Ø§Øª Ø§Ù„Ù‚Ø¯ÙŠÙ…Ø© Ù„Ù„Ø¨Ù‚Ø§Ø¡ Ù…Ù†Ø¸Ù…Ù‹Ø§."
        ],
        tipsTitleMobile: "Ù†ØµØ§Ø¦Ø­"
      }
    };

    function getLang() {
      try {
        const l = localStorage.getItem('timerhavenLang') || 'en';
        return (l && l.slice(0,2)) || 'en';
      } catch (e) {
        return 'en';
      }
    }
    const langNames = { en: "English", fr: "FranÃ§ais", es: "EspaÃ±ol", de: "Deutsch", ru: "Ð ÑƒÑÑÐºÐ¸Ð¹", el: "Î•Î»Î»Î·Î½Î¹ÎºÎ¬", ar: "Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©" };

    function applyLanguage(lang) {
      lang = (lang || getLang()).slice(0,2);
      const t = translations[lang] || translations['en'];

      // RTL support
      if (lang === 'ar') document.body.dir = 'rtl'; else document.body.removeAttribute('dir');

      // Article 1 (left)
      document.getElementById('howto-title').innerHTML = t.howtoTitle || '';
      document.getElementById('howto-list').innerHTML = (t.howtoSteps || []).map(s => `<li>${s}</li>`).join('');
      document.getElementById('howto-link').innerHTML = t.howtoLink || '';
      document.getElementById('howto-link').href = (lang === 'en') ? 'notes-how-to.html' : `notes-how-to-${lang}.html`;

      // Article 2 (right)
      document.getElementById('tips-title').innerHTML = t.tipsTitle || '';
      document.getElementById('tips-list').innerHTML = (t.tipsItems || []).map(s => `<li>${s}</li>`).join('');
      document.getElementById('tips-link').innerHTML = t.tipsLink || '';
      document.getElementById('tips-link').href = (lang === 'en') ? 'notes-tips.html' : `notes-tips-${lang}.html`;

      // Tool card (middle) â€” no HowTo or Tips blocks here anymore
      document.getElementById('back-main').innerHTML = t.backMain || '';
      document.getElementById('notes-title').innerHTML = t.notesTitle || '';
      const addBtn = document.getElementById('add-note-btn');
      if (addBtn) addBtn.innerHTML = t.addNoteBtn || 'Add Note';
      const noteInput = document.getElementById('noteInput');
      if (noteInput) noteInput.placeholder = t.noteInputPlaceholder || '';
      document.getElementById('faq-title').innerHTML = t.faqTitle || '';
      document.getElementById('faq-list').innerHTML = (t.faqItems || []).map(s => `<li>${s}</li>`).join('');
    }

    // listen for main-menu language changes
    window.addEventListener('storage', function(e) {
      if (e.key === 'timerhavenLang') {
        applyLanguage((e.newValue || 'en').slice(0,2));
      }
    });

    // Notes implementation (storage + render)
    let notes = [];
    try {
      notes = JSON.parse(localStorage.getItem('notesData') || '[]');
      if (!Array.isArray(notes)) notes = [];
    } catch (e) {
      notes = [];
    }

    function saveNotes() {
      try { localStorage.setItem('notesData', JSON.stringify(notes)); } catch (e) {}
    }

    function escapeHtml(s) {
      if (!s) return '';
      return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;');
    }

    function renderNotes() {
      const list = document.getElementById('notesList');
      if (!list) return;
      list.innerHTML = '';
      if (!notes || notes.length === 0) {
        list.innerHTML = '<div style="color:#888;">No notes yet.</div>';
        return;
      }
      notes.forEach((note, idx) => {
        const pinnedHtml = note.pinned ? `<span class="note-pinned" aria-hidden="true"><i class="fa fa-thumbtack"></i></span>` : '';
        const textHtml = escapeHtml(note.text);
        const dateHtml = escapeHtml(note.date || '');
        list.innerHTML += `
          <div class="note-item" role="article" aria-label="note-${idx}">
            <div style="display:flex;align-items:center;gap:.6rem;min-width:0;">
              ${pinnedHtml}
              <div style="min-width:0;overflow:hidden;">
                <div style="white-space:pre-wrap;word-break:break-word;">${textHtml}</div>
                <div class="note-meta" style="margin-top:6px;">${dateHtml}</div>
              </div>
            </div>
            <div style="display:flex;gap:.4rem;align-items:center;">
              <button class="btn btn-outline-${note.pinned ? 'secondary' : 'info'} btn-sm note-btn" onclick="pinNote(${idx})" aria-label="Pin or unpin note ${idx}"><i class="fa fa-thumbtack"></i></button>
              <button class="btn btn-outline-danger btn-sm note-btn" onclick="deleteNote(${idx})" aria-label="Delete note ${idx}"><i class="fa fa-trash"></i></button>
            </div>
          </div>
        `;
      });
    }

    // DOM handlers are attached after DOMContentLoaded
    function attachHandlers() {
      const form = document.getElementById('notesForm');
      if (form) {
        form.addEventListener('submit', function(e){
          e.preventDefault();
          const input = document.getElementById('noteInput');
          if (!input) return;
          const text = input.value.trim();
          if (!text) return;
          notes.unshift({ text, date: new Date().toLocaleString(), pinned: false });
          saveNotes();
          input.value = '';
          renderNotes();
        });
      }
      // expose functions globally for inline onclick
      window.deleteNote = function(idx){
        notes.splice(idx, 1);
        saveNotes();
        renderNotes();
      };
      window.pinNote = function(idx){
        if (!notes[idx]) return;
        notes[idx].pinned = !notes[idx].pinned;
        if (notes[idx].pinned) {
          const pn = notes.splice(idx, 1)[0];
          notes.unshift(pn);
        }
        saveNotes();
        renderNotes();
      };
    }

    // initialize after DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
      // apply language from main site
      applyLanguage(getLang());
      attachHandlers();
      renderNotes();
    });
  </script>

