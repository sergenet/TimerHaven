<script>
    const cities = [
      {value:"", label:"Î•Ï€Î¹Î»Î­Î¾Ï„Îµ Ï€ÏŒÎ»Î·/Î¶ÏŽÎ½Î· ÏŽÏÎ±Ï‚"},
      {value:"America/New_York", label:"ÎÎ­Î± Î¥ÏŒÏÎºÎ· ðŸ‡ºðŸ‡¸"},
      {value:"America/Chicago", label:"Î£Î¹ÎºÎ¬Î³Î¿ ðŸ‡ºðŸ‡¸"},
      {value:"America/Los_Angeles", label:"Î›Î¿Ï‚ Î†Î½Ï„Î¶ÎµÎ»ÎµÏ‚ ðŸ‡ºðŸ‡¸"},
      {value:"America/Toronto", label:"Î¤Î¿ÏÏŒÎ½Ï„Î¿ ðŸ‡¨ðŸ‡¦"},
      {value:"Europe/London", label:"Î›Î¿Î½Î´Î¯Î½Î¿ ðŸ‡¬ðŸ‡§"},
      {value:"Europe/Paris", label:"Î Î±ÏÎ¯ÏƒÎ¹ ðŸ‡«ðŸ‡·"},
      {value:"Europe/Berlin", label:"Î’ÎµÏÎ¿Î»Î¯Î½Î¿ ðŸ‡©ðŸ‡ª"},
      {value:"Europe/Moscow", label:"ÎœÏŒÏƒÏ‡Î± ðŸ‡·ðŸ‡º"},
      {value:"Europe/Istanbul", label:"ÎšÏ‰Î½ÏƒÏ„Î±Î½Ï„Î¹Î½Î¿ÏÏ€Î¿Î»Î· ðŸ‡¹ðŸ‡·"},
      {value:"Asia/Dubai", label:"ÎÏ„Î¿Ï…Î¼Ï€Î¬Î¹ ðŸ‡¦ðŸ‡ª"},
      {value:"Asia/Kolkata", label:"ÎšÎ±Î»ÎºÎ¿ÏÏ„Î± ðŸ‡®ðŸ‡³"},
      {value:"Asia/Shanghai", label:"Î£Î±Î½Î³ÎºÎ¬Î· ðŸ‡¨ðŸ‡³"},
      {value:"Asia/Tokyo", label:"Î¤ÏŒÎºÎ¹Î¿ ðŸ‡¯ðŸ‡µ"},
      {value:"Asia/Singapore", label:"Î£Î¹Î³ÎºÎ±Ï€Î¿ÏÏÎ· ðŸ‡¸ðŸ‡¬"},
      {value:"Asia/Jakarta", label:"Î¤Î¶Î±ÎºÎ¬ÏÏ„Î± ðŸ‡®ðŸ‡©"},
      {value:"Australia/Sydney", label:"Î£Î¯Î´Î½ÎµÏŠ ðŸ‡¦ðŸ‡º"},
      {value:"Pacific/Auckland", label:"ÎŒÎºÎ»Î±Î½Ï„ ðŸ‡³ðŸ‡¿"},
      {value:"America/Sao_Paulo", label:"Î£Î¬Î¿ Î Î¬Î¿Î»Î¿ ðŸ‡§ðŸ‡·"},
      {value:"America/Mexico_City", label:"Î ÏŒÎ»Î· Ï„Î¿Ï… ÎœÎµÎ¾Î¹ÎºÎ¿Ï ðŸ‡²ðŸ‡½"},
      {value:"Africa/Johannesburg", label:"Î“Î¹Î¿Ï‡Î¬Î½ÎµÏƒÎ¼Ï€Î¿Ï…ÏÎ³Îº ðŸ‡¿ðŸ‡¦"},
      {value:"Africa/Cairo", label:"ÎšÎ¬Î¹ÏÎ¿ ðŸ‡ªðŸ‡¬"},
      {value:"Africa/Nairobi", label:"ÎÎ±ÏŠÏÏŒÎ¼Ï€Î¹ ðŸ‡°ðŸ‡ª"},
      {value:"Asia/Seoul", label:"Î£ÎµÎ¿ÏÎ» ðŸ‡°ðŸ‡·"},
      {value:"Asia/Hong_Kong", label:"Î§Î¿Î½Î³Îº ÎšÎ¿Î½Î³Îº ðŸ‡­ðŸ‡°"},
      {value:"Asia/Bangkok", label:"ÎœÏ€Î±Î½Î³ÎºÏŒÎº ðŸ‡¹ðŸ‡­"},
      {value:"Asia/Manila", label:"ÎœÎ±Î½Î¯Î»Î± ðŸ‡µðŸ‡­"},
      {value:"Europe/Madrid", label:"ÎœÎ±Î´ÏÎ¯Ï„Î· ðŸ‡ªðŸ‡¸"},
      {value:"Europe/Rome", label:"Î¡ÏŽÎ¼Î· ðŸ‡®ðŸ‡¹"},
      {value:"Europe/Warsaw", label:"Î’Î±ÏÏƒÎ¿Î²Î¯Î± ðŸ‡µðŸ‡±"},
      {value:"Europe/Amsterdam", label:"Î†Î¼ÏƒÏ„ÎµÏÎ½Ï„Î±Î¼ ðŸ‡³ðŸ‡±"},
      {value:"Europe/Athens", label:"Î‘Î¸Î®Î½Î± ðŸ‡¬ðŸ‡·"},
      {value:"America/Vancouver", label:"Î’Î±Î½ÎºÎ¿ÏÎ²ÎµÏ ðŸ‡¨ðŸ‡¦"}
    ];

    function populateCities() {
      const sel = document.getElementById('participantCity');
      sel.innerHTML = '';
      cities.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.value;
        opt.textContent = c.label;
        sel.appendChild(opt);
      });
    }

    const LS_KEY = 'meetingPlannerParticipants';
    function loadParticipants() {
      try { const raw = localStorage.getItem(LS_KEY); window.participants = raw ? JSON.parse(raw) : []; } catch(e){ window.participants = []; }
    }
    function saveParticipants() { try { localStorage.setItem(LS_KEY, JSON.stringify(window.participants || [])); } catch(e){} }
    function renderParticipants() {
      const container = document.getElementById('participantList');
      container.innerHTML = '';
      if (!window.participants || window.participants.length === 0) {
        container.innerHTML = '<div style="color:#888;">Î”ÎµÎ½ Ï…Ï€Î¬ÏÏ‡Î¿Ï…Î½ ÏƒÏ…Î¼Î¼ÎµÏ„Î­Ï‡Î¿Î½Ï„ÎµÏ‚ Î±ÎºÏŒÎ¼Î±.</div>';
        return;
      }
      window.participants.forEach((p, idx) => {
        const el = document.createElement('div');
        el.className = 'participant-item';
        el.innerHTML = `<div style="min-width:0;"><div style="font-weight:700;">${escapeHtml(p.name)}</div><div style="font-size:.9em;color:#666;">${escapeHtml(p.city)}</div></div>
          <div style="display:flex;gap:.5rem;"><button class="btn btn-outline-danger btn-sm" onclick="removeParticipant(${idx})" aria-label="ÎšÎ±Ï„Î¬ÏÎ³Î·ÏƒÎ· ÏƒÏ…Î¼Î¼ÎµÏ„Î­Ï‡Î¿Î½Ï„Î±"><i class="fa fa-trash"></i></button></div>`;
        container.appendChild(el);
      });
    }
    function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

    document.getElementById('addParticipant').addEventListener('click', function(){
      const name = document.getElementById('participantName').value.trim();
      const city = document.getElementById('participantCity').value;
      if (!name) { alert('Î Î±ÏÎ±ÎºÎ±Î»ÏŽ ÎµÎ¹ÏƒÎ¬Î³ÎµÏ„Îµ ÏŒÎ½Î¿Î¼Î± ÏƒÏ…Î¼Î¼ÎµÏ„Î­Ï‡Î¿Î½Ï„Î±.'); return; }
      if (!city) { alert('Î Î±ÏÎ±ÎºÎ±Î»ÏŽ ÎµÏ€Î¹Î»Î­Î¾Ï„Îµ Ï€ÏŒÎ»Î· / Î¶ÏŽÎ½Î· ÏŽÏÎ±Ï‚.'); return; }
      window.participants = window.participants || [];
      window.participants.push({ name, city });
      saveParticipants();
      document.getElementById('participantName').value = '';
      document.getElementById('participantCity').selectedIndex = 0;
      renderParticipants();
      updateMeetingTimes();
    });

    document.getElementById('clearParticipants').addEventListener('click', function(){
      if (!window.participants || window.participants.length === 0) return;
      if (!confirm('Î”Î¹Î±Î³ÏÎ±Ï†Î® ÏŒÎ»Ï‰Î½ Ï„Ï‰Î½ ÏƒÏ…Î¼Î¼ÎµÏ„ÎµÏ‡ÏŒÎ½Ï„Ï‰Î½;')) return;
      window.participants = [];
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    });

    window.removeParticipant = function(idx){
      if (!window.participants) return;
      window.participants.splice(idx,1);
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    };

    const { DateTime } = luxon;
    function updateMeetingTimes(){
      const date = document.getElementById('meetingDate').value;
      const time = document.getElementById('meetingTime').value;
      const out = document.getElementById('meetingTimes');
      const tlang = {
        noDateTime: "Î Î±ÏÎ±ÎºÎ±Î»ÏŽ ÎµÏ€Î¹Î»Î­Î¾Ï„Îµ Î·Î¼ÎµÏÎ¿Î¼Î·Î½Î¯Î± ÎºÎ±Î¹ ÏŽÏÎ±.",
        noParticipants: "Î”ÎµÎ½ Ï…Ï€Î¬ÏÏ‡Î¿Ï…Î½ ÏƒÏ…Î¼Î¼ÎµÏ„Î­Ï‡Î¿Î½Ï„ÎµÏ‚ Î±ÎºÏŒÎ¼Î±.",
        heading: "ÎÏÎµÏ‚ ÏƒÏ…Î½Î¬Î½Ï„Î·ÏƒÎ·Ï‚ (Î¿ÏÎ³Î±Î½Ï‰Ï„Î®Ï‚ â†’ Ï„Î¿Ï€Î¹ÎºÎ­Ï‚ ÏŽÏÎµÏ‚ ÏƒÏ…Î¼Î¼ÎµÏ„ÎµÏ‡ÏŒÎ½Ï„Ï‰Î½)"
      };
      if (!date || !time) { out.innerHTML = `<div style="color:#888;">${tlang.noDateTime}</div>`; return; }
      if (!window.participants || window.participants.length === 0) { out.innerHTML = `<div style="color:#888;">${tlang.noParticipants}</div>`; return; }
      const localISO = `${date}T${time}`;
      let organizer = DateTime.fromISO(localISO);
      if (!organizer.isValid) { out.innerHTML = `<div style="color:#b00;">${tlang.noDateTime}</div>`; return; }
      let html = `<div style="font-weight:700;margin-bottom:.4rem;">${tlang.heading}</div><div class="meeting-times-grid">`;
      html += `<div class="time-suggestion"><div><b>ÎŸÏÎ³Î±Î½Ï‰Ï„Î®Ï‚</b> (${escapeHtml(organizer.zoneName)})</div><div>${escapeHtml(organizer.toLocaleString(DateTime.DATETIME_FULL))}</div></div>`;
      window.participants.forEach(p => {
        let dt;
        try { dt = organizer.setZone(p.city); } catch(e) { dt = null; }
        const label = dt ? dt.toLocaleString(DateTime.DATETIME_FULL) : 'Î†ÎºÏ…ÏÎ· Î¶ÏŽÎ½Î·';
        html += `<div class="time-suggestion"><div><b>${escapeHtml(p.name)}</b> <span style="color:#666;">(${escapeHtml(p.city)})</span></div><div>${escapeHtml(label)}</div></div>`;
      });
      html += `</div>`;
      out.innerHTML = html;
    }

    document.getElementById('calcTimes').addEventListener('click', updateMeetingTimes);

    document.addEventListener('DOMContentLoaded', function(){
      populateCities();
      loadParticipants();
      renderParticipants();
      try {
        const savedDate = localStorage.getItem('meetingPlannerDate');
        const savedTime = localStorage.getItem('meetingPlannerTime');
        if (savedDate) document.getElementById('meetingDate').value = savedDate;
        if (savedTime) document.getElementById('meetingTime').value = savedTime;
      } catch(e){}
    });

    document.getElementById('meetingDate').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerDate', this.value); }catch(e){} });
    document.getElementById('meetingTime').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerTime', this.value); }catch(e){} });

  </script>
