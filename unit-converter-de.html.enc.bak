</footer>
</div>

<script>
  // --- Extended unitTypes (same canonical factors as English version) ---
  const unitTypes = {
    length: {
      units: { "Meter": 1, "Kilometer": 1000, "Centimeter": 0.01, "Millimeter": 0.001, "Mile": 1609.344, "Yard": 0.9144, "Foot": 0.3048, "Inch": 0.0254 },
      convert: (val, from, to) => val * unitTypes.length.units[from] / unitTypes.length.units[to]
    },
    weight: {
      units: { "Kilogram": 1, "Gram": 0.001, "Milligram": 0.000001, "Pound": 0.45359237, "Ounce": 0.028349523125, "Ton (metric)":1000 },
      convert: (val, from, to) => val * unitTypes.weight.units[from] / unitTypes.weight.units[to]
    },
    temperature: {
      units: { "Celsius": "C", "Fahrenheit": "F", "Kelvin": "K" },
      convert: (val, from, to) => {
        if (from === to) return val;
        if (from === "Celsius" && to === "Fahrenheit") return val * 9/5 + 32;
        if (from === "Fahrenheit" && to === "Celsius") return (val - 32) * 5/9;
        if (from === "Celsius" && to === "Kelvin") return val + 273.15;
        if (from === "Kelvin" && to === "Celsius") return val - 273.15;
        if (from === "Fahrenheit" && to === "Kelvin") return (val - 32) * 5/9 + 273.15;
        if (from === "Kelvin" && to === "Fahrenheit") return (val - 273.15) * 9/5 + 32;
      }
    },
    volume: {
      units: {
        "Liter": 1,
        "Milliliter": 0.001,
        "Cubic meter": 1000,
        "US gallon": 3.785411784,
        "US quart": 0.946352946,
        "US pint": 0.473176473,
        "Imperial gallon": 4.54609,
        "Cubic inch": 0.016387064,
        "Cubic foot": 28.316846592
      },
      convert: (val, from, to) => val * unitTypes.volume.units[from] / unitTypes.volume.units[to]
    },
    area: {
      units: {
        "Square meter": 1,
        "Square kilometer": 1e6,
        "Hectare": 10000,
        "Acre": 4046.8564224,
        "Square mile": 2589988.110336,
        "Square foot": 0.09290304,
        "Square yard": 0.83612736,
        "Square inch": 0.00064516
      },
      convert: (val, from, to) => val * unitTypes.area.units[from] / unitTypes.area.units[to]
    },
    speed: {
      units: { "m/s": 1, "km/h": 1/3.6, "mph": 0.44704, "knots": 0.514444 },
      convert: (val, from, to) => val * unitTypes.speed.units[from] / unitTypes.speed.units[to]
    },
    time: {
      units: { "Second":1, "Minute":60, "Hour":3600, "Day":86400, "Week":604800 },
      convert: (val, from, to) => val * unitTypes.time.units[from] / unitTypes.time.units[to]
    },
    pressure: {
      units: { "Pascal":1, "kPa":1000, "Bar":100000, "atm":101325, "psi":6894.757293168 },
      convert: (val, from, to) => val * unitTypes.pressure.units[from] / unitTypes.pressure.units[to]
    },
    energy: {
      units: { "Joule":1, "Kilojoule":1000, "Calorie":4.184, "kcal":4184, "Wh":3600 },
      convert: (val, from, to) => val * unitTypes.energy.units[from] / unitTypes.energy.units[to]
    },
    power: {
      units: { "Watt":1, "Kilowatt":1000, "Horsepower (metric)":735.49875, "Horsepower (mechanical)":745.69987158227022 },
      convert: (val, from, to) => val * unitTypes.power.units[from] / unitTypes.power.units[to]
    },
    data: {
      unitsSI: { "Byte":1, "KB":1e3, "MB":1e6, "GB":1e9, "TB":1e12 },
      unitsBin: { "Byte":1, "KiB":1024, "MiB":1024**2, "GiB":1024**3, "TiB":1024**4 },
      convert: (val, from, to, mode='SI') => {
        const table = (mode === 'Bin') ? unitTypes.data.unitsBin : unitTypes.data.unitsSI;
        if (!table[from] || !table[to]) return NaN;
        return val * table[from] / table[to];
      }
    },
    fuel: {
      units: { "L/100km": "L100", "mpg (US)": "mpgus", "mpg (UK)": "mpguk" },
      convert: (val, from, to) => {
        if (from === to) return val;
        const toL100 = (v, src) => {
          if (src === "L/100km") return v;
          if (src === "mpg (US)") return 235.214583 / v;
          if (src === "mpg (UK)") return 282.480936 / v;
        };
        const fromL100 = (l100, dst) => {
          if (dst === "L/100km") return l100;
          if (dst === "mpg (US)") return 235.214583 / l100;
          if (dst === "mpg (UK)") return 282.480936 / l100;
        };
        const l100 = toL100(val, from);
        return fromL100(l100, to);
      }
    },
    angle: {
      units: { "Degree": 1, "Radian": (180/Math.PI), "Gradian": 0.9 },
      convert: (val, from, to) => val * unitTypes.angle.units[from] / unitTypes.angle.units[to]
    },
    frequency: {
      units: { "Hz":1, "kHz":1e3, "MHz":1e6, "GHz":1e9 },
      convert: (val, from, to) => val * unitTypes.frequency.units[from] / unitTypes.frequency.units[to]
    }
  };

  // Persistence keys
  const LS_KEYS = {
    lastType: 'th_unit_lastType',
    lastFrom: 'th_unit_lastFrom',
    lastTo: 'th_unit_lastTo',
    lastValue: 'th_unit_lastValue',
    lastPrecision: 'th_unit_lastPrecision',
    dataMode: 'th_unit_dataMode'
  };

  function saveState(k,v){ try{ localStorage.setItem(k,v); }catch(e){} }
  function loadState(k,def){ try{ const v=localStorage.getItem(k); return v!==null? v: def;}catch(e){ return def;} }

  // UI elements
  const typeSelect = document.getElementById('typeSelect');
  const fromUnit = document.getElementById('fromUnit');
  const toUnit = document.getElementById('toUnit');
  const inputValue = document.getElementById('inputValue');
  const unitFilter = document.getElementById('unitFilter');
  const precisionSelect = document.getElementById('precisionSelect');
  const unitResultText = document.getElementById('unitResultText');
  const resultExtras = document.getElementById('resultExtras');
  const dataModeSI = document.getElementById('dataModeSI');
  const dataModeBin = document.getElementById('dataModeBin');
  const copyBtn = document.getElementById('copyBtn');
  const swapBtn = document.getElementById('swapBtn');

  let currentDataMode = loadState(LS_KEYS.dataMode, 'SI');

  function setDataModeUI(){
    if (currentDataMode === 'SI'){ dataModeSI.classList.add('active'); dataModeBin.classList.remove('active'); }
    else { dataModeBin.classList.add('active'); dataModeSI.classList.remove('active'); }
  }

  function getUnitsForType(type){
    if (type === 'data') return (currentDataMode === 'Bin') ? Object.keys(unitTypes.data.unitsBin) : Object.keys(unitTypes.data.unitsSI);
    if (unitTypes[type] && unitTypes[type].units) return Object.keys(unitTypes[type].units);
    if (unitTypes[type] && unitTypes[type].unitsSI) return Object.keys(unitTypes[type].unitsSI);
    return [];
  }

  function populateUnits(type){
    const allUnits = getUnitsForType(type);
    fromUnit.innerHTML = ''; toUnit.innerHTML = '';
    allUnits.forEach(u => {
      const o1 = document.createElement('option'); o1.value = u; o1.textContent = u; fromUnit.appendChild(o1);
      const o2 = document.createElement('option'); o2.value = u; o2.textContent = u; toUnit.appendChild(o2);
    });
    applyUnitFilter();
    setDataModeUI();
    // restore last selections if valid
    const lastFrom = loadState(LS_KEYS.lastFrom,'');
    const lastTo = loadState(LS_KEYS.lastTo,'');
    if (lastFrom && Array.from(fromUnit.options).some(o=>o.value===lastFrom)) fromUnit.value = lastFrom;
    if (lastTo && Array.from(toUnit.options).some(o=>o.value===lastTo)) toUnit.value = lastTo;
    if (!fromUnit.value && fromUnit.options.length) fromUnit.selectedIndex = 0;
    if (!toUnit.value && toUnit.options.length) toUnit.selectedIndex = Math.min(1,toUnit.options.length-1);
  }

  function applyUnitFilter(){
    const q = (unitFilter.value||'').toLowerCase().trim();
    const type = typeSelect.value;
    const allUnits = getUnitsForType(type);
    const filtered = q ? allUnits.filter(u => u.toLowerCase().includes(q)) : allUnits.slice();
    const final = filtered.length ? filtered : allUnits;
    fromUnit.innerHTML = ''; toUnit.innerHTML = '';
    final.forEach(u=> {
      const o1 = document.createElement('option'); o1.value=u; o1.textContent=u; fromUnit.appendChild(o1);
      const o2 = document.createElement('option'); o2.value=u; o2.textContent=u; toUnit.appendChild(o2);
    });
  }

  function doConvert(){
    const type = typeSelect.value;
    const val = parseFloat(inputValue.value);
    const from = fromUnit.value;
    const to = toUnit.value;
    const precision = parseInt(precisionSelect.value,10);
    if (!isFinite(val)){ unitResultText.textContent = 'Bitte geben Sie einen gÃ¼ltigen Wert ein.'; resultExtras.textContent=''; return; }
    let result;
    try {
      if (type === 'data') result = unitTypes.data.convert(val, from, to, currentDataMode === 'Bin' ? 'Bin' : 'SI');
      else if (type === 'fuel') result = unitTypes.fuel.convert(val, from, to);
      else if (type === 'temperature') result = unitTypes.temperature.convert(val, from, to);
      else if (unitTypes[type] && typeof unitTypes[type].convert === 'function') result = unitTypes[type].convert(val, from, to);
      else result = NaN;
    } catch(e){ console.error('convert error', e); result = NaN; }
    if (!isFinite(result)){ unitResultText.textContent = 'Konversion nicht verfÃ¼gbar.'; resultExtras.textContent=''; return; }
    const formatted = Number.isFinite(result) ? Number(result).toFixed(precision) : String(result);
    unitResultText.textContent = `${val} ${from} = ${formatted} ${to}`;
    resultExtras.textContent = (parseFloat(formatted) !== result) ? ` (raw ${result})` : '';
    saveState(LS_KEYS.lastType, type); saveState(LS_KEYS.lastFrom, from); saveState(LS_KEYS.lastTo, to);
    saveState(LS_KEYS.lastValue, inputValue.value); saveState(LS_KEYS.lastPrecision, precisionSelect.value);
  }

  // Event wiring
  document.getElementById('unitForm').addEventListener('submit', function(e){ e.preventDefault(); doConvert(); });
  typeSelect.addEventListener('change', function(){ unitFilter.value=''; populateUnits(this.value); });
  unitFilter.addEventListener('input', applyUnitFilter);
  precisionSelect.addEventListener('change', doConvert);
  fromUnit.addEventListener('change', doConvert);
  toUnit.addEventListener('change', doConvert);
  swapBtn.addEventListener('click', function(){ const a=fromUnit.value, b=toUnit.value; fromUnit.value=b; toUnit.value=a; doConvert(); });
  copyBtn.addEventListener('click', function(){ const text = unitResultText.textContent + (resultExtras.textContent? ' ' + resultExtras.textContent : ''); if (navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(text).then(()=>{ copyBtn.innerHTML='<i class="fa fa-check"></i>'; setTimeout(()=>{ copyBtn.innerHTML='<i class="fa fa-copy"></i>'; },1200); }).catch(()=>{ alert('Kopieren fehlgeschlagen'); }); } else { const ta=document.createElement('textarea'); ta.value=text; document.body.appendChild(ta); ta.select(); try{ document.execCommand('copy'); copyBtn.innerHTML='<i class="fa fa-check"></i>'; setTimeout(()=>{ copyBtn.innerHTML='<i class="fa fa-copy"></i>'; },1200);}catch(e){ alert('Kopieren nicht unterstÃ¼tzt'); } ta.remove(); }});

  dataModeSI.addEventListener('click', ()=>{ currentDataMode='SI'; saveState(LS_KEYS.dataMode,'SI'); setDataModeUI(); if (typeSelect.value==='data') populateUnits('data'); });
  dataModeBin.addEventListener('click', ()=>{ currentDataMode='Bin'; saveState(LS_KEYS.dataMode,'Bin'); setDataModeUI(); if (typeSelect.value==='data') populateUnits('data'); });

  // Shortcuts
  document.addEventListener('keydown', function(e){ if (e.ctrlKey && (e.key === 'k' || e.key === 'K')){ e.preventDefault(); inputValue.focus(); inputValue.select(); } });

  // init
  (function init(){
    setDataModeUI();
    const lastType = loadState(LS_KEYS.lastType,'length');
    if (Array.from(typeSelect.options).some(o=>o.value===lastType)) typeSelect.value=lastType;
    populateUnits(typeSelect.value);
    const lastFrom = loadState(LS_KEYS.lastFrom,''); const lastTo = loadState(LS_KEYS.lastTo,'');
    if (lastFrom && Array.from(fromUnit.options).some(o=>o.value===lastFrom)) fromUnit.value = lastFrom;
    if (lastTo && Array.from(toUnit.options).some(o=>o.value===lastTo)) toUnit.value = lastTo;
    const lastVal = loadState(LS_KEYS.lastValue,''); if (lastVal) inputValue.value = lastVal;
    const lastPrecision = loadState(LS_KEYS.lastPrecision,'4'); if (lastPrecision && Array.from(precisionSelect.options).some(o=>o.value===lastPrecision)) precisionSelect.value = lastPrecision;
    if (inputValue.value) doConvert();
  })();

  // language selector redirect (markup hidden but behavior kept)
  (function(){ var sel = document.getElementById('language-select-top'); if (sel) sel.addEventListener('change', function(){ window.location.href = 'unit-converter-' + (this.value || 'en') + '.html'; }); })();

</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>


