<style>
    body { background:#f4f7fb; font-family:'Montserrat', Arial, sans-serif; color:#0b2545; }
    .page-wrap { max-width:1200px; margin:2rem auto; padding:0 1rem; }
    .top-row { display:flex; justify-content:flex-end; gap:.6rem; margin-bottom:.6rem; }
    .language-select { width:220px; border-radius:10px; padding:.28rem .6rem; border:1px solid rgba(13,110,253,0.25); background:#fff; color:#0d6efd; }
    .center-row { display:flex; gap:1.6rem; justify-content:center; align-items:stretch; } /* stretch children to same height */
    .article-card, .tool-card { background:#fff; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,0.06); padding:1.3rem; box-sizing: border-box; display:flex; flex-direction:column; }
    /* Set matching minimum heights so left and right cards align visually */
    .article-card { width:330px; min-width:200px; min-height:340px; justify-content:space-between; align-items:flex-start; }
    .tool-card { width:520px; min-width:240px; min-height:340px; }
    .article-card h2 { color:#185a9d; font-size:1.25rem; margin-bottom:.6rem; }
    .tool-card h3 { color:#185a9d; font-size:1.35rem; margin-bottom:.5rem; }
    .converter-form { display:flex; gap:.5rem; margin-bottom:1rem; flex-wrap:wrap; align-items:center; }
    .converter-result { font-weight:700; font-size:1.12em; margin-bottom:1rem; display:flex; gap:.6rem; align-items:center; }
    .faq-section { margin-top:1rem; background:#f7fafc; border-radius:8px; padding:1rem; }
    .btn-small { padding:.35rem .7rem; font-size:.9rem; }
    .unit-filter { max-width:220px; }
    .swap-btn,.copy-btn{border-radius:8px;border:1px solid #e6eef8;background:#fff;padding:.35rem .6rem;cursor:pointer}
    .data-mode { display:flex; gap:.25rem; }
    footer.site { text-align:center; margin-top:1.5rem; color:#6b7280; }
    @media (max-width:900px) { .center-row{flex-direction:column;align-items:center;} .article-card, .tool-card{width:98%; max-width:540px;} }

    /* HIDE the visible language selector while keeping the markup and JS intact */
    .top-row { display: none !important; }

    .small-muted { color:#6b7280; font-size:.9rem; }
  </style>
