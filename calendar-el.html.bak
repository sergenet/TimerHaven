      border-radius:8px; padding:.18rem .32rem; border:1px solid #e4edf5; background:#fff; font-size:.92rem; height:34px;
      box-sizing:border-box; flex-shrink:0; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    .calendar-select.month { width:120px; max-width:150px; }
    .calendar-select.year { width:110px; max-width:150px; }
    #default-start-time.calendar-select { width:120px; max-width:150px; padding:.18rem .36rem; text-align:center; font-size:.9rem; }

    .calendar-table { width:100%; margin-top:1rem; border-collapse: separate; border-spacing:0; background:#fff; border-radius:8px; overflow:hidden; min-height:360px; table-layout:auto; }
    .calendar-table thead th { text-align:center; font-weight:700; padding:.6rem .3rem; border-bottom:1px solid #eef2f6; background:#fff; }
    .calendar-table tbody td { text-align:center; vertical-align:middle; padding:.5rem .25rem; height:52px; }

    .day-cell { cursor:pointer; border-radius:6px; transition:background .12s; display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; margin:0 auto; padding:0; box-sizing:border-box; }
    .day-cell:hover, .day-cell:focus { background:#eef6fb; outline:none; }
    .has-note { background:#fff5d6 !important; }
    .calendar-today { display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; background:linear-gradient(180deg,#e6f7ff 0%,#cfefff 100%); color:#004e73; border-radius:50%; font-weight:700; border:1px solid rgba(0,126,204,0.18); box-shadow:0 4px 12px rgba(24,144,255,0.08); padding:0; margin:0; }

    .note-list { list-style:none; padding:0; margin:0; }
    .modal .list-group-item { border-radius:6px; margin-bottom:.45rem; }

    details.faq-section summary { cursor:pointer; padding:.2rem 0; font-weight:600; }
    details.faq-section ul { margin-top:.5rem; color:var(--muted); padding-left:1rem; }

    @media (max-width:520px) {
      .calendar-header { gap:.5rem; }
      .right-controls { flex:1 1 100%; width:100%; margin-left:0; justify-content:flex-start; }
      .calendar-select { max-width:48%; }
      #default-start-time.calendar-select { width:120px; max-width:48%; }
    }
