  <footer style="text-align:center;padding:18px 12px;color:#6b7c89;">&copy; 2025 TimerHaven. ÎŒÎ»Î± Ï„Î± ÎµÏÎ³Î±Î»ÎµÎ¯Î± ÎµÎ¯Î½Î±Î¹ Î´Ï‰ÏÎµÎ¬Î½ ÎºÎ±Î¹ Ï†Î¹Î»Î¹ÎºÎ¬ Ï€ÏÎ¿Ï‚ Ï„Î·Î½ Î¹Î´Î¹Ï‰Ï„Î¹ÎºÏŒÏ„Î·Ï„Î±. <a href="/privacy.html">Î Î¿Î»Î¹Ï„Î¹ÎºÎ® Î‘Ï€Î¿ÏÏÎ®Ï„Î¿Ï…</a> Â· <a href="/contact.html">Î•Ï€Î¹ÎºÎ¿Î¹Î½Ï‰Î½Î¯Î±</a></footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const STORAGE_KEY = 'calendarNotes_el';
    const DEFAULT_START_KEY = 'calendarDefaultStart_el';

    // Load notes (supports legacy shapes)
    let notes = {};
    try { notes = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch(e) { notes = {}; console.error('notes parse error', e); }

    let currentYear, currentMonth, selectedDay;
    let controlsHooked = false;

    const translations = {
      el: {
        "back-link":"Î•Ï€Î¹ÏƒÏ„ÏÎ¿Ï†Î® ÏƒÏ„Î¿ ÎºÏÏÎ¹Î¿ Î¼ÎµÎ½Î¿Ï",
        "tool-title":"Î—Î¼ÎµÏÎ¿Î»ÏŒÎ³Î¹Î¿",
        "tool-help":"ÎšÎ¬Î½Ï„Îµ ÎºÎ»Î¹Îº ÏƒÎµ Î¿Ï€Î¿Î¹Î±Î´Î®Ï€Î¿Ï„Îµ Î·Î¼Î­ÏÎ± Î³Î¹Î± Î½Î± Ï€ÏÎ¿ÏƒÎ¸Î­ÏƒÎµÏ„Îµ/Î´ÎµÎ¯Ï„Îµ/ÎµÏ€ÎµÎ¾ÎµÏÎ³Î±ÏƒÏ„ÎµÎ¯Ï„Îµ Ï„Î¹Ï‚ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ ÏƒÎ±Ï‚. Î¥Ï€Î¿ÏƒÏ„Î·ÏÎ¯Î¶Î¿Î½Ï„Î±Î¹ Ï€Î¿Î»Î»Î­Ï‚ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î±Î½Î¬ Î·Î¼Î­ÏÎ± ÎºÎ±Î¹ Î±Ï€Î¿Î¸Î·ÎºÎµÏÎ¿Î½Ï„Î±Î¹!",
        "faq-list": `<li><strong>Î‘Ï€Î¿Î¸Î·ÎºÎµÏÎ¿Î½Ï„Î±Î¹ Î¿Î¹ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î¼Î¿Ï…;</strong> ÎÎ±Î¹ â€” Î¿Î¹ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î±Ï€Î¿Î¸Î·ÎºÎµÏÎ¿Î½Ï„Î±Î¹ ÏƒÏ„Î¿ Ï€ÏÏŒÎ³ÏÎ±Î¼Î¼Î± Ï€ÎµÏÎ¹Î®Î³Î·ÏƒÎ®Ï‚ ÏƒÎ±Ï‚ ÎºÎ±Î¹ Ï€Î±ÏÎ±Î¼Î­Î½Î¿Ï…Î½ Î¼Î­Ï‡ÏÎ¹ Î½Î± Ï„Î¹Ï‚ Î´Î¹Î±Î³ÏÎ¬ÏˆÎµÏ„Îµ.</li>
                     <li><strong>ÎœÏ€Î¿ÏÏŽ Î½Î± Ï€ÏÎ¿ÏƒÎ¸Î­ÏƒÏ‰ Ï€ÎµÏÎ¹ÏƒÏƒÏŒÏ„ÎµÏÎµÏ‚ Î±Ï€ÏŒ Î¼Î¯Î± ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚;</strong> ÎÎ±Î¹ â€” Î¼Ï€Î¿ÏÎµÎ¯Ï„Îµ Î½Î± Ï€ÏÎ¿ÏƒÎ¸Î­ÏƒÎµÏ„Îµ Ï€Î¿Î»Î»Î­Ï‚ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î±Î½Î¬ Î·Î¼Î­ÏÎ±.</li>
                     <li><strong>Î ÏŽÏ‚ ÎºÎ¬Î½Ï‰ backup;</strong> Î§ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÏ„Îµ Ï„Î·Î½ ÎµÏ€Î¹Î»Î¿Î³Î® Î•Î¾Î±Î³Ï‰Î³Î®Ï‚ Î³Î¹Î± Î½Î± ÎºÎ±Ï„ÎµÎ²Î¬ÏƒÎµÏ„Îµ Î±Î½Ï„Î¯Î³ÏÎ±Ï†Î± Î±ÏƒÏ†Î±Î»ÎµÎ¯Î±Ï‚.</li>`,
        "noteModalLabel":"Î£Î·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î³Î¹Î±",
        "noteInput":"Î ÏÎ¿ÏƒÎ¸Î­ÏƒÏ„Îµ Î¼Î¹Î± Î½Î­Î± ÏƒÎ·Î¼ÎµÎ¯Ï‰ÏƒÎ· Î³Î¹Î± Î±Ï…Ï„Î®Î½ Ï„Î·Î½ Î·Î¼Î­ÏÎ±...",
        "note-none":"Î”ÎµÎ½ Ï…Ï€Î¬ÏÏ‡Î¿Ï…Î½ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î³Î¹Î± Î±Ï…Ï„Î®Î½ Ï„Î·Î½ Î·Î¼Î­ÏÎ±.",
        "note-delete":"Î”Î¹Î±Î³ÏÎ±Ï†Î® Î±Ï…Ï„Î®Ï‚ Ï„Î·Ï‚ ÏƒÎ·Î¼ÎµÎ¯Ï‰ÏƒÎ·Ï‚",
        "note-close-btn":"ÎšÎ»ÎµÎ¯ÏƒÎ¹Î¼Î¿",
        "note-add-btn":"Î ÏÎ¿ÏƒÎ¸Î®ÎºÎ· ÏƒÎ·Î¼ÎµÎ¯Ï‰ÏƒÎ·Ï‚",
        "days":["ÎšÏ…Ï","Î”ÎµÏ…","Î¤ÏÎ¹","Î¤ÎµÏ„","Î ÎµÎ¼","Î Î±Ï","Î£Î±Î²"],
        "months":["Î™Î±Î½Î¿Ï…Î¬ÏÎ¹Î¿Ï‚","Î¦ÎµÎ²ÏÎ¿Ï…Î¬ÏÎ¹Î¿Ï‚","ÎœÎ¬ÏÏ„Î¹Î¿Ï‚","Î‘Ï€ÏÎ¯Î»Î¹Î¿Ï‚","ÎœÎ¬Î¹Î¿Ï‚","Î™Î¿ÏÎ½Î¹Î¿Ï‚","Î™Î¿ÏÎ»Î¹Î¿Ï‚","Î‘ÏÎ³Î¿Ï…ÏƒÏ„Î¿Ï‚","Î£ÎµÏ€Ï„Î­Î¼Î²ÏÎ¹Î¿Ï‚","ÎŸÎºÏ„ÏŽÎ²ÏÎ¹Î¿Ï‚","ÎÎ¿Î­Î¼Î²ÏÎ¹Î¿Ï‚","Î”ÎµÎºÎ­Î¼Î²ÏÎ¹Î¿Ï‚"]
      }
    };

    function getLang(){ return 'el'; }

    function parseDurationFromText(text) {
      if (!text || typeof text !== 'string') return null;
      const range = text.match(/(\d{1,3})\s*(?:â€“|-)\s*(\d{1,3})\s*(?:minutes?|mins?|min|Î»ÎµÏ€Ï„Î±|Î»ÎµÏ€Ï„Î¬|Î»ÎµÏ€Ï„Î¿?)/i);
      if (range) return parseInt(range[1],10);
      const single = text.match(/(\d{1,3})\s*(?:minutes?|mins?|min|Î»ÎµÏ€Ï„Î±|Î»ÎµÏ€Ï„Î¬|Î»ÎµÏ€Ï„Î¿?)/i);
      if (single) return parseInt(single[1],10);
      return null;
    }

    function escapeHtml(s){ if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }

    function formatTime(date) {
      if (!(date instanceof Date)) date = new Date(date);
      return date.toLocaleTimeString('el-GR', { hour:'numeric', minute:'2-digit' });
    }

    function getDefaultStartTime(){ return localStorage.getItem(DEFAULT_START_KEY) || '20:00'; }
    function setDefaultStartTime(v){ localStorage.setItem(DEFAULT_START_KEY, v); }

    function dateFromDateStrAndTime(dateStr, timeStr){
      const [y,m,d] = dateStr.split('-').map(Number);
      const [hh=0, mm=0] = (timeStr || '00:00').split(':').map(Number);
      return new Date(y, m-1, d, hh, mm, 0, 0);
    }

    function migrateLegacyNotes(raw){
      if (!Array.isArray(raw)) return [];
      return raw.map(n => {
        if (typeof n === 'string') {
          return { text: n, durationMinutes: parseDurationFromText(n) || null, createdAt: null };
        }
        if (n && typeof n === 'object') {
          const createdAt = n.createdAt ? n.createdAt : (n.ts ? new Date(n.ts).toISOString() : null);
          return {
            text: n.text || String(n),
            durationMinutes: (typeof n.durationMinutes === 'number') ? n.durationMinutes : parseDurationFromText(n.text) || null,
            createdAt: createdAt
          };
        }
        return { text: String(n), durationMinutes: null, createdAt: null };
      });
    }

    function populateMonthYearControls(year, month) {
      const monthSelect = document.getElementById('calendar-month-select');
      const yearSelect = document.getElementById('calendar-year-select');
      if (!monthSelect || !yearSelect) return;
      const months = translations['el'].months;
      monthSelect.innerHTML = '';
      for (let m=0;m<12;m++){
        const opt = document.createElement('option'); opt.value = String(m); opt.textContent = months[m]; if (m===month) opt.selected = true; monthSelect.appendChild(opt);
      }
      const now = new Date(); const base = now.getFullYear(); const start = base - 50; const end = base + 50;
      yearSelect.innerHTML = '';
      for (let y=start;y<=end;y++){ const opt=document.createElement('option'); opt.value=String(y); opt.textContent=String(y); if (y===year) opt.selected=true; yearSelect.appendChild(opt); }
    }

    function renderCalendar(year, month) {
      currentYear = year; currentMonth = month;
      const table = document.getElementById('calendar-table');
      if (table) { const maxRows=6,rowHeight=44,headerHeight=48; table.style.minHeight=(maxRows*rowHeight+headerHeight)+'px'; }
      populateMonthYearControls(year, month);
      const firstDay = new Date(year,month,1).getDay();
      const daysInMonth = new Date(year,month+1,0).getDate();
      let html = '<thead><tr>'; (translations['el'].days).forEach(d => html += `<th>${d}</th>`); html += '</tr></thead><tbody><tr>';
      for (let i=0;i<firstDay;i++) html += '<td></td>';
      const now=new Date(); const todayY=now.getFullYear(), todayM=now.getMonth(), todayD=now.getDate();
      for (let d=1; d<=daysInMonth; d++){
        const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const rawDayNotes = notes[dateStr] || [];
        const dayNotes = migrateLegacyNotes(rawDayNotes);
        const hasNote = dayNotes.length > 0;
        if ((firstDay + d - 1) % 7 === 0 && d !== 1) html += '</tr><tr>';
        const isToday = (d===todayD && month===todayM && year===todayY);
        const classes = ['day-cell', hasNote ? 'has-note' : '', isToday ? 'calendar-today' : ''].join(' ').trim();
        html += `<td role="gridcell" tabindex="0" data-date="${dateStr}" aria-label="${dateStr}"><div class="${classes}" ${isToday ? 'aria-current="date"' : ''}>${d}</div></td>`;
      }
      html += '</tr></tbody>'; if (table) table.innerHTML = html;

      Array.from(document.querySelectorAll('.day-cell')).forEach(cell => {
        cell.addEventListener('click', function(){ const td = cell.closest('td'); if(!td) return; selectedDay = td.getAttribute('data-date'); showNoteModal(selectedDay); });
        cell.addEventListener('keydown', function(e){ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); const td = cell.closest('td'); if(!td) return; selectedDay = td.getAttribute('data-date'); showNoteModal(selectedDay); }});
      });
    }

    function showNoteModal(dateStr){ const ml=document.getElementById('modal-date-label'); if(ml) ml.textContent = dateStr; selectedDay = dateStr; renderNoteList(dateStr); document.getElementById('noteInput').value=''; const modal=new bootstrap.Modal(document.getElementById('noteModal')); modal.show(); setTimeout(()=>{ try{ document.getElementById('noteInput').focus(); }catch(e){} },120); }

    function renderNoteList(dateStr){
      const ul = document.getElementById('noteList'); if(!ul) return; ul.innerHTML='';
      const rawDayNotes = notes[dateStr] || []; const dayNotes = migrateLegacyNotes(rawDayNotes);
      try{ if (JSON.stringify(rawDayNotes) !== JSON.stringify(dayNotes)) { notes[dateStr] = dayNotes; localStorage.setItem(STORAGE_KEY, JSON.stringify(notes)); } } catch(e){}
      if(dayNotes.length===0){ ul.innerHTML = `<li class="list-group-item">${translations['el']['note-none']}</li>`; return; }

      let baseTime;
      if (dayNotes[0] && dayNotes[0].createdAt) {
        const parsed = new Date(dayNotes[0].createdAt);
        baseTime = !isNaN(parsed) ? parsed : dateFromDateStrAndTime(dateStr, getDefaultStartTime());
      } else {
        baseTime = dateFromDateStrAndTime(dateStr, getDefaultStartTime());
      }
      let currentTime = new Date(baseTime.getTime());

      dayNotes.forEach((noteObj, index) => {
        const li = document.createElement('li'); li.className='list-group-item d-flex justify-content-between align-items-start';
        const duration = (typeof noteObj.durationMinutes === 'number' && !isNaN(noteObj.durationMinutes)) ? noteObj.durationMinutes : parseDurationFromText(noteObj.text) || 5;
        const left = document.createElement('div'); left.style.flex='1 1 auto';
        left.innerHTML = `<div style="font-weight:500;">${escapeHtml(noteObj.text)}</div><div style="color:#6b7c89;font-size:.9rem;">ÎˆÎ½Î±ÏÎ¾Î·: <strong>${formatTime(currentTime)}</strong> Â· Î”Î¹Î¬ÏÎºÎµÎ¹Î±: ${duration} Î»ÎµÏ€.</div>`;
        const del = document.createElement('button'); del.className='btn btn-sm btn-outline-danger ms-3'; del.type='button';
        del.setAttribute('aria-label', translations['el']['note-delete']); del.innerHTML = '<i class="fa fa-trash-alt"></i>';
        del.addEventListener('click', function(){ const arr = notes[dateStr] || []; arr.splice(index,1); notes[dateStr]=arr; try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(notes)); }catch(e){console.error(e);} renderNoteList(dateStr); renderCalendar(currentYear,currentMonth); });
        li.appendChild(left); li.appendChild(del); ul.appendChild(li);
        currentTime.setMinutes(currentTime.getMinutes() + duration);
      });
    }

    function hookupCalendarControls(){
      if (controlsHooked) return; controlsHooked = true;
      const prevYear=document.getElementById('nav-prev-year'), prevMonth=document.getElementById('nav-prev-month');
      const nextMonth=document.getElementById('nav-next-month'), nextYear=document.getElementById('nav-next-year');
      const todayBtn=document.getElementById('nav-today'); const monthSelect=document.getElementById('calendar-month-select'), yearSelect=document.getElementById('calendar-year-select');

      prevYear && prevYear.addEventListener('click', ()=> renderCalendar(currentYear-1,currentMonth));
      nextYear && nextYear.addEventListener('click', ()=> renderCalendar(currentYear+1,currentMonth));
      prevMonth && prevMonth.addEventListener('click', ()=> { currentMonth = (currentMonth - 1 + 12) % 12; if (currentMonth === 11) currentYear--; renderCalendar(currentYear,currentMonth); });
      nextMonth && nextMonth.addEventListener('click', ()=> { currentMonth = (currentMonth + 1) % 12; if (currentMonth === 0) currentYear++; renderCalendar(currentYear,currentMonth); });
      todayBtn && todayBtn.addEventListener('click', ()=> { const n=new Date(); renderCalendar(n.getFullYear(),n.getMonth()); });

      if (monthSelect) monthSelect.addEventListener('change', function(){ const m=Number(this.value); if (!isNaN(m)){ currentMonth = m; renderCalendar(currentYear,currentMonth); }});
      if (yearSelect) yearSelect.addEventListener('change', function(){ const y=Number(this.value); if (!isNaN(y)){ currentYear = y; renderCalendar(currentYear,currentMonth); }});

      const defaultTimeInput = document.getElementById('default-start-time');
      if (defaultTimeInput) { defaultTimeInput.value = getDefaultStartTime(); defaultTimeInput.addEventListener('change', function(){ setDefaultStartTime(this.value); }); }

      const noteForm = document.getElementById('noteForm');
      if (noteForm) {
        noteForm.addEventListener('submit', function(e){
          e.preventDefault();
          const input = document.getElementById('noteInput'); if(!input) return;
          const text = input.value.trim(); if(!text) return;
          const dur = parseDurationFromText(text) || 5;
          notes[selectedDay] = notes[selectedDay] || [];
          let createdAt;
          const existing = notes[selectedDay] || [];
          if (existing.length === 0) createdAt = dateFromDateStrAndTime(selectedDay, getDefaultStartTime()).toISOString();
          else createdAt = new Date().toISOString();
          const item = { text: text, durationMinutes: dur, createdAt: createdAt };
          notes[selectedDay].push(item);
          try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(notes)); } catch(e){ console.error('save notes error', e); }
          input.value=''; renderNoteList(selectedDay); renderCalendar(currentYear,currentMonth);
        });
      }
    }

    document.addEventListener('DOMContentLoaded', function(){
      const now=new Date(); currentYear = now.getFullYear(); currentMonth = now.getMonth();

      // populate UI
      document.getElementById('back-link') && (document.getElementById('back-link').textContent = translations['el']['back-link']);
      document.getElementById('tool-title') && (document.getElementById('tool-title').innerHTML = `<i class="fa fa-calendar-days"></i> ${translations['el']['tool-title']}`);
      document.getElementById('tool-help') && (document.getElementById('tool-help').textContent = translations['el']['tool-help']);
      document.getElementById('faq-list') && (document.getElementById('faq-list').innerHTML = translations['el']['faq-list']);
      document.getElementById('noteModalLabel') && (document.getElementById('noteModalLabel').innerHTML = `${translations['el']['noteModalLabel']} <span id="modal-date-label"></span>`);
      document.getElementById('noteInput') && (document.getElementById('noteInput').placeholder = translations['el']['noteInput']);
      document.getElementById('note-close-btn') && (document.getElementById('note-close-btn').textContent = translations['el']['note-close-btn']);
      document.getElementById('note-add-btn') && (document.getElementById('note-add-btn').textContent = translations['el']['note-add-btn']);

      populateMonthYearControls(currentYear, currentMonth);
      hookupCalendarControls();
      renderCalendar(currentYear, currentMonth);
    });
  </script>
</body>
</html>

