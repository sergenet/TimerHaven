  const langNames = { en: "English", fr: "FranÃ§ais", de: "Deutsch", ru: "Ð ÑƒÑÑÐºÐ¸Ð¹", el: "Î•Î»Î»Î·Î½Î¹ÎºÎ¬", es: "EspaÃ±ol", ar: "Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©" };

  function populateCurrencySelects() {
    const from = document.getElementById('fromCurrency');
    const to = document.getElementById('toCurrency');
    from.innerHTML = '';
    to.innerHTML = '';
    currencyList.forEach(cur => {
      from.innerHTML += `<option value="${cur}">${cur}</option>`;
      to.innerHTML += `<option value="${cur}">${cur}</option>`;
    });
    from.value = "USD";
    to.value = "EUR";
  }

  function getLang() {
    try { const l = localStorage.getItem('timerhavenLang') || 'ru'; return (l && l.slice(0,2)) || 'ru'; } catch (e) { return 'ru'; }
  }

  function applyLanguage(lang) {
    lang = (lang || getLang()).slice(0,2);
    const t = currencyTranslations[lang] || currencyTranslations['ru'];
    document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';
    const labelEl = document.getElementById('language-label');
    const nameEl = document.getElementById('language-name');
    if (labelEl) labelEl.textContent = t['language-label'] || 'Ð¯Ð·Ñ‹Ðº:';
    if (nameEl) nameEl.textContent = langNames[lang] || lang;
    if (document.getElementById('back-link')) document.getElementById('back-link').textContent = t['back-link'] || '';
    if (document.getElementById('tool-title')) document.getElementById('tool-title').innerHTML = `<i class="fa fa-dollar-sign"></i> ${t['tool-title'] || ''}`;
    if (document.getElementById('tool-help')) document.getElementById('tool-help').textContent = t['tool-help'] || '';
    if (document.getElementById('amount')) document.getElementById('amount').placeholder = t['amount'] || '';
    if (document.getElementById('convert-btn')) document.getElementById('convert-btn').textContent = t['convert'] || 'Convert';
    if (document.getElementById('result')) document.getElementById('result').textContent = t['result-placeholder'] || '';
    if (document.getElementById('faq-title')) document.getElementById('faq-title').textContent = t['faq-title'] || '';
    if (document.getElementById('faq-list')) document.getElementById('faq-list').innerHTML = t['faq-list'] || '';
    if (document.getElementById('howto-title')) document.getElementById('howto-title').innerHTML = t['howto-title'] || '';
    if (document.getElementById('howto-steps')) document.getElementById('howto-steps').innerHTML = t['howto-steps'] || '';
    if (document.getElementById('howto-article-btn')) { document.getElementById('howto-article-btn').textContent = t['howto-article-btn'] || ''; document.getElementById('howto-article-btn').href = t['howto-article-link'] || ''; }
    if (document.getElementById('tips-title')) document.getElementById('tips-title').innerHTML = t['tips-title'] || '';
    if (document.getElementById('tips-list')) document.getElementById('tips-list').innerHTML = t['tips-list'] || '';
    if (document.getElementById('tips-article-btn')) { document.getElementById('tips-article-btn').textContent = t['tips-article-btn'] || ''; document.getElementById('tips-article-btn').href = t['tips-article-link'] || ''; }
    if (document.getElementById('howto-mobile-title')) document.getElementById('howto-mobile-title').innerHTML = t['howto-title'] || '';
    if (document.getElementById('howto-mobile-steps')) document.getElementById('howto-mobile-steps').innerHTML = t['howto-steps'] || '';
    if (document.getElementById('tips-mobile-title')) document.getElementById('tips-mobile-title').innerHTML = t['tips-title'] || '';
    if (document.getElementById('tips-mobile-list')) document.getElementById('tips-mobile-list').innerHTML = t['tips-list'] || '';
  }

  document.addEventListener('DOMContentLoaded', function(){
    populateCurrencySelects();
    applyLanguage(getLang());
  });

  window.addEventListener('storage', function(e) {
    if (e.key === 'timerhavenLang') applyLanguage((e.newValue || 'ru').slice(0,2));
  });

  document.getElementById('currencyForm').addEventListener('submit', function(e){
    e.preventDefault();
    const amountVal = parseFloat(document.getElementById('amount').value);
    const fromCur = document.getElementById('fromCurrency').value;
    const toCur = document.getElementById('toCurrency').value;
    const lang = getLang();
    const t = currencyTranslations[lang] || currencyTranslations['ru'];
    if (isNaN(amountVal) || amountVal <= 0) {
      document.getElementById('result').innerText = t['amount-error'] || "ÐŸÐ¾Ð¶Ð°Ð»ÑƒÐ¹ÑÑ‚Ð°, Ð²Ð²ÐµÐ´Ð¸Ñ‚Ðµ ÐºÐ¾Ñ€Ñ€ÐµÐºÑ‚Ð½ÑƒÑŽ ÑÑƒÐ¼Ð¼Ñƒ.";
      return;
    }
    document.getElementById('result').innerText = t['fetching'] || "ÐŸÐ¾Ð»ÑƒÑ‡ÐµÐ½Ð¸Ðµ ÐºÑƒÑ€ÑÐ°...";
    fetch(`https://v6.exchangerate-api.com/v6/${apiKey}/pair/${fromCur}/${toCur}/${amountVal}`)
      .then(r => r.json())
      .then(data => {
        if (data && typeof data.conversion_result !== 'undefined') {
          const conv = (Math.round((data.conversion_result + Number.EPSILON) * 100000) / 100000);
          const rate = (Math.round((data.conversion_rate + Number.EPSILON) * 100000) / 100000);
          document.getElementById('result').innerText = `${amountVal} ${fromCur} = ${conv} ${toCur} (ÐšÑƒÑ€Ñ: ${rate})`;
        } else {
          document.getElementById('result').innerText = t['conversion-unavailable'] || "ÐšÐ¾Ð½Ð²ÐµÑ€Ñ‚Ð°Ñ†Ð¸Ñ Ð½ÐµÐ´Ð¾ÑÑ‚ÑƒÐ¿Ð½Ð°.";
        }
      })
      .catch(() => {
        document.getElementById('result').innerText = t['fetch-error'] || "ÐÐµ ÑƒÐ´Ð°Ð»Ð¾ÑÑŒ Ð¿Ð¾Ð»ÑƒÑ‡Ð¸Ñ‚ÑŒ ÐºÐ¾Ð½Ð²ÐµÑ€Ñ‚Ð°Ñ†Ð¸ÑŽ.";
      });
  });
</script>
