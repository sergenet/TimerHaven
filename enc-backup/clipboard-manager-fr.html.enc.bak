<style>
    :root { --card-bg: #fff; --page-bg: #f4f7fb; --accent: #185a9d; --accent-2: #43cea2; }
    body { background: var(--page-bg); font-family: 'Montserrat', Arial, sans-serif; margin: 0; }

    /* keep language select (top-left) â€” it's part of localized pages */
    .top-bar { padding: 10px 16px; }

    /* Layout: make columns flex containers so cards can stretch to equal height */
    .main-container { max-width: 1200px; margin: 1.5em auto; display: flex; justify-content: center; align-items: stretch; min-height: 70vh; padding: 0 12px; box-sizing: border-box; }
    .center-row { display: flex; flex-direction: row; justify-content: center; align-items: stretch; gap: 1.5em; width: 100%; }

    /* Each column is a flex column so inner card can expand */
    .center-row > .col { display: flex; flex-direction: column; flex: 1 1 0; min-width: 240px; }

    .article-card, .tool-card {
      background: var(--card-bg);
      border-radius: 16px;
      box-shadow: 0 2px 12px #e0e7ef;
      /* use width:100% so card fills its column */
      width: 100%;
      display: flex;
      flex-direction: column;
      padding: 1.6em;
      box-sizing: border-box;
      text-align: left;
      overflow: visible;
      /* make card stretch to fill column height */
      height: 100%;
    }

    .article-card h2, .tool-card h3 { font-weight: 700; color: var(--accent); margin-bottom: .5em; display:flex; align-items:center; gap:.4em; }
    .article-card .btn, .tool-card .btn { margin-top: .6em; border-radius: 8px; font-weight:600; }
    .clips-section { margin-top: 6px; display:flex; flex-direction:column; flex:1 1 auto; }
    .clips-form { display:flex; gap:.5em; align-items:center; margin-bottom:.6em; }
    .clips-form input[type="text"] { flex: 1 1 180px; min-width: 0; }
    .clips-list { margin-top:.6em; max-height: 260px; overflow-y: auto; padding-right: 6px; }
    .clip-item { background:#f7fafc; border-radius:8px; padding:10px; margin-bottom:8px; display:flex; align-items:center; gap:.8em; }
    .clip-text { flex:1; word-break:break-word; }
    .clip-actions .btn { padding:.25rem .5rem; }
    .faq-section { margin-top: 1em; background:#f7fafc; border-radius:8px; padding: .8em; }
    details[open] summary::after { content: " â–²"; }
    details summary::after { content: " â–¼"; }
    .back-link { color: var(--accent); font-weight:700; text-decoration:none; display:inline-block; margin-bottom:.6em; }
    .back-link i { margin-right:.35em; }
    footer { text-align:center; color:#666; padding: 1.2rem 0; font-size:.9rem; }

    /* small-screen adjustments */
    @media (max-width: 900px) {
      .main-container { margin: 12px auto; padding: 0 8px; }
      .center-row { flex-direction: column; gap: 12px; align-items: stretch; }
      .center-row > .col { min-width: auto; }
      .article-card, .tool-card { width: 100%; max-width: 680px; }
    }
  </style>
