      <section id="ics" class="section">
        <h2>Ð¨Ð°Ð±Ð»Ð¾Ð½Ñ‹ Ð¸ ÑÐºÐ°Ñ‡Ð¸Ð²Ð°Ð½Ð¸Ðµ .ics</h2>
        <p class="muted">Ð¡ÐºÐ°Ñ‡Ð°Ð¹Ñ‚Ðµ ÑˆÐ°Ð±Ð»Ð¾Ð½ .ics Ð´Ð»Ñ Ð¸Ð¼Ð¿Ð¾Ñ€Ñ‚Ð° Ð² Google/Outlook/Apple Calendar.</p>
        <p><a href="#" id="downloadIcs" class="cta">Ð¡ÐºÐ°Ñ‡Ð°Ñ‚ÑŒ ÑˆÐ°Ð±Ð»Ð¾Ð½ .ics</a></p>

        <pre class="template" id="icsTemplate" aria-hidden="true">BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//TimerHaven//Pomodoro Block Template//RU
BEGIN:VEVENT
UID:{{UID}}
DTSTAMP:{{UTC_NOW}}
DTSTART:20251110T090000Z
DTEND:20251110T103000Z
SUMMARY:Pomodoro Focus â€” [Ð¦ÐµÐ»ÑŒ]
DESCRIPTION:Checklist:
- ÐŸÑƒÐ½ÐºÑ‚ 1
- ÐŸÑƒÐ½ÐºÑ‚ 2
Notes: Ð¡ÑÑ‹Ð»ÐºÐ° Ð½Ð° Ð·Ð°Ð¼ÐµÑ‚ÐºÐ¸ (ID)
STATUS:BUSY
END:VEVENT
END:VCALENDAR</pre>

        <script>
          document.getElementById('downloadIcs').addEventListener('click', function(e){
            e.preventDefault();
            var template = document.getElementById('icsTemplate').textContent;
            var now = new Date();
            var uid = 'ph-' + Math.floor(Math.random()*900000+100000) + '@timerhaven.com';
            var stamp = now.toISOString().replace(/[-:]/g,'').split('.')[0] + 'Z';
            var content = template.replace('{{UID}}', uid).replace('{{UTC_NOW}}', stamp);
            var blob = new Blob([content], {type:'text/calendar;charset=utf-8'});
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'pomodoro-block-template.ics';
            document.body.appendChild(a);
            a.click();
            setTimeout(function(){ URL.revokeObjectURL(url); a.remove(); }, 150);
          });
        </script>
      </section>

