<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Weltwetter أ¢â‚¬â€‌ TimerHaven</title>
  <meta name="description" content="Prأƒآ¼fen Sie das Wetter fأƒآ¼r Stأƒآ¤dte weltweit sofort.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet"/>
  <style>
    :root{--brand:#0d6efd;--muted:#6b7c89}
    html,body { height:100%; }
    body { background:#f4f7fb; font-family:'Inter', 'Montserrat', Arial, sans-serif; color:#0b2545; -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale; }
    .main-container { max-width:920px; margin:2rem auto; padding:0 1rem; display:flex; justify-content:center; align-items:flex-start; min-height:80vh; box-sizing:border-box; }
    .card { background:#fff; border-radius:12px; box-shadow:0 8px 24px rgba(0,0,0,0.06); width:100%; padding:1.6rem 1.5rem; box-sizing:border-box; }
    .back-link { display:inline-block; margin-bottom:.75rem; color:var(--brand); text-decoration:none; font-weight:700; }
    .back-link:hover { text-decoration:underline; }
    .tool-title { color:#185a9d; font-size:1.35rem; margin:0 0 .45rem 0; display:flex; align-items:center; gap:.5rem; font-weight:700; }
    .read-guide-wrap { display:inline-block; margin-bottom:.6rem; } /* prevent wrapper expanding full width */
    .read-guide {
      display:inline-flex !important;
      width:auto !important;
      max-width:none !important;
      align-items:center;
      justify-content:center;
      padding:.45rem .85rem;
      border-radius:8px;
      background:var(--brand);
      color:#fff;
      text-decoration:none;
      font-weight:700;
      font-size:.95rem;
      white-space:nowrap;
      box-sizing:border-box;
    }

    .lead { color:#374151; margin:0 0 0.9rem 0; font-size:1.05rem; }
    .weather-form-row { display:flex; gap:.5rem; margin-bottom:1rem; align-items:center; flex-wrap:wrap; }
    .weather-result { margin-top:1rem; background:#f7fafc; border-radius:7px; padding:1rem; font-size:1.15em; min-height:48px; }
    .powered-by { margin-top:0.6rem; font-size:0.92rem; color:var(--muted); }
    .action-row { display:flex; gap:.7rem; flex-wrap:wrap; align-items:center; margin-top:.4rem; }

    #getWeatherBtn { min-width:175px; height:42px; font-size:1.07em; background:var(--brand); color:#fff; border:none; border-radius:8px; font-weight:600; box-shadow:0 2px 8px #e0e7ef; cursor:pointer; padding:0 1.1rem; }
    #useLocationBtn { min-width:175px; height:42px; font-size:1.02rem; background:#444; color:#fff; border-radius:8px; border:none; padding:0 1.1rem; display:inline-flex; align-items:center; gap:.4em; cursor:pointer; justify-content:center; text-align:center; white-space:nowrap; }

    .unit-toggle { display:inline-flex; gap:6px; align-items:center; margin-left:6px; }
    .unit-toggle button { border-radius:8px; padding:6px 10px; border:1px solid #e6eef8; background:#fff; cursor:pointer; font-weight:700; }
    .unit-toggle button.active { background:var(--brand); color:#fff; border-color:var(--brand); }

    .faq-section { margin-top:1rem; background:#f7fafc; border-radius:8px; padding:1rem; box-shadow:0 1px 4px #e0e7ef; }
    .forecast-grid { display:grid; grid-template-columns: repeat(2, 1fr); gap:8px; margin-top:0.6rem; }
    @media(min-width:560px) { .forecast-grid { grid-template-columns: repeat(3, 1fr); } }
    .forecast-day { background:#fff; border-radius:8px; padding:.55rem; box-shadow:0 1px 4px rgba(9,30,66,0.04); text-align:center; font-size:0.95rem; }
    .forecast-day .day { font-weight:700; color:#0b2545; margin-bottom:.25rem; }
    .weather-icon { font-size:1.4rem; margin-bottom:.25rem; display:block; }
    .forecast-day .desc { color:#374151; font-size:.86rem; margin-top:.25rem; }
    .forecast-day .temp { margin-top:.3rem; color:#185a9d; }

    @media (max-width:750px) { #getWeatherBtn,#useLocationBtn{width:100%;} .weather-form-row{flex-direction:column;align-items:stretch;} .action-row{flex-direction:column;} }
  </style>
<script>

</script>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <main class="main-container" role="main">
    <article class="card" aria-labelledby="title">
      <a href="index.html" class="back-link">&larr; Zurأƒآ¼ck zum Hauptmenأƒآ¼</a>

      <div id="title" class="tool-title"><i class="fa fa-cloud-sun"></i> Weltwetter</div>

      <div class="read-guide-wrap">
        <a id="read-guide-btn" class="read-guide" href="https://timerhaven.com/de/weather/weather-index.html" target="_blank" rel="noopener">Vollstأƒآ¤ndigen Leitfaden lesen</a>
      </div>

      <p class="lead">Prأƒآ¼fen Sie das Wetter fأƒآ¼r Stأƒآ¤dte weltweit sofort.</p>

      <form id="weatherForm" autocomplete="off">
        <div class="weather-form-row">
          <select id="cityDropdown" class="form-select" title="Stadt auswأƒآ¤hlen..." style="min-width:140px;">
            <option value="">Stadt auswأƒآ¤hlen...</option>
            <option value="New York">New York</option>
            <option value="London">London</option>
            <option value="Paris">Paris</option>
            <option value="Berlin">Berlin</option>
            <option value="Tokyo">Tokio</option>
            <option value="Sydney">Sydney</option>
            <option value="Sأƒآ£o Paulo">Sأƒآ£o Paulo</option>
            <option value="Moscow">Moskau</option>
            <option value="Dubai">Dubai</option>
            <option value="Istanbul">Istanbul</option>
            <option value="Johannesburg">Johannesburg</option>
            <option value="Toronto">Toronto</option>
            <option value="Mexico City">Mexiko-Stadt</option>
            <option value="Los Angeles">Los Angeles</option>
            <option value="Mumbai">Mumbai</option>
            <option value="Cairo">Kairo</option>
            <option value="Singapore">Singapur</option>
            <option value="Hong Kong">Hongkong</option>
            <option value="Bangkok">Bangkok</option>
            <option value="Seoul">Seoul</option>
            <option value="San Francisco">San Francisco</option>
            <option value="Rome">Rom</option>
            <option value="Kolkata">Kolkata</option>
            <option value="Jakarta">Jakarta</option>
            <option value="Madrid">Madrid</option>
            <option value="Cape Town">Kapstadt</option>
            <option value="Lagos">Lagos</option>
            <option value="Melbourne">Melbourne</option>
            <option value="Beijing">Peking</option>
            <option value="Chicago">Chicago</option>
            <option value="Vancouver">Vancouver</option>
            <option value="Auckland">Auckland</option>
            <option value="Hanoi">Hanoi</option>
            <option value="Manila">Manila</option>
            <option value="Warsaw">Warschau</option>
          </select>

          <input type="text" id="cityInput" class="form-control" placeholder="Oder Stadt eingeben..." title="Oder Stadt eingeben..." style="min-width:160px;">
        </div>

        <div class="action-row" role="group" aria-label="Aktionen">
          <button type="submit" id="getWeatherBtn">Wetter abrufen</button>
          <button type="button" id="useLocationBtn"><i class="fa fa-location-arrow"></i> Meine Position verwenden</button>

          <div class="unit-toggle" role="group" aria-label="Einheiten">
            <!-- Add explicit data-unit attributes and aria-pressed for accessibility -->
            <button type="button" id="unitC" data-unit="C" title="Celsius" aria-pressed="false">أ‚آ°C</button>
            <button type="button" id="unitF" data-unit="F" title="Fahrenheit" aria-pressed="false">أ‚آ°F</button>
          </div>
        </div>
      </form>

      <div id="weatherResult" class="weather-result" aria-live="polite"></div>
      <div class="powered-by">Daten von <a href="https://open-meteo.com" target="_blank" rel="noopener">Openأ¢â‚¬â€کMeteo</a></div>

      <details class="faq-section" style="margin-top:1rem;">
        <summary style="font-weight:700; font-size:1rem;">FAQ</summary>
        <ul style="padding-left:1.1rem; color:#374151;">
          <li><strong>Wie genau sind die Daten?</strong> Die Daten stammen von Openأ¢â‚¬â€کMeteo und أƒآ¤hnlichen Diensten.</li>
          <li><strong>Kann ich meine Position verwenden?</strong> Ja أ¢â‚¬â€‌ tippen Sie auf <strong>Meine Position verwenden</strong>.</li>
          <li><strong>Kann ich jede Stadt eingeben?</strong> Ja أ¢â‚¬â€‌ geben Sie einfach den Stأƒآ¤dtenamen ein.</li>
        </ul>
      </details>
    </article>
  </main>

  <script>
  // Full DE page JS with robust unit-toggle binding (matches the AR/EN robust pattern)
  const DEFAULT_PAGE_LANG = 'de';
  const SUPPORTED_LANGS = ['en','fr','de','es','ru','el','ar'];
  const PAGE_LANG = 'de';

  const UI_STRINGS = {
    de: {
      PLEASE_SELECT:"Bitte wأƒآ¤hlen Sie eine Stadt oder geben Sie eine ein.",
      GEO_UNSUPPORTED:"Geolokalisierung wird nicht unterstأƒآ¼tzt.",
      UNABLE_LOCATION:"Standort konnte nicht ermittelt werden.",
      FETCH_ERROR:"Fehler beim Abrufen der Wetterdaten.",
      NOT_FOUND_TEMPLATE:"Fأƒآ¼r \"{city}\" konnte kein Wetter gefunden werden.",
      SELECT_CITY_PLACEHOLDER:"Stadt auswأƒآ¤hlen...",
      OR_ENTER_CITY_PLACEHOLDER:"Oder Stadt eingeben..."
    }
  };

  const WEATHERCODE_DESC = {
    0:{ de:"Klarer Himmel" },
    1:{ de:"أƒإ“berwiegend klar" },
    2:{ de:"Teilweise bewأƒآ¶lkt" },
    3:{ de:"Bedeckt" },
    45:{ de:"Nebel" },
    48:{ de:"Reifnebel" },
    51:{ de:"Leichter Niesel" },
    53:{ de:"Mأƒآ¤أƒإ¸iger Niesel" },
    55:{ de:"Dichter Niesel" },
    56:{ de:"Leichter gefrierender Niesel" },
    57:{ de:"Dichter gefrierender Niesel" },
    61:{ de:"Leichter Regen" },
    63:{ de:"Mأƒآ¤أƒإ¸iger Regen" },
    65:{ de:"Starker Regen" },
    71:{ de:"Leichter Schneefall" },
    73:{ de:"Mأƒآ¤أƒإ¸iger Schneefall" },
    75:{ de:"Starker Schneefall" },
    80:{ de:"Leichte Regenschauer" },
    81:{ de:"Mأƒآ¤أƒإ¸ige Regenschauer" },
    82:{ de:"Starke Regenschauer" },
    95:{ de:"Gewitter" },
    96:{ de:"Gewitter mit leichtem Hagel" },
    99:{ de:"Gewitter mit starkem Hagel" }
  };

  const TEMP_UNIT_KEY = 'timerhavenTempUnit';
  const DEFAULT_UNIT = 'C';
  let LAST_QUERY = null;

  function getStoredUnit() { try { const u = localStorage.getItem(TEMP_UNIT_KEY); if (u === 'C' || u === 'F') return u; } catch(e) {} return DEFAULT_UNIT; }
  function setStoredUnit(u) { try { localStorage.setItem(TEMP_UNIT_KEY, u); } catch(e) {} }

  // Improved applyUnitUI (sets aria-pressed and visual active class)
  function applyUnitUI() {
    try {
      const u = getStoredUnit();
      const c = document.getElementById('unitC'), f = document.getElementById('unitF');
      if (!c || !f) return;
      if (u === 'C') {
        c.classList.add('active'); c.setAttribute('aria-pressed','true');
        f.classList.remove('active'); f.setAttribute('aria-pressed','false');
      } else {
        f.classList.add('active'); f.setAttribute('aria-pressed','true');
        c.classList.remove('active'); c.setAttribute('aria-pressed','false');
      }
    } catch(e){ console.warn('applyUnitUI error', e); }
  }

  function reapplyLastQuery() {
    if (!LAST_QUERY) return;
    if (LAST_QUERY.type === 'coords' && LAST_QUERY.lat != null && LAST_QUERY.lon != null) {
      fetchOpenMeteoForecast(LAST_QUERY.lat, LAST_QUERY.lon).then(fore => { try { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(fore, LAST_QUERY.placeName || ''); } catch(e){} });
    } else if (LAST_QUERY.type === 'city' && LAST_QUERY.city) {
      fetchWeather(LAST_QUERY.city);
    } else if (LAST_QUERY.type === 'backend' && LAST_QUERY.city) {
      fetchBackendCity(LAST_QUERY.city);
    }
  }

  // Robust unit toggle binder: discovers buttons by id, data-unit or text, attaches click/touch/keyboard; retries if inserted late.
  (function bindUnitToggles() {
    function findButtons() {
      const byIdC = document.getElementById('unitC');
      const byIdF = document.getElementById('unitF');
      if (byIdC || byIdF) return { c: byIdC, f: byIdF };

      const byDataC = document.querySelector('button[data-unit="C"], button[data-unit="أ‚آ°C"]');
      const byDataF = document.querySelector('button[data-unit="F"], button[data-unit="أ‚آ°F"]');
      if (byDataC || byDataF) return { c: byDataC, f: byDataF };

      const container = document.querySelector('.unit-toggle') || document.body;
      let c=null, f=null;
      container.querySelectorAll('button, [role="button"]').forEach(btn => {
        const txt = (btn.textContent || '').trim();
        if (!c && /أ‚آ°\s*C|Celsius|C$/i.test(txt)) c = btn;
        if (!f && /أ‚آ°\s*F|Fahrenheit|F$/i.test(txt)) f = btn;
      });
      return { c, f };
    }

    function attach(btn, unit) {
      if (!btn) return;
      const handler = function(e) {
        try {
          setStoredUnit(unit);
          applyUnitUI();
          setTimeout(reapplyLastQuery, 50);
        } catch (err) {
          console.warn('unit toggle handler error', err);
        }
      };
      // remove any previous listener attempt (defensive)
      try { btn.removeEventListener && btn.removeEventListener('click', handler); } catch(e){}
      btn.addEventListener('click', handler);
      try { btn.addEventListener('touchend', function(e){ e.preventDefault(); handler(); }, { passive: false }); } catch(e){}
      btn.addEventListener('keydown', function(ev){ if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); handler(); } });
      btn.setAttribute('tabindex', '0');
    }

    function init() {
      const { c, f } = findButtons();
      attach(c, 'C');
      attach(f, 'F');
      try { applyUnitUI(); } catch(e){}
      // Retry shortly if buttons weren't present at init (works for late DOM insertion)
      if (!(c && f)) {
        setTimeout(()=> {
          const again = findButtons();
          if (again.c) attach(again.c, 'C');
          if (again.f) attach(again.f, 'F');
          try { applyUnitUI(); } catch(e){}
        }, 350);
      }

      // Delegated fallback in case of unusual DOM structure
      document.addEventListener('click', function(e){
        try {
          const t = e.target;
          const unitBtn = t.closest && t.closest('#unitC, #unitF');
          if (unitBtn) {
            e.preventDefault();
            const id = unitBtn.id;
            const unit = (id === 'unitC') ? 'C' : (id === 'unitF') ? 'F' : null;
            if (unit) {
              setStoredUnit(unit);
              applyUnitUI();
              setTimeout(reapplyLastQuery, 50);
            }
          }
        } catch(err){}
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();

  // --- Remaining weather code (unchanged logic) ---

  function t(key, vars) {
    const dict = UI_STRINGS[PAGE_LANG] || UI_STRINGS[DEFAULT_PAGE_LANG] || {};
    let s = dict[key] || '';
    if (vars && typeof vars === 'object') { Object.keys(vars).forEach(k => { s = s.replace('{'+k+'}', vars[k]); }); }
    return s;
  }

  function describeWeatherCode(code) {
    const obj = WEATHERCODE_DESC[code];
    if (!obj) return String(code);
    return obj[PAGE_LANG] || obj['de'] || String(code);
  }

  function localizedWeekday(dateStr) {
    try { const d = new Date(dateStr); return new Intl.DateTimeFormat(PAGE_LANG, { weekday: 'short' }).format(d); } catch(e){ return dateStr; }
  }

  function getWeatherEmoji(code) {
    if (code === null || code === undefined) return 'أ¢â‚¬آ¢';
    if (code === 0) return 'أ¢ثœâ‚¬أ¯آ¸آڈ';
    if (code === 1 || code === 2) return 'أ°إ¸إ’آ¤أ¯آ¸آڈ';
    if (code === 3) return 'أ¢ثœآپأ¯آ¸آڈ';
    if ([45,48].includes(code)) return 'أ°إ¸إ’آ«أ¯آ¸آڈ';
    if ([51,53,55,56,57].includes(code)) return 'أ°إ¸إ’آ¦أ¯آ¸آڈ';
    if ([61,63,65,80,81,82].includes(code)) return 'أ°إ¸إ’آ§أ¯آ¸آڈ';
    if ([71,73,75].includes(code)) return 'أ¢آ‌â€‍أ¯آ¸آڈ';
    if ([95,96,99].includes(code)) return 'أ¢â€؛ث†أ¯آ¸آڈ';
    return 'أ°إ¸إ’آ¤أ¯آ¸آڈ';
  }

  function renderOpenMeteo(forecast, placeName) {
    const unit = getStoredUnit();
    const tempSymbol = (unit === 'F') ? 'أ‚آ°F' : 'أ‚آ°C';
    const speedUnit = (unit === 'F') ? 'mph' : 'm/s';
    const cw = forecast.current_weather || {};
    const daily = forecast.daily || {};
    const parts = [];
    const title = `<div style="font-weight:700; margin-bottom:6px;">${placeName || ''}</div>`;
    const weatherLabel = describeWeatherCode(cw.weathercode);
    const currentHtml = `<div style="display:flex;gap:.6rem;align-items:center;">
      <div style="flex:1"><div style="font-weight:700;font-size:1.05rem;">${weatherLabel}</div></div>
      <div style="text-align:right;min-width:110px">
        <div style="font-size:1.45rem;font-weight:700;">${typeof cw.temperature === 'number' ? Math.round(cw.temperature) + tempSymbol : 'N/A'}</div>
        <div style="color:#6b7280;">Wind ${typeof cw.windspeed === 'number' ? Math.round(cw.windspeed) + ' ' + speedUnit : 'N/A'}</div>
      </div>
    </div>`; 
    parts.push(title + currentHtml);

    if (daily.time && daily.time.length) {
      const days = daily.time.map((d,i) => {
        const maxT = daily.temperature_2m_max && daily.temperature_2m_max[i] !== undefined ? Math.round(daily.temperature_2m_max[i]) : 'أ¢â‚¬â€‌';
        const minT = daily.temperature_2m_min && daily.temperature_2m_min[i] !== undefined ? Math.round(daily.temperature_2m_min[i]) : 'أ¢â‚¬â€‌';
        const code = daily.weathercode && daily.weathercode[i] !== undefined ? daily.weathercode[i] : null;
        const desc = code !== null ? describeWeatherCode(code) : '';
        return { date: d, maxT, minT, code, desc };
      }).slice(0,7);

      let grid = '<div class="forecast-grid">';
      days.forEach(day => {
        grid += `<div class="forecast-day">
                    <div class="day">${localizedWeekday(day.date)}</div>
                    <div class="weather-icon">${getWeatherEmoji(day.code)}</div>
                    <div class="desc">${day.desc}</div>
                    <div class="temp"><span style="font-weight:700;">${day.maxT}${tempSymbol}</span> / ${day.minT}${tempSymbol}</div>
                 </div>`;
      });
      grid += '</div>';
      parts.push(grid);
    }

    return parts.join('');
  }

  function geocodeCity(city) {
    const url = `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=${PAGE_LANG}`;
    return fetch(url).then(r => r.json()).then(j => {
      if (j && Array.isArray(j.results) && j.results.length > 0) {
        const r0 = j.results[0];
        return { latitude: r0.latitude, longitude: r0.longitude, name: r0.name + (r0.country ? ', ' + r0.country : '') };
      }
      return null;
    }).catch(()=>null);
  }

  function fetchOpenMeteoForecast(lat, lon) {
    const unit = getStoredUnit();
    const temperature_unit = (unit === 'F') ? 'fahrenheit' : 'celsius';
    const windspeed_unit = (unit === 'F') ? 'mph' : 'ms';
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&daily=temperature_2m_max,temperature_2m_min,weathercode&current_weather=true&timezone=auto&forecast_days=7&temperature_unit=${temperature_unit}&windspeed_unit=${windspeed_unit}`;
    return fetch(url).then(r => r.json());
  }

  function fetchBackendCity(city) {
    const resultEl = document.getElementById('weatherResult');
    return fetch(`/weather?city=${encodeURIComponent(city)}`)
      .then(r => r.json())
      .then(data => {
        if (!data || (data.cod && parseInt(data.cod,10) !== 200)) {
          const err = (data && (data.error || data.message)) || t('NOT_FOUND_TEMPLATE', { city });
          resultEl.innerHTML = `<span style="color:#b00;">${err}</span>`;
          return null;
        }
        LAST_QUERY = { type: 'backend', city };
        resultEl.innerHTML = renderWeatherData(data);
        return data;
      })
      .catch(() => {
        resultEl.innerHTML = '<span style="color:#b00;">' + t('FETCH_ERROR') + '</span>';
        return null;
      });
  }

  function renderWeatherData(data) {
    const unit = getStoredUnit();
    let tempStr = (data.main && typeof data.main.temp === 'number') ? Math.round(data.main.temp) + 'أ‚آ°C' : 'N/A';
    if (unit === 'F' && data.main && typeof data.main.temp === 'number') tempStr = Math.round((data.main.temp * 9/5)+32) + 'أ‚آ°F';
    const windUnit = (unit === 'F') ? 'mph' : 'm/s';
    let wind = data.wind ? data.wind.speed : 'N/A';
    if (unit === 'F' && data.wind && typeof data.wind.speed === 'number') wind = Math.round(data.wind.speed * 2.23694);
    return `<b>${data.name}${data.sys && data.sys.country ? ', ' + data.sys.country : ''}</b><br>
            Wetter: ${data.weather && data.weather[0] ? data.weather[0].description : 'N/A'}<br>
            Temperatur: ${tempStr}<br>
            Luftfeuchtigkeit: ${data.main ? data.main.humidity : 'N/A'}%<br>
            Wind: ${wind} ${windUnit}`;
  }

  function fetchWeather(city) {
    const resultEl = document.getElementById('weatherResult');
    if (!city) {
      resultEl.innerHTML = '<span style="color:#b00;">' + t('PLEASE_SELECT') + '</span>';
      return;
    }
    resultEl.innerHTML = 'Lأƒآ¤dt...';
    geocodeCity(city).then(geo => {
      if (geo && geo.latitude != null && geo.longitude != null) {
        LAST_QUERY = { type: 'city', city };
        fetchOpenMeteoForecast(geo.latitude, geo.longitude).then(fore => {
          if (!fore) return fetchBackendCity(city);
          try {
            LAST_QUERY = { type: 'coords', lat: geo.latitude, lon: geo.longitude, placeName: geo.name, city: city };
            resultEl.innerHTML = renderOpenMeteo(fore, geo.name || city);
          } catch (e) {
            console.error('renderOpenMeteo error', e);
            resultEl.innerHTML = '<span style="color:#b00;">' + t('FETCH_ERROR') + '</span>';
          }
        }).catch(()=> fetchBackendCity(city));
      } else {
        fetchBackendCity(city);
      }
    }).catch(()=> fetchBackendCity(city));
  }

  // UI wiring
  try {
    const dd = document.getElementById('cityDropdown');
    if (dd) {
      dd.addEventListener('change', function () {
        const input = document.getElementById('cityInput');
        if (input) input.value = this.value;
        if (this.value) fetchWeather(this.value);
      });
    }

    const cityInput = document.getElementById('cityInput');
    if (cityInput) {
      cityInput.addEventListener('input', function () {
        const val = this.value.trim();
        const dd2 = document.getElementById('cityDropdown');
        let found = false;
        if (dd2) {
          for (let i = 0; i < dd2.options.length; i++) {
            if (dd2.options[i].value.toLowerCase() === val.toLowerCase()) { dd2.selectedIndex = i; found = true; break; }
          }
          if (!found) dd2.selectedIndex = 0;
        }
      });
    }

    const form = document.getElementById('weatherForm');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const city = (document.getElementById('cityInput') && document.getElementById('cityInput').value.trim()) || (document.getElementById('cityDropdown') && document.getElementById('cityDropdown').value);
        fetchWeather(city);
      });
    }
  } catch(e){ console.warn(e); }

  // ---- Robust unit toggle handlers fallback (already bound above, this is safe) ----
  try {
    const btnC = document.getElementById('unitC');
    const btnF = document.getElementById('unitF');
    if (btnC) btnC.addEventListener && btnC.addEventListener('click', ()=>{ setStoredUnit('C'); applyUnitUI(); setTimeout(reapplyLastQuery,50); });
    if (btnF) btnF.addEventListener && btnF.addEventListener('click', ()=>{ setStoredUnit('F'); applyUnitUI(); setTimeout(reapplyLastQuery,50); });
  } catch(e){}

  try { if (!localStorage.getItem(TEMP_UNIT_KEY)) localStorage.setItem(TEMP_UNIT_KEY, DEFAULT_UNIT); } catch(e){}
  applyUnitUI();

  // Injected/native coordinates fetch helper (sets LAST_QUERY too)
  window._injectedFetchByCoords = window._injectedFetchByCoords || function(lat, lon, placeName){
    try {
      if (typeof fetchOpenMeteoForecast === 'function' && typeof renderOpenMeteo === 'function') {
        fetchOpenMeteoForecast(lat, lon).then(fore => {
          try {
            const q = { type:'coords', lat: lat, lon: lon, placeName: placeName || '' };
            LAST_QUERY = q; window.LAST_QUERY = q;
            document.getElementById('weatherResult').innerHTML = renderOpenMeteo(fore, placeName || '');
          } catch(e) {
            console.error('renderOpenMeteo error', e);
            document.getElementById('weatherResult').innerHTML = '<span style="color:#b00;">Fehler bei der Anzeige</span>';
          }
        }).catch(err => {
          console.error('fetchOpenMeteoForecast error', err);
          document.getElementById('weatherResult').innerHTML = '<span style="color:#b00;">Fehler beim Abrufen</span>';
        });
      } else {
        console.log('Coordinates available:', lat, lon);
      }
    } catch(e){ console.error(e); }
  };

  // Geolocation helper
  (function(){
    const TIMEOUT_MS = 25000;
    const useBtn = document.getElementById('useLocationBtn');
    const resultEl = document.getElementById('weatherResult');

    function log(msg){ try { console.debug('[geo] '+msg); } catch(e){} }
    function show(msg, isError){
      if (!resultEl) return;
      resultEl.innerHTML = isError ? ('<span style="color:#b00;">' + msg + '</span>') : msg;
    }

    function getPositionWithTimeout(opts){
      return new Promise((resolve, reject) => {
        if (!navigator.geolocation) {
          const err = new Error('Geolocation unavailable');
          err.code = 0;
          return reject(err);
        }
        let finished = false;
        const timer = setTimeout(()=> {
          if (finished) return;
          finished = true;
          const err = new Error('Timeout');
          err.code = 3;
          reject(err);
        }, TIMEOUT_MS);
        navigator.geolocation.getCurrentPosition(pos => {
          if (finished) return;
          finished = true; clearTimeout(timer); resolve(pos);
        }, err => {
          if (finished) return;
          finished = true; clearTimeout(timer); reject(err);
        }, opts || { enableHighAccuracy: false, maximumAge: 0, timeout: TIMEOUT_MS });
      });
    }

    async function queryPermission(){
      if (!navigator.permissions || !navigator.permissions.query) return null;
      try {
        const p = await navigator.permissions.query({ name: 'geolocation' });
        return p.state;
      } catch(e){
        log('permissions.query failed: '+e);
        return null;
      }
    }

    function permissionHelpText(){
      return `
        <div style="font-size:0.95rem;line-height:1.3;">
          Standortzugriff scheint blockiert zu sein. So aktivieren Sie ihn:
          <ul>
            <li>أƒâ€“ffnen Sie im Browser das Menأƒآ¼ أ¢â€ â€™ Website-Einstellungen أ¢â€ â€™ Standort أ¢â€ â€™ erlauben fأƒآ¼r timerhaven.com</li>
            <li>Stellen Sie sicher, dass Android أ¢â€ â€™ Einstellungen أ¢â€ â€™ Standort aktiviert ist</li>
            <li>Verwenden Sie keinen Inkognito-Modus</li>
          </ul>
          Oder fأƒآ¼gen Sie die Koordinaten aus Ihrer Karten-App ein (Teilen أ¢â€ â€™ Koordinaten kopieren).
        </div>
      `;
    }

    async function handleUseLocation(e){
      e && e.preventDefault && e.preventDefault();
      show('Standort wird ermittelt...');
      log('User requested location');

      const perm = await queryPermission().catch(()=>null);
      log('permission state: '+perm);

      if (perm === 'denied'){
        show(permissionHelpText(), true);
        return;
      }

      try {
        const pos = await getPositionWithTimeout({ enableHighAccuracy: false, maximumAge: 60 * 1000, timeout: TIMEOUT_MS });
        log('got coords quick: '+pos.coords.latitude+','+pos.coords.longitude);
        show('' + pos.coords.latitude.toFixed(4)+', '+pos.coords.longitude.toFixed(4) + ' أ¢â‚¬â€‌ Vorhersage wird geladen...');
        if (typeof window._injectedFetchByCoords === 'function') {
          window._injectedFetchByCoords(pos.coords.latitude, pos.coords.longitude);
        } else {
          fetchOpenMeteoForecast(pos.coords.latitude, pos.coords.longitude).then(f => { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(f, ''); }).catch(err => { log(err); show('Fehler beim Abrufen', true); });
        }
        return;
      } catch(err){
        log('quick getCurrentPosition failed: ' + (err && err.code) + ' / ' + err.message);
      }

      try {
        const pos = await getPositionWithTimeout({ enableHighAccuracy: true, maximumAge: 0, timeout: TIMEOUT_MS+5000 });
        log('got coords after prompt: '+pos.coords.latitude+','+pos.coords.longitude);
        show('' + pos.coords.latitude.toFixed(4)+', ' + pos.coords.longitude.toFixed(4) + ' أ¢â‚¬â€‌ Vorhersage wird geladen...');
        if (typeof window._injectedFetchByCoords === 'function') {
          window._injectedFetchByCoords(pos.coords.latitude, pos.coords.longitude);
        } else {
          fetchOpenMeteoForecast(pos.coords.latitude, pos.coords.longitude).then(f => { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(f, ''); }).catch(err => { log(err); show('Fehler beim Abrufen', true); });
        }
        return;
      } catch(err){
        log('final getCurrentPosition failed: ' + (err && err.code) + ' / ' + err.message);
        if (err && err.code === 1) {
          show(permissionHelpText(), true);
        } else if (err && err.code === 3) {
          show('Anforderung nach Standort hat zu lange gedauert. Schalten Sie GPS ein und versuchen Sie es erneut.', true);
        } else {
          show('Standort auf diesem Gerأƒآ¤t oder Browser nicht verfأƒآ¼gbar. Sie kأƒآ¶nnen die Koordinaten manuell eingeben.', true);
        }
      }
    }

    if (useBtn) {
      try { useBtn.removeEventListener && useBtn.removeEventListener('click', handleUseLocation); } catch(e){}
      useBtn.addEventListener('click', handleUseLocation);
    } else {
      log('useLocationBtn not present');
    }

    window.receiveNativeLocation = function(obj){
      try {
        const lat = parseFloat(obj.latitude || obj.lat);
        const lon = parseFloat(obj.longitude || obj.lon || obj.lng);
        if (!isNaN(lat) && !isNaN(lon)) {
          show('Standort aus App: ' + lat + ', ' + lon + ' أ¢â‚¬â€‌ Vorhersage wird geladen...');
          if (typeof window._injectedFetchByCoords === 'function') window._injectedFetchByCoords(lat, lon);
          else fetchOpenMeteoForecast(lat, lon).then(f => { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(f, ''); }).catch(err => { log(err); show('Fehler beim Abrufen', true); });
        }
      } catch(e){ log(e); }
    };
  })();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js"></script>
</body>
</html>


