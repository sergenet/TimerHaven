<div class="password-section">
<form aria-label="Password generator form" class="password-form" id="passwordForm" onsubmit="return false;">
<label style="font-weight:600;">ÎœÎ®ÎºÎ¿Ï‚ ÎºÏ‰Î´Î¹ÎºÎ¿Ï:</label>
<input class="form-control" id="pwLength" max="128" min="4" style="max-width:90px;" type="number" value="16"/>
<label><input checked="" id="pwUpper" type="checkbox"/> ÎšÎµÏ†Î±Î»Î±Î¯Î±</label>
<label><input checked="" id="pwLower" type="checkbox"/> Î ÎµÎ¶Î¬</label>
<label><input checked="" id="pwDigits" type="checkbox"/> Î‘ÏÎ¹Î¸Î¼Î¿Î¯</label>
<label><input id="pwSymbols" type="checkbox"/> Î£ÏÎ¼Î²Î¿Î»Î±</label>
<button class="btn btn-success btn-sm" id="generateBtn" type="button">Î”Î·Î¼Î¹Î¿Ï…ÏÎ³Î¯Î±</button>
<button class="btn btn-outline-secondary btn-sm" id="copyBtn" style="display:none;" type="button">Î‘Î½Ï„Î¹Î³ÏÎ±Ï†Î®</button>
<button class="btn btn-outline-danger btn-sm" id="clearBtn" style="display:none; margin-left:6px;" type="button">ÎšÎ±Î¸Î±ÏÎ¹ÏƒÎ¼ÏŒÏ‚</button>
</form>
<div aria-live="polite" class="password-result" id="pwResult"></div>
