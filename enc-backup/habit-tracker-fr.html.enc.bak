<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
<div class="main-container">
<div class="center-row">
<div class="article-card">
<div>
<h2 id="howto-title"></h2>
<ol id="howto-steps"></ol>
</div>
<a class="btn btn-outline-primary btn-sm" href="#" id="howto-article-btn"></a>
</div>
<div class="tool-card">
<div class="banner" id="banner" style="display:none;"></div>
<a class="back-link" href="index.html" id="back-link"></a>
<h3 id="tool-title"></h3>
<div class="stats-bar" id="stats-bar"></div>
<div class="habit-section">
<form class="habit-form" id="habitForm">
<input class="form-control" id="habitInput" placeholder="" type="text"/>
<button class="btn btn-success btn-sm" id="add-btn" type="submit"></button>
</form>
<div class="habit-list" id="habitList"></div>
</div>
<details class="faq-section" id="faq-section">
<summary id="faq-title"></summary>
<ul id="faq-list" style="padding-left:1em;"></ul>
</details>
<!-- Removed the inline "tips" block from inside the tool-card (desktop duplicate). -->
</div>
<div class="article-card">
<div>
<h2 id="tips-title"></h2>
<ul id="tips-list"></ul>
</div>
<a class="btn btn-outline-primary btn-sm" href="#" id="tips-article-btn"></a>
</div>
</div>
</div>
<!-- Mobile-only tips (kept outside tool-card). Hidden on desktop, shown on small viewports. -->
<details class="tips-mobile" id="tips-mobile" style="display:none;">
<summary><h4 id="tips-mobile-title" style="color:#185a9d;display:inline;"></h4></summary>
<ul id="tips-mobile-list"></ul>
</details>
<script>
  // Full French-focused translations (other languages available in canonical English file if needed)
  const habitTranslations = {
    fr: {
      "language-label": "Langue :",
      "back-link": "Retour au menu principal",
      "tool-title": "Suivi d'Habitudes",
      "habitInput": "Nom de l'habitude",
      "add-btn": "Ajouter l'habitude",
      "banner-all-done": "ðŸŽ‰ Toutes les habitudes sont terminÃ©es aujourd'hui ! Bravo !",
      "stats-tracked": "Suivies : ",
      "stats-done": "Faites aujourd'hui : ",
      "stats-best": "Meilleure sÃ©rie : ",
      "howto-title": '<i class="fa fa-check-double"></i> Comment utiliser le Suivi d\'Habitudes',
      "howto-steps": `<li><b>Ajoutez une habitude :</b> Tapez votre habitude quotidienne et cliquez sur Ajouter.</li>
        <li><b>Marquez comme fait :</b> Lorsque vous complÃ©tez une habitude, cliquez sur TerminÃ© Ã  cÃ´tÃ©.</li>
        <li><b>Supprimer/archiver :</b> Supprimez ou archivez les habitudes non suivies.</li>
        <li><b>RÃ©pÃ©tez chaque jour :</b> Revenez chaque jour pour suivre vos progrÃ¨s.</li>`,
      "howto-article-btn": "Lire l'article complet",
      "howto-article-link": "habit-how-to-fr.html",
      "tips-title": '<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Conseils pour les Habitudes',
      "tips-list": `<li><b>Commencez petit :</b> DÃ©butez avec des habitudes faciles pour progresser.</li>
        <li><b>Suivez chaque jour :</b> La constance est la clÃ© !</li>
        <li><b>CÃ©lÃ©brez :</b> Valorisez les petits progrÃ¨s.</li>`,
      "tips-article-btn": "Lire l'article complet",
      "tips-article-link": "habit-tips-fr.html",
      "tips-mobile-title": '<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Conseils',
      "tips-mobile-list": `<li><b>Commencez petit :</b> Construisez progressivement.</li>
        <li><b>Suivez la rÃ©gularitÃ© :</b> Regardez vos sÃ©ries pour rester motivÃ©.</li>
        <li><b>Ajoutez des rappels :</b> Utilisez des alertes calendrier.</li>`,
      "faq-title": "Foire aux questions",
      "faq-list": `<li><b>Mes habitudes sont-elles sauvegardÃ©es ?</b> Oui, dans votre navigateur.</li>
        <li><b>Puis-je suivre plusieurs habitudes ?</b> Oui, autant que vous voulez.</li>
        <li><b>Puis-je voir mes sÃ©ries ?</b> Oui, affichÃ©es pour chaque habitude.</li>
        <li><b>Puis-je archiver ?</b> Oui, archivez les habitudes mises en pause.</li>`,
      "mark-done": "Terminer",
      "done-today": "Fait aujourd'hui",
      "streak": "SÃ©rie : ",
      "longest": "Meilleur : ",
      "archive": "Archiver",
      "unarchive": "DÃ©sarchiver",
      "delete": "Supprimer",
      "no-habits": "Aucune habitude pour l'instant."
    }
  };

  const langNames = { en: "English", fr: "FranÃ§ais", de: "Deutsch", ru: "Ð ÑƒÑÑÐºÐ¸Ð¹", el: "Î•Î»Î»Î·Î½Î¹ÎºÎ¬", es: "EspaÃ±ol", ar: "Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©" };

  function getLang() {
    try { const l = localStorage.getItem('timerhavenLang') || 'fr'; return (l && l.slice(0,2)) || 'fr'; } catch(e){ return 'fr'; }
  }

  function getTodayStr() {
    const d = new Date();
    return d.getFullYear() + "-" + (d.getMonth()+1).toString().padStart(2,"0") + "-" + d.getDate().toString().padStart(2,"0");
  }
  function lastNDays(n) {
    const arr = [];
    for (let i = n-1; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      arr.push(d.getFullYear() + "-" + (d.getMonth()+1).toString().padStart(2,"0") + "-" + d.getDate().toString().padStart(2,"0"));
    }
    return arr;
  }

  let habits = JSON.parse(localStorage.getItem('habits') || '[]');

  function applyLanguage(lang) {
    lang = (lang || getLang()).slice(0,2);
    const t = habitTranslations[lang] || habitTranslations['fr'];
    document.body.dir = (lang === "ar") ? "rtl" : "ltr";
    const back = document.getElementById('back-link'); if (back) back.textContent = t['back-link'] || '';
    const toolTitle = document.getElementById('tool-title'); if (toolTitle) toolTitle.innerHTML = `<i class="fa fa-check-double"></i> ${t['tool-title'] || ''}`;
    const input = document.getElementById('habitInput'); if (input) input.placeholder = t['habitInput'] || '';
    const addBtn = document.getElementById('add-btn'); if (addBtn) addBtn.textContent = t['add-btn'] || '';
    const faqTitle = document.getElementById('faq-title'); if (faqTitle) faqTitle.textContent = t['faq-title'] || '';
    const faqList = document.getElementById('faq-list'); if (faqList) faqList.innerHTML = t['faq-list'] || '';
    const howtoTitle = document.getElementById('howto-title'); if (howtoTitle) howtoTitle.innerHTML = t['howto-title'] || '';
    const howtoSteps = document.getElementById('howto-steps'); if (howtoSteps) howtoSteps.innerHTML = t['howto-steps'] || '';
    const howtoBtn = document.getElementById('howto-article-btn'); if (howtoBtn) { howtoBtn.textContent = t['howto-article-btn'] || ''; howtoBtn.href = t['howto-article-link'] || ''; }
    const tipsTitle = document.getElementById('tips-title'); if (tipsTitle) tipsTitle.innerHTML = t['tips-title'] || '';
    const tipsList = document.getElementById('tips-list'); if (tipsList) tipsList.innerHTML = t['tips-list'] || '';
    const tipsBtn = document.getElementById('tips-article-btn'); if (tipsBtn) { tipsBtn.textContent = t['tips-article-btn'] || ''; tipsBtn.href = t['tips-article-link'] || ''; }
    const tipsMobileTitle = document.getElementById('tips-mobile-title'); if (tipsMobileTitle) tipsMobileTitle.innerHTML = t['tips-mobile-title'] || '';
    const tipsMobileList = document.getElementById('tips-mobile-list'); if (tipsMobileList) tipsMobileList.innerHTML = t['tips-mobile-list'] || '';
    renderHabits();

    // show mobile-only tips control if viewport < 800px
    const mobileDetails = document.getElementById('tips-mobile');
    if (mobileDetails) {
      mobileDetails.style.display = (window.innerWidth < 801) ? 'block' : 'none';
    }
  }

  function resetHabitsIfNeeded() {
    const today = getTodayStr();
    let changed = false;
    habits.forEach(habit => {
      if (!habit.history) habit.history = [];
      if (habit.lastChecked !== today) {
        habit.doneToday = false;
        habit.lastChecked = today;
        changed = true;
      }
    });
    if (changed) saveHabits();
  }
  function saveHabits() { localStorage.setItem('habits', JSON.stringify(habits)); }

  function renderHabits() {
    resetHabitsIfNeeded();
    const lang = getLang();
    const t = habitTranslations[lang] || habitTranslations['fr'];
    const list = document.getElementById('habitList');
    list.innerHTML = '';
    const today = getTodayStr();
    let doneTodayCount = 0;
    let bestStreak = 0;
    let activeCount = 0;
    habits.forEach(h => { if (!h.archived) activeCount++; });
    if (habits.length === 0 || activeCount === 0) {
      list.innerHTML = `<div style="color:#888;">${t["no-habits"] || habitTranslations["fr"]["no-habits"]}</div>`;
    }
    habits.forEach((habit, idx) => {
      if (habit.archived) return;
      let streak = habit.streak || 0;
      let longest = habit.longest || streak;
      bestStreak = Math.max(bestStreak, longest);
      if (!habit.history) habit.history = [];
      let historyDots = "";
      lastNDays(7).forEach((date) => {
        const done = habit.history.includes(date);
        historyDots += `<span class="dot${done ? ' done' : ''}${date === today ? ' today' : ''}" title="${date}"></span>`;
      });
      const isDone = habit.doneToday;
      if (isDone) doneTodayCount++;
      list.innerHTML += `
        <div class="habit-item">
          <span><b>${habit.name}</b>
            <span class="habit-meta">${t["streak"]}${streak} ${t["longest"]}${longest}</span>
            <span class="habit-history">${historyDots}</span>
          </span>
          <button class="btn btn-outline-${isDone ? 'secondary' : 'success'} btn-sm habit-btn" onclick="markDone(${idx})" ${isDone ? 'disabled' : ''}>
            ${isDone ? t["done-today"] : t["mark-done"]}
          </button>
          <button class="archive-btn${habit.archived ? ' archived' : ''}" onclick="archiveHabit(${idx})">
            ${habit.archived ? t["unarchive"] : t["archive"]}
          </button>
          <button class="btn btn-outline-danger btn-sm habit-btn" onclick="deleteHabit(${idx})"><i class="fa fa-trash"></i> ${t["delete"]}</button>
        </div>
      `;
    });
    renderStats(activeCount, doneTodayCount, bestStreak);
    renderBanner(activeCount, doneTodayCount);
  }
  function renderStats(tracked, done, best) {
    const lang = getLang();
    const t = habitTranslations[lang] || habitTranslations['fr'];
    document.getElementById("stats-bar").innerHTML =
      `${t["stats-tracked"]}${tracked} &bull; ${t["stats-done"]}${done} &bull; ${t["stats-best"]}${best}`;
  }
  function renderBanner(tracked, done) {
    const lang = getLang();
    const t = habitTranslations[lang] || habitTranslations['fr'];
    const banner = document.getElementById("banner");
    if (tracked > 0 && done === tracked) {
      banner.textContent = t["banner-all-done"] || habitTranslations["fr"]["banner-all-done"];
      banner.style.display = "block";
    } else {
      banner.style.display = "none";
    }
  }

  document.getElementById('habitForm').addEventListener('submit', function(e){
    e.preventDefault();
    const name = document.getElementById('habitInput').value.trim();
    if (!name) return;
    habits.push({
      name,
      streak: 0,
      longest: 0,
      doneToday: false,
      lastChecked: getTodayStr(),
      history: [],
      archived: false
    });
    saveHabits();
    document.getElementById('habitInput').value = "";
    renderHabits();
  });
  window.markDone = function(idx){
    const today = getTodayStr();
    if (!habits[idx].doneToday) {
      habits[idx].doneToday = true;
      habits[idx].lastChecked = today;
      habits[idx].streak = (habits[idx].streak || 0) + 1;
      habits[idx].longest = Math.max(habits[idx].longest || 0, habits[idx].streak);
      if (!habits[idx].history) habits[idx].history = [];
      if (!habits[idx].history.includes(today)) habits[idx].history.push(today);
      saveHabits();
      renderHabits();
    }
  }
  window.archiveHabit = function(idx){
    habits[idx].archived = !habits[idx].archived;
    saveHabits();
    renderHabits();
  }
  window.deleteHabit = function(idx){
    habits.splice(idx, 1);
    saveHabits();
    renderHabits();
  }

  window.addEventListener('storage', function(e) {
    if (e.key === 'timerhavenLang') {
      const lang = (e.newValue || getLang()).slice(0,2);
      applyLanguage(lang);
    }
  });

  document.addEventListener("DOMContentLoaded", function() {
    applyLanguage(getLang());
    renderHabits();
    // toggle mobile tips visibility on resize
    window.addEventListener('resize', function(){ applyLanguage(getLang()); });
  });
</script>
