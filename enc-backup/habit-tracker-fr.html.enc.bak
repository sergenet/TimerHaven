<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="utf-8"/>
<title>Suivi d'Habitudes â€” TimerHaven</title>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<meta content="Suivez vos habitudes quotidiennes et construisez de nouvelles routines." name="description"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet"/>
<style>
    /* same styles as English file for consistency */
    body { background: #f4f7fb; font-family: 'Montserrat', Arial, sans-serif; }
    .main-container { max-width: 1200px; margin: 2em auto; display: flex; justify-content: center; align-items: center; min-height: 90vh; }
    .center-row { display: flex; flex-direction: row; justify-content: center; align-items: flex-start; gap: 2em; width: 100%; }
    .article-card, .tool-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px #e0e7ef; width: 340px; min-width: 220px; max-width: 340px; min-height: 500px; flex: 1 1 340px; display: flex; flex-direction: column; justify-content: flex-start; align-items: stretch; padding: 2em 1.3em 1em 1.3em; margin: 0; box-sizing: border-box; text-align: left; overflow: hidden; }
    .tool-card { max-width: 410px; min-width: 240px; padding: 2em 1.5em 1em 1.5em; position: relative; z-index: 1; }
    .tool-card h3 { font-size: 1.45em; font-weight: 700; margin-bottom: 0.1em; }
    .article-card h2, .tool-card h3 { font-size: 1.35em; font-weight: 700; margin-bottom: 0.4em; display: flex; align-items: center; gap: 0.3em; }
    .habit-form { margin-bottom: 1em; display: flex; gap: 0.5em; }
    .habit-list { margin-bottom: 1em; }
    .habit-item { background: #f7fafc; border-radius: 7px; padding: 0.6em 0.8em; margin-bottom: 0.6em; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; }
    .habit-meta { font-size: 0.9em; color: #888; margin-left: 0.6em; margin-right: 1em; }
    .habit-btn { font-size: 0.9em; margin-left: 0.6em; }
    .habit-history { display: flex; gap: 3px; margin-left: 1em; align-items: center;}
    .dot { width: 15px; height: 15px; border-radius: 50%; display: inline-block; background: #e0e7ef; border: 1px solid #d0d0d0;}
    .dot.done { background: #43cea2; border: 1.5px solid #185a9d; }
    .dot.today { border: 2px solid #43cea2; }
    .stats-bar { background: #f6fbfa; border-radius: 10px; margin-bottom: 1.2em; padding: 0.7em 1em; font-size: 1.05em; font-weight: 600; color: #185a9d; display:flex; gap:2em; align-items:center; justify-content:space-between; }
    .archive-btn { font-size: 0.9em; margin-left: 0.6em; background: #fff; border: 1px solid #43cea2; color: #43cea2; border-radius: 6px; padding: 0.15em 0.7em;}
    .archive-btn.archived { opacity: 0.65; color: #888; border-color: #d0d0d0; }
    .banner { background: linear-gradient(90deg,#43cea2 0%,#185a9d 100%); color:#fff; border-radius:10px; font-size:1.11em; font-weight:600; text-align:center; margin-bottom:1em; padding:0.7em 0.8em; }
    .faq-section { margin-top: 1.1em; margin-bottom: 0.3em; font-size: 1em; background: #f7fafc; border-radius: 8px; padding: 1em; box-shadow: 0 1px 4px #e0e7ef; }
    @media (max-width: 1100px) { .main-container{padding:0 8px;} .center-row{gap:1em;} .tool-card,.article-card{width:97vw;max-width:540px;height:auto;} }
    @media (max-width: 800px) { .main-container{padding:0;} .center-row{flex-direction:column;align-items:center;} .tool-card,.article-card{width:98vw;max-width:540px;height:auto;} .article-card { display: none !important; } .howto-mobile, .tips-mobile { display: block !important; margin-bottom: 1em; } }
    @media (min-width: 801px) { .howto-mobile, .tips-mobile { display: none !important; } }
    details[open] summary::after { content: " â–²"; font-size: 0.9em; }
    details summary { cursor: pointer; padding: 0.35em 0; font-weight: bold; font-size: 1.09em; }
    details:not([open]) summary::after { content: " â–¼"; font-size: 0.9em; }
  </style>
<script>

