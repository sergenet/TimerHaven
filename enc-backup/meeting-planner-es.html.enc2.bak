</head>
<body>
<div class="main-container">
<div class="center-row">
<!-- Left article card: How-to -->
<div aria-labelledby="howto-heading" class="article-card">
<h2 id="howto-heading">CÃ³mo usar el Planificador de Reuniones</h2>
<ol>
<li>Agrega asistentes y sus zonas horarias.</li>
<li>Elige una fecha y una hora sugerida.</li>
<li>Verifica las horas locales y comparte el horario final.</li>
</ol>

</div>
<!-- Center tool card -->
<div class="tool-card" id="tool-card">
<!-- language selector removed (language controlled by index/main menu) -->
<a class="back-link" href="index.html"><i class="fa fa-arrow-left"></i> Volver al menÃº principal</a>
<h3><i class="fa fa-users"></i> Planificador de Reuniones</h3>
<form id="meetingForm" onsubmit="return false;">
<div class="meeting-form-row mb-2">
<label for="participantName">Nombre del participante</label>
<input autocomplete="off" class="form-control" id="participantName" placeholder="Introduce el nombre (ej. Juan)" type="text"/>
</div>
<div class="meeting-form-row mb-2">
<label for="participantCity">Zona horaria / Ciudad</label>
<select autocomplete="off" class="form-select" id="participantCity"></select>
</div>
<div class="mb-2 d-flex gap-2">
<button class="btn btn-success btn-participant" id="addParticipant" type="button"><i class="fa fa-plus"></i> Agregar participante</button>
<button class="btn btn-outline-secondary" id="clearParticipants" title="Clear participants" type="button"><i class="fa fa-eraser"></i></button>
</div>
</form>
<div class="participant-list mb-3" id="participantList"></div>
<div class="meeting-form-row mb-2">
<label for="meetingDate">Selecciona la fecha</label>
<input class="form-control" id="meetingDate" type="date"/>
</div>
<div class="meeting-form-row mb-2">
<label for="meetingTime">Selecciona la hora</label>
<input class="form-control" id="meetingTime" type="time"/>
<button class="btn btn-primary btn-sm mt-2" id="calcTimes" type="button"><i class="fa fa-clock"></i> Mostrar horarios</button>
</div>
<div aria-live="polite" class="mt-2" id="meetingTimes"></div>
<details class="faq-section mt-3">
<summary id="faq-heading">Preguntas frecuentes</summary>
<ul id="faq-list" style="padding-left: 1em;">
<li><b>Â¿CuÃ¡ntos participantes?</b> Los que necesites.</li>
<li><b>Â¿QuÃ© zonas horarias?</b> Elige entre mÃ¡s de 30 ciudades globales.</li>
<li><b>Â¿CÃ³mo compartir?</b> Copia los horarios y compÃ¡rtelos con los asistentes.</li>
</ul>
</details>
<!-- "Leer los consejos" link removed from the bottom of the tool card -->
</div>
<!-- Right article card: Tips -->
<div aria-labelledby="tips-heading" class="article-card">
<h2 id="tips-heading">Consejos de productividad para reuniones</h2>
<ul>
<li>Planifica con antelaciÃ³n para encontrar un horario que funcione para todos.</li>
<li>EnvÃ­a invitaciones de calendario para evitar confusiones.</li>
<li>Verifica las zonas horarias antes de enviar la invitaciÃ³n.</li>
</ul>

</div>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/luxon@3.4.3/build/global/luxon.min.js"></script>
<script>
    const cities = [
      {value:"", label:"Elige ciudad/zona horaria"},
      {value:"America/New_York", label:"Nueva York ðŸ‡ºðŸ‡¸"},
      {value:"America/Chicago", label:"Chicago ðŸ‡ºðŸ‡¸"},
      {value:"America/Los_Angeles", label:"Los Ãngeles ðŸ‡ºðŸ‡¸"},
      {value:"America/Toronto", label:"Toronto ðŸ‡¨ðŸ‡¦"},
      {value:"Europe/London", label:"Londres ðŸ‡¬ðŸ‡§"},
      {value:"Europe/Paris", label:"ParÃ­s ðŸ‡«ðŸ‡·"},
      {value:"Europe/Berlin", label:"BerlÃ­n ðŸ‡©ðŸ‡ª"},
      {value:"Europe/Moscow", label:"MoscÃº ðŸ‡·ðŸ‡º"},
      {value:"Europe/Istanbul", label:"Estambul ðŸ‡¹ðŸ‡·"},
      {value:"Asia/Dubai", label:"DubÃ¡i ðŸ‡¦ðŸ‡ª"},
      {value:"Asia/Kolkata", label:"Calcuta ðŸ‡®ðŸ‡³"},
      {value:"Asia/Shanghai", label:"ShanghÃ¡i ðŸ‡¨ðŸ‡³"},
      {value:"Asia/Tokyo", label:"Tokio ðŸ‡¯ðŸ‡µ"},
      {value:"Asia/Singapore", label:"Singapur ðŸ‡¸ðŸ‡¬"},
      {value:"Asia/Jakarta", label:"Yakarta ðŸ‡®ðŸ‡©"},
      {value:"Australia/Sydney", label:"SÃ­dney ðŸ‡¦ðŸ‡º"},
      {value:"Pacific/Auckland", label:"Auckland ðŸ‡³ðŸ‡¿"},
      {value:"America/Sao_Paulo", label:"SÃ£o Paulo ðŸ‡§ðŸ‡·"},
      {value:"America/Mexico_City", label:"Ciudad de MÃ©xico ðŸ‡²ðŸ‡½"},
      {value:"Africa/Johannesburg", label:"Johannesburgo ðŸ‡¿ðŸ‡¦"},
      {value:"Africa/Cairo", label:"El Cairo ðŸ‡ªðŸ‡¬"},
      {value:"Africa/Nairobi", label:"Nairobi ðŸ‡°ðŸ‡ª"},
      {value:"Asia/Seoul", label:"SeÃºl ðŸ‡°ðŸ‡·"},
      {value:"Asia/Hong_Kong", label:"Hong Kong ðŸ‡­ðŸ‡°"},
      {value:"Asia/Bangkok", label:"Bangkok ðŸ‡¹ðŸ‡­"},
      {value:"Asia/Manila", label:"Manila ðŸ‡µðŸ‡­"},
      {value:"Europe/Madrid", label:"Madrid ðŸ‡ªðŸ‡¸"},
      {value:"Europe/Rome", label:"Roma ðŸ‡®ðŸ‡¹"},
      {value:"Europe/Warsaw", label:"Varsovia ðŸ‡µðŸ‡±"},
      {value:"Europe/Amsterdam", label:"Ãmsterdam ðŸ‡³ðŸ‡±"},
      {value:"Europe/Athens", label:"Atenas ðŸ‡¬ðŸ‡·"},
      {value:"America/Vancouver", label:"Vancouver ðŸ‡¨ðŸ‡¦"}
    ];

    function populateCities() {
      const sel = document.getElementById('participantCity');
      sel.innerHTML = '';
      cities.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.value;
        opt.textContent = c.label;
        sel.appendChild(opt);
      });
    }

    const LS_KEY = 'meetingPlannerParticipants';
    function loadParticipants() {
      try { const raw = localStorage.getItem(LS_KEY); window.participants = raw ? JSON.parse(raw) : []; } catch(e){ window.participants = []; }
    }
    function saveParticipants() { try { localStorage.setItem(LS_KEY, JSON.stringify(window.participants || [])); } catch(e){} }
    function renderParticipants() {
      const container = document.getElementById('participantList');
      container.innerHTML = '';
      if (!window.participants || window.participants.length === 0) {
        container.innerHTML = '<div style="color:#888;">No hay participantes todavÃ­a.</div>';
        return;
      }
      window.participants.forEach((p, idx) => {
        const el = document.createElement('div');
        el.className = 'participant-item';
        el.innerHTML = `<div style="min-width:0;"><div style="font-weight:700;">${escapeHtml(p.name)}</div><div style="font-size:.9em;color:#666;">${escapeHtml(p.city)}</div></div>
          <div style="display:flex;gap:.5rem;"><button class="btn btn-outline-danger btn-sm" onclick="removeParticipant(${idx})" aria-label="Remove participant"><i class="fa fa-trash"></i></button></div>`;
        container.appendChild(el);
      });
    }
    function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

    document.getElementById('addParticipant').addEventListener('click', function(){
      const name = document.getElementById('participantName').value.trim();
      const city = document.getElementById('participantCity').value;
      if (!name) { alert('Por favor introduce un nombre de participante.'); return; }
      if (!city) { alert('Por favor selecciona una ciudad / zona horaria.'); return; }
      window.participants = window.participants || [];
      window.participants.push({ name, city });
      saveParticipants();
      document.getElementById('participantName').value = '';
      document.getElementById('participantCity').selectedIndex = 0;
      renderParticipants();
      updateMeetingTimes();
    });

    document.getElementById('clearParticipants').addEventListener('click', function(){
      if (!window.participants || window.participants.length === 0) return;
      if (!confirm('Â¿Borrar todos los participantes?')) return;
      window.participants = [];
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    });

    window.removeParticipant = function(idx){
      if (!window.participants) return;
      window.participants.splice(idx,1);
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    };

    const { DateTime } = luxon;
    function updateMeetingTimes(){
      const date = document.getElementById('meetingDate').value;
      const time = document.getElementById('meetingTime').value;
      const out = document.getElementById('meetingTimes');
      const tlang = {
        noDateTime: "Por favor selecciona fecha y hora.",
        noParticipants: "No hay participantes todavÃ­a.",
        heading: "Horarios de la reuniÃ³n (organizador â†’ local de los participantes)"
      };
      if (!date || !time) { out.innerHTML = `<div style="color:#888;">${tlang.noDateTime}</div>`; return; }
      if (!window.participants || window.participants.length === 0) { out.innerHTML = `<div style="color:#888;">${tlang.noParticipants}</div>`; return; }
      const localISO = `${date}T${time}`;
      let organizer = DateTime.fromISO(localISO);
      if (!organizer.isValid) { out.innerHTML = `<div style="color:#b00;">${tlang.noDateTime}</div>`; return; }
      let html = `<div style="font-weight:700;margin-bottom:.4rem;">${tlang.heading}</div><div class="meeting-times-grid">`;
      html += `<div class="time-suggestion"><div><b>Organizador</b> (${escapeHtml(organizer.zoneName)})</div><div>${escapeHtml(organizer.toLocaleString(DateTime.DATETIME_FULL))}</div></div>`;
      window.participants.forEach(p => {
        let dt;
        try { dt = organizer.setZone(p.city); } catch(e) { dt = null; }
        const label = dt ? dt.toLocaleString(DateTime.DATETIME_FULL) : 'Zona invÃ¡lida';
        html += `<div class="time-suggestion"><div><b>${escapeHtml(p.name)}</b> <span style="color:#666;">(${escapeHtml(p.city)})</span></div><div>${escapeHtml(label)}</div></div>`;
      });
      html += `</div>`;
      out.innerHTML = html;
    }

    document.getElementById('calcTimes').addEventListener('click', updateMeetingTimes);

    document.addEventListener('DOMContentLoaded', function(){
      populateCities();
      loadParticipants();
      renderParticipants();
      try {
        const savedDate = localStorage.getItem('meetingPlannerDate');
        const savedTime = localStorage.getItem('meetingPlannerTime');
        if (savedDate) document.getElementById('meetingDate').value = savedDate;
        if (savedTime) document.getElementById('meetingTime').value = savedTime;
      } catch(e){}
    });

    document.getElementById('meetingDate').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerDate', this.value); }catch(e){} });
    document.getElementById('meetingTime').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerTime', this.value); }catch(e){} });

  </script>
<p style="margin-top:1rem;"><a class="cta" href="/es/meeting-planner/meeting-planner-index.html">Read full guide</a></p></body>
</html>


