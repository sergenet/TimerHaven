    .tool-card { background:#fff; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,0.06); width:420px; padding:1.3rem; display:flex; flex-direction:column; }
    .tool-card h3 { color:#185a9d; font-size:1.35rem; margin-bottom:.5rem; }

    /* Make all three cards equal height on desktop */
