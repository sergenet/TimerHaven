<a class="d-block mb-2" href="index.html" style="text-decoration:none; color:#0d6efd; font-weight:600;">â† ZurÃ¼ck zum HauptmenÃ¼</a>
<div class="password-section">
<form aria-label="Password generator form" class="password-form" id="passwordForm" onsubmit="return false;">
<label style="font-weight:600;">LÃ¤nge des Passworts:</label>
<input class="form-control" id="pwLength" max="128" min="4" style="max-width:90px;" type="number" value="16"/>
<label><input checked="" id="pwUpper" type="checkbox"/> GroÃŸbuchstaben</label>
<label><input checked="" id="pwLower" type="checkbox"/> Kleinbuchstaben</label>
<label><input checked="" id="pwDigits" type="checkbox"/> Zahlen</label>
<label><input id="pwSymbols" type="checkbox"/> Symbole</label>
<button class="btn btn-success btn-sm" id="generateBtn" type="button">Generieren</button>
<button class="btn btn-outline-secondary btn-sm" id="copyBtn" style="display:none;" type="button">Kopieren</button>
<button class="btn btn-outline-danger btn-sm" id="clearBtn" style="display:none; margin-left:6px;" type="button">LÃ¶schen</button>
</form>
<div aria-live="polite" class="password-result" id="pwResult"></div>
