<script>
/* Patched EL world-clock: tolerant loader, dedupe/sort locale 'el', Awesomplete chooser, native select preserved */
const { DateTime } = luxon;

function normalizeKey(s){ if(!s) return ''; try { return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim(); } catch(e){ return String(s).toLowerCase().trim(); } }
function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

let cityList = [], cityToZone = {}, cityNames = [], awesompleteInstance = null;

(async function loadCities(){
  const dropdown = document.getElementById('cityDropdown');
  const input = document.getElementById('cityInput');
  const PATHS = ['/world-cities.json','/assets/data/world-cities.json','/el/world-cities.json','/world-cities.json?cachebust='+Date.now()];

  async function tryFetch(paths, timeoutMs=4500){
    const start = Date.now();
    for (const p of paths){ if (Date.now()-start > timeoutMs) break;
      try { const r = await fetch(p, { cache:'no-cache' }); if(!r.ok) continue; const txt = await r.text(); try { return JSON.parse(txt); } catch(e){ continue; } } catch(e){ continue; }
    }
    return null;
  }

  try {
    const raw = await tryFetch(PATHS);
    const list = Array.isArray(raw) ? raw : (raw && Array.isArray(raw.cities) ? raw.cities : []);
    const map = new Map();
    (list||[]).forEach(item => {
      if(!item) return;
      const name = (item.name||item.city||'').trim();
      const tz = (item.timezone||item.tz||item.zone||'').trim();
      if(!name) return;
      const key = normalizeKey(name);
      if(!map.has(key)) map.set(key, { name, timezone: tz||'' });
    });
    const entries = Array.from(map.values()).sort((a,b) => a.name.localeCompare(b.name, 'el', { sensitivity:'base' }));
    cityList = entries; cityToZone = {}; cityNames = entries.map(e => e.name);
    if (dropdown) {
      const placeholder = dropdown.querySelector('option[value=""]') ? dropdown.querySelector('option[value=""]').outerHTML : '<option value="">Î•Ï€Î¹Î»Î­Î¾Ï„Îµ Ï€ÏŒÎ»Î·...</option>';
      dropdown.innerHTML = placeholder;
    }
    entries.forEach(e => {
      cityToZone[normalizeKey(e.name)] = e.timezone || '';
      if (dropdown && (e.name||'').toLowerCase() !== 'tokyo') {
        const opt = document.createElement('option'); opt.value = e.timezone||''; opt.textContent = e.name; dropdown.appendChild(opt);
      }
    });
    if (typeof Awesomplete !== 'undefined' && input) {
      const awList = cityNames.slice();
      if (input.awesomplete) input.awesomplete.list = awList;
      else awesompleteInstance = new Awesomplete(input, { list: awList, minChars:1, maxItems:12, autoFirst:true });
    }
    console.info('world-cities: populated', entries.length);
  } catch(err){
    console.warn('world-cities load failed', err);
    const fallback = [{name:'Athens',timezone:'Europe/Athens'},{name:'London',timezone:'Europe/London'},{name:'New York',timezone:'America/New_York'}];
    cityList = fallback; cityToZone = {}; cityNames = fallback.map(f=>f.name);
    if (dropdown) {
      const placeholder = dropdown.querySelector('option[value=""]') ? dropdown.querySelector('option[value=""]').outerHTML : '<option value="">Î•Ï€Î¹Î»Î­Î¾Ï„Îµ Ï€ÏŒÎ»Î·...</option>';
      dropdown.innerHTML = placeholder + fallback.map(e=>`<option value="${escapeHtml(e.timezone)}">${escapeHtml(e.name)}</option>`).join('');
    }
    if (typeof Awesomplete !== 'undefined' && input) {
      if (input.awesomplete) input.awesomplete.list = cityNames;
      else awesompleteInstance = new Awesomplete(input, { list: cityNames, minChars:1, maxItems:12, autoFirst:true });
    }
  }
})();

// Clocks
let clocks = JSON.parse(localStorage.getItem('worldClocks') || '[]');
function saveClocks(){ localStorage.setItem('worldClocks', JSON.stringify(clocks)); }

function renderClocks(){
  const list = document.getElementById('clockList'); list.innerHTML = '';
  if (!clocks || clocks.length===0){ list.innerHTML = '<div style="color:#888;">Î”ÎµÎ½ Î­Ï‡Î¿Ï…Î½ Ï€ÏÎ¿ÏƒÏ„ÎµÎ¸ÎµÎ¯ ÏÎ¿Î»ÏŒÎ³Î¹Î±.</div>'; return; }
  clocks.forEach((clock, idx) => {
    let timeStr='...'; let error=false;
    try { const now = DateTime.now().setZone(clock.tz); if (!now.isValid) throw new Error('invalid zone'); timeStr = now.toFormat('cccc, dd LLL yyyy<br>HH:mm:ss'); }
    catch { timeStr = 'ÎœÎ· Î­Î³ÎºÏ…ÏÎ· Î¶ÏŽÎ½Î· ÏŽÏÎ±Ï‚'; error = true; }
    const div = document.createElement('div'); div.className='clock-item';
    div.innerHTML = `
      <div style="display:flex;gap:.8rem;align-items:center;">
        <span style="background:#0b2545;color:#fff;border-radius:50%;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;"><i class="fa fa-clock"></i></span>
        <div style="min-width:0">
          <div style="font-weight:700;">${escapeHtml(clock.label)}</div>
          <div style="font-size:.95rem;color:#444;">${timeStr}${error ? ' <span style="color:#b00;">(Î•Î»Î­Î³Î¾Ï„Îµ Î¿ÏÎ¸Î¿Î³ÏÎ±Ï†Î¯Î± Î® Ï‡ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÏ„Îµ Î­Î³ÎºÏ…ÏÎ· Ï€ÏŒÎ»Î· Î® IANA Î¶ÏŽÎ½Î·)</span>' : ''}</div>
        </div>
      </div>
      <div><button class="btn btn-outline-danger btn-sm" onclick="deleteClock(${idx})" aria-label="Î”Î¹Î±Î³ÏÎ±Ï†Î®"><i class="fa fa-trash"></i></button></div>
    `;
    list.appendChild(div);
  });
}

function normalizeInput(s){ return String(s||'').trim().toLowerCase().replace(/[\s\-_]+/g,' '); }
function resolveZoneFromValue(v){ if (!v) return ''; if (/^[A-Za-z]+\/[A-Za-z_]+$/.test(v)) return v; return cityToZone[normalizeKey(v)] || ''; }

function addClock(label,tz){ clocks.push({label,tz}); saveClocks(); renderClocks(); }

document.getElementById('addClockBtn').addEventListener('click', function(){
  document.getElementById('errorMsg').textContent = '';
  const inputVal = document.getElementById('cityInput').value.trim();
  let label='', zone='';
  if (inputVal) {
    zone = resolveZoneFromValue(inputVal);
    if (!zone) { document.getElementById('errorMsg').innerText = 'Î— Ï€ÏŒÎ»Î· Î´ÎµÎ½ Î±Î½Î±Î³Î½Ï‰ÏÎ¯ÏƒÏ„Î·ÎºÎµ. Î§ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÏ„Îµ autocomplete Î® ÎµÎ¹ÏƒÎ¬Î³ÎµÏ„Îµ IANA Î¶ÏŽÎ½Î·.'; return; }
    const canonical = cityList.find(c => normalizeKey(c.name) === normalizeKey(inputVal));
    label = canonical ? canonical.name : inputVal;
  } else {
    const sel = document.getElementById('cityDropdown');
    if (sel && sel.value) { zone = sel.value; label = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].text : zone; }
    else { document.getElementById('errorMsg').textContent = 'Î•Ï€Î¹Î»Î­Î¾Ï„Îµ Î® ÎµÎ¹ÏƒÎ¬Î³ÎµÏ„Îµ Ï€ÏŒÎ»Î· Î® Î¶ÏŽÎ½Î· ÏŽÏÎ±Ï‚.'; return; }
  }
  addClock(label, zone);
  document.getElementById('cityInput').value = '';
  document.getElementById('cityDropdown').selectedIndex = 0;
});

document.getElementById('cityInput').addEventListener('keydown', function(e){ if (e.key === 'Enter'){ e.preventDefault(); document.getElementById('addClockBtn').click(); } });

window.deleteClock = function(idx){ clocks.splice(idx,1); saveClocks(); renderClocks(); }

setInterval(renderClocks,1000); renderClocks();
</script>

<!-- header language selector script -->
<script>
  (function(){
    const LANGS = [{code:'en',name:'English'},{code:'fr',name:'FranÃ§ais'},{code:'es',name:'EspaÃ±ol'},{code:'de',name:'Deutsch'},{code:'ru',name:'Ð ÑƒÑÑÐºÐ¸Ð¹'},{code:'el',name:'Î•Î»Î»Î·Î½Î¹ÎºÎ¬'},{code:'ar',name:'Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©'}];
    function detectPageInfo(){ const path=(location.pathname||'').split('/').pop()||''; const m=path.match(/^world-(clock|how-to|tips)-([a-z]{2})\.html$/i); if(m) return {type:m[1],lang:m[2].toLowerCase()}; if(/^world-clock\.html$/i.test(path)) return {type:'clock',lang:'el'}; const m2=path.match(/^world-(clock|how-to|tips)\.html$/i); if(m2) return {type:m2[1],lang:'el'}; return {type:'clock',lang:'el'}; }
    function removeInCardSelectors(){ document.querySelectorAll('.tool-card .lang-wrap, .tool-card #language-select-top').forEach(el=>{ try{ el.remove(); }catch(e){} }); }
    function buildHeaderSelector(selectedLang){ let top = document.querySelector('.page-wrap .top-row') || document.querySelector('.top-row'); if(!top){ top=document.createElement('div'); top.className='top-row'; const pw=document.querySelector('.page-wrap')||document.body; pw.insertBefore(top,pw.firstChild); } top.querySelectorAll('label[for="language-select-top"], #language-select-top').forEach(n=>{ try{ n.remove(); }catch(e){} }); const label=document.createElement('label'); label.setAttribute('for','language-select-top'); label.textContent='Language:'; label.style.fontWeight='600'; label.style.marginRight='.5rem'; const sel=document.createElement('select'); sel.id='language-select-top'; sel.className='language-select'; sel.setAttribute('aria-label','Language selector'); LANGS.forEach(l=>{ const o=document.createElement('option'); o.value=l.code; o.textContent=l.name; if(l.code===selectedLang) o.selected=true; sel.appendChild(o); }); top.appendChild(label); top.appendChild(sel); sel.style.display='inline-flex'; sel.style.visibility='visible'; return sel; }
    function hookSelector(sel){ if(!sel) return; if(sel._handler) sel.removeEventListener('change', sel._handler); sel._handler=function(){ const code=this.value||'el'; const info=detectPageInfo(); if((location.pathname||'').match(/world-clock\.html$/i)){ window.location.href='world-clock-'+code+'.html'; return; } window.location.href='world-'+info.type+'-'+code+'.html'; }; sel.addEventListener('change', sel._handler); }
    function init(){ removeInCardSelectors(); const info=detectPageInfo(); const sel=buildHeaderSelector(info.lang); hookSelector(sel); const observer=new MutationObserver(function(muts){ muts.forEach(function(m){ if(m.addedNodes){ m.addedNodes.forEach(function(n){ try{ if(n.querySelectorAll){ n.querySelectorAll('.tool-card .lang-wrap, .tool-card #language-select-top').forEach(function(el){ try{ el.remove(); }catch(e){} }); } if(n.matches && (n.matches('.tool-card .lang-wrap') || n.matches('.tool-card #language-select-top'))){ try{ n.remove(); }catch(e){} } }catch(e){} }); } }); }); observer.observe(document.documentElement||document.body,{ childList:true, subtree:true }); setTimeout(function(){ try{ observer.disconnect(); }catch(e){} },6000); }
    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>

