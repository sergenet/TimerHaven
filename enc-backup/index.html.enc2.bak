  <!-- Demo export script (stable sample filename) -->
  <script>
  (function(){
    function escapeCsv(v){
      if (v === null || v === undefined) return '';
      return '"' + String(v).replace(/"/g,'""') + '"';
    }

    function downloadCsv(filename, content){
      var blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    function buildDemoSession(){
      var now = new Date();
      var start = new Date(now.getTime() - (25*60*1000)); // 25 minutes earlier
      var task = (document.getElementById('demoSessionName') && document.getElementById('demoSessionName').textContent) || 'ÐÐ°Ð¿Ð¸ÑÐ°Ñ‚ÑŒ Ð¾Ñ‚Ñ‡Ñ‘Ñ‚';
      var tagsText = (document.getElementById('demoSessionTags') && document.getElementById('demoSessionTags').textContent) || '';
      var tags = tagsText.split(',').map(function(t){ return t.trim(); }).filter(Boolean);
      return {
        id: 'demo-' + Math.floor(Math.random()*900000+100000),
        task_name: task.trim(),
        tags: tags,
        start_time: start.toISOString(),
        end_time: now.toISOString(),
        duration_seconds: 25*60,
        duration_human: '25:00',
        notes: 'ÐŸÑ€Ð¸Ð¼ÐµÑ€ ÑÐºÑÐ¿Ð¾Ñ€Ñ‚Ð° Ð¸Ð· Ñ€ÑƒÐºÐ¾Ð²Ð¾Ð´ÑÑ‚Ð²Ð°',
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'
      };
    }

    function exportSessionAsCsv(session){
      var header = ['id','task_name','tags','start_time','end_time','duration_seconds','duration_human','notes','timezone'];
      var row = [
        session.id || '',
        session.task_name || '',
        (session.tags || []).join(';'),
        session.start_time || '',
        session.end_time || '',
        session.duration_seconds != null ? session.duration_seconds : '',
        session.duration_human || '',
        session.notes || '',
        session.timezone || ''
      ];
      var csv = header.map(escapeCsv).join(',') + '\n' + row.map(escapeCsv).join(',') + '\n';
      // Stable sample filename for the example download
      var filename = 'tasktimer-sample.csv';
      downloadCsv(filename, csv);
    }

    document.addEventListener('DOMContentLoaded', function(){
      var btn = document.getElementById('exportDemoBtnInline');
      if (!btn) return;
      btn.addEventListener('click', function(){
        try {
          var session = buildDemoSession();
          exportSessionAsCsv(session);
          var orig = btn.innerHTML;
          btn.innerHTML = 'Ð¡ÐºÐ°Ñ‡Ð°Ð½Ð¾';
          btn.disabled = true;
          setTimeout(function(){ btn.innerHTML = orig; btn.disabled = false; }, 1200);
        } catch (e) {
          console.error('Export error', e);
          alert('ÐžÑˆÐ¸Ð±ÐºÐ° Ð¿Ñ€Ð¸ ÑÐºÑÐ¿Ð¾Ñ€Ñ‚Ðµ â€” ÑÐ¼. ÐºÐ¾Ð½ÑÐ¾Ð»ÑŒ Ð´Ð»Ñ Ð´ÐµÑ‚Ð°Ð»ÐµÐ¹.');
        }
      });
    });
  })();
  </script>
</body>
