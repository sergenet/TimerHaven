  <style>
    body { background: #f4f7fb; font-family: 'Montserrat', Arial, sans-serif; color:var(--text-dark,#102a43); }
    .main-container { max-width: 1200px; margin: 2rem auto; padding:0 1rem; display:flex; justify-content:center; align-items:flex-start; min-height:90vh; box-sizing:border-box; }
    .tool-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px #e0e7ef; width: 420px; padding: 1.6rem 1.5rem; box-sizing: border-box; }
    .back-link { display:inline-block; margin-bottom:.75rem; color:var(--brand,#0d6efd) !important; text-decoration:none; font-weight:700; }
    .tool-title { font-size:1.35rem; margin:0 0 .4rem 0; display:flex; align-items:center; gap:.4rem; color:#185a9d; }
    .read-guide { display:inline-block; margin:.35rem 0 .8rem 0; padding:.45rem .7rem; border-radius:8px; background:var(--brand,#0d6efd); color:#fff; text-decoration:none; font-weight:700; font-size:.95rem; border:none; }
    .tool-help { color:var(--muted,#6b7c89); margin-bottom:.8rem; }
    .converter-form { display:flex; gap:.5rem; margin-bottom:1rem; flex-wrap:wrap; align-items:center; }
    .converter-result { font-weight:700; font-size:1.12rem; margin-bottom:1rem; color:var(--text-dark,#102a43); }
    details.faq-section summary { cursor:pointer; padding:.2rem 0; font-weight:700; }
    details.faq-section ul { margin-top:.5rem; color:var(--muted,#6b7c89); padding-left:1rem; }

    /* Mobile: show small summary and bring converter controls above long intro */
    .mobile-summary { display:none; margin-bottom:.6rem; color:#51606b; font-size:.95rem; }
    @media (max-width:520px) {
      .mobile-summary { display:block; }
      .converter-section { order: 1; }
      .tool-intro { order: 2; }
      .tool-intro p { display:none; }
      .tool-card { width:94vw; padding:12px; }
    }
    @media (max-width:900px) { .tool-card { width:98vw; padding:1rem; } }
  </style>
<script>

</script>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <script>try{ localStorage.setItem('timerhavenLang','en'); }catch(e){};</script>

  <main class="main-container" role="main">
    <section class="tool-card" aria-labelledby="tool-title">
      <a href="index.html" class="back-link" id="back-link" style="color:var(--brand,#0d6efd) !important;">â† Back to Main Menu</a>

      <div id="tool-title" class="tool-title"><i class="fa fa-dollar-sign"></i> Currency Converter</div>

      <div class="mobile-summary">Quick currency checks â€” <a href="/en/currency-converter/currency-index.html">Read full guide</a></div>

      <a id="read-guide-btn" class="read-guide" href="/en/currency-converter/currency-index.html" role="button"
         style="background:var(--brand,#0d6efd) !important; border-color:var(--brand,#0d6efd) !important; color:#fff !important;">
        Read full guide
      </a>

      <div class="tool-intro" id="tool-help" data-preserve="true" style="margin-top:.6rem;margin-bottom:.9rem;color:#374151;line-height:1.45;">
        <p><strong>How to use the Currency Converter</strong> â€” Enter an amount, pick the source and target currencies, and click Convert. The tool fetches live rates and shows the converted amount and the exchange rate used. Use it for quick checks when budgeting or shopping abroad.</p>
        <p>Note: For large transfers or business decisions, confirm rates with your bank (provider fees and timing can affect the final amount). This tool is for fast, everyday checks.</p>
        <p style="margin-top:.6rem;color:#51606b;font-size:.95rem;"><strong>By Serge Shammas</strong> Â· Last updated: <time datetime="2026-01-06">Jan 6, 2026</time></p>
      </div>

      <div class="converter-section">
        <form class="converter-form" id="currencyForm">
          <input type="number" min="0" step="any" id="amount" class="form-control" placeholder="" style="max-width:100px;">
          <select id="fromCurrency" class="form-select" style="max-width:120px;"></select>
          <span style="font-size:1.3em;">â†’</span>
          <select id="toCurrency" class="form-select" style="max-width:120px;"></select>
          <button type="submit" class="btn btn-outline-primary btn-sm" id="convert-btn">Convert</button>
        </form>
        <div id="result" class="converter-result">Converted amount will appear here.</div>
      </div>

      <details class="faq-section">
        <summary id="faq-title">FAQs</summary>
        <ul id="faq-list" style="padding-left:1em;"></ul>
      </details>
    </section>
  </main>

  <script>
  // API key
  const apiKey = "5f484bfa921ef56c9c279660";

  window.currencyList = window.currencyList || [
    "USD","EUR","GBP","JPY","AUD","CAD","CHF","CNY","SEK","NZD",
    "MXN","SGD","HKD","NOK","KRW","TRY","INR","RUB","BRL","ZAR"
  ];

  var currencyTranslations = {
    en: {
      "language-label":"Language:",
      "back-link":"â† Back to Main Menu",
      "tool-title":"Currency Converter",
      "tool-help":"Convert currencies using live exchange rates.",
      "amount":"Amount",
      "convert":"Convert",
      "result-placeholder":"Converted amount will appear here.",
      "fetching":"Fetching rate...",
      "amount-error":"Please enter a valid amount.",
      "conversion-unavailable":"Conversion not available.",
      "fetch-error":"Could not fetch conversion.",
      "faq-title":"FAQs",
      "faq-list": `<li><b>Are exchange rates live?</b> Yes, rates update regularly from the API.</li>
                   <li><b>Can I convert between any currency?</b> Most global currencies are supported.</li>
                   <li><b>Is this free?</b> Yes, all tools on TimerHaven are free.</li>`,
      "howto-article-btn":"Read Full Article",
      "howto-article-link":"/en/currency-converter/currency-index.html"
    }
  };

  function $id(id){ return document.getElementById(id); }

  function populateCurrencySelects() {
    var from = $id('fromCurrency'), to = $id('toCurrency');
    if (!from || !to) return;
    from.innerHTML = ''; to.innerHTML = '';
    var list = Array.isArray(window.currencyList) && window.currencyList.length ? window.currencyList : ["USD","EUR","GBP","JPY","AUD","CAD","CHF","CNY","SEK","NZD","MXN","SGD","HKD","NOK","KRW","TRY","INR","RUB","BRL","ZAR"];
    list.forEach(function(cur){
      from.appendChild(new Option(cur, cur));
      to.appendChild(new Option(cur, cur));
    });
    from.value = "USD";
    to.value = "EUR";
  }

  function getLang() {
    try { var l = localStorage.getItem('timerhavenLang') || 'en'; return (l && l.slice(0,2)) || 'en'; } catch(e){ return 'en'; }
  }

  function applyLanguage(lang) {
    lang = (lang || getLang()).slice(0,2);
    var t = (currencyTranslations && currencyTranslations[lang]) ? currencyTranslations[lang] : (currencyTranslations && currencyTranslations['en'] ? currencyTranslations['en'] : null);
    document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';
    try {
      if (t) {
        if ($id('back-link')) $id('back-link').textContent = t['back-link'] || '';
        if ($id('tool-title')) $id('tool-title').innerHTML = '<i class="fa fa-dollar-sign"></i> ' + (t['tool-title'] || '');
        var help = $id('tool-help');
        if (help) {
          if (!(help.dataset && help.dataset.preserve === 'true')) help.textContent = t['tool-help'] || '';
        }
        if ($id('amount')) $id('amount').placeholder = t['amount'] || '';
        if ($id('convert-btn')) $id('convert-btn').textContent = t['convert'] || 'Convert';
        if ($id('result')) $id('result').textContent = t['result-placeholder'] || '';
        if ($id('faq-title')) $id('faq-title').textContent = t['faq-title'] || '';
        if ($id('faq-list')) $id('faq-list').innerHTML = t['faq-list'] || '';
        if ($id('read-guide-btn')) {
          $id('read-guide-btn').href = t['howto-article-link'] || '/en/currency-converter/currency-index.html';
          $id('read-guide-btn').textContent = t['howto-article-btn'] || 'Read full guide';
        }
      }
    } catch (err) { console.warn('applyLanguage error', err); }
  }

  (function(){
    var form = $id('currencyForm');
    if (!form) return;
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var amtEl = $id('amount'), fromEl = $id('fromCurrency'), toEl = $id('toCurrency'), resEl = $id('result');
      var lang = getLang();
      var t = (currencyTranslations && currencyTranslations[lang]) ? currencyTranslations[lang] : (currencyTranslations && currencyTranslations['en'] ? currencyTranslations['en'] : null);
      if (!amtEl || !fromEl || !toEl || !resEl) return;

      var amountVal = parseFloat(amtEl.value);
      if (!isFinite(amountVal) || amountVal <= 0) {
        resEl.innerText = (t && t['amount-error']) ? t['amount-error'] : 'Please enter a valid amount.';
        return;
      }

      resEl.innerText = (t && t['fetching']) ? t['fetching'] : 'Fetching rate...';

      var fromCur = fromEl.value, toCur = toEl.value;
      if (!fromCur || !toCur) {
        resEl.innerText = (t && t['conversion-unavailable']) ? t['conversion-unavailable'] : 'Conversion not available.';
        return;
      }

      fetch('https://v6.exchangerate-api.com/v6/' + apiKey + '/pair/' + encodeURIComponent(fromCur) + '/' + encodeURIComponent(toCur) + '/' + encodeURIComponent(amountVal))
        .then(function(r){ return r.json(); })
        .then(function(data){
          if (data && typeof data.conversion_result !== 'undefined') {
            var conv = Math.round((data.conversion_result + Number.EPSILON) * 100000) / 100000;
            var rate = Math.round((data.conversion_rate + Number.EPSILON) * 100000) / 100000;
            resEl.innerText = amountVal + ' ' + fromCur + ' = ' + conv + ' ' + toCur + ' (Rate: ' + rate + ')';
          } else {
            resEl.innerText = (t && t['conversion-unavailable']) ? t['conversion-unavailable'] : 'Conversion not available.';
          }
        })
        .catch(function(){
          resEl.innerText = (t && t['fetch-error']) ? t['fetch-error'] : 'Could not fetch conversion.';
        });
    });
  })();

  document.addEventListener('DOMContentLoaded', function(){
    try { populateCurrencySelects(); } catch(e){ console.warn('populateCurrencySelects failed', e); }
    try { applyLanguage(getLang()); } catch(e){ console.warn('applyLanguage failed', e); }
  });
  </script>

  <footer style="text-align:center;margin-top:1.2rem;color:var(--muted,#6b7c89);">
    &copy; 2025 TimerHaven. All tools are free and privacy-friendly.<br>
    <a href="privacy.html">Privacy Policy</a> &bull;
    <a href="terms.html">Terms</a> &bull;
    <a href="contact.html">Contact</a>
  </footer>
</body>
</html>


