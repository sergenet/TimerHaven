<script>
    // Safety: if any anchor on this page still points to the generic currency.html (cached / old copy),
    // rewrite it immediately to the localized page so users return to currency-ru.html.
    (function rewriteBackLinks() {
      try {
        document.querySelectorAll('a[href]').forEach(a => {
          const h = (a.getAttribute('href') || '').toLowerCase();
          if (h === 'currency.html' || h === '/currency.html' || h.endsWith('/currency.html')) {
            a.setAttribute('href', '/currency-ru.html');
            a.href = location.origin + '/currency-ru.html';
          }
        });
      } catch (e) { /* ignore */ }
    })();

    // Replace navigation helper: always navigate to the localized converter and replace history entry
    function goBackReplace(e) {
      try {
        e.preventDefault();
        // Use replace to avoid leaving the tips page in the back history chain
        window.location.replace('/currency-ru.html');
        return false;
      } catch (err) {
        // Fall back to normal anchor navigation if replace fails
        return true;
      }
    }
