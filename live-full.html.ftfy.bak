  <script></script>
  <style>
    body {
      font-family: 'Montserrat', Arial, sans-serif;
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
    }

    .language-select {
      text-align: right;
      padding: 10px 18px 0 0;
      margin-bottom: 0.5em;
    }

    #language-label {
      color: #185a9d;
      font-weight: bold;
      font-size: 1.08em;
      margin-right: 0.5em;
      letter-spacing: 0.02em;
    }

    #lang-select {
      border: 2px solid #43cea2;
      background: linear-gradient(90deg, #f4f7fb 60%, #e0f7fa 100%);
      color: #185a9d;
      font-weight: 600;
      border-radius: 7px;
      padding: 7px 16px;
      font-size: 1em;
      box-shadow: 0 2px 8px #e0e7ef;
      outline: none;
      transition: border 0.2s, background 0.2s;
    }

    #lang-select:focus {
      border-color: #185a9d;
      background: linear-gradient(90deg, #e0f7fa 60%, #43cea2 100%);
    }

    .main-header {
      text-align: center;
      margin: 2em 0 1em;
      color: #222;
      letter-spacing: 1px;
    }
    .main-header h1 {
      font-size: 2em;
      font-weight: 700;
      margin-bottom: 0.2em;
      background: linear-gradient(90deg,#43cea2,#185a9d);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .main-header p {
      font-size: 1em;
      color: #444;
      margin-top: 0.1em;
      font-weight: 400;
    }
    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      max-width: 900px;
      margin: 0 auto 2em auto;
      padding: 0 0.5em;
    }
    .menu-card {
      border-radius: 14px;
      padding: 0.9em 0.3em 0.7em 0.3em;
      text-align: center;
      background: #fff;
      box-shadow: 0 2px 10px #e0e7ef;
      transition: transform 0.15s, box-shadow 0.15s;
      position: relative;
      cursor: pointer;
      min-height: 120px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border: 2px solid transparent;
    }
    .menu-card:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 4px 18px #b5c6e0;
      border-color: #43cea2;
      z-index: 1;
    }
    .menu-icon {
      font-size: 1.7em;
      margin-bottom: 0.25em;
      display: inline-block;
      padding: 0.15em 0.42em;
      border-radius: 50px;
      background: linear-gradient(135deg, var(--card-color1,#43cea2) 40%, var(--card-color2,#185a9d) 100%);
      color: #fff;
      box-shadow: 0 1px 4px #c9e2e2;
    }
    /* Ensure menu titles are visible (explicit color to avoid CSS inheritance issues) */
    .menu-title {
      font-size: 1em;
      font-weight: bold;
      margin-bottom: 0.13em;
      letter-spacing: 0.5px;
      color: #0a2540; /* explicit dark color so text is visible */
    }
    .menu-description {
      color: #555;
      font-size: 0.82em;
      margin-bottom: 0.1em;
      font-weight: 400;
      min-height: 0;
    }
    .card-calendar   .menu-icon { --card-color1: #a1c4fd; --card-color2: #fd5d47; }
    .card-clipboard  .menu-icon { --card-color1: #a1c4fd; --card-color2: #43cea2; }
    .card-countdown  .menu-icon { --card-color1: #43cea2; --card-color2: #185a9d; }
    .card-currency   .menu-icon { --card-color1: #43cea2; --card-color2: #fcb045; }
    .card-focus      .menu-icon { --card-color1: #43cea2; --card-color2: #f857a6; }
    .card-habit      .menu-icon { --card-color1: #f857a6; --card-color2: #43cea2; }
    .card-meeting    .menu-icon { --card-color1: #c2e9fb; --card-color2: #185a9d; }
    .card-notes      .menu-icon { --card-color1: #ff5858; --card-color2: #fcb045; }
    .card-password   .menu-icon { --card-color1: #ffb347; --card-color2: #ffcc33; }
    .card-pomodoro   .menu-icon { --card-color1: #f857a6; --card-color2: #ff5858; }
    .card-stopwatch  .menu-icon { --card-color1: #fcb045; --card-color2: #fd5d47; }
    .card-task       .menu-icon { --card-color1: #fd5d47; --card-color2: #fcb045; }
    .card-unit       .menu-icon { --card-color1: #fd5d47; --card-color2: #a1c4fd; }
    .card-weather    .menu-icon { --card-color1: #a1c4fd; --card-color2: #c2e9fb; }
    .card-world      .menu-icon { --card-color1: #185a9d; --card-color2: #43cea2; }

    /* Pomodoro icon styling (tomato emoji + stopwatch) */
    .pomodoro-emoji { font-size:1.1em; line-height:1; margin-right:.25rem; vertical-align:middle; }
    .pomodoro-fa { font-size:1.0em; color:#e24b3a; margin-right:.25rem; vertical-align:middle; }

    @media (max-width: 800px) {
      .main-header h1 { font-size: 1.2em; }
      .tool-grid { gap: 8px; }
      .menu-card { min-height: 90px; padding: 0.6em 0.1em; }
      .menu-icon { font-size: 1.3em; }
      .menu-title { font-size: 0.82em; }
      .menu-description { font-size: 0.70em; }
    }
    footer {
      text-align: center;
      margin: 1em 0 1em 0;
      color: #444;
      font-size: 0.95em;
    }
	/* responsive reserve for leaderboard-style ad to avoid layout shift */
.ad-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* desktop/tablet reserve */
@media (min-width: 900px) {
  .ad-wrapper { min-height: 90px; }   /* reserve approx 728x90 leaderboard */
}

/* mobile reserve */
@media (max-width: 899px) {
  .ad-wrapper { min-height: 50px; }   /* reserve approx 320x50 mobile banner */
}
  </style>

