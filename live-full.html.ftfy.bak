<!-- Homepage leaderboard ad (placeholder reserved; will initialize after consent) -->
<div class="ad-wrapper" id="th-leaderboard-ad" aria-hidden="false" style="max-width:900px;margin:0 auto;padding:0 1rem;min-height:0;display:flex;align-items:center;justify-content:center;">
