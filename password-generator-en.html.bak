<body>
  <main class="main-container" role="main">
    <section class="tool-card" aria-labelledby="tool-title">
      <a href="index.html" class="back-link">&larr; Back to Main Menu</a>

      <h3 id="tool-title" class="tool-title"><i class="fa fa-key"></i> Password Generator</h3>

      <div class="mobile-summary">Generate secure passwords locally â€” <a href="/en/password-generator/password-generator-index.html">Read full guide</a></div>

      <a id="read-guide-btn" class="read-guide" href="/en/password-generator/password-generator-index.html" role="button">Read full guide</a>

      <!-- Server-rendered intro preserved by data-preserve="true" -->
      <div class="tool-intro" id="tool-help" data-preserve="true" style="margin-top:.6rem;margin-bottom:.9rem;color:#374151;line-height:1.45;">
        <p><strong>Quick generator â€” local and private</strong> â€” Generate secure passwords or passphrases locally in your browser. Choose length and character classes, then copy the result to your clipboard. Passwords are not stored or transmitted by this page.</p>
        <p style="margin-top:.5rem;color:#51606b;font-size:.95rem;"><strong>By Serge Shammas</strong> Â· Last updated: <time datetime="2026-01-06">Jan 6, 2026</time></p>
      </div>

      <div class="password-section" style="margin-top:.6rem;">
        <form id="passwordForm" class="password-form" aria-label="Password generator form" onsubmit="return false;">
          <label style="font-weight:600;">Length:</label>
          <input id="pwLength" type="number" min="4" max="128" value="16" class="form-control" style="max-width:90px;">
          <label style="margin-left:.4rem;"><input id="pwUpper" type="checkbox" checked> Upper</label>
          <label><input id="pwLower" type="checkbox" checked> Lower</label>
          <label><input id="pwDigits" type="checkbox" checked> Digits</label>
          <label><input id="pwSymbols" type="checkbox"> Symbols</label>
          <button id="generateBtn" class="btn btn-success btn-sm" type="button">Generate</button>
        </form>

        <div id="pwResult" class="password-result" aria-live="polite"></div>

        <div style="margin-top:.6rem;">
          <button id="copyBtn" class="btn btn-outline-secondary btn-sm" type="button" style="display:none;">Copy</button>
          <button id="clearBtn" class="btn btn-outline-danger btn-sm" type="button" style="display:none; margin-left:6px;">Clear</button>
        </div>
      </div>

      <details class="faq-section">
        <summary style="font-weight:700; font-size:1rem;">FAQs</summary>
        <ul style="padding-left:1.1rem; color:#374151;">
          <li><b>Are passwords saved?</b> No â€” passwords are generated locally and not stored by this page.</li>
          <li><b>Is this secure?</b> Passwords are created using randomization; always keep them private.</li>
          <li><b>Can I copy to clipboard?</b> Yes â€” use the "Copy" button next to the generated password.</li>
        </ul>
      </details>
    </section>
  </main>

<script>
(function() {
  // Defensive helper
  function $id(id){ return document.getElementById(id); }

  function randInt(max) { return Math.floor(Math.random() * max); }
  function generatePassword(length, upper, lower, digits, symbols) {
    var low = 'abcdefghijklmnopqrstuvwxyz';
    var up = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    var nums = '0123456789';
    var syms = '!@#$%^&*()-_=+[]{};:,.<>?/|`~';
    var chars = '';
    if (lower) chars += low;
    if (upper) chars += up;
    if (digits) chars += nums;
    if (symbols) chars += syms;
    if (!chars) return '';
    var out = '';
    for (var i=0;i<length;i++) out += chars.charAt(randInt(chars.length));
    return out;
  }

  var genBtn = $id('generateBtn');
  var copyBtn = $id('copyBtn');
  var clearBtn = $id('clearBtn');
  var pwResult = $id('pwResult');

  function doGenerate() {
    var lengthEl = $id('pwLength');
    var upperEl = $id('pwUpper');
    var lowerEl = $id('pwLower');
    var digitsEl = $id('pwDigits');
    var symbolsEl = $id('pwSymbols');
    if (!lengthEl || !upperEl || !lowerEl || !digitsEl || !symbolsEl || !pwResult) return;
    var length = parseInt(lengthEl.value,10) || 16;
    length = Math.max(1, Math.min(128, length));
    var upper = upperEl.checked;
    var lower = lowerEl.checked;
    var digits = digitsEl.checked;
    var symbols = symbolsEl.checked;
    var pw = generatePassword(length, upper, lower, digits, symbols);
    pwResult.textContent = pw;
    if (pw) { copyBtn && (copyBtn.style.display='inline-block'); clearBtn && (clearBtn.style.display='inline-block'); } else { copyBtn && (copyBtn.style.display='none'); clearBtn && (clearBtn.style.display='none'); }
  }

  if (genBtn) genBtn.addEventListener('click', doGenerate);

  if (copyBtn) copyBtn.addEventListener('click', function() {
    var t = (pwResult && pwResult.textContent) || '';
    if (!t) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(t).then(function(){
        var old = copyBtn.textContent;
        copyBtn.textContent = old + ' âœ“';
        setTimeout(function(){ copyBtn.textContent = old; }, 1000);
      }, function(){ alert('Could not copy to clipboard.'); });
    } else {
      var ta = document.createElement('textarea');
      ta.value = t;
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch(e) { alert('Could not copy to clipboard.'); }
      document.body.removeChild(ta);
    }
  });

  if (clearBtn) clearBtn.addEventListener('click', function() {
    if (pwResult) pwResult.textContent = '';
    if (copyBtn) copyBtn.style.display = 'none';
    if (clearBtn) clearBtn.style.display = 'none';
  });

  // auto-generate on load (safe)
  if (genBtn) genBtn.click();
})();
</script>

