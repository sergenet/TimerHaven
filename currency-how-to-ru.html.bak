<script>
    // Safety rewrite: if any anchor on this page still points to the generic currency.html (from cached/old copy),
    // rewrite it immediately to the localized currency-ru.html so users return to the Russian converter.
    (function rewriteBackLinks() {
      try {
        document.querySelectorAll('a[href]').forEach(a => {
          const h = (a.getAttribute('href') || '').toLowerCase();
          if (h === 'currency.html' || h === '/currency.html' || h.endsWith('/currency.html')) {
            a.setAttribute('href', 'currency-ru.html');
            // Keep resolved href relative to origin
            a.href = location.origin + '/currency-ru.html';
          }
        });
      } catch (e) { /* ignore */ }
    })();

    // Robust go-back: prefer history.back() only when referrer is the localized currency page;
    // otherwise replace to the localized page (to avoid leaving an extra history entry).
    function goBackOrFallback(e) {
      try {
        const ref = (document.referrer || '').toLowerCase();
        const localized = '/currency-ru.html';
        if (ref && (ref.endsWith(localized) || ref.indexOf(location.origin + localized) === 0)) {
          e.preventDefault();
          window.history.back();
          return false;
        }
      } catch (err) {
        // ignore and fallback to replace below
      }
      try {
        e.preventDefault();
        window.location.replace('/currency-ru.html');
        return false;
      } catch (err) {
        return true;
      }
    }
  </script>
