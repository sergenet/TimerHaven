    const stopBtn = document.getElementById('stop-btn');
    if (playBtn) playBtn.textContent = t['play'] || 'Î‘Î½Î±Ï€Î±ÏÎ±Î³Ï‰Î³Î®';
    if (stopBtn) stopBtn.textContent = t['stop'] || 'Î”Î¹Î±ÎºÎ¿Ï€Î®';

    if (document.getElementById('faq-title')) document.getElementById('faq-title').textContent = t['faq-title'] || '';
    if (document.getElementById('faq-list')) document.getElementById('faq-list').innerHTML = t['faq-list'] || '';

    if (document.getElementById('howto-title')) document.getElementById('howto-title').innerHTML = t['howto-title'] || '';
    if (document.getElementById('howto-steps')) document.getElementById('howto-steps').innerHTML = t['howto-steps'] || '';
    if (document.getElementById('howto-article-btn')) { document.getElementById('howto-article-btn').textContent = t['howto-article-btn'] || ''; document.getElementById('howto-article-btn').href = t['howto-article-link'] || ''; }

    if (document.getElementById('tips-title')) document.getElementById('tips-title').innerHTML = t['tips-title'] || '';
    if (document.getElementById('tips-list')) document.getElementById('tips-list').innerHTML = t['tips-list'] || '';
    if (document.getElementById('tips-article-btn')) { document.getElementById('tips-article-btn').textContent = t['tips-article-btn'] || ''; document.getElementById('tips-article-btn').href = t['tips-article-link'] || ''; }
  }

  window.addEventListener('storage', function(e) {
    if (e.key === 'timerhavenLang') applyLanguage((e.newValue || 'el').slice(0,2));
  });

  function playMusic() {
    const sel = document.getElementById('music-select').value;
    const audio = document.getElementById('focus-audio');
    audio.src = tracks[sel];
    audio.loop = document.getElementById('music-loop').checked;
    audio.style.display = 'block';
    audio.load();
    audio.play().catch(()=>{});
  }
  function stopMusic() {
    const audio = document.getElementById('focus-audio');
    audio.pause();
    audio.currentTime = 0;
    audio.style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function() {
    applyLanguage(getLang());

    const playBtn = document.getElementById('play-btn');
    const stopBtn = document.getElementById('stop-btn');
    const loopCb = document.getElementById('music-loop');

    if (playBtn) playBtn.addEventListener('click', playMusic);
    if (stopBtn) stopBtn.addEventListener('click', stopMusic);
    if (loopCb) loopCb.addEventListener('change', function(){ document.getElementById('focus-audio').loop = this.checked; });

    // Safety: if option labels were empty due to local-file quirks, re-apply translations
    const ms = document.getElementById('music-select');
    if (ms && (!ms.options[0].text || ms.options[0].text.trim() === "")) applyLanguage(getLang());
  });
</script>
