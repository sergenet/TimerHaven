<!-- Replaced Apple icon with Pomodoro visuals -->
<h3><span class="pomodoro-emoji" aria-hidden="true">ðŸ…</span><i class="fa fa-stopwatch pomodoro-fa" aria-hidden="true"></i> Minuteur Pomodoro</h3>
<div aria-live="polite" class="pomodoro-section">
<div class="form-inline mb-2">
<label style="font-weight:600;">Travail (min):
              <input class="form-control" id="workLength" max="60" min="1" style="width:80px; margin-left:.3rem;" type="number" value="25"/>
</label>
<label style="font-weight:600;">Pause (min):
