          <li><b>ÎŸÎ¹ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ ÏƒÏ…Î³Ï‡ÏÎ¿Î½Î¯Î¶Î¿Î½Ï„Î±Î¹ ÏƒÎµ Î¬Î»Î»ÎµÏ‚ ÏƒÏ…ÏƒÎºÎµÏ…Î­Ï‚;</b> ÎŒÏ‡Î¹ Î±ÎºÏŒÎ¼Î· â€” Î¿Î¹ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î±Ï€Î¿Î¸Î·ÎºÎµÏÎ¿Î½Ï„Î±Î¹ Î±Î½Î¬ Ï€ÏÏŒÎ³ÏÎ±Î¼Î¼Î± Ï€ÎµÏÎ¹Î®Î³Î·ÏƒÎ·Ï‚. Î“Î¹Î± Ï€ÏÏŒÏƒÎ²Î±ÏƒÎ· Î±Ï€ÏŒ Ï€Î¿Î»Î»Î­Ï‚ ÏƒÏ…ÏƒÎºÎµÏ…Î­Ï‚, Ï‡ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÏ„Îµ Î¼Î¹Î± cloud ÎµÏ†Î±ÏÎ¼Î¿Î³Î®.</li>`,
        "howto-title": "<i class=\"fa fa-calendar-check\"></i> Î ÏŽÏ‚ Î½Î± Ï‡ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÎµÏ„Îµ Ï„Î¿ Î—Î¼ÎµÏÎ¿Î»ÏŒÎ³Î¹Î¿",
        "howto-steps": `<li><b>ÎšÎ¬Î½Ï„Îµ ÎºÎ»Î¹Îº ÏƒÎµ Î¼Î¹Î± Î·Î¼Î­ÏÎ±:</b> Î‘Î½Î¿Î¯Î¾Ï„Îµ Ï„Î¿ Ï€Î±ÏÎ¬Î¸Ï…ÏÎ¿ Î³Î¹Î± Î½Î± Ï€ÏÎ¿ÏƒÎ¸Î­ÏƒÎµÏ„Îµ/Î´ÎµÎ¯Ï„Îµ Ï€Î¿Î»Î»Î­Ï‚ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î±Î½Î¬ Î·Î¼Î­ÏÎ±.</li>
          <li><b>ÎŸÏÎ³Î±Î½ÏŽÏƒÏ„Îµ Ï„Î± Î³ÎµÎ³Î¿Î½ÏŒÏ„Î±:</b> ÎšÎ¬Î¸Îµ ÏƒÎ·Î¼ÎµÎ¯Ï‰ÏƒÎ· Î­Ï‡ÎµÎ¹ Ï‡ÏÎ¿Î½Î¿ÏƒÎ®Î¼Î±Î½ÏƒÎ· ÎºÎ±Î¹ Î¼Ï€Î¿ÏÎµÎ¯ Î½Î± Î´Î¹Î±Î³ÏÎ±Ï†ÎµÎ¯ Î¼ÎµÎ¼Î¿Î½Ï‰Î¼Î­Î½Î±.</li>
          <li><b>Î•Ï€Î¹Î¼Î¿Î½Î®:</b> ÎŸÎ¹ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î±Ï€Î¿Î¸Î·ÎºÎµÏÎ¿Î½Ï„Î±Î¹ ÏƒÏ„Î¿ Ï€ÏÏŒÎ³ÏÎ±Î¼Î¼Î± Ï€ÎµÏÎ¹Î®Î³Î·ÏƒÎ®Ï‚ ÏƒÎ±Ï‚ ÎºÎ±Î¹ Ï€Î±ÏÎ±Î¼Î­Î½Î¿Ï…Î½ Î¼Î­Ï‡ÏÎ¹ Î½Î± Ï„Î¹Ï‚ Î´Î¹Î±Î³ÏÎ¬ÏˆÎµÏ„Îµ.</li>`,
        "howto-article-btn": "Î”Î¹Î±Î²Î¬ÏƒÏ„Îµ Ï„Î¿ Ï€Î»Î®ÏÎµÏ‚ Î¬ÏÎ¸ÏÎ¿",
        "howto-article-link": "calendar-how-to-el.html",
        "tips-title": "<i class=\"fa fa-lightbulb\"></i> Î£Ï…Î¼Î²Î¿Ï…Î»Î­Ï‚",
        "tips-list": `<li><b>ÎšÏ‰Î´Î¹ÎºÎ¿Ï€Î¿Î¯Î·ÏƒÎ· Î¼Îµ Ï‡ÏÏŽÎ¼Î± Î³Î¹Î± Ï„Î¹Ï‚ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚:</b> Î§ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÏ„Îµ emoji Î® ÎµÏ„Î¹ÎºÎ­Ï„ÎµÏ‚ Î³Î¹Î± Î¿Ï€Ï„Î¹ÎºÎ® Î¿ÏÎ³Î¬Î½Ï‰ÏƒÎ·.</li>
          <li><b>Î•Î»Î­Î³Ï‡ÎµÏ„Îµ Ï„Î±ÎºÏ„Î¹ÎºÎ¬:</b> Î•Î»Î­Î³Î¾Ï„Îµ Ï„Î¹Ï‚ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ ÏƒÎ±Ï‚ ÎºÎ±Î¹ Î±Ï†Î±Î¹ÏÎ­ÏƒÏ„Îµ Ï€Î±Î»Î¹Î¬ ÏƒÏ…Î¼Î²Î¬Î½Ï„Î±.</li>
          <li><b>Î£Ï‡ÎµÎ´Î¹Î¬ÏƒÏ„Îµ ÎµÎº Ï„Ï‰Î½ Ï€ÏÎ¿Ï„Î­ÏÏ‰Î½:</b> Î ÏÎ¿ÏƒÎ¸Î­ÏƒÏ„Îµ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î³Î¹Î± Î¼ÎµÎ»Î»Î¿Î½Ï„Î¹ÎºÎ­Ï‚ Î·Î¼ÎµÏÎ¿Î¼Î·Î½Î¯ÎµÏ‚ Î³Î¹Î± Î½Î± ÎµÎ¯ÏƒÏ„Îµ Ï€ÏÎ¿ÎµÏ„Î¿Î¹Î¼Î±ÏƒÎ¼Î­Î½Î¿Î¹.</li>`,
        "tips-article-btn": "Î”Î¹Î±Î²Î¬ÏƒÏ„Îµ Ï„Î¿ Ï€Î»Î®ÏÎµÏ‚ Î¬ÏÎ¸ÏÎ¿",
        "tips-article-link": "calendar-tips-el.html",
        "tips-mobile-title": "<i class=\"fa fa-lightbulb\" style=\"color:#43cea2;\"></i> Î£Ï…Î¼Î²Î¿Ï…Î»Î­Ï‚",
        "tips-mobile-list": `<li><b>Î§ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÏ„Îµ ÎºÏ‰Î´Î¹ÎºÎ¿Ï€Î¿Î¯Î·ÏƒÎ· Ï‡ÏÏ‰Î¼Î¬Ï„Ï‰Î½:</b> Î§ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÏ„Îµ emoji Î® ÎµÏ„Î¹ÎºÎ­Ï„ÎµÏ‚ Î³Î¹Î± Î¿Ï€Ï„Î¹ÎºÎ® Î¿ÏÎ³Î¬Î½Ï‰ÏƒÎ·.</li>`,
        "noteModalLabel": "Î£Î·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î³Î¹Î±",
        "noteInput": "Î ÏÎ¿ÏƒÎ¸Î­ÏƒÏ„Îµ Î¼Î¹Î± Î½Î­Î± ÏƒÎ·Î¼ÎµÎ¯Ï‰ÏƒÎ· Î³Î¹Î± Î±Ï…Ï„Î®Î½ Ï„Î·Î½ Î·Î¼Î­ÏÎ±...",
        "note-none": "Î”ÎµÎ½ Ï…Ï€Î¬ÏÏ‡Î¿Ï…Î½ ÏƒÎ·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î³Î¹Î± Î±Ï…Ï„Î®Î½ Ï„Î·Î½ Î·Î¼Î­ÏÎ±.",
        "note-delete": "Î”Î¹Î±Î³ÏÎ±Ï†Î® Î±Ï…Ï„Î®Ï‚ Ï„Î·Ï‚ ÏƒÎ·Î¼ÎµÎ¯Ï‰ÏƒÎ·Ï‚",
        "note-close-btn": "ÎšÎ»ÎµÎ¯ÏƒÎ¹Î¼Î¿",
        "note-add-btn": "Î ÏÎ¿ÏƒÎ¸Î®ÎºÎ· ÏƒÎ·Î¼ÎµÎ¯Ï‰ÏƒÎ·Ï‚",
        "days": ["ÎšÏ…Ï","Î”ÎµÏ…","Î¤ÏÎ¹","Î¤ÎµÏ„","Î ÎµÎ¼","Î Î±Ï","Î£Î±Î²"]
      }
    };

    function updateLanguage(lang) {
      lang = lang || getLang();
      document.body.dir = (lang === "ar") ? "rtl" : "ltr";
      const t = translations[lang] || translations['en'];
      const elById = id => document.getElementById(id);
      if (elById("back-link")) elById("back-link").textContent = t["back-link"];
      if (elById("tool-title")) elById("tool-title").innerHTML = `<i class="fa fa-calendar-days"></i> ${t["tool-title"]}`;
      if (elById("tool-help")) elById("tool-help").textContent = t["tool-help"];
      if (elById("faq-title")) elById("faq-title").textContent = t["faq-title"];
      if (elById("faq-list")) elById("faq-list").innerHTML = t["faq-list"];
      if (elById("howto-title")) elById("howto-title").innerHTML = t["howto-title"];
      if (elById("howto-steps")) elById("howto-steps").innerHTML = t["howto-steps"];
      if (elById("howto-article-btn")) { elById("howto-article-btn").textContent = t["howto-article-btn"]; elById("howto-article-btn").href = t["howto-article-link"]; }

      if (elById("tips-title")) elById("tips-title").innerHTML = t["tips-title"] || "";
      if (elById("tips-list")) elById("tips-list").innerHTML = t["tips-list"] || "";
      if (elById("tips-article-btn")) { elById("tips-article-btn").textContent = t["tips-article-btn"] || ""; elById("tips-article-btn").href = t["tips-article-link"] || "#"; }
      if (elById("tips-mobile-title")) elById("tips-mobile-title").innerHTML = t["tips-mobile-title"] || "";
      if (elById("tips-mobile-list")) elById("tips-mobile-list").innerHTML = t["tips-mobile-list"] || "";

      if (elById("noteModalLabel")) elById("noteModalLabel").innerHTML = `${t["noteModalLabel"]} <span id="modal-date-label"></span>`;
      if (elById("noteInput")) elById("noteInput").placeholder = t["noteInput"];
      if (elById("note-close-btn")) elById("note-close-btn").textContent = t["note-close-btn"];
      if (elById("note-add-btn")) elById("note-add-btn").textContent = t["note-add-btn"];

      if (typeof currentYear === 'number' && typeof currentMonth === 'number') {
        renderCalendar(currentYear, currentMonth, lang);
      }
    }

    // Populate month/year controls
    function populateMonthYearControls(year, month, lang) {
      lang = lang || getLang();
      const monthSelect = document.getElementById('calendar-month-select');
      const yearSelect = document.getElementById('calendar-year-select');
      if (!monthSelect || !yearSelect) return;
      const locale = (lang === 'el') ? 'el-GR' : 'en-US';
      const mf = new Intl.DateTimeFormat(locale, { month: 'long' });
      monthSelect.innerHTML = '';
      for (let m=0; m<12; m++) {
        const opt = document.createElement('option');
        opt.value = String(m);
        opt.textContent = mf.format(new Date(2000,m,1));
        if (m === month) opt.selected = true;
        monthSelect.appendChild(opt);
      }
      const now = new Date();
      const base = now.getFullYear();
      const start = base - 50, end = base + 50;
      yearSelect.innerHTML = '';
      for (let y = start; y <= end; y++) {
        const opt = document.createElement('option');
        opt.value = String(y);
        opt.textContent = String(y);
        if (y === year) opt.selected = true;
        yearSelect.appendChild(opt);
      }
    }

    // Calendar renderer
    function renderCalendar(year, month, lang) {
      currentYear = year;
      currentMonth = month;
      lang = lang || getLang();
      const table = document.getElementById('calendar-table');
      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      let html = `<thead><tr>`;
      const dayNames = (translations[lang] && translations[lang]["days"]) ? translations[lang]["days"] : translations['en']["days"];
      dayNames.forEach(day => { html += `<th>${day}</th>`; });
      html += `</tr></thead><tbody><tr>`;

      for (let i = 0; i < firstDay; i++) html += `<td></td>`;

      const now = new Date();
      const todayYear = now.getFullYear();
      const todayMonth = now.getMonth();
      const todayDay = now.getDate();

      for (let d = 1; d <= daysInMonth; d++) {
        const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const dayNotes = notes[dateStr] || [];
        const hasNote = dayNotes.length > 0;
        if ((firstDay + d - 1) % 7 === 0 && d !== 1) html += `</tr><tr>`;
        const isToday = (d === todayDay && month === todayMonth && year === todayYear);
        /* Inline style forces table-cell behaviour even if external CSS overrides */
        html += `<td class="day-cell${hasNote ? ' has-note' : ''}${isToday ? ' calendar-today' : ''}" data-date="${dateStr}" style="display:table-cell !important; vertical-align:middle;">${d}${hasNote ? ' <span title="Î£Î·Î¼ÎµÎ¹ÏŽÏƒÎµÎ¹Ï‚ Î±Ï€Î¿Î¸Î·ÎºÎµÏÏ„Î·ÎºÎ±Î½">ðŸ“</span>' : ''}</td>`;
      }
      html += `</tr></tbody>`;
      table.innerHTML = html;

      // Ensure the month/year selects reflect the currently rendered calendar
      populateMonthYearControls(currentYear, currentMonth, lang);

      Array.from(document.getElementsByClassName('day-cell')).forEach(cell => {
        cell.addEventListener('click', function() {
          selectedDay = this.getAttribute('data-date');
          showNoteModal(selectedDay);
        });
      });
    }

    function showNoteModal(dateStr) {
      const modalDateLabel = document.getElementById('modal-date-label');
      if (modalDateLabel) modalDateLabel.textContent = dateStr;
      renderNoteList(dateStr);
      document.getElementById('noteInput').value = '';
      let modal = new bootstrap.Modal(document.getElementById('noteModal'));
      modal.show();
    }

    function renderNoteList(dateStr) {
      const list = document.getElementById('noteList');
      list.innerHTML = '';
      const lang = getLang();
      const dayNotes = notes[dateStr] || [];
      if (dayNotes.length === 0) {
        list.innerHTML = `<li style="color:#888;">${translations[lang]["note-none"] || translations['el']["note-none"]}</li>`;
        return;
      }
      dayNotes.forEach((note, idx) => {
        list.innerHTML += `
          <li>
            <span class="note-text">${escapeHtml(note.text)}</span>
            <span class="note-meta">${new Date(note.ts).toLocaleString()}</span>
            <button class="delete-note-btn" title="${translations[lang]["note-delete"] || translations['el']["note-delete"]}" onclick="deleteNote('${dateStr}',${idx})"><i class="fa fa-trash"></i></button>
          </li>
        `;
      });
    }

    function escapeHtml(s) {
      if (!s) return '';
      return s.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;');
    }

    document.getElementById('noteForm').addEventListener('submit', function(e) {
      e.preventDefault();
      if (!selectedDay) return;
      const text = document.getElementById('noteInput').value.trim();
      if (!text) return;
      if (!notes[selectedDay]) notes[selectedDay] = [];
      notes[selectedDay].push({ text, ts: Date.now() });
      localStorage.setItem('calendarNotes', JSON.stringify(notes));
      document.getElementById('noteInput').value = '';
      renderNoteList(selectedDay);
      renderCalendar(currentYear, currentMonth, getLang());
    });

    window.deleteNote = function(dateStr, idx) {
      if (!notes[dateStr]) return;
      notes[dateStr].splice(idx, 1);
      if (notes[dateStr].length === 0) delete notes[dateStr];
      localStorage.setItem('calendarNotes', JSON.stringify(notes));
      renderNoteList(dateStr);
      renderCalendar(currentYear, currentMonth, getLang());
    };

    // Hookup nav controls and select changes
    function hookupCalendarControls() {
      const prevYear=document.getElementById('nav-prev-year');
      const prevMonth=document.getElementById('nav-prev-month');
      const nextMonth=document.getElementById('nav-next-month');
      const nextYear=document.getElementById('nav-next-year');
      const todayBtn=document.getElementById('nav-today');

      prevYear && prevYear.addEventListener('click', ()=> renderCalendar(currentYear-1, currentMonth, getLang()));
      nextYear && nextYear.addEventListener('click', ()=> renderCalendar(currentYear+1, currentMonth, getLang()));
      prevMonth && prevMonth.addEventListener('click', ()=> { let y=currentYear,m=currentMonth-1; if(m<0){m=11;y--;} renderCalendar(y,m,getLang()); });
      nextMonth && nextMonth.addEventListener('click', ()=> { let y=currentYear,m=currentMonth+1; if(m>11){m=0;y++;} renderCalendar(y,m,getLang()); });
      todayBtn && todayBtn.addEventListener('click', ()=> { const n=new Date(); renderCalendar(n.getFullYear(), n.getMonth(), getLang()); });

      const mSel=document.getElementById('calendar-month-select');
      const ySel=document.getElementById('calendar-year-select');
      if(mSel && ySel){
        mSel.addEventListener('change', ()=> renderCalendar(parseInt(ySel.value,10), parseInt(mSel.value,10), getLang()));
        ySel.addEventListener('change', ()=> renderCalendar(parseInt(ySel.value,10), parseInt(mSel.value,10), getLang()));
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const now = new Date();
      currentYear = now.getFullYear();
      currentMonth = now.getMonth();

      updateLanguage(getLang());
      populateMonthYearControls(currentYear, currentMonth, getLang());
      hookupCalendarControls();
      renderCalendar(currentYear, currentMonth, getLang());
    });
  </script>

