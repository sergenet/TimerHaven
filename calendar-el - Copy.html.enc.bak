      justify-content: center;
      align-items: center;
      min-height: 90vh;
    }
    .center-row {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: stretch;
      gap: 2em;
      width: 100%;
    }
    .article-card, .tool-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 2px 12px #e0e7ef;
      width: 340px;
      min-width: 220px;
      max-width: 340px;
      flex: 1 1 340px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      padding: 2em 1.3em 1em 1.3em;
      margin: 0;
      box-sizing: border-box;
      min-height: 500px;
    }
    .tool-card { max-width: 640px; min-width: 320px; }
    .article-card h2, .tool-card h3 { font-size: 1.35em; font-weight: 700; margin-bottom: 0.4em; display:flex; align-items:center; gap:0.3em; }
    .calendar-table { width:100%; margin-top:1em; border-collapse:separate; border-spacing:0; background:#fff; border-radius:8px; overflow:hidden; table-layout: fixed; }
    .calendar-table th, .calendar-table td { text-align:center; padding:0.6em 0.7em; min-width:36px; max-width:40px; vertical-align:middle; }
    .day-cell { cursor:pointer; border-radius:6px; transition: background 0.1s; display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; margin:0 auto; }
    .day-cell:hover { background:#e0e7ef; }
    .has-note { background:#ffeeba !important; }
    .calendar-today { background:#43cea2 !important; color:#fff !important; border-radius:50% !important; font-weight:bold; box-shadow:0 0 6px #185a9d33; }
    .modal-header { background:#f4f7fb; }
    .modal-footer { background:#f7fafc; }
    .note-list { list-style:none; padding:0; margin-bottom:1em; }
    .note-list li { background:#f7fafc; border-radius:6px; margin-bottom:0.5em; padding:0.5em 0.8em; display:flex; align-items:center; justify-content:space-between; }
    .note-text { word-break:break-word; flex-grow:1; }
    .note-meta { font-size:0.85em; color:#888; margin-right:1em; }
    .delete-note-btn { font-size:0.9em; color:#c00; background:none; border:none; cursor:pointer; }

    /* Header controls: nav + month/year on one line (desktop) */
    .calendar-header { display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-bottom:.6rem; flex-wrap:nowrap; }
    .calendar-nav { display:flex; gap:.25rem; align-items:center; flex-shrink:0; }
    /* Slightly reduced height to make the controls tighter */
    .calendar-nav .btn { min-width:40px; padding:.22rem .45rem; height:34px; line-height:1; display:inline-flex; align-items:center; justify-content:center; }
    .calendar-select { border-radius:8px; padding:.14rem .35rem; border:1px solid #e4edf5; background:#fff; font-size:.9rem; height:34px; line-height:1; display:inline-block; vertical-align:middle; box-sizing:border-box; -webkit-appearance:none; appearance:none; }
    /* Narrower to ensure both selects fit inside the tool card */
