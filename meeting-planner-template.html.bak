<!DOCTYPE html>
<html lang="{lang}"{dir}>
<head>
  <meta charset="UTF-8">
  <title>{tool_title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{tool_desc}">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    body {{ background: #f4f7fb; font-family: 'Montserrat', Arial, sans-serif; }}
    .main-container {{ max-width: 1200px; margin: 2em auto; display: flex; justify-content: center; align-items: center; min-height: 90vh; }}
    .center-row {{ display: flex; flex-direction: row; justify-content: center; align-items: stretch; gap: 2em; width: 100%; }}
    .tool-card {{
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 2px 12px #e0e7ef;
      min-width: 220px;
      max-width: 340px;
      width: 340px;
      min-height: 500px;
      flex: 1 1 340px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      padding: 2em 1.3em 1em 1.3em;
      margin: 0;
      box-sizing: border-box;
      text-align: left;
      overflow: hidden;
    }}
    .back-link {{ display: inline-block; margin-bottom: 1em; color: #007bff; text-decoration: none; font-weight: bold; font-size: 1em; }}
    .back-link:hover {{ text-decoration: underline; }}
    .faq-section {{ margin-top: 1.1em; margin-bottom: 0.3em; font-size: 1em; background: #f7fafc; border-radius: 8px; padding: 1em; box-shadow: 0 1px 4px #e0e7ef; }}
    .faq-section summary {{ font-weight: bold; font-size: 1.07em; cursor: pointer; margin-bottom: 0.5em; }}
    .language-selector-row {{ margin-bottom: 1em; }}
  </style>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <div class="main-container">
    <div class="center-row">
      <div class="tool-card">
        <div class="language-selector-row">
          <label for="languageSelector">{label_language}</label>
          <select id="languageSelector" class="form-select" onchange="onLanguageChange()">
            {language_options}
          </select>
        </div>
        <a href="index.html" class="back-link"><i class="fa fa-arrow-left"></i> {back_menu}</a>
        <h3><i class="fa fa-users"></i> {tool_title}</h3>
        <form id="meetingForm">
          <div class="meeting-form-row">
            <label for="participantName">{label_name}</label>
            <input type="text" id="participantName" class="form-control" placeholder="{placeholder_name}" autocomplete="off">
          </div>
          <div class="meeting-form-row">
            <label for="participantCity">{label_city}</label>
            <select id="participantCity" class="form-select" autocomplete="off">
              <option value="" disabled selected>{placeholder_city}</option>
              {city_options}
            </select>
          </div>
          <button type="button" class="btn btn-success btn-participant" id="addParticipant"><i class="fa fa-plus"></i> {button_add}</button>
        </form>
        <div class="participant-list" id="participantList"></div>
        <div class="meeting-form-row">
          <label for="meetingDate">{label_date}</label>
          <input type="date" id="meetingDate" class="form-control">
        </div>
        <div class="meeting-form-row">
          <label for="meetingTime">{label_time}</label>
          <input type="time" id="meetingTime" class="form-control">
          <button type="button" class="btn btn-primary btn-sm" style="margin-top:0.6em;" id="calcTimes"><i class="fa fa-clock"></i> {button_show_times}</button>
        </div>
        <div>
          <div id="meetingTimes"></div>
        </div>
        <details class="faq-section">
          <summary>{faq_title}</summary>
          <ul style="padding-left: 1em;">
            {faqs}
          </ul>
        </details>
      </div>
    </div>
  </div>
  <script>
    function onLanguageChange() {{
      var lang = document.getElementById("languageSelector").value;
      window.location.href = "meeting-planner-" + lang + ".html";
    }}
  </script>
</body>
</html>

