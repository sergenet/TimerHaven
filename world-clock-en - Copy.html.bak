<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>World Clock â€” TimerHaven</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="See the time anywhere in the world, instantly.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.min.css" />
  <link rel="canonical" href="https://timerhaven.com/world-clock-en.html" />
  <script src="https://cdn.jsdelivr.net/npm/luxon@3.4.3/build/global/luxon.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.min.js"></script>

  <style>
    body { background:#f4f7fb; font-family: 'Montserrat', Arial, sans-serif; color:#0b2545; margin:0; }
    .main-container { max-width:1200px; margin:2.4rem auto; padding:0 1rem; box-sizing:border-box; min-height:90vh; display:flex; justify-content:center; align-items:flex-start; }
    .tool-card { background:#fff; border-radius:18px; box-shadow:0 6px 20px rgba(11,37,69,0.06); width:420px; padding:1.6rem 1.5rem; box-sizing:border-box; }
    .back-link { color:var(--brand,#0d6efd) !important; display:inline-block; margin-bottom:.6rem; text-decoration:none; font-weight:700; }
    .tool-title { color:#185a9d; font-size:1.35rem; margin:0 0 .6rem 0; display:flex; align-items:center; gap:.5rem; }
    .read-guide { display:inline-block; margin:.35rem 0 .8rem 0; padding:.45rem .7rem; border-radius:8px; background:var(--brand,#0d6efd); color:#fff; text-decoration:none; font-weight:700; font-size:.95rem; border:none; }
    .clock-form { display:flex; gap:.5rem; flex-direction:column; }
    .clock-item { background:#f7fafc; border-radius:8px; padding:.8rem; margin-bottom:.6rem; display:flex; align-items:center; justify-content:space-between; }
    .faq-section { margin-top:1rem; background:#f7fafc; border-radius:8px; padding:1rem; box-shadow:0 1px 4px #e0e7ef; }
    @media (max-width:900px) { .tool-card{ width:98vw; padding:1rem; } }
  </style>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <main class="main-container" role="main">
    <section class="tool-card" aria-labelledby="tool-title">
      <a href="index.html" class="back-link">&larr; Back to Main Menu</a>

      <h3 id="tool-title" class="tool-title"><i class="fa fa-globe"></i> World Clock</h3>

      <a id="read-guide-btn" class="read-guide" href="world-how-to-en.html" role="button">Read full guide</a>

      <p class="lead" style="margin:0 0 .8rem 0; color:#6b7280;">See the time anywhere in the world, instantly.</p>

      <form class="clock-form" id="clockForm" onsubmit="return false;">
        <select id="cityDropdown" class="form-select city-dropdown" aria-label="Select a popular city">
          <option value="">Select city...</option>
        </select>

        <input type="text" id="cityInput" class="form-control awesomplete" placeholder="Or enter city or IANA time zone (e.g. London, America/Denver, GMT+2)" autocomplete="off">

        <div style="display:flex; gap:.6rem; margin-top:.5rem;">
          <button id="addClockBtn" class="btn btn-success btn-sm" type="button">Add Clock</button>
          <button id="clearClocksBtn" class="btn btn-outline-secondary btn-sm" type="button">Clear All</button>
        </div>
      </form>

      <div id="errorMsg" style="color:#b00;margin-top:.6rem;"></div>
      <div id="clockList" style="margin-top:.8rem;"></div>

      <details class="faq-section" style="margin-top:1rem;">
        <summary style="font-weight:700; font-size:1rem;">FAQs</summary>
        <ul style="padding-left:1.1rem; color:#374151;">
          <li><b>Add a city:</b> Use the dropdown for popular cities or start typing any city name.</li>
          <li><b>Compare times:</b> Add multiple clocks to compare zones.</li>
          <li><b>Remove:</b> Click the Remove button to delete a city from your list.</li>
          <li>Full list of time zones: <a href="https://en.wikipedia.org/wiki/List_of_tz_database_time_zones" target="_blank" rel="noopener">See here</a></li>
        </ul>
      </details>
    </section>
  </main>

  <script>
    // Clock logic adapted from the original; keeps behavior and localStorage persistence
    const { DateTime } = luxon;
    let cityList = [];
    let cityToZone = {};
    let cityNames = [];
    let awesompleteInstance;

    // Try to load world-cities.json if available (server should provide it). Fallback: a small sample.
    (function loadCities() {
      fetch('world-cities.json').then(r => r.json()).then(data => {
        initCityData(data);
      }).catch(() => {
        // fallback sample list if world-cities.json not found
        const sample = [
          { name: 'London', timezone: 'Europe/London' },
          { name: 'New York', timezone: 'America/New_York' },
          { name: 'Tokyo', timezone: 'Asia/Tokyo' },
          { name: 'Sydney', timezone: 'Australia/Sydney' },
          { name: 'Paris', timezone: 'Europe/Paris' },
          { name: 'Los Angeles', timezone: 'America/Los_Angeles' },
          { name: 'Dubai', timezone: 'Asia/Dubai' },
          { name: 'Moscow', timezone: 'Europe/Moscow' },
          { name: 'Beijing', timezone: 'Asia/Shanghai' }
        ];
        initCityData(sample);
      });

      function initCityData(data) {
        cityList = data;
        cityToZone = {};
        cityNames = [];
        const dropdown = document.getElementById('cityDropdown');
        dropdown.innerHTML = '<option value="">Select city...</option>';
        data.forEach(city => {
          cityToZone[city.name.toLowerCase()] = city.timezone;
          cityNames.push(city.name);
          const opt = document.createElement('option');
          opt.value = city.timezone;
          opt.textContent = city.name;
          dropdown.appendChild(opt);
        });
        const input = document.getElementById('cityInput');
        awesompleteInstance = new Awesomplete(input, { list: cityNames, minChars: 1, maxItems: 12, autoFirst: true });
      }
    })();

    let clocks = JSON.parse(localStorage.getItem('worldClocks') || '[]');
    function saveClocks() { localStorage.setItem('worldClocks', JSON.stringify(clocks)); }
    function renderClocks() {
      const list = document.getElementById('clockList');
      list.innerHTML = '';
      if (!clocks || clocks.length === 0) {
        list.innerHTML = '<div style="color:#888;">No clocks added yet.</div>';
        return;
      }
      clocks.forEach((clock, idx) => {
        let timeStr = '...';
        let error = false;
        try {
          let now = DateTime.now().setZone(clock.tz);
          if (!now.isValid) throw new Error('Invalid zone');
          timeStr = now.toFormat('cccc, dd LLL yyyy<br>HH:mm:ss');
        } catch {
          timeStr = 'Invalid time zone';
          error = true;
        }
        const div = document.createElement('div');
        div.className = 'clock-item';
        div.innerHTML = `
          <div style="min-width:0;">
            <div style="font-weight:700;">${escapeHtml(clock.label)}</div>
            <div style="font-size:.95rem;color:#444;">${timeStr}${error ? ' <span style="color:#b00;">(check spelling or use IANA zone)</span>' : ''}</div>
          </div>
          <div style="display:flex;gap:.5rem;">
            <button class="btn btn-outline-danger btn-sm" onclick="deleteClock(${idx})" aria-label="Remove clock"><i class="fa fa-trash"></i></button>
          </div>
        `;
        list.appendChild(div);
      });
    }

    function normalizeInput(input) { return input.trim().toLowerCase().replace(/[\s\-_]+/g, ' '); }
    function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

    function addClock(label, tz) {
      clocks.push({ label, tz });
      saveClocks();
      renderClocks();
    }

    document.getElementById('addClockBtn').addEventListener('click', function() {
      document.getElementById('errorMsg').textContent = '';
      const cityInput = document.getElementById('cityInput').value.trim();
      const dropdownVal = document.getElementById('cityDropdown').value;
      let label = '', zone = '';
      if (dropdownVal) {
        label = document.getElementById('cityDropdown').options[document.getElementById('cityDropdown').selectedIndex].text;
        zone = dropdownVal;
      } else if (cityInput) {
        label = cityInput;
        // allow raw IANA zone input like "Europe/London"
        if (/^[A-Za-z]+\/[A-Za-z_]+$/.test(cityInput)) {
          zone = cityInput;
        } else {
          const norm = normalizeInput(cityInput);
          if (cityToZone[norm]) zone = cityToZone[norm];
          else {
            document.getElementById('errorMsg').innerHTML = 'City not recognized. Try the dropdown, autocomplete, or enter a valid IANA time zone (e.g. Europe/London). <a href="https://en.wikipedia.org/wiki/List_of_tz_database_time_zones" target="_blank" rel="noopener">Full list here</a>.';
            return;
          }
        }
      } else {
        document.getElementById('errorMsg').textContent = 'Please select or enter a city or time zone.';
        return;
      }
      addClock(label, zone);
      document.getElementById('cityInput').value = '';
      document.getElementById('cityDropdown').selectedIndex = 0;
    });

    document.getElementById('clearClocksBtn').addEventListener('click', function() {
      if (!clocks || clocks.length === 0) return;
      if (!confirm('Clear all clocks?')) return;
      clocks = [];
      saveClocks();
      renderClocks();
    });

    window.deleteClock = function(idx) {
      clocks.splice(idx,1);
      saveClocks();
      renderClocks();
    };

    // update every second
    setInterval(renderClocks, 1000);
    renderClocks();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js"></script>
</body>
</html>

