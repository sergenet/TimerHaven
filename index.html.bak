  <link rel="alternate" href="https://timerhaven.com/ar/" hreflang="ar" />
  <link rel="alternate" href="https://timerhaven.com/" hreflang="x-default" />

  <!-- Optional: theme color for mobile UI -->
  <meta name="theme-color" content="#185a9d">

  <!-- Performance & Fonts (only once) -->
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;400&display=swap" as="style">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;400&display=swap" rel="stylesheet">

