      <section id="ics" class="section">
        <h2>ICSâ€‘Vorlage</h2>
        <p class="muted">ICS herunterladen und in Kalender importieren.</p>
        <p><a href="#" id="downloadIcs" class="cta">ICSâ€‘Vorlage herunterladen</a></p>
        <pre id="icsTemplate" class="template" aria-hidden="true">BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//TimerHaven//Pomodoro Block Template//DE
BEGIN:VEVENT
UID:{{UID}}
DTSTAMP:{{UTC_NOW}}
DTSTART:{{START_UTC}}
DTEND:{{END_UTC}}
SUMMARY:Pomodoro Focus â€” [Ziel]
DESCRIPTION:Checklist:
- Punkt 1
- Punkt 2
Notes: Notizâ€‘URL/ID hier einfÃ¼gen.
STATUS:BUSY
END:VEVENT
END:VCALENDAR</pre>

        <script>
          document.getElementById('downloadIcs').addEventListener('click', function(e){
            e.preventDefault();
            var template = document.getElementById('icsTemplate').textContent;
            var now = new Date();
            var uid = 'ph-' + Math.floor(Math.random()*900000+100000) + '@timerhaven.com';
            var stamp = now.toISOString().replace(/[-:]/g,'').split('.')[0] + 'Z';
            var content = template.replace('{{UID}}', uid).replace('{{UTC_NOW}}', stamp).replace('{{START_UTC}}','20251110T090000Z').replace('{{END_UTC}}','20251110T103000Z');
            var blob = new Blob([content], {type:'text/calendar;charset=utf-8'});
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'pomodoro-block-template.ics';
            document.body.appendChild(a);
            a.click();
            setTimeout(function(){ URL.revokeObjectURL(url); a.remove(); }, 150);
          });
        </script>
      </section>

