        <script>
          document.getElementById('downloadPomodoro').addEventListener('click', function(e){
            e.preventDefault();
            var text = document.getElementById('pomTemplate').textContent;
            var blob = new Blob([text], {type:'text/plain;charset=utf-8'});
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'pomodoro-session-template-de.txt';
            document.body.appendChild(a);
            a.click();
            setTimeout(function(){ URL.revokeObjectURL(url); a.remove(); }, 150);
          });
        </script>
