# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Ignore log files
*.log

# Ignore node dependencies
node_modules/
**/node_modules/

# Ignore environment files
.env
.env.*
.env.txt
*.key
TH_KEY.txt
**/*credentials*

# Ignore PHP sessions and cache
*.session
*.cache
__pycache__/
*.pyc

# Ignore other backup files
*~
*.bak
*.orig

# Build output and tool caches (generated, never edited by hand)
_site/
.expo/
.caret/
.cache/

# Credentials that live on the server (or in the environment) only\.
api/secrets.local.php
scripts/_secrets.py

# Local scratch: retired pages, sitemap downloads, deploy artefacts
_attic/
_live_sm.xml
_remote*
_preview*
