      "faq-list": `<li><b>هل يمكن تكرار المقطع؟</b> نعم، استخدم التكرار أو أدوات الصوت.</li>
      <li><b>هل يعمل بدون إنترنت؟</b> لا، تُبث الموسيقى من الخادم.</li>
      <li><b>هل يمكن إضافة موسيقاك؟</b> ليس بعد—أخبرنا إذا رغبت بذلك!</li>`,
      "howto-title": '<i class="fa fa-music"></i> كيفية استخدام موسيقى التركيز',
      "howto-steps": `<li><b>اختر قائمة تشغيل:</b> موسيقى للتركيز أو الاسترخاء.</li>
      <li><b>شغل وعدل الصوت:</b> استخدم أدوات التحكم.</li>
      <li><b>غيّر المقطوعات:</b> جرب أنماطًا مختلفة للتركيز الأفضل.</li>`,
      "howto-article-btn": "اقرأ المقال الكامل",
      "howto-article-link": "focus-music-how-to-ar.html",
      "tips-title": '<i class="fa fa-lightbulb" style="color:#43cea2;"></i> نصائح لموسيقى التركيز',
      "tips-list": `<li><b>جرب الأنواع المختلفة:</b> قوائم تشغيل متنوعة لكل مهمة.</li>
      <li><b>استخدم سماعات الرأس:</b> احجب المشتتات.</li>
      <li><b>حافظ على انخفاض الصوت:</b> لمزيد من التركيز.</li>`,
      "tips-article-btn": "اقرأ المقال الكامل",
      "tips-article-link": "focus-music-tips-ar.html"
    }
  };

  const langNames = { en: "English", fr: "Français", de: "Deutsch", ru: "Русский", el: "Ελληνικά", es: "Español", ar: "العربية" };

  function getLang() {
    try {
      const l = localStorage.getItem('timerhavenLang') || 'fr';
      return (l && l.slice(0,2)) || 'fr';
    } catch (e) {
      return 'fr';
    }
  }

  function applyLanguage(lang) {
    lang = (lang || getLang()).slice(0,2);
    const t = focusMusicTranslations[lang] || focusMusicTranslations['fr'];
    document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';
    if (document.getElementById('back-link')) document.getElementById('back-link').textContent = t['back-link'] || '';
    if (document.getElementById('tool-title')) document.getElementById('tool-title').innerHTML = `<i class="fa fa-music"></i> ${t['tool-title'] || ''}`;
    if (document.getElementById('tool-help')) document.getElementById('tool-help').textContent = t['tool-help'] || '';
    const musicLabel = document.getElementById('music-label');
    if (musicLabel) musicLabel.textContent = t['music-label'] || '';
    const ms = document.getElementById('music-select');
    if (ms && ms.options) {
      ms.options[0].text = t['music-white'] || 'Bruit blanc';
      ms.options[1].text = t['music-rain'] || 'Pluie';
      ms.options[2].text = t['music-alpha'] || 'Ondes alpha';
      ms.options[3].text = t['music-classical'] || 'Classique';
      ms.options[4].text = t['music-ocean'] || 'Vagues de l\'océan';
      ms.options[5].text = t['music-cafe'] || 'Ambiance café';
    }
    const loopText = document.getElementById('loop-label-text');
    if (loopText) loopText.textContent = t['loop-label'] || 'Boucler le morceau';
    const playBtn = document.getElementById('play-btn');
    const stopBtn = document.getElementById('stop-btn');
    if (playBtn) playBtn.textContent = t['play'] || 'Lecture';
    if (stopBtn) stopBtn.textContent = t['stop'] || 'Arrêter';
    const faqTitle = document.getElementById('faq-title');
    if (faqTitle) faqTitle.textContent = t['faq-title'] || '';
    const faqList = document.getElementById('faq-list');
    if (faqList) faqList.innerHTML = t['faq-list'] || '';
    const howtoTitle = document.getElementById('howto-title');
    const howtoSteps = document.getElementById('howto-steps');
    if (howtoTitle) howtoTitle.innerHTML = t['howto-title'] || '';
    if (howtoSteps) howtoSteps.innerHTML = t['howto-steps'] || '';
    const howtoBtn = document.getElementById('howto-article-btn');
    if (howtoBtn) { howtoBtn.textContent = t['howto-article-btn'] || ''; howtoBtn.href = t['howto-article-link'] || ''; }
    const tipsTitle = document.getElementById('tips-title');
    const tipsList = document.getElementById('tips-list');
    const tipsBtn = document.getElementById('tips-article-btn');
    if (tipsTitle) tipsTitle.innerHTML = t['tips-title'] || '';
    if (tipsList) tipsList.innerHTML = t['tips-list'] || '';
    if (tipsBtn) { tipsBtn.textContent = t['tips-article-btn'] || ''; tipsBtn.href = t['tips-article-link'] || ''; }
  }

  window.addEventListener('storage', function(e) {
    if (e.key === 'timerhavenLang') applyLanguage((e.newValue || 'fr').slice(0,2));
  });

  function playMusic() {
    const sel = document.getElementById("music-select").value;
    const audio = document.getElementById("focus-audio");
    audio.src = tracks[sel];
    audio.loop = document.getElementById("music-loop").checked;
    audio.style.display = "block";
    audio.load();
    audio.play().catch(()=>{});
  }
  function stopMusic() {
    const audio = document.getElementById("focus-audio");
    audio.pause();
    audio.currentTime = 0;
    audio.style.display = "none";
  }

  document.addEventListener('DOMContentLoaded', function() {
    applyLanguage(getLang());
    const playBtn = document.getElementById('play-btn');
    const stopBtn = document.getElementById('stop-btn');
    const loopCb = document.getElementById('music-loop');
    if (playBtn) playBtn.addEventListener('click', playMusic);
    if (stopBtn) stopBtn.addEventListener('click', stopMusic);
    if (loopCb) loopCb.addEventListener('change', function() {
      document.getElementById("focus-audio").loop = this.checked;
    });
  });
</script>
