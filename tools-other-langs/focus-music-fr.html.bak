<!-- Force French for local-file testing -->
<script>try{ localStorage.setItem('timerhavenLang','fr'); }catch(e){}</script>
<div class="main-container">
<div class="center-row">
<div class="article-card">
<div>
<h2 id="howto-title"></h2>
<ol id="howto-steps"></ol>
</div>
<a class="btn btn-outline-primary btn-sm" href="#" id="howto-article-btn"></a>
</div>
<div class="tool-card">
<a class="back-link" href="index.html" id="back-link"></a>
<h3 id="tool-title"></h3><p style="margin-top:1rem;"><a class="read-guide cta" href="/fr/focus-music/focus-music-index.html" rel="noopener" target="_blank">Lire le guide complet</a></p>
<div class="help-section" id="tool-help"></div>
<div class="music-player">
<label for="music-select" id="music-label"></label>
<select class="form-select mb-2" id="music-select">
<option value="white"></option>
<option value="rain"></option>
<option value="alpha"></option>
<option value="classical"></option>
<option value="ocean"></option>
<option value="cafe"></option>
</select>
<label for="music-loop" id="loop-label">
<input id="music-loop" type="checkbox"/>
<span id="loop-label-text"></span>
</label>
</div>
<button class="btn btn-primary w-100 mb-2" id="play-btn">Lecture</button>
<button class="btn btn-danger w-100 mb-2" id="stop-btn">Arrêter</button>
<audio controls="" id="focus-audio" style="display:none;"></audio>
<details class="faq-section mt-2">
<summary id="faq-title">Foire aux questions</summary>
<ul id="faq-list" style="padding-left: 1em;"></ul>
</details>
</div>
<div class="article-card">
<div>
<h2 id="tips-title"></h2>
<ul id="tips-list"></ul>
</div>
<a class="btn btn-outline-primary btn-sm" href="#" id="tips-article-btn"></a>
</div>
</div>
</div>
