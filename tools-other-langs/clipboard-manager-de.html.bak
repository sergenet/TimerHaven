<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8"/>
<title>Clipboard Manager — TimerHaven (de)</title>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<meta content="Save, manage, and organize multiple clipboard snippets." name="description"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet"/>
<style>
    :root { --card-bg: #fff; --page-bg: #f4f7fb; --accent: #185a9d; --accent-2: #43cea2; }
    html,body { height: 100%; margin: 0; }
    body { background: var(--page-bg); font-family: 'Montserrat', Arial, sans-serif; color: #1f2937; }

    /* Defensive: hide any language indicator injected by other templates */
    .language-indicator { display: none !important; visibility: hidden !important; opacity: 0 !important; height: 0 !important; width: 0 !important; }

    /* Layout: make columns flex containers so inner cards can stretch to equal height */
    .main-container { max-width: 1200px; margin: 1.5em auto; padding: 0 12px; box-sizing: border-box; display:flex; justify-content:center; align-items:stretch; min-height:70vh; }
    .center-row { display:flex; gap:1.5em; width:100%; align-items:stretch; justify-content:center; }
    .center-row > .col { display:flex; flex-direction:column; flex:1 1 0; min-width:220px; }

    .article-card, .tool-card {
      background: var(--card-bg);
      border-radius: 16px;
      box-shadow: 0 2px 12px #e0e7ef;
      width: 100%;
      display:flex;
      flex-direction:column;
      padding: 1.6em;
      box-sizing: border-box;
      text-align:left;
      height: 100%; /* stretch to column height */
      overflow: visible;
    }

    .article-card h2, .tool-card h3 { font-weight:700; color:var(--accent); margin-bottom:.5em; display:flex; align-items:center; gap:.4em; }
    .article-card .btn, .tool-card .btn { margin-top:.6em; border-radius:8px; font-weight:600; }
    .clips-section { margin-top:6px; display:flex; flex-direction:column; flex:1 1 auto; }
    .clips-form { display:flex; gap:.5em; align-items:center; margin-bottom:.6em; }
    .clips-form input[type="text"] { flex:1 1 180px; min-width:0; }
    .clips-list { margin-top:.6em; max-height:260px; overflow-y:auto; padding-right:6px; }
    .clip-item { background:#f7fafc; border-radius:8px; padding:10px; margin-bottom:8px; display:flex; align-items:center; gap:.8em; }
    .clip-text { flex:1; word-break:break-word; }
    .faq-section { margin-top:1em; background:#f7fafc; border-radius:8px; padding:.8em; }
    details[open] summary::after { content: " ▲"; }
    details summary::after { content: " ▼"; }
    .back-link { color:var(--accent); font-weight:700; text-decoration:none; display:inline-block; margin-bottom:.6em; }
    .back-link i { margin-right:.35em; }

    footer { text-align:center; color:#666; padding:1.2rem 0; font-size:.9rem; }

    @media (max-width:900px) {
      .main-container { padding: 0 8px; margin: 12px auto; }
      .center-row { flex-direction: column; gap:12px; align-items:stretch; }
      .center-row > .col { min-width:auto; }
      .article-card, .tool-card { width:100%; max-width:680px; }
    }
  </style>
<style>
/* timerhaven: enforce single-card layout and CTA */
.main-container {
  max-width: 520px !important;
  margin: 2rem auto !important;
  padding: 0 12px !important;
  box-sizing: border-box;
}
.center-row {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  gap: 0 !important;
}
.tool-card, .article-card {
  background: #fff !important;
  border-radius: 16px !important;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06) !important;
  width: 100% !important;
  max-width: 520px !important;
  padding: 1.6rem 1.3rem !important;
  box-sizing: border-box !important;
  margin: 0 0 1.2rem 0 !important;
}
.article-card {
  display: none !important;
}
.read-guide {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: .35rem 0 .8rem 0 !important;
  padding: .45rem .9rem !important;
  border-radius: 8px !important;
  background: #007bff !important;
  color: #fff !important;
  text-decoration: none !important;
  font-weight: 700 !important;
  font-size: .95rem !important;
  border: none !important;
  box-sizing: border-box !important;
  box-shadow: 0 2px 6px rgba(0,0,0,0.06) !important;
}
.read-guide:hover { filter: brightness(.95); text-decoration: none; }
@media (max-width: 800px) {
  .main-container { padding: 0 8px !important; }
  .tool-card { max-width: 97vw !important; }
}
</style><style>/* timerhaven: backlink color */
.back-link {
  color: #0d6efd !important;
  font-weight: 700 !important;
  text-decoration: none !important;
}
.back-link:hover { text-decoration: underline !important; }
</style></head>
<body>
<!-- language selector removed -->
<div class="main-container" id="page-main">
<div class="center-row">
<div class="col">
<article class="article-card" id="left-article">
<div style="display:flex;flex-direction:column;flex:1 1 auto;">
<header style="flex:1 1 auto;">
<h2><i class="fa fa-clipboard"></i> So nutzt du den Zwischenablage-Manager</h2>
<ol>
<li><b>Notiz hinzufügen:</b> Text eingeben/einfügen und <b>Hinzufügen</b> klicken. Die Notiz erscheint unten.</li>
<li><b>Notiz kopieren:</b> Klicke auf <b>Kopieren</b> neben dem Clip.</li>
<li><b>Notiz entfernen:</b> Klicke auf <b>Entfernen</b>.</li>
<li><b>Notizen sind gespeichert:</b> Bleiben im Browser, auch nach dem Schließen.</li>
</ol>
</header>
</div>
</article>
</div>
<div class="col">
<section aria-labelledby="tool-title" class="tool-card" id="tool-card">
<div style="display:flex;flex-direction:column;flex:1 1 auto;">
<div style="flex:1 1 auto;">
<a class="back-link" href="index.html"><i class="fa fa-arrow-left"></i> Zurück zum Hauptmenü</a>
<h3 id="tool-title">Zwischenablage-Manager</h3><p style="margin-top:1rem;"><a class="read-guide cta" href="/de/clipboard-manager/clipboard-manager-index.html" rel="noopener" target="_blank">Vollständige Anleitung lesen</a></p>
<div aria-label="Clips section" class="clips-section" role="region">
<form aria-label="Add clip form" class="clips-form" id="clipboardForm">
<input class="form-control" id="clipInput" placeholder="Text hier eingeben oder einfügen..." type="text"/>
<button class="btn btn-success" id="add-btn" type="submit">Hinzufügen</button>
</form>
<div aria-live="polite" class="clips-list" id="clipsList"></div>
<details class="faq-section" style="margin-top:12px;">
<summary>Häufig gestellte Fragen</summary>
<ul style="padding-left:1em;">
<li><b>Werden meine Notizen gespeichert?</b> Ja! Sie bleiben im Browser, bis du sie löschst.</li>
<li><b>Kann ich eine Notiz kopieren?</b> Ja, klicke auf <b>Kopieren</b> neben der Notiz.</li>
<li><b>Wie entferne ich eine Notiz?</b> Klicke auf <b>Entfernen</b> daneben.</li>
<li><b>Wie lösche ich alles?</b> Entferne jede Notiz einzeln.</li>
</ul>
</details>
</div>
</div>
<div aria-hidden="true" style="margin-top:auto;"></div>
</div>
</section>
</div>
<div class="col">
<aside class="article-card" id="right-article">
<div style="display:flex;flex-direction:column;flex:1 1 auto;">
<header style="flex:1 1 auto;">
<h2><i class="fa fa-lightbulb" style="color:#43cea2;"></i> Tipps für die Zwischenablage</h2>
<ul>
<li><b>Farbcodes für deine Notizen:</b> Emojis oder Tags für schnelle visuelle Organisation.</li>
<li><b>Regelmäßig prüfen:</b> Überprüfe und lösche veraltete Notizen.</li>
<li><b>Im Voraus planen:</b> Füge Notizen für zukünftige Termine hinzu!</li>
</ul>
</header>
</div>
</aside>
</div>
</div>
</div>
<button id="lh-floating-add" style="display:none;" title="Add (fallback)">Add</button>
<script>
    // Defensive removal of any existing language-indicator element from DOM (if present)
    (function(){ try { var li = document.querySelector('.language-indicator'); if (li && li.parentNode) li.parentNode.removeChild(li); } catch(e){} })();

    // Clips persistence and UI (unchanged logic)
    (function(){
      function safeGet(k){ try { return localStorage.getItem(k);} catch(e){return null;} }
      function safeSet(k,v){ try { localStorage.setItem(k,v); return true;} catch(e){ return false;} }
      window.clips = JSON.parse(safeGet('clipboardClips') || '[]');
      var clips = window.clips || [];

      function escapeHtml(s){ return String(s||'').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

      function renderClips(){
        var list = document.getElementById('clipsList');
        if (!list) return;
        list.innerHTML = '';
        if (!clips.length) { list.innerHTML = '<div style="color:#888;">Noch keine Notizen hinzugefügt.</div>'; return; }
        for (var i=0;i<clips.length;i++){
          var c = clips[i];
          var pin = c.pinned ? '<span style="font-weight:700;color:var(--accent);margin-right:.5em;"><i class="fa fa-thumbtack"></i></span>' : '';
          var div = document.createElement('div');
          div.className = 'clip-item';
          div.innerHTML = '<div class="clip-text">' + pin + escapeHtml(c.text) + '</div>' +
                          '<div style="display:flex;gap:.4rem;align-items:center;">' +
                          '<button class="btn btn-outline-info btn-sm" data-idx="'+i+'" data-action="pin" title="Pin/unpin"><i class="fa fa-thumbtack"></i></button>' +
                          '<button class="btn btn-outline-success btn-sm" data-idx="'+i+'" data-action="copy" title="Copy"><i class="fa fa-copy"></i></button>' +
                          '<button class="btn btn-outline-danger btn-sm" data-idx="'+i+'" data-action="remove" title="Remove"><i class="fa fa-trash"></i></button>' +
                          '</div>';
          list.appendChild(div);
        }

        Array.from(list.querySelectorAll('button[data-idx]')).forEach(function(btn){
          var idx = parseInt(btn.getAttribute('data-idx'), 10);
          var action = btn.getAttribute('data-action');
          btn.onclick = function(){
            if (action === 'copy') {
              try { navigator.clipboard.writeText(clips[idx].text); } catch(e) {}
            } else if (action === 'remove') {
              clips.splice(idx,1); window.clips = clips; safeSet('clipboardClips', JSON.stringify(clips)); renderClips();
            } else if (action === 'pin') {
              clips[idx].pinned = !clips[idx].pinned;
              if (clips[idx].pinned) { var p = clips.splice(idx,1)[0]; clips.unshift(p); }
              safeSet('clipboardClips', JSON.stringify(clips)); renderClips();
            }
          };
        });

        // After rendering, trigger equalizer
        setTimeout(function(){ try { window.dispatchEvent(new Event('resize')); } catch(e){} }, 60);
      }

      function addClipFromInput(){
        var input = document.getElementById('clipInput');
        var text = (input && input.value || '').trim();
        if (!text) return;
        clips = clips || [];
        clips.unshift({ text: text, date: new Date().toLocaleString(), pinned: false });
        window.clips = clips;
        safeSet('clipboardClips', JSON.stringify(clips));
        if (input) input.value = '';
        renderClips();
      }

      var form = document.getElementById('clipboardForm');
      if (form) form.addEventListener('submit', function(e){ e.preventDefault(); addClipFromInput(); });

      window.addClipFromInput = addClipFromInput;
      window.lhShowClips = function(){ console.log('window.clips', window.clips); return window.clips; };

      window.addEventListener('pagehide', function(){ safeSet('clipboardClips', JSON.stringify(window.clips || [])); });
      window.addEventListener('beforeunload', function(){ safeSet('clipboardClips', JSON.stringify(window.clips || [])); });

      document.addEventListener('DOMContentLoaded', function(){ clips = window.clips || []; renderClips(); });
    })();

    // Equalize heights: robust approach with MutationObserver + retries
    (function(){
      function equalizeCardHeights(){
        var cols = Array.from(document.querySelectorAll('.center-row > .col'));
        if (!cols.length) return;
        cols.forEach(function(col){ var card = col.querySelector('.article-card, .tool-card'); if (card) card.style.height = ''; });
        var maxh = 0;
        cols.forEach(function(col){
          var card = col.querySelector('.article-card, .tool-card');
          if (!card) return;
          var rect = card.getBoundingClientRect();
          var h = Math.ceil(rect.height);
          if (h > maxh) maxh = h;
        });
        if (maxh > 0) {
          cols.forEach(function(col){
            var card = col.querySelector('.article-card, .tool-card');
            if (card) card.style.height = maxh + 'px';
          });
        }
      }
      function runRetries(){
        equalizeCardHeights();
        setTimeout(equalizeCardHeights, 120);
        setTimeout(equalizeCardHeights, 420);
      }
      var container = document.getElementById('page-main');
      if (container) {
        var mo = new MutationObserver(function(){ runRetries(); });
        mo.observe(container, { childList:true, subtree:true, characterData:true });
      }
      window.addEventListener('load', runRetries);
      window.addEventListener('resize', runRetries);
      document.addEventListener('DOMContentLoaded', runRetries);
      window.addEventListener('storage', function(e){ if (e.key === 'timerhavenLang') runRetries(); });
    })();
  </script>
<footer>
    © 2025 TimerHaven. All tools are free and privacy-friendly.<br/> <a href="privacy.html">Privacy Policy</a> • <a href="terms.html">Terms</a> • <a href="contact.html">Contact</a>
</footer>
<p style="margin-top:1rem;"></p></body>
</html>