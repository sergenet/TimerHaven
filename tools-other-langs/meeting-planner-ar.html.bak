<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="utf-8"/>
<title>مخطط الاجتماعات — TimerHaven</title>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<meta content="ابحث عن أفضل وقت للاجتماع للجميع في أي مكان في العالم." name="description"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet"/>
<style>
    body { background: #f4f7fb; font-family: 'Montserrat', Arial, sans-serif; direction: rtl; }
    .main-container { max-width: 1200px; margin: 2em auto; display:flex; justify-content:center; align-items:center; min-height:90vh; }
    .center-row { display:flex; gap:2em; width:100%; justify-content:center; align-items:flex-start; }
    .article-card, .tool-card {
      background:#fff; border-radius:16px; box-shadow:0 2px 12px #e0e7ef;
      width:340px; min-width:220px; max-width:340px; min-height:500px;
      flex:1 1 340px; display:flex; flex-direction:column; padding:2em 1.3em 1em; box-sizing:border-box; overflow:hidden;
      text-align:right;
    }
    .article-card { padding:1.2em; min-height:200px; }
    .back-link { display:inline-block; margin-bottom:1em; color:#007bff; text-decoration:none; font-weight:bold; font-size:1em; }
    .back-link:hover { text-decoration:underline; }
    .faq-section { margin-top:1.1em; margin-bottom:0.3em; font-size:1em; background:#f7fafc; border-radius:8px; padding:1em; box-shadow:0 1px 4px #e0e7ef; direction:rtl; text-align:right; }
    .faq-section summary { font-weight:bold; font-size:1.07em; cursor:pointer; margin-bottom:0.5em; }
    .article-links { display:flex; flex-direction:column; gap:.5rem; margin-top:.6rem; }
    .participant-item { background:#f7fafc; border-radius:8px; padding:.6rem; margin-bottom:.6rem; display:flex; justify-content:space-between; align-items:center; gap:.6rem; direction:rtl; }
    .meeting-times-grid { display:flex; flex-direction:column; gap:.4rem; margin-top:.6rem; }
    .time-suggestion { display:flex; gap:.6rem; align-items:center; justify-content:space-between; padding:.45rem .6rem; border-radius:8px; background:#fff; border:1px solid #eef6f3; direction:rtl; }
  </style>
<style>
/* timerhaven: enforce single-card layout and CTA */
.main-container {
  max-width: 520px !important;
  margin: 2rem auto !important;
  padding: 0 12px !important;
  box-sizing: border-box;
}
.center-row {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  gap: 0 !important;
}
.tool-card, .article-card {
  background: #fff !important;
  border-radius: 16px !important;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06) !important;
  width: 100% !important;
  max-width: 520px !important;
  padding: 1.6rem 1.3rem !important;
  box-sizing: border-box !important;
  margin: 0 0 1.2rem 0 !important;
}
.article-card {
  display: none !important;
}
.read-guide {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: .35rem 0 .8rem 0 !important;
  padding: .45rem .9rem !important;
  border-radius: 8px !important;
  background: #007bff !important;
  color: #fff !important;
  text-decoration: none !important;
  font-weight: 700 !important;
  font-size: .95rem !important;
  border: none !important;
  box-sizing: border-box !important;
  box-shadow: 0 2px 6px rgba(0,0,0,0.06) !important;
}
.read-guide:hover { filter: brightness(.95); text-decoration: none; }
@media (max-width: 800px) {
  .main-container { padding: 0 8px !important; }
  .tool-card { max-width: 97vw !important; }
}
</style><style>/* timerhaven: backlink color */
.back-link {
  color: #0d6efd !important;
  font-weight: 700 !important;
  text-decoration: none !important;
}
.back-link:hover { text-decoration: underline !important; }
</style></head>
<body>
<div class="main-container">
<div class="center-row">
<!-- Left article card: How-to (Arabic) -->
<div aria-labelledby="howto-heading" class="article-card">
<h2 id="howto-heading">كيفية استخدام مخطط الاجتماعات</h2>
<ol>
<li>أضف المشاركين ومناطقهم الزمنية.</li>
<li>اختر تاريخًا ووقتًا مقترحًا.</li>
<li>تحقق من الأوقات المحلية وشارك الموعد النهائي.</li>
</ol>
</div>
<!-- Center tool card (Arabic) -->
<div class="tool-card" id="tool-card">
<!-- removed in-page language selector: language controlled by main menu -->
<a class="back-link" href="index.html"><i class="fa fa-arrow-left"></i> العودة إلى القائمة الرئيسية</a>
<h3 style="display:flex;align-items:center;gap:.6rem;justify-content:flex-end;"><span id="tool-title">مخطط الاجتماعات</span> <i class="fa fa-users"></i></h3><p style="margin-top:1rem;"><a class="read-guide cta" href="/ar/meeting-planner/meeting-planner-index.html" rel="noopener" target="_blank">اقرأ الدليل الكامل</a></p>
<form id="meetingForm" onsubmit="return false;">
<div class="meeting-form-row mb-2">
<label for="participantName">اسم المشارك</label>
<input autocomplete="off" class="form-control" id="participantName" placeholder="أدخل الاسم (مثال: أحمد)" type="text"/>
</div>
<div class="meeting-form-row mb-2">
<label for="participantCity">المنطقة الزمنية / المدينة</label>
<select autocomplete="off" class="form-select" id="participantCity"></select>
</div>
<div class="mb-2 d-flex gap-2" style="justify-content:flex-end;">
<button class="btn btn-success btn-participant" id="addParticipant" type="button"><i class="fa fa-plus"></i> أضف مشارك</button>
<button class="btn btn-outline-secondary" id="clearParticipants" title="مسح المشاركين" type="button"><i class="fa fa-eraser"></i></button>
</div>
</form>
<div class="participant-list mb-3" id="participantList"></div>
<div class="meeting-form-row mb-2">
<label for="meetingDate">اختر التاريخ</label>
<input class="form-control" id="meetingDate" type="date"/>
</div>
<div class="meeting-form-row mb-2">
<label for="meetingTime">اختر الوقت</label>
<input class="form-control" id="meetingTime" type="time"/>
<button class="btn btn-primary btn-sm mt-2" id="calcTimes" type="button"><i class="fa fa-clock"></i> عرض الأوقات</button>
</div>
<div aria-live="polite" class="mt-2" id="meetingTimes"></div>
<details class="faq-section mt-3">
<summary>الأسئلة الشائعة</summary>
<ul style="padding-right:1em;">
<li><b>كم عدد المشاركين؟</b> أضف العدد الذي تحتاجه.</li>
<li><b>ما هي المناطق الزمنية؟</b> اختر من أكثر من 30 مدينة شائعة.</li>
<li><b>كيف أشارك؟</b> انسخ الأوقات وشاركها مع المشاركين.</li>
</ul>
</details>
<!-- extra article link removed from bottom of tool card -->
</div>
<!-- Right article card: Tips (Arabic) -->
<div aria-labelledby="tips-heading" class="article-card">
<h2 id="tips-heading">نصائح لاجتماعات أكثر إنتاجية</h2>
<ul>
<li>خطط مسبقًا لاختيار وقت مناسب للجميع.</li>
<li>أرسل دعوات التقويم لتجنب الالتباس.</li>
<li>تحقق من المناطق الزمنية قبل الإرسال.</li>
</ul>
</div>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/luxon@3.4.3/build/global/luxon.min.js"></script>
<script>
    // City list (Arabic labels where practical)
    const cities = [
      {value:"", label:"اختر مدينة/منطقة زمنية"},
      {value:"America/New_York", label:"نيويورك 🇺🇸"},
      {value:"America/Chicago", label:"شيكاغو 🇺🇸"},
      {value:"America/Los_Angeles", label:"لوس أنجلوس 🇺🇸"},
      {value:"America/Toronto", label:"تورونتو 🇨🇦"},
      {value:"Europe/London", label:"لندن 🇬🇧"},
      {value:"Europe/Paris", label:"باريس 🇫🇷"},
      {value:"Europe/Berlin", label:"برلين 🇩🇪"},
      {value:"Europe/Moscow", label:"موسكو 🇷🇺"},
      {value:"Europe/Istanbul", label:"إسطنبول 🇹🇷"},
      {value:"Asia/Dubai", label:"دبي 🇦🇪"},
      {value:"Asia/Kolkata", label:"كولكاتا 🇮🇳"},
      {value:"Asia/Shanghai", label:"شنغهاي 🇨🇳"},
      {value:"Asia/Tokyo", label:"طوكيو 🇯🇵"},
      {value:"Asia/Singapore", label:"سنغافورة 🇸🇬"},
      {value:"Asia/Jakarta", label:"جاكرتا 🇮🇩"},
      {value:"Australia/Sydney", label:"سيدني 🇦🇺"},
      {value:"Pacific/Auckland", label:"أوكلاند 🇳🇿"},
      {value:"America/Sao_Paulo", label:"ساو باولو 🇧🇷"},
      {value:"America/Mexico_City", label:"مكسيكو سيتي 🇲🇽"},
      {value:"Africa/Johannesburg", label:"جوهانسبرغ 🇿🇦"},
      {value:"Africa/Cairo", label:"القاهرة 🇪🇬"},
      {value:"Africa/Nairobi", label:"نيروبي 🇰🇪"},
      {value:"Asia/Seoul", label:"سيول 🇰🇷"},
      {value:"Asia/Hong_Kong", label:"هونغ كونغ 🇭🇰"},
      {value:"Asia/Bangkok", label:"بانكوك 🇹🇭"},
      {value:"Asia/Manila", label:"مانيلا 🇵🇭"},
      {value:"Europe/Madrid", label:"مدريد 🇪🇸"},
      {value:"Europe/Rome", label:"روما 🇮🇹"},
      {value:"Europe/Warsaw", label:"وارسو 🇵🇱"},
      {value:"Europe/Amsterdam", label:"أمستردام 🇳🇱"},
      {value:"Europe/Athens", label:"أثينا 🇬🇷"},
      {value:"America/Vancouver", label:"فانكوفر 🇨🇦"}
    ];

    function populateCities() {
      const sel = document.getElementById('participantCity');
      sel.innerHTML = '';
      cities.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.value;
        opt.textContent = c.label;
        sel.appendChild(opt);
      });
    }

    const LS_KEY = 'meetingPlannerParticipants';
    function loadParticipants() {
      try {
        const raw = localStorage.getItem(LS_KEY);
        window.participants = raw ? JSON.parse(raw) : [];
      } catch(e) {
        window.participants = [];
      }
    }
    function saveParticipants() {
      try { localStorage.setItem(LS_KEY, JSON.stringify(window.participants || [])); } catch(e) {}
    }
    function renderParticipants() {
      const container = document.getElementById('participantList');
      container.innerHTML = '';
      if (!window.participants || window.participants.length === 0) {
        container.innerHTML = '<div style="color:#888;">لا يوجد مشاركون حتى الآن.</div>';
        return;
      }
      window.participants.forEach((p, idx) => {
        const el = document.createElement('div');
        el.className = 'participant-item';
        el.innerHTML = `<div style="min-width:0; text-align:right;"><div style="font-weight:700;">${escapeHtml(p.name)}</div><div style="font-size:.9em;color:#666;">${escapeHtml(p.city)}</div></div>
          <div style="display:flex;gap:.5rem;"><button class="btn btn-outline-danger btn-sm" onclick="removeParticipant(${idx})" aria-label="حذف المشارك"><i class="fa fa-trash"></i></button></div>`;
        container.appendChild(el);
      });
    }
    function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

    document.getElementById('addParticipant').addEventListener('click', function(){
      const name = document.getElementById('participantName').value.trim();
      const city = document.getElementById('participantCity').value;
      if (!name) { alert('يرجى إدخال اسم المشارك.'); return; }
      if (!city) { alert('يرجى اختيار مدينة / منطقة زمنية.'); return; }
      window.participants = window.participants || [];
      window.participants.push({ name, city });
      saveParticipants();
      document.getElementById('participantName').value = '';
      document.getElementById('participantCity').selectedIndex = 0;
      renderParticipants();
      updateMeetingTimes();
    });

    document.getElementById('clearParticipants').addEventListener('click', function(){
      if (!window.participants || window.participants.length === 0) return;
      if (!confirm('هل تريد مسح كل المشاركين؟')) return;
      window.participants = [];
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    });

    window.removeParticipant = function(idx){
      if (!window.participants) return;
      window.participants.splice(idx,1);
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    };

    // Luxon usage
    const { DateTime } = luxon;
    function updateMeetingTimes(){
      const date = document.getElementById('meetingDate').value;
      const time = document.getElementById('meetingTime').value;
      const out = document.getElementById('meetingTimes');
      const tlang = {
        noDateTime: "يرجى اختيار التاريخ والوقت.",
        noParticipants: "لا يوجد مشاركون حتى الآن.",
        heading: "أوقات الاجتماع (المنظم محلي → المشاركون محلياً)"
      };
      if (!date || !time) { out.innerHTML = `<div style="color:#888;">${tlang.noDateTime}</div>`; return; }
      if (!window.participants || window.participants.length === 0) { out.innerHTML = `<div style="color:#888;">${tlang.noParticipants}</div>`; return; }
      const localISO = `${date}T${time}`;
      let organizer = DateTime.fromISO(localISO);
      if (!organizer.isValid) { out.innerHTML = `<div style="color:#b00;">${tlang.noDateTime}</div>`; return; }
      let html = `<div style="font-weight:700;margin-bottom:.4rem;">${tlang.heading}</div>`;
      html += `<div class="meeting-times-grid">`;
      html += `<div class="time-suggestion"><div style="text-align:right;"><b>المنظم</b> (${escapeHtml(organizer.zoneName)})</div><div>${escapeHtml(organizer.toLocaleString(DateTime.DATETIME_FULL))}</div></div>`;
      window.participants.forEach(p => {
        let dt;
        try { dt = organizer.setZone(p.city); } catch(e) { dt = null; }
        const label = dt ? dt.toLocaleString(DateTime.DATETIME_FULL) : 'منطقة زمنية غير صالحة';
        html += `<div class="time-suggestion"><div style="text-align:right;"><b>${escapeHtml(p.name)}</b> <span style="color:#666;">(${escapeHtml(p.city)})</span></div><div>${escapeHtml(label)}</div></div>`;
      });
      html += `</div>`;
      out.innerHTML = html;
    }

    document.getElementById('calcTimes').addEventListener('click', updateMeetingTimes);

    // Init
    document.addEventListener('DOMContentLoaded', function(){
      populateCities();
      loadParticipants();
      renderParticipants();
      try {
        const savedDate = localStorage.getItem('meetingPlannerDate');
        const savedTime = localStorage.getItem('meetingPlannerTime');
        if (savedDate) document.getElementById('meetingDate').value = savedDate;
        if (savedTime) document.getElementById('meetingTime').value = savedTime;
      } catch(e){}
    });

    document.getElementById('meetingDate').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerDate', this.value); }catch(e){} });
    document.getElementById('meetingTime').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerTime', this.value); }catch(e){} });
  </script>
<p style="margin-top:1rem;"></p></body>
</html>