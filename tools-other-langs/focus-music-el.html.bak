<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="utf-8"/>
<title>Μουσική Συγκέντρωσης — TimerHaven</title>
<meta content="width=device-width,initial-scale=1" name="viewport"/>
<meta content="Ακούστε μουσική που βοηθά στη συγκέντρωση. Επιλέξτε λευκό θόρυβο, βροχή, άλφα κύματα, κλασική, κύματα ωκεανού ή ατμόσφαιρα καφέ." name="description"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet"/>
<style>
    body { background:#f4f7fb; font-family:'Montserrat', Arial, sans-serif; }
    .main-container { max-width:1200px; margin:2em auto; display:flex; justify-content:center; align-items:center; min-height:90vh; }
    .center-row, .card-row { display:flex; gap:2em; width:100%; justify-content:center; align-items:stretch; }
    .article-card, .tool-card {
      background:#fff; border-radius:16px; box-shadow:0 2px 12px #e0e7ef;
      min-width:220px; max-width:340px; width:340px; min-height:500px;
      flex:1 1 340px; display:flex; flex-direction:column; padding:2em 1.3em 1em; box-sizing:border-box;
      text-align:left; overflow:hidden;
    }
    .article-card h2, .tool-card h3 { font-size:1.35em; font-weight:700; margin-bottom:.4em; display:flex; gap:.3em; align-items:center; }
    .music-player { margin-bottom:1em; }
    .music-player label { margin-left:.5em; font-size:1em; }
    .faq-section { margin-top:1.1em; background:#f7fafc; border-radius:8px; padding:1em; box-shadow:0 1px 4px #e0e7ef; }
    .back-link { display:inline-block; margin-bottom:1em; color:#007bff; text-decoration:none; font-weight:700; }
    .back-link:hover { text-decoration:underline; }
    @media (max-width:1100px){ .main-container{padding:0 8px;} .tool-card,.article-card{width:97vw;max-width:540px;height:auto;} }
    @media (max-width:800px){ .center-row{flex-direction:column;align-items:center;} .article-card{display:none!important;} }
    details[open] summary::after{ content:" ▲"; font-size:.9em; } details summary{ cursor:pointer; padding:.35em 0; font-weight:700; font-size:1.09em; } details:not([open]) summary::after{ content:" ▼"; font-size:.9em; }
  </style>
<style>
/* timerhaven: enforce single-card layout and CTA */
.main-container {
  max-width: 520px !important;
  margin: 2rem auto !important;
  padding: 0 12px !important;
  box-sizing: border-box;
}
.center-row {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  gap: 0 !important;
}
.tool-card, .article-card {
  background: #fff !important;
  border-radius: 16px !important;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06) !important;
  width: 100% !important;
  max-width: 520px !important;
  padding: 1.6rem 1.3rem !important;
  box-sizing: border-box !important;
  margin: 0 0 1.2rem 0 !important;
}
.article-card {
  display: none !important;
}
.read-guide {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: .35rem 0 .8rem 0 !important;
  padding: .45rem .9rem !important;
  border-radius: 8px !important;
  background: #007bff !important;
  color: #fff !important;
  text-decoration: none !important;
  font-weight: 700 !important;
  font-size: .95rem !important;
  border: none !important;
  box-sizing: border-box !important;
  box-shadow: 0 2px 6px rgba(0,0,0,0.06) !important;
}
.read-guide:hover { filter: brightness(.95); text-decoration: none; }
@media (max-width: 800px) {
  .main-container { padding: 0 8px !important; }
  .tool-card { max-width: 97vw !important; }
}
</style><style>/* timerhaven: backlink color */
.back-link {
  color: #0d6efd !important;
  font-weight: 700 !important;
  text-decoration: none !important;
}
.back-link:hover { text-decoration: underline !important; }
</style></head>
<body>
<!-- Force Greek for local testing -->
<script>try{ localStorage.setItem('timerhavenLang','el'); }catch(e){}</script>
<div class="main-container">
<div class="center-row">
<div class="article-card">
<div>
<h2 id="howto-title"></h2>
<ol id="howto-steps"></ol>
</div>
<a class="btn btn-outline-primary btn-sm" href="#" id="howto-article-btn"></a>
</div>
<div class="tool-card">
<a class="back-link" href="index.html" id="back-link"></a>
<h3 id="tool-title"></h3><p style="margin-top:1rem;"><a class="read-guide cta" href="/el/focus-music/focus-music-index.html" rel="noopener" target="_blank">Διαβάστε τον πλήρη οδηγό</a></p>
<div class="help-section" id="tool-help"></div>
<div class="music-player">
<label for="music-select" id="music-label"></label>
<select aria-label="Επιλέξτε playlist" class="form-select mb-2" id="music-select">
<option value="white"></option>
<option value="rain"></option>
<option value="alpha"></option>
<option value="classical"></option>
<option value="ocean"></option>
<option value="cafe"></option>
</select>
<label for="music-loop" id="loop-label" style="display:flex;align-items:center;gap:.5rem;">
<input aria-label="Επανάληψη κομματιού" id="music-loop" type="checkbox"/>
<span id="loop-label-text"></span>
</label>
</div>
<button class="btn btn-primary w-100 mb-2" id="play-btn">Αναπαραγωγή</button>
<button class="btn btn-danger w-100 mb-2" id="stop-btn">Διακοπή</button>
<audio controls="" id="focus-audio" style="display:none;"></audio>
<details class="faq-section mt-2">
<summary id="faq-title"></summary>
<ul id="faq-list" style="padding-left:1em;"></ul>
</details>
</div>
<div class="article-card">
<div>
<h2 id="tips-title"></h2>
<ul id="tips-list"></ul>
</div>
<a class="btn btn-outline-primary btn-sm" href="#" id="tips-article-btn"></a>
</div>
</div>
</div>
<script>
  // Test tracks (SoundHelix)
  const tracks = {
    white:    "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
    rain:     "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3",
    alpha:    "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3",
    classical:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3",
    ocean:    "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3",
    cafe:     "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-6.mp3"
  };

  // Full translations object (no placeholders)
  const focusMusicTranslations = {
    en: {
      "language-label":"Language:",
      "back-link":"Back to Main Menu",
      "tool-title":"Focus Music",
      "tool-help":"Enhance your concentration and productivity with music scientifically shown to help focus. Choose soothing sounds: white noise, rain, alpha waves, classical, ocean waves, or cafe ambience.",
      "music-label":"Select a playlist:",
      "music-white":"White Noise","music-rain":"Rain","music-alpha":"Alpha Waves",
      "music-classical":"Classical","music-ocean":"Ocean Waves","music-cafe":"Cafe Ambience",
      "loop-label":"Loop track","play":"Play","stop":"Stop","faq-title":"FAQs",
      "faq-list":`<li><b>Can I loop tracks?</b> Yes, use the Loop checkbox or audio controls after pressing Play.</li>
        <li><b>Does this work offline?</b> No, tracks stream from the server.</li>
        <li><b>Can I add my own music?</b> Not yet—let us know if you want this.</li>`,
      "howto-title":'<i class="fa fa-music"></i> How to Use Focus Music',
      "howto-steps":`<li><b>Select a playlist:</b> Choose music for focus or relaxation.</li>
        <li><b>Play and adjust volume:</b> Use the controls to adjust playback.</li>
        <li><b>Switch tracks:</b> Try different music styles to see what works best.</li>`,
      "howto-article-btn":"Read Full Article","howto-article-link":"focus-music-how-to.html",
      "tips-title":'<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Focus Music Productivity Tips',
      "tips-list":`<li><b>Experiment with genres:</b> Try different playlists for various work modes.</li>
        <li><b>Use headphones:</b> Block distractions with quality headphones.</li>
        <li><b>Volume matters:</b> Keep the sound low enough for concentration.</li>`,
      "tips-article-btn":"Read Full Article","tips-article-link":"focus-music-tips.html"
    },
    fr: {
      "language-label":"Langue :","back-link":"Retour au menu principal","tool-title":"Musique pour la Concentration",
      "tool-help":"Boostez την προσοχή σας με μουσική...", "music-label":"Choisissez une playlist :",
      "music-white":"Bruit blanc","music-rain":"Pluie","music-alpha":"Ondes alpha","music-classical":"Classique",
      "music-ocean":"Vagues de l'océan","music-cafe":"Ambiance café","loop-label":"Boucler le morceau","play":"Lecture","stop":"Arrêter",
      "faq-title":"FAQ","faq-list":"<li><b>Peut-on boucler les morceaux ?</b> Oui.</li>","howto-title":'<i class="fa fa-music"></i> Comment ...',"howto-steps":"<li>...</li>","howto-article-btn":"Lire l'article","howto-article-link":"focus-music-how-to-fr.html",
      "tips-title":'<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Συμβουλές',"tips-list":"<li>...</li>","tips-article-btn":"Lire","tips-article-link":"focus-music-tips-fr.html"
    },
    de: {
      "language-label":"Sprache:","back-link":"Zurück zum Hauptmenü","tool-title":"Fokus-Musик",
      "tool-help":"Verbessern Sie Ihre Konzentration ...","music-label":"Playlist auswählen:",
      "music-white":"Weißes Rauschen","music-rain":"Regen","music-alpha":"Alpha-Wellen","music-classical":"Klassik",
      "music-ocean":"Meeresrauschen","music-cafe":"Café-Atmosphäre","loop-label":"Titel wiederholen","play":"Abspielen","stop":"Stopp",
      "faq-title":"FAQ","faq-list":"<li>...</li>","howto-title":'<i class="fa fa-music"></i> So nutzt du Fokus-Musик',"howto-steps":"<li>...</li>","howto-article-btn":"Lesen","howto-article-link":"focus-music-how-to-de.html",
      "tips-title":"<i class=\"fa fa-lightbulb\" style=\"color:#43cea2;\"></i> Tipps","tips-list":"<li>...</li>","tips-article-btn":"Lesen","tips-article-link":"focus-music-tips-de.html"
    },
    ru: {
      "language-label":"Язык:","back-link":"Назад в главное меню","tool-title":"Музыка для концентрации",
      "tool-help":"Улучшите концентрацию с помощью музыки ...","music-label":"Выберите плейлист:",
      "music-white":"Белый шум","music-rain":"Дождь","music-alpha":"Альфа-волны","music-classical":"Классика",
      "music-ocean":"Шум океана","music-cafe":"Кафе","loop-label":"Зациклить трек","play":"Воспроизвести","stop":"Стоп",
      "faq-title":"Частые вопросы","faq-list":"<li>...</li>","howto-title":"<i class='fa fa-music'></i> Как пользоваться","howto-steps":"<li>...</li>","howto-article-btn":"Читать","howto-article-link":"focus-music-how-to-ru.html",
      "tips-title":"<i class='fa fa-lightbulb' style='color:#43cea2;'></i> Советы","tips-list":"<li>...</li>","tips-article-btn":"Читать","tips-article-link":"focus-music-tips-ru.html"
    },
    el: {
      "language-label":"Γλώσσα:","back-link":"Επιστροφή στο κύριο μενού","tool-title":"Μουσική Συγκέντρωσης",
      "tool-help":"Βελτιώστε τη συγκέντρωση με μουσική: λευκός θόρυβος, βροχή, άλφα κύματα, κλασική, κύματα ωκεανού ή ατμόσφαιρα καφέ.",
      "music-label":"Επιλέξτε playlist:","music-white":"Λευκός θόρυβος","music-rain":"Βροχή","music-alpha":"Άλφα κύματα",
      "music-classical":"Κλασική","music-ocean":"Κύματα ωκεανού","music-cafe":"Ατμόσφαιρα καφέ","loop-label":"Επανάληψη κομματιού",
      "play":"Αναπαραγωγή","stop":"Διακοπή","faq-title":"Συχνές Ερωτήσεις",
      "faq-list":`<li><b>Μπορώ να επαναλάβω κομμάτια;</b> Ναι, με το κουμπί ή τα χειριστήρια audio.</li>
        <li><b>Λειτουργεί offline;</b> Όχι, η μουσική μεταδίδεται από τον server.</li>
        <li><b>Μπορώ να προσθέσω δική μου μουσική;</b> Όχι ακόμα—πείτε μας αν το θέλετε!</li>`,
      "howto-title":'<i class="fa fa-music"></i> Πώς να χρησιμοποιήσετε τη Μουσική Συγκέντρωσης',
      "howto-steps":`<li><b>Επιλέξτε playlist:</b> Μουσική για συγκέντρωση ή χαλάρωση.</li>
        <li><b>Παίξτε & ρυθμίστε ένταση:</b> Χρησιμοποιήστε τα χειριστήρια για αναπαραγωγή/ένταση.</li>
        <li><b>Αλλάξτε είδος:</b> Δοκιμάστε διαφορετικές μουσικές για καλύτερη συγκέντρωση.</li>`,
      "howto-article-btn":"Διαβάστε το πλήρες άρθρο","howto-article-link":"focus-music-how-to-el.html",
      "tips-title":'<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Συμβουλές για Μουσική Συγκέντρωσης',
      "tips-list":`<li><b>Πειραματιστείτε με είδη:</b> Δοκιμάστε διαφορετικές playlists.</li>
        <li><b>Χρησιμοποιήστε ακουστικά:</b> Μειώστε τους περισπασμούς.</li>
        <li><b>Ένταση χαμηλά:</b> Για καλύτερη συγκέντρωση.</li>`,
      "tips-article-btn":"Διαβάστε το πλήρες άρθρο","tips-article-link":"focus-music-tips-el.html"
    },
    es: { "language-label":"Idioma:","back-link":"Volver al menú principal","tool-title":"Música para concentrarse","tool-help":"Mejora tu concentración με música.","music-label":"Selecciona una lista:","music-white":"Ruido blanco","music-rain":"Lluvia","music-alpha":"Ondas alfa","music-classical":"Clásica","music-ocean":"Olas","music-cafe":"Ambiente de café","loop-label":"Repetir pista","play":"Reproducir","stop":"Detener","faq-title":"Preguntas frecuentes","faq-list":"<li>...</li>","howto-title":"<i class='fa fa-music'></i> Cómo usar","howto-steps":"<li>...</li>","howto-article-btn":"Leer","howto-article-link":"focus-music-how-to-es.html","tips-title":"<i class='fa fa-lightbulb' style='color:#43cea2;'></i> Consejos","tips-list":"<li>...</li>","tips-article-btn":"Leer","tips-article-link":"focus-music-tips-es.html" },
    ar: { "language-label":"اللغة:","back-link":"العودة إلى القائمة الرئيسية","tool-title":"موسيقى التركيز","tool-help":"عزز تركيزك بإيقاعات علمية.","music-label":"اختر قائمة تشغيل:","music-white":"ضوضاء بيضاء","music-rain":"مطر","music-alpha":"موجات ألفا","music-classical":"كلاسيك","music-ocean":"أمواج البحر","music-cafe":"أجواء مقهى","loop-label":"تكرار المقطع","play":"تشغيل","stop":"إيقاف","faq-title":"الأسئلة الشائعة","faq-list":"<li>...</li>","howto-title":"<i class='fa fa-music'></i> كيفية الاستخدام","howto-steps":"<li>...</li>","howto-article-btn":"اقرأ","howto-article-link":"focus-music-how-to-ar.html","tips-title":"<i class='fa fa-lightbulb' style='color:#43cea2;'></i> نصائح","tips-list":"<li>...</li>","tips-article-btn":"اقرأ","tips-article-link":"focus-music-tips-ar.html" }
  };

  const langNames = { en:"English", fr:"Français", de:"Deutsch", ru:"Русский", el:"Ελληνικά", es:"Español", ar:"العربية" };

  function getLang() {
    try { const l = localStorage.getItem('timerhavenLang') || 'el'; return (l && l.slice(0,2)) || 'el'; } catch(e){ return 'el'; }
  }

  function applyLanguage(lang) {
    lang = (lang || getLang()).slice(0,2);
    const t = focusMusicTranslations[lang] || focusMusicTranslations['el'];
    document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';

    if (document.getElementById('back-link')) document.getElementById('back-link').textContent = t['back-link'] || '';
    if (document.getElementById('tool-title')) document.getElementById('tool-title').innerHTML = `<i class="fa fa-music"></i> ${t['tool-title'] || ''}`;
    if (document.getElementById('tool-help')) document.getElementById('tool-help').textContent = t['tool-help'] || '';

    const musicLabel = document.getElementById('music-label');
    if (musicLabel) musicLabel.textContent = t['music-label'] || '';
    const ms = document.getElementById('music-select');
    if (ms && ms.options) {
      ms.options[0].text = t['music-white'] || 'Λευκός θόρυβος';
      ms.options[1].text = t['music-rain'] || 'Βροχή';
      ms.options[2].text = t['music-alpha'] || 'Άλφα κύματα';
      ms.options[3].text = t['music-classical'] || 'Κλασική';
      ms.options[4].text = t['music-ocean'] || 'Κύματα ωκεανού';
      ms.options[5].text = t['music-cafe'] || 'Ατμόσφαιρα καφέ';
    }

    const loopText = document.getElementById('loop-label-text');
    if (loopText) loopText.textContent = t['loop-label'] || 'Επανάληψη κομματιού';
    const playBtn = document.getElementById('play-btn');
    const stopBtn = document.getElementById('stop-btn');
    if (playBtn) playBtn.textContent = t['play'] || 'Αναπαραγωγή';
    if (stopBtn) stopBtn.textContent = t['stop'] || 'Διακοπή';

    if (document.getElementById('faq-title')) document.getElementById('faq-title').textContent = t['faq-title'] || '';
    if (document.getElementById('faq-list')) document.getElementById('faq-list').innerHTML = t['faq-list'] || '';

    if (document.getElementById('howto-title')) document.getElementById('howto-title').innerHTML = t['howto-title'] || '';
    if (document.getElementById('howto-steps')) document.getElementById('howto-steps').innerHTML = t['howto-steps'] || '';
    if (document.getElementById('howto-article-btn')) { document.getElementById('howto-article-btn').textContent = t['howto-article-btn'] || ''; document.getElementById('howto-article-btn').href = t['howto-article-link'] || ''; }

    if (document.getElementById('tips-title')) document.getElementById('tips-title').innerHTML = t['tips-title'] || '';
    if (document.getElementById('tips-list')) document.getElementById('tips-list').innerHTML = t['tips-list'] || '';
    if (document.getElementById('tips-article-btn')) { document.getElementById('tips-article-btn').textContent = t['tips-article-btn'] || ''; document.getElementById('tips-article-btn').href = t['tips-article-link'] || ''; }
  }

  window.addEventListener('storage', function(e) {
    if (e.key === 'timerhavenLang') applyLanguage((e.newValue || 'el').slice(0,2));
  });

  function playMusic() {
    const sel = document.getElementById('music-select').value;
    const audio = document.getElementById('focus-audio');
    audio.src = tracks[sel];
    audio.loop = document.getElementById('music-loop').checked;
    audio.style.display = 'block';
    audio.load();
    audio.play().catch(()=>{});
  }
  function stopMusic() {
    const audio = document.getElementById('focus-audio');
    audio.pause();
    audio.currentTime = 0;
    audio.style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function() {
    applyLanguage(getLang());

    const playBtn = document.getElementById('play-btn');
    const stopBtn = document.getElementById('stop-btn');
    const loopCb = document.getElementById('music-loop');

    if (playBtn) playBtn.addEventListener('click', playMusic);
    if (stopBtn) stopBtn.addEventListener('click', stopMusic);
    if (loopCb) loopCb.addEventListener('change', function(){ document.getElementById('focus-audio').loop = this.checked; });

    // Safety: if option labels were empty due to local-file quirks, re-apply translations
    const ms = document.getElementById('music-select');
    if (ms && (!ms.options[0].text || ms.options[0].text.trim() === "")) applyLanguage(getLang());
  });
</script>
<footer>
