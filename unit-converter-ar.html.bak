<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>محول الوحدات</title>
  <meta name="description" content="حوّل الطول والوزن ودرجة الحرارة والمزيد. تعلّم كيفية استخدام محول الوحدات، واحصل على نصائح ومقالات.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    body { background:#f4f7fb; font-family:'Montserrat', Arial, sans-serif; color:#0b2545; direction:rtl; }
    .page-wrap { max-width:1200px; margin:2rem auto; padding:0 1rem; }
    .top-row { display:flex; justify-content:flex-start; gap:.6rem; margin-bottom:.6rem; align-items:center; }
    .language-select { width:220px; border-radius:10px; padding:.28rem .6rem; border:1px solid rgba(13,110,253,0.25); background:#fff; color:#0d6efd; direction:ltr; }
    .center-row { display:flex; gap:1.6rem; justify-content:center; align-items:flex-start; flex-wrap:wrap; }
    .article-card, .tool-card { background:#fff; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,0.06); padding:1.3rem; box-sizing:border-box; min-width:280px; }
    .article-card { width:330px; min-height:340px; height:340px; display:flex; flex-direction:column; justify-content:space-between; align-items:flex-start; text-align:right; }
    .tool-card { width:410px; min-width:240px; min-height:330px; display:flex; flex-direction:column; text-align:right; }
    h1,h2,h3 { color:#0b2545; }
    .converter-form { display:flex; gap:.5rem; margin-bottom:1rem; flex-wrap:wrap; align-items:center; justify-content:center; }
    .converter-result { font-weight:700; font-size:1.12em; margin-bottom:1rem; text-align:center; }
    .faq-section { margin-top:1rem; background:#f7fafc; border-radius:8px; padding:1rem; text-align:right; }
    .btn-small { padding:.35rem .7rem; font-size:.9rem; }
    footer.site { text-align:center; margin-top:1.5rem; color:#6b7280; direction:ltr; }
    @media (max-width:900px) { .center-row{flex-direction:column;align-items:center;} .article-card, .tool-card{width:98%; max-width:540px;} }

    /* Hide the visible language selector while keeping the markup and JS behavior intact */
    .top-row { display: none !important; }
  </style>
</head>
<body>
  <div class="page-wrap">
    <div class="top-row">
      <label for="language-select-top" style="font-weight:600; margin-left:.5rem;">اللغة:</label>
      <select id="language-select-top" class="language-select" aria-label="محدد اللغة">
        <option value="en">English</option><option value="fr">Français</option><option value="es">Español</option><option value="de">Deutsch</option><option value="ru">Русский</option><option value="el">Ελληνικά</option><option value="ar" selected>العربية</option>
      </select>
    </div>

    <div class="text-center mb-4" style="direction:ltr;">
      <h1 style="margin-bottom:.25rem;">محول الوحدات</h1>
      <p class="lead" style="color:#374151; margin-bottom:1rem;">حوّل الطول والوزن ودرجة الحرارة والمزيد. تعلّم كيفية استخدام محول الوحدات، واحصل على نصائح ومقالات.</p>
    </div>

    <div class="center-row">
      <div class="article-card" aria-labelledby="howto-title">
        <div>
          <h2 id="howto-title"><i class="fa fa-ruler-combined"></i> كيفية استخدام المحول</h2>
          <ol style="padding-left:1.1rem; color:#374151; text-align:right;">
            <li><b>أدخل القيمة:</b> اكتب الرقم الذي تريد تحويله.</li>
            <li><b>اختر النوع:</b> اختر الطول أو الوزن أو الحرارة.</li>
            <li><b>اختر الوحدات:</b> حدد وحدة المصدر والهدف ثم اضغط تحويل.</li>
            <li><b>جرّب:</b> غيّر الوحدات إذا احتجت.</li>
          </ol>
        </div>
        <a href="unit-how-to-ar.html" class="btn btn-outline-primary btn-sm" style="align-self:stretch; margin-top:.6rem; text-align:center;">اقرأ المقالة</a>
      </div>

      <div class="tool-card" role="region" aria-label="محول الوحدات">
        <a href="index.html" class="back-link" style="text-decoration:none; color:#0d6efd; font-weight:600; margin-bottom:.4rem; display:block;">&larr; العودة إلى القائمة الرئيسية</a>
        <h3><i class="fa fa-ruler-combined"></i> محول الوحدات</h3>

        <div class="unit-section">
          <form class="converter-form" id="unitForm">
            <select id="typeSelect" class="form-select" style="max-width:140px;">
              <option value="length">الطول</option>
              <option value="weight">الوزن</option>
              <option value="temperature">الحرارة</option>
            </select>

            <input type="number" id="inputValue" class="form-control" placeholder="القيمة" style="max-width:100px; direction:ltr;">

            <select id="fromUnit" class="form-select" style="max-width:140px;"></select>
            <span style="font-size:1.3em;">→</span>
            <select id="toUnit" class="form-select" style="max-width:140px;"></select>

            <button type="submit" class="btn btn-primary btn-sm">تحويل</button>
          </form>

          <div id="unitResult" class="converter-result"></div>
        </div>

        <details class="faq-section">
          <summary style="text-align:right;">الأسئلة الشائعة</summary>
          <ul style="padding-left:1.1rem; color:#374151; text-align:right;">
            <li><b>هل تدعم الوحدات؟</b> يتضمن المحول الوحدات الأكثر استخداماً.</li>
            <li><b>هل يمكن تحويل الكسور؟</b> نعم، يتم دعم الكسور والعلامة العشرية.</li>
          </ul>
        </details>
      </div>

      <div class="article-card" aria-labelledby="tips-title">
        <div>
          <h2 id="tips-title"><i class="fa fa-lightbulb" style="color:#43cea2;"></i> نصائح</h2>
          <ul style="padding-left:1.1rem; color:#374151; text-align:right;">
            <li><b>تحقق من الوحدات:</b> تأكد من اختيار النوع الصحيح قبل التحويل.</li>
            <li><b>جرب بالاتجاه المعاكس:</b> استعمل التحويل العكسي للتحقق.</li>
            <li><b>احفظ الصفحة:</b> لتسهيل الوصول لاحقاً.</li>
          </ul>
        </div>
        <a href="unit-tips-ar.html" class="btn btn-outline-primary btn-sm" style="align-self:stretch; margin-top:.6rem; text-align:center;">اقرأ المقالة</a>
      </div>
    </div>

    <footer class="site">© 2025 TimerHaven. <a href="privacy.html">سياسة الخصوصية</a></footer>
  </div>

  <script>
  // Unit types & conversion logic (canonical keys used for option values)
  const unitTypes = {
    length: {
      units: { "Meter": 1, "Kilometer": 1000, "Centimeter": 0.01, "Millimeter": 0.001, "Mile": 1609.34, "Yard": 0.9144, "Foot": 0.3048, "Inch": 0.0254 },
      convert: (val, from, to) => val * unitTypes.length.units[from] / unitTypes.length.units[to]
    },
    weight: {
      units: { "Kilogram": 1, "Gram": 0.001, "Milligram": 0.000001, "Pound": 0.453592, "Ounce": 0.0283495 },
      convert: (val, from, to) => val * unitTypes.weight.units[from] / unitTypes.weight.units[to]
    },
    temperature: {
      units: { "Celsius": "C", "Fahrenheit": "F", "Kelvin": "K" },
      convert: (val, from, to) => {
        if (from === to) return val;
        if (from === "Celsius" && to === "Fahrenheit") return val * 9/5 + 32;
        if (from === "Fahrenheit" && to === "Celsius") return (val - 32) * 5/9;
        if (from === "Celsius" && to === "Kelvin") return val + 273.15;
        if (from === "Kelvin" && to === "Celsius") return val - 273.15;
        if (from === "Fahrenheit" && to === "Kelvin") return (val - 32) * 5/9 + 273.15;
        if (from === "Kelvin" && to === "Fahrenheit") return (val - 273.15) * 9/5 + 32;
      }
    }
  };

  function populateUnits(type) {
    const from = document.getElementById('fromUnit');
    const to = document.getElementById('toUnit');
    from.innerHTML = to.innerHTML = '';
    Object.keys(unitTypes[type].units).forEach(u => {
      from.innerHTML += `<option value="${u}">${u}</option>`;
      to.innerHTML += `<option value="${u}">${u}</option>`;
    });
  }

  const typeSelect = document.getElementById('typeSelect');
  const initialType = typeSelect.value || 'length';
  typeSelect.addEventListener('change', function() {
    populateUnits(this.value);
  });
  populateUnits(initialType);

  document.getElementById('unitForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const type = document.getElementById('typeSelect').value;
    const val = parseFloat(document.getElementById('inputValue').value);
    const from = document.getElementById('fromUnit').value;
    const to = document.getElementById('toUnit').value;
    const resultEl = document.getElementById('unitResult');
    if (isNaN(val)) {
      resultEl.innerText = "الرجاء إدخال قيمة صحيحة.";
      return;
    }
    let result = unitTypes[type].convert(val, from, to);
    resultEl.innerText = `${val} ${from} = ${result} ${to}`;
  });

  // language selector redirect (robust)
  (function() {
    var sel = document.getElementById('language-select-top');
    if (sel) {
      sel.addEventListener('change', function() {
        var v = this.value || 'en';
        window.location.href = 'unit-converter-' + v + '.html';
      });
    }
  })();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>