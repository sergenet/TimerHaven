  <script>
    (function(){
      var btn = document.getElementById('returnToToolCountdown');
      if (!btn) return;
      btn.addEventListener('keydown', function(e){
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); btn.click(); }
      });
      function toggleOpacity(){ try { btn.style.opacity = (window.scrollY < 80) ? '0.85' : '0.98'; } catch(e){} }
      window.addEventListener('scroll', toggleOpacity);
      toggleOpacity();
    })();
  </script>
