{
  "manifest_version": 3,
  "name": "TimerHaven Productivity Hub",
  "version": "1.0",
  "description": "Quick access to your favorite timers, stopwatches, and productivity tools from TimerHaven.",
  "permissions": ["storage", "notifications", "contextMenus"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.webp",
      "48": "icons/icon48.webp",
      "128": "icons/icon128.webp"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.webp",
    "48": "icons/icon48.webp",
    "128": "icons/icon128.webp"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
