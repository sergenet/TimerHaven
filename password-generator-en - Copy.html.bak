<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Password Generator â€” TimerHaven</title>
  <meta name="description" content="Create secure, random passwords instantly.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="canonical" href="https://timerhaven.com/password-generator-en.html" />
  
  <style>
    body { background:#f4f7fb; font-family: 'Montserrat', Arial, sans-serif; color:#0b2545; }
    .main-container { max-width:1200px; margin:2rem auto; padding:0 1rem; display:flex; justify-content:center; align-items:flex-start; min-height:90vh; box-sizing:border-box; }
    .tool-card { background:#fff; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,0.06); width:420px; padding:1.6rem 1.5rem; box-sizing:border-box; }
    .back-link { display:inline-block; margin-bottom:.75rem; color:var(--brand,#0d6efd) !important; text-decoration:none; font-weight:700; }
    .tool-title { color:#185a9d; font-size:1.35rem; margin:0 0 .6rem 0; display:flex; align-items:center; gap:.5rem; }
    .read-guide { display:inline-block; margin:.35rem 0 .8rem 0; padding:.45rem .7rem; border-radius:8px; background:var(--brand,#0d6efd); color:#fff; text-decoration:none; font-weight:700; font-size:.95rem; border:none; }
    .password-form { display:flex; gap:.5rem; flex-wrap:wrap; align-items:center; margin-bottom:.75rem; }
    .password-result { font-size:1.15rem; font-weight:600; min-height:1.5rem; margin-bottom:.5rem; }
    .faq-section { margin-top:1rem; background:#f7fafc; border-radius:8px; padding:1rem; }
    @media (max-width:900px){ .tool-card{ width:98vw; padding:1rem; } }
  </style>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <main class="main-container" role="main">
    <section class="tool-card" aria-labelledby="tool-title">
      <a href="index.html" class="back-link">&larr; Back to Main Menu</a>

      <h3 id="tool-title" class="tool-title"><i class="fa fa-key"></i> Password Generator</h3>

      <a id="read-guide-btn" class="read-guide" href="password-how-to-en.html" role="button">Read full guide</a>

      <div class="password-section" style="margin-top:.6rem;">
        <form id="passwordForm" class="password-form" aria-label="Password generator form" onsubmit="return false;">
          <label style="font-weight:600;">Length:</label>
          <input id="pwLength" type="number" min="4" max="128" value="16" class="form-control" style="max-width:90px;">
          <label><input id="pwUpper" type="checkbox" checked> Upper</label>
          <label><input id="pwLower" type="checkbox" checked> Lower</label>
          <label><input id="pwDigits" type="checkbox" checked> Digits</label>
          <label><input id="pwSymbols" type="checkbox"> Symbols</label>
          <button id="generateBtn" class="btn btn-success btn-sm" type="button">Generate</button>
        </form>

        <div id="pwResult" class="password-result" aria-live="polite"></div>

        <div style="margin-top:.6rem;">
          <button id="copyBtn" class="btn btn-outline-secondary btn-sm" type="button" style="display:none;">Copy</button>
          <button id="clearBtn" class="btn btn-outline-danger btn-sm" type="button" style="display:none; margin-left:6px;">Clear</button>
        </div>
      </div>

      <details class="faq-section">
        <summary style="font-weight:700; font-size:1rem;">FAQs</summary>
        <ul style="padding-left:1.1rem; color:#374151;">
          <li><b>Are passwords saved?</b> No â€” passwords are generated locally and not stored by this page.</li>
          <li><b>Is this secure?</b> Passwords are created using randomization; always keep them private.</li>
          <li><b>Can I copy to clipboard?</b> Yes â€” use the "Copy" button next to the generated password.</li>
        </ul>
      </details>
    </section>
  </main>

<script>
(function() {
  function randInt(max) { return Math.floor(Math.random() * max); }
  function generatePassword(length, upper, lower, digits, symbols) {
    var low = 'abcdefghijklmnopqrstuvwxyz';
    var up = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    var nums = '0123456789';
    var syms = '!@#$%^&*()-_=+[]{};:,.<>?/|`~';
    var chars = '';
    if (lower) chars += low;
    if (upper) chars += up;
    if (digits) chars += nums;
    if (symbols) chars += syms;
    if (!chars) return '';
    var out = '';
    for (var i=0;i<length;i++) out += chars.charAt(randInt(chars.length));
    return out;
  }

  var genBtn = document.getElementById('generateBtn');
  var copyBtn = document.getElementById('copyBtn');
  var clearBtn = document.getElementById('clearBtn');
  var pwResult = document.getElementById('pwResult');

  function doGenerate() {
    var length = parseInt(document.getElementById('pwLength').value) || 16;
    length = Math.max(1, Math.min(128, length));
    var upper = document.getElementById('pwUpper').checked;
    var lower = document.getElementById('pwLower').checked;
    var digits = document.getElementById('pwDigits').checked;
    var symbols = document.getElementById('pwSymbols').checked;
    var pw = generatePassword(length, upper, lower, digits, symbols);
    pwResult.textContent = pw;
    if (pw) { copyBtn.style.display='inline-block'; clearBtn.style.display='inline-block'; } else { copyBtn.style.display='none'; clearBtn.style.display='none'; }
  }

  if (genBtn) genBtn.addEventListener('click', doGenerate);

  if (copyBtn) copyBtn.addEventListener('click', function() {
    var t = pwResult.textContent || '';
    if (!t) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(t).then(function(){
        var old = copyBtn.textContent;
        copyBtn.textContent = old + ' âœ“';
        setTimeout(function(){ copyBtn.textContent = old; }, 1000);
      }, function(){ alert('Could not copy to clipboard.'); });
    } else {
      var ta = document.createElement('textarea');
      ta.value = t;
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch(e) { alert('Could not copy to clipboard.'); }
      document.body.removeChild(ta);
    }
  });

  if (clearBtn) clearBtn.addEventListener('click', function() {
    pwResult.textContent = '';
    copyBtn.style.display = 'none';
    clearBtn.style.display = 'none';
  });

  if (genBtn) genBtn.click();
})();
</script>

<footer>
  &copy; 2025 TimerHaven. All tools are free and privacy-friendly.<br>
