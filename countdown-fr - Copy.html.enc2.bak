  const langNames = { en:"English", fr:"Français", de:"Deutsch", ru:"Русский", el:"Ελληνικά", es:"Español", ar:"العربية" };

  function getLang() {
    try {
      const l = localStorage.getItem('timerhavenLang') || 'fr';
      return (l && l.slice(0,2)) || 'fr';
    } catch (e) {
      return 'fr';
    }
  }

  function applyLanguage(lang) {
    lang = (lang || getLang()).slice(0,2);
    const t = countdownTranslations[lang] || countdownTranslations['fr'];

    // direction for RTL languages
    document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';

    // indicator
    const labelEl = document.getElementById('language-label');
    const nameEl = document.getElementById('language-name');
    if (labelEl) labelEl.textContent = t['language-label'] || 'Langue :';
    if (nameEl) nameEl.textContent = langNames[lang] || lang;

    // main UI strings
    const back = document.getElementById('back-link');
    if (back) back.textContent = t['back-link'] || '';

    const toolTitle = document.getElementById('tool-title');
    if (toolTitle) toolTitle.innerHTML = `<i class="fa fa-stopwatch-20"></i> ${t['tool-title'] || ''}`;

    const help = document.getElementById('tool-help');
    if (help) help.textContent = t['tool-help'] || '';

    // placeholders
    const mins = document.getElementById('minutes');
    const secs = document.getElementById('seconds');
    if (mins) mins.placeholder = t['minutes'] || '';
    if (secs) secs.placeholder = t['seconds'] || '';

    // buttons
    const startBtn = document.getElementById('startBtn');
    const pauseBtn = document.getElementById('pauseBtn');
    const resetBtn = document.getElementById('resetBtn');
    if (startBtn) startBtn.textContent = t['start'] || 'Démarrer';
    if (pauseBtn) pauseBtn.textContent = t['pause'] || 'Pause';
    if (resetBtn) resetBtn.textContent = t['reset'] || 'Réinitialiser';

    // faq & howto & tips
    const faqTitle = document.getElementById('faq-title');
    if (faqTitle) faqTitle.textContent = t['faq-title'] || '';
    const faqList = document.getElementById('faq-list');
    if (faqList) faqList.innerHTML = t['faq-list'] || '';

    const howtoTitle = document.getElementById('howto-title');
    const howtoSteps = document.getElementById('howto-steps');
    if (howtoTitle) howtoTitle.innerHTML = t['howto-title'] || '';
    if (howtoSteps) howtoSteps.innerHTML = t['howto-steps'] || '';

    const howtoBtn = document.getElementById('howto-article-btn');
    if (howtoBtn) {
      howtoBtn.textContent = t['howto-article-btn'] || '';
      howtoBtn.href = t['howto-article-link'] || '';
    }

    // right-column tips (article)
    const tipsTitle = document.getElementById('tips-title');
    const tipsList = document.getElementById('tips-list');
    const tipsBtn = document.getElementById('tips-article-btn');
    if (tipsTitle) tipsTitle.innerHTML = t['tips-title'] || '';
    if (tipsList) tipsList.innerHTML = t['tips-list'] || '';
    if (tipsBtn) { tipsBtn.textContent = t['tips-article-btn'] || ''; tipsBtn.href = t['tips-article-link'] || ''; }

    // display initial
    const disp = document.getElementById('display');
    if (disp) disp.textContent = t['display'] || '00:00';
  }

  // update UI when localStorage changes in other tabs
  window.addEventListener('storage', function(e) {
    if (e.key === 'timerhavenLang') {
      applyLanguage((e.newValue || 'fr').slice(0,2));
    }
  });

  // Timer logic
  let timerInterval = null;
  let totalSeconds = 0;
  let paused = false;

  function updateDisplay() {
    const mins = Math.floor(totalSeconds / 60);
    const secs = totalSeconds % 60;
    const disp = document.getElementById('display');
    if (disp) {
      disp.textContent = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
    }
  }

  document.addEventListener("DOMContentLoaded", function() {
    applyLanguage(getLang());

    totalSeconds = 0;
    updateDisplay();

    const startBtn = document.getElementById('startBtn');
    const pauseBtn = document.getElementById('pauseBtn');
    const resetBtn = document.getElementById('resetBtn');

    if (startBtn) {
      startBtn.addEventListener('click', function() {
        if (timerInterval) return; // already running
        let minutes = parseInt(document.getElementById('minutes').value, 10);
        let seconds = parseInt(document.getElementById('seconds').value, 10);
        minutes = isNaN(minutes) ? 0 : minutes;
        seconds = isNaN(seconds) ? 0 : seconds;
        totalSeconds = minutes * 60 + seconds;
        updateDisplay();
        if (totalSeconds <= 0) return;
        const lang = getLang();
        const t = countdownTranslations[lang] || countdownTranslations['fr'];
        paused = false;
        // ensure pause button shows "Pause"
        if (pauseBtn) pauseBtn.textContent = t['pause'] || 'Pause';

        timerInterval = setInterval(function() {
          if (!paused && totalSeconds > 0) {
            totalSeconds--;
            updateDisplay();
          }
          if (totalSeconds <= 0) {
            clearInterval(timerInterval);
            timerInterval = null;
            try {
              alert(t['alert-end'] || "Le temps est écoulé !");
            } catch (e) {}
            // reset pause button text
            if (pauseBtn) pauseBtn.textContent = t['pause'] || 'Pause';
          }
        }, 1000);
      });
    }

    if (pauseBtn) {
      pauseBtn.addEventListener('click', function() {
        paused = !paused;
        const lang = getLang();
        const t = countdownTranslations[lang] || countdownTranslations['fr'];
        this.textContent = paused ? (t['resume'] || 'Reprendre') : (t['pause'] || 'Pause');
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        clearInterval(timerInterval);
        timerInterval = null;
        totalSeconds = 0;
        updateDisplay();
        const lang = getLang();
        const t = countdownTranslations[lang] || countdownTranslations['fr'];
        const pauseBtnEl = document.getElementById('pauseBtn');
        if (pauseBtnEl) pauseBtnEl.textContent = t['pause'] || 'Pause';
        paused = false;
      });
    }
  });
</script>

