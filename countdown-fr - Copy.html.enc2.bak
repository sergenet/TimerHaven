<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Minuteur Décompte — TimerHaven</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Définissez un compte à rebours pour les échéances, événements ou réunions. Apprenez à utiliser le Minuteur Décompte, obtenez des conseils de productivité, FAQ et articles.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    body { background: #f4f7fb; font-family: 'Montserrat', Arial, sans-serif; }
    .main-container { max-width: 1200px; margin: 2em auto; display: flex; justify-content: center; align-items: center; min-height: 90vh; }
    .center-row, .card-row { display: flex; flex-direction: row; justify-content: center; align-items: stretch; gap: 2em; width: 100%; }
    .article-card, .tool-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 2px 12px #e0e7ef;
      min-width: 220px;
      max-width: 340px;
      width: 340px;
      min-height: 500px;
      flex: 1 1 340px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      padding: 2em 1.3em 1em 1.3em;
      margin: 0;
      box-sizing: border-box;
      text-align: left;
      overflow: hidden;
    }
    .article-card h2, .tool-card h3 {
      font-size: 1.35em;
      font-weight: 700;
      margin-bottom: 0.4em;
      display: flex;
      align-items: center;
      gap: 0.3em;
    }
    .article-card ul, .article-card ol, .tool-card ul, .tool-card ol { 
      margin-left: 1em; font-size: 1em; margin-bottom: 0.2em; padding-right: 0.2em; word-break: break-word; 
    }
    .article-card .btn, .tool-card .btn { 
      align-self: stretch;
      font-weight: 600; 
      border-radius: 8px; 
      margin-top: 0.2em; 
      margin-bottom: 0; 
      box-sizing: border-box;
    }
    .countdown-section { margin-bottom: 1.5em; }
    .countdown-section input[type="number"] { width: 100px; display: inline-block; margin-right: 0.5em; }
    .countdown-section .btn { margin-right: 0.3em; min-width: 80px; margin-bottom: 0.3em;}
    #display { font-size:2em; margin-top:1em; font-weight:700; color:#185a9d; }
    .help-section { margin-bottom: 1em; font-size: 1em; }
    .faq-section { margin-top: 1.1em; margin-bottom: 0.3em; font-size: 1em; background: #f7fafc; border-radius: 8px; padding: 1em; box-shadow: 0 1px 4px #e0e7ef; }
    .faq-section summary { font-weight: bold; font-size: 1.07em; cursor: pointer; margin-bottom: 0.5em; }
    .back-link { display: inline-block; margin-bottom: 1em; color: #007bff; text-decoration: none; font-weight: bold; font-size: 1em; }
    .back-link:hover { text-decoration: underline; }

    /* Non-editable language indicator (top-right) */
    .language-indicator {
      position: fixed;
      right: 18px;
      top: 16px;
      z-index: 12000;
      display:flex;
      align-items:center;
      gap:8px;
      font-weight:700;
      color:#185a9d;
      background: rgba(255,255,255,0.95);
      padding:8px 12px;
      border-radius:10px;
      box-shadow: 0 6px 18px rgba(8,20,40,0.06);
      font-size:0.98em;
    }
    .language-indicator .lang-label { margin-right:6px; }
    .language-indicator .lang-name {
      background: linear-gradient(90deg,#43cea2 0%,#185a9d 100%);
      color:#fff;
      padding:6px 10px;
      border-radius:8px;
      font-weight:700;
      box-shadow: 0 2px 8px #e0e7ef;
    }

    @media (max-width: 1100px) {
      .main-container{padding:0 8px;}
      .center-row, .card-row{gap:1em;}
      .tool-card,.article-card{width:97vw;max-width:540px;height:auto;}
    }
    @media (max-width: 800px) {
      .main-container{padding:0;}
      .center-row, .card-row{flex-direction:column;align-items:center;}
      .tool-card,.article-card{width:98vw;max-width:540px;height:auto;}
      .article-card { display: none !important; }
    }
    details[open] summary::after { content: " ▲"; font-size: 0.9em; }
    details summary { cursor: pointer; padding: 0.35em 0; font-weight: bold; font-size: 1.09em; }
    details:not([open]) summary::after { content: " ▼"; font-size: 0.9em; }
  </style>
<script>

</script>
