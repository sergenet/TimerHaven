  <!-- Force French for local-file testing so the local file opens in French -->
  <script>try{ localStorage.setItem('timerhavenLang','fr'); }catch(e){}</script>

  <div class="language-indicator" id="language-indicator" role="status" aria-live="polite" title="Langue sélectionnée depuis le menu principal">
    <span class="lang-label" id="language-label">Langue :</span>
    <span class="lang-name" id="language-name">Français</span>
  </div>

<div class="main-container">
  <div class="center-row">
    <!-- Article 1 (desktop only) -->
    <div class="article-card">
      <div>
        <h2 id="howto-title"></h2>
        <ol id="howto-steps"></ol>
      </div>
      <a href="#" class="btn btn-outline-primary btn-sm" id="howto-article-btn"></a>
    </div>

    <!-- Countdown Tool -->
    <div class="tool-card">
      <a href="index.html" class="back-link" id="back-link"></a>
      <h3 id="tool-title"></h3>
      <div class="help-section" id="tool-help"></div>

      <div class="countdown-section">
        <div>
          <input type="number" id="minutes" placeholder="" min="0" class="form-control" aria-label="minutes">
          <input type="number" id="seconds" placeholder="" min="0" max="59" class="form-control" aria-label="seconds">
        </div>

        <div style="margin-top:0.8em;">
          <button class="btn btn-success" id="startBtn"></button>
          <button class="btn btn-secondary" id="pauseBtn"></button>
          <button class="btn btn-danger" id="resetBtn"></button>
        </div>

        <div id="display" aria-live="polite">00:00</div>
      </div>

      <details class="faq-section">
        <summary id="faq-title"></summary>
        <ul id="faq-list" style="padding-left: 1em;"></ul>
      </details>
    </div>

    <!-- Article 2 (desktop only) -->
    <div class="article-card">
      <div>
        <h2 id="tips-title"></h2>
        <ul id="tips-list"></ul>
      </div>
      <a href="#" class="btn btn-outline-primary btn-sm" id="tips-article-btn"></a>
    </div>
  </div>
</div>

