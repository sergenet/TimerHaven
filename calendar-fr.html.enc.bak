<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="google" content="notranslate">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Calendrier â€” TimerHaven</title>
  <meta name="description" content="Enregistrez et gÃ©rez facilement plusieurs notes de calendrier. Astuces, FAQ et articles disponibles.">
  <meta name="author" content="Serge Shammas">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/tool-theme.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

  <style>
    :root { --brand:#185a9d; --muted:#6b7c89; }

    html,body { height:100%; }
    body { background:#f4f7fb; margin:0; font-family:Inter, "Helvetica Neue", Arial, sans-serif; color:#102a43; }

    .main-container { max-width:720px; margin:2.5rem auto; padding:0 1rem; min-height:80vh; display:flex; align-items:flex-start; justify-content:center; }
    .tool-card { width:100%; max-width:640px; background:#fff; border-radius:12px; padding:18px; box-shadow:0 10px 30px rgba(16,42,67,0.06); box-sizing:border-box; }

    .back-link { display:inline-block; margin-bottom:.6rem; color:var(--brand); text-decoration:none; font-weight:700; }
    .tool-title { font-size:1.35rem; margin:0 0 .5rem 0; display:flex; align-items:center; gap:.5rem; color:var(--brand) !important; }
    .read-guide {
      display:inline-block; margin:.35rem 0 .8rem 0; padding:.45rem .8rem; border-radius:8px; background:var(--brand);
      color:#fff; text-decoration:none; font-weight:700; font-size:.95rem; border:none;
    }
    .small-muted{ color:var(--muted); font-size:.95rem; margin-bottom:.8rem; }

    .calendar-header { display:flex; align-items:center; gap:.6rem; margin-bottom:.8rem; white-space:nowrap; flex-wrap:wrap; justify-content:space-between; }
    .calendar-nav { display:flex; gap:.35rem; align-items:center; flex-shrink:0; }
    .calendar-nav .btn { min-width:36px; padding:.2rem .4rem; height:34px; display:inline-flex; align-items:center; justify-content:center; }

    .right-controls { display:flex; gap:.45rem; align-items:center; flex-shrink:0; min-width:0; }
    .calendar-select {
      border-radius:8px; padding:.18rem .32rem; border:1px solid #e4edf5; background:#fff; font-size:.92rem; height:34px;
      box-sizing:border-box; flex-shrink:0; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    .calendar-select.month { width:110px; max-width:150px; }
    .calendar-select.year  { width:90px; max-width:120px; }
    #default-start-time.calendar-select { width:120px; max-width:150px; padding:.18rem .36rem; text-align:center; font-size:.9rem; }

    .calendar-table { width:100%; margin-top:1rem; border-collapse: separate; border-spacing:0; background:#fff; border-radius:8px; overflow:hidden; min-height:360px; table-layout:auto; }
    .calendar-table thead th { text-align:center; font-weight:700; padding:.6rem .3rem; border-bottom:1px solid #eef2f6; background:#fff; }
    .calendar-table tbody td { text-align:center; vertical-align:middle; padding:.5rem .25rem; height:52px; }

    .day-cell { cursor:pointer; border-radius:6px; transition:background .12s; display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; margin:0 auto; padding:0; box-sizing:border-box; }
    .day-cell:hover, .day-cell:focus { background:#eef6fb; outline:none; }
    .has-note { background:#fff5d6 !important; }
    .calendar-today { display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; background:linear-gradient(180deg,#e6f7ff 0%,#cfefff 100%); color:#004e73; border-radius:50%; font-weight:700; border:1px solid rgba(0,126,204,0.18); box-shadow:0 4px 12px rgba(24,144,255,0.08); padding:0; margin:0; }

    .note-list { list-style:none; padding:0; margin:0; }
    .note-list li { border-radius:6px; margin-bottom:.45rem; background:#f7fafc; padding:.5rem; display:flex; justify-content:space-between; gap:.6rem; align-items:center; }
    .note-text { flex:1; word-break:break-word; }
    .note-meta { color:var(--muted); font-size:.9rem; margin-left:.6rem; white-space:nowrap; }
    .delete-note-btn { background:none; border:none; color:#c00; cursor:pointer; font-size:1rem; padding:.15rem; }

    details.faq-section summary { cursor:pointer; padding:.2rem 0; font-weight:600; }
    details.faq-section ul { margin-top:.5rem; color:var(--muted); padding-left:1rem; }

    @media (max-width:520px) {
      .calendar-header { gap:.5rem; }
      .right-controls { flex:1 1 100%; width:100%; margin-left:0; justify-content:flex-start; }
      .calendar-select { max-width:48%; }
      #default-start-time.calendar-select { width:120px; max-width:48%; }
    }
  </style>
<script>

</script>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <main class="main-container" role="main">
    <section class="tool-card" aria-labelledby="tool-title">
      <a id="back-link" class="back-link" href="index.html">â† Retour au menu principal</a>

      <h3 id="tool-title" class="tool-title"><i class="fa fa-calendar-days"></i> Calendrier</h3>
      <a id="read-guide-btn" class="read-guide" href="https://timerhaven.com/fr/calendar-planning/calendar-planning-index.html" role="button" target="_blank" rel="noopener">Lire le guide complet</a>

      <div class="small-muted" id="tool-help">Cliquez sur un jour pour ajouter/voir/modifier vos notes. Plusieurs notes par jour sont possibles et enregistrÃ©es !</div>

      <div class="calendar-header" aria-label="Navigation du calendrier">
        <div class="calendar-nav" role="toolbar" aria-label="Navigation mois/annÃ©e">
          <button id="nav-prev-year" class="btn btn-sm btn-outline-secondary" aria-label="AnnÃ©e prÃ©cÃ©dente">Â«</button>
          <button id="nav-prev-month" class="btn btn-sm btn-outline-secondary" aria-label="Mois prÃ©cÃ©dent">â€¹</button>
          <button id="nav-today" class="btn btn-sm btn-outline-secondary" aria-label="Aujourd'hui">Aujourd'hui</button>
          <button id="nav-next-month" class="btn btn-sm btn-outline-secondary" aria-label="Mois suivant">â€º</button>
          <button id="nav-next-year" class="btn btn-sm btn-outline-secondary" aria-label="AnnÃ©e suivante">Â»</button>
        </div>

        <div class="right-controls">
          <select id="calendar-month-select" class="calendar-select month" aria-label="SÃ©lectionner le mois"></select>
          <select id="calendar-year-select" class="calendar-select year" aria-label="SÃ©lectionner l'annÃ©e"></select>
          <input id="default-start-time" class="calendar-select" type="time" aria-label="Heure de dÃ©but par dÃ©faut" title="Heure de dÃ©but par dÃ©faut pour la premiÃ¨re note">
        </div>
      </div>

      <table id="calendar-table" class="calendar-table table" role="grid" aria-describedby="tool-help"></table>

      <details class="faq-section" id="faq-section" style="margin-top:12px;">
        <summary id="faq-title">FAQ â–¾</summary>
        <ul id="faq-list" style="margin-top:.5rem;"></ul>
      </details>
    </section>
  </main>

  <!-- Notes Modal -->
  <div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
      <form id="noteForm" autocomplete="off">
        <div class="modal-header">
          <h5 class="modal-title" id="noteModalLabel"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body">
          <ul id="noteList" class="note-list" aria-live="polite"></ul>
          <textarea id="noteInput" class="form-control" rows="3" placeholder="Ajouter une nouvelle note pour ce jour..."></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="note-close-btn">Fermer</button>
          <button type="submit" class="btn btn-success" id="note-add-btn">Ajouter la note</button>
        </div>
      </form>
    </div></div>
  </div>

  <footer style="text-align:center;padding:18px 12px;color:var(--muted);">Â© 2025 TimerHaven. Outils gratuits et respectueux de la vie privÃ©e. <a href="/privacy.html">Politique de confidentialitÃ©</a> Â· <a href="/contact.html">Contact</a></footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Force French UI for this file (safe)
    try { localStorage.setItem('timerhavenLang','fr'); } catch (e) {}

    // locale-specific storage keys
    const STORAGE_KEY = 'calendarNotes_fr';
    const DEFAULT_START_KEY = 'calendarDefaultStart_fr';

    // load notes (may be legacy)
    let notes = {};
    try { notes = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch(e) { notes = {}; console.error('notes parse error', e); }

    let currentYear, currentMonth, selectedDay;
    let controlsHooked = false;

    const translations = {
      fr: {
        "back-link":"Retour au menu principal",
        "tool-title":"Calendrier",
        "tool-help":"Cliquez sur un jour pour ajouter/voir/modifier vos notes. Plusieurs notes par jour sont possibles et enregistrÃ©es !",
        "faq-list": `<li><strong>Mes notes sont-elles sauvegardÃ©es ?</strong> Oui ! Les notes sont enregistrÃ©es dans votre navigateur et restent jusqu'Ã  leur suppression.</li>
                     <li><strong>Puis-je ajouter plusieurs notes ?</strong> Oui.</li>`,
        "noteModalLabel":"Notes pour",
        "noteInput":"Ajouter une nouvelle note pour ce jour...",
        "note-none":"Aucune note pour ce jour.",
        "note-delete":"Supprimer cette note",
        "note-close-btn":"Fermer",
        "note-add-btn":"Ajouter la note",
        "days":["Dim","Lun","Mar","Mer","Jeu","Ven","Sam"],
        "months": ["janvier","fÃ©vrier","mars","avril","mai","juin","juillet","aoÃ»t","septembre","octobre","novembre","dÃ©cembre"]
      },
      en: {
        "back-link":"Back to Main Menu",
        "tool-title":"Calendar",
        "tool-help":"Click any day to add/view/edit your notes. Multiple notes per day are supported and persist!",
        "faq-list": `<li><strong>Are my notes saved?</strong> Yes! Notes are saved in your browser and remain until you delete them.</li>`,
        "noteModalLabel":"Notes for",
        "noteInput":"Add a new note for this day...",
        "note-none":"No notes yet for this day.",
        "note-delete":"Delete this note",
        "note-close-btn":"Close",
        "note-add-btn":"Add Note",
        "days":["Sun","Mon","Tue","Wed","Thu","Fri","Sat"]
      }
    };

    function getLang() { return localStorage.getItem('timerhavenLang') || 'fr'; }

    function parseDurationFromText(text) {
      if (!text || typeof text !== 'string') return null;
      const rangeMatch = text.match(/(\d{1,3})\s*(?:â€“|-)\s*(\d{1,3})\s*(?:minutes?|mins?|min|minutes|mn)/i);
      if (rangeMatch) return parseInt(rangeMatch[1], 10);
      const singleMatch = text.match(/(\d{1,3})\s*(?:minutes?|mins?|min|minutes|mn)/i);
      if (singleMatch) return parseInt(singleMatch[1], 10);
      return null;
    }

    function escapeHtml(s) {
      if (!s) return '';
      return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;');
    }

    function formatTime(date) {
      if (!(date instanceof Date)) date = new Date(date);
      return date.toLocaleTimeString('fr-FR', { hour:'numeric', minute:'2-digit' });
    }

    function getDefaultStartTime(){ return localStorage.getItem(DEFAULT_START_KEY) || '20:00'; }
    function setDefaultStartTime(v){ localStorage.setItem(DEFAULT_START_KEY, v); }

    function dateFromDateStrAndTime(dateStr, timeStr){
      const [y,m,d] = dateStr.split('-').map(Number);
      const [hh=0, mm=0] = (timeStr || '00:00').split(':').map(Number);
      return new Date(y, m-1, d, hh, mm, 0, 0);
    }

    function migrateLegacyNotes(raw){
      if (!Array.isArray(raw)) return [];
      return raw.map(n => {
        if (typeof n === 'string') {
          return { text: n, durationMinutes: parseDurationFromText(n) || null, createdAt: null };
        }
        if (n && typeof n === 'object') {
          const createdAt = n.createdAt ? n.createdAt : (n.ts ? new Date(n.ts).toISOString() : null);
          return {
            text: n.text || String(n),
            durationMinutes: (typeof n.durationMinutes === 'number') ? n.durationMinutes : parseDurationFromText(n.text) || null,
            createdAt: createdAt
          };
        }
        return { text: String(n), durationMinutes: null, createdAt: null };
      });
    }

    function populateMonthYearControls(year, month, lang) {
      lang = lang || getLang();
      const monthSelect = document.getElementById('calendar-month-select');
      const yearSelect = document.getElementById('calendar-year-select');
      if (!monthSelect || !yearSelect) return;
      const monthNames = (translations[lang] && translations[lang].months) ? translations[lang].months : null;
      monthSelect.innerHTML = '';
      for (let m=0;m<12;m++){
        const opt = document.createElement('option');
        opt.value = String(m);
        opt.textContent = monthNames ? monthNames[m] : new Intl.DateTimeFormat('fr-FR', { month:'long' }).format(new Date(2000,m,1));
        if (m===month) opt.selected = true;
        monthSelect.appendChild(opt);
      }
      const now = new Date(); const base = now.getFullYear(); const start = base - 50; const end = base + 50;
      yearSelect.innerHTML = '';
      for (let y=start;y<=end;y++){ const opt=document.createElement('option'); opt.value=String(y); opt.textContent=String(y); if(y===year) opt.selected=true; yearSelect.appendChild(opt); }
    }

    function renderCalendar(year, month, lang) {
      currentYear = year; currentMonth = month; lang = lang || getLang();
      const table = document.getElementById('calendar-table');
      if (!table) return;
      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month+1, 0).getDate();
      let html = '<thead><tr>';
      const dayNames = (translations[lang] && translations[lang].days) ? translations[lang].days : translations['fr'].days;
      dayNames.forEach(d => html += `<th>${d}</th>`);
      html += '</tr></thead><tbody><tr>';
      for (let i=0;i<firstDay;i++) html += '<td></td>';
      const now = new Date(); const todayY = now.getFullYear(), todayM = now.getMonth(), todayD = now.getDate();
      for (let d=1; d<=daysInMonth; d++){
        const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const rawDayNotes = notes[dateStr] || [];
        const dayNotes = migrateLegacyNotes(rawDayNotes);
        const hasNote = dayNotes.length > 0;
        if ((firstDay + d - 1) % 7 === 0 && d !== 1) html += '</tr><tr>';
        const isToday = (d===todayD && month===todayM && year===todayY);
        html += `<td class="day-cell${hasNote ? ' has-note' : ''}${isToday ? ' calendar-today' : ''}" data-date="${dateStr}" style="display:table-cell !important; vertical-align:middle;">${d}${hasNote ? ' <span title="Notes enregistrÃ©es">ðŸ“</span>' : ''}</td>`;
      }
      html += '</tr></tbody>';
      table.innerHTML = html;
      populateMonthYearControls(currentYear, currentMonth, lang);
      Array.from(document.getElementsByClassName('day-cell')).forEach(cell => {
        cell.addEventListener('click', function(){ selectedDay = this.getAttribute('data-date'); showNoteModal(selectedDay); });
      });
    }

    function renderNoteList(dateStr){
      const ul = document.getElementById('noteList'); if(!ul) return; ul.innerHTML = '';
      const rawDayNotes = notes[dateStr] || []; const dayNotes = migrateLegacyNotes(rawDayNotes);
      try { if (JSON.stringify(rawDayNotes) !== JSON.stringify(dayNotes)) { notes[dateStr] = dayNotes; localStorage.setItem(STORAGE_KEY, JSON.stringify(notes)); } } catch(e){}
      if (dayNotes.length === 0) { ul.innerHTML = `<li style="color:#888;">${translations['fr']['note-none']}</li>`; return; }
      let baseTime;
      if (dayNotes[0] && dayNotes[0].createdAt) { const parsed = new Date(dayNotes[0].createdAt); baseTime = !isNaN(parsed) ? parsed : dateFromDateStrAndTime(dateStr, getDefaultStartTime()); } else { baseTime = dateFromDateStrAndTime(dateStr, getDefaultStartTime()); }
      let currentTime = new Date(baseTime.getTime());
      dayNotes.forEach((noteObj, idx) => {
        const duration = (typeof noteObj.durationMinutes === 'number' && !isNaN(noteObj.durationMinutes)) ? noteObj.durationMinutes : parseDurationFromText(noteObj.text) || 5;
        const li = document.createElement('li');
        li.className = 'list-group-item d-flex justify-content-between align-items-start';
        const left = document.createElement('div'); left.style.flex='1 1 auto';
        left.innerHTML = `<div style="font-weight:500;">${escapeHtml(noteObj.text)}</div><div style="color:#6b7c89;font-size:.9rem;">DÃ©but : <strong>${formatTime(currentTime)}</strong> Â· DurÃ©e : ${duration} min</div>`;
        const del = document.createElement('button'); del.className='btn btn-sm btn-outline-danger ms-3'; del.type='button'; del.setAttribute('aria-label', translations['fr']['note-delete']); del.innerHTML = '<i class="fa fa-trash-alt"></i>';
        del.addEventListener('click', function(){ const arr = notes[dateStr] || []; arr.splice(idx,1); notes[dateStr] = arr; try { localStorage.setItem(STORAGE_KEY, JSON.stringify(notes)); } catch(e){ console.error('save notes error', e); } renderNoteList(dateStr); renderCalendar(currentYear, currentMonth); });
        li.appendChild(left); li.appendChild(del); ul.appendChild(li);
        currentTime.setMinutes(currentTime.getMinutes() + duration);
      });
    }

    // Add note form
    document.getElementById('noteForm').addEventListener('submit', function(e){
      e.preventDefault();
      if (!selectedDay) return;
      const text = document.getElementById('noteInput').value.trim(); if (!text) return;
      notes[selectedDay] = notes[selectedDay] || [];
      const dur = parseDurationFromText(text) || 5;
      const existing = notes[selectedDay] || [];
      const createdAt = (existing.length === 0) ? dateFromDateStrAndTime(selectedDay, getDefaultStartTime()).toISOString() : new Date().toISOString();
      const item = { text: text, durationMinutes: dur, createdAt: createdAt };
      notes[selectedDay].push(item);
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(notes)); } catch(e){ console.error('save notes error', e); }
      document.getElementById('noteInput').value = '';
      renderNoteList(selectedDay);
      renderCalendar(currentYear, currentMonth, getLang());
    });

    window.deleteNote = function(dateStr, idx){
      if (!notes[dateStr]) return;
      notes[dateStr].splice(idx,1);
      if (!notes[dateStr].length) delete notes[dateStr];
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(notes)); } catch(e){ console.error('save notes error', e); }
      renderNoteList(dateStr);
      renderCalendar(currentYear, currentMonth, getLang());
    };

    // navigation & controls
    function hookupCalendarControls(){
      if (controlsHooked) return; controlsHooked = true;
      const prevYear=document.getElementById('nav-prev-year'), prevMonth=document.getElementById('nav-prev-month'), nextMonth=document.getElementById('nav-next-month'), nextYear=document.getElementById('nav-next-year'), todayBtn=document.getElementById('nav-today');
      prevYear && prevYear.addEventListener('click', ()=> renderCalendar(currentYear-1, currentMonth, getLang()));
      nextYear && nextYear.addEventListener('click', ()=> renderCalendar(currentYear+1, currentMonth, getLang()));
      prevMonth && prevMonth.addEventListener('click', ()=> { let y=currentYear,m=currentMonth-1; if(m<0){m=11;y--;} renderCalendar(y,m,getLang()); });
      nextMonth && nextMonth.addEventListener('click', ()=> { let y=currentYear,m=currentMonth+1; if(m>11){m=0;y++;} renderCalendar(y,m,getLang()); });
      todayBtn && todayBtn.addEventListener('click', ()=> { const n=new Date(); renderCalendar(n.getFullYear(), n.getMonth(), getLang()); });
      const mSel=document.getElementById('calendar-month-select'), ySel=document.getElementById('calendar-year-select');
      if (mSel && ySel) { mSel.addEventListener('change', ()=> renderCalendar(parseInt(ySel.value,10), parseInt(mSel.value,10), getLang())); ySel.addEventListener('change', ()=> renderCalendar(parseInt(ySel.value,10), parseInt(mSel.value,10), getLang())); }
      const defaultTimeInput = document.getElementById('default-start-time');
      if (defaultTimeInput) { defaultTimeInput.value = getDefaultStartTime(); defaultTimeInput.addEventListener('change', function(){ setDefaultStartTime(this.value); }); }
    }

    document.addEventListener('DOMContentLoaded', function(){
      const now = new Date(); currentYear = now.getFullYear(); currentMonth = now.getMonth();
      // populate static UI strings
      document.getElementById('back-link') && (document.getElementById('back-link').textContent = translations['fr']['back-link']);
      document.getElementById('tool-title') && (document.getElementById('tool-title').innerHTML = `<i class="fa fa-calendar-days"></i> ${translations['fr']['tool-title']}`);
      document.getElementById('tool-help') && (document.getElementById('tool-help').textContent = translations['fr']['tool-help']);
      document.getElementById('faq-list') && (document.getElementById('faq-list').innerHTML = translations['fr']['faq-list']);
      document.getElementById('noteModalLabel') && (document.getElementById('noteModalLabel').innerHTML = `${translations['fr']['noteModalLabel']} <span id="modal-date-label"></span>`);
      document.getElementById('noteInput') && (document.getElementById('noteInput').placeholder = translations['fr']['noteInput']);
      document.getElementById('note-close-btn') && (document.getElementById('note-close-btn').textContent = translations['fr']['note-close-btn']);
      document.getElementById('note-add-btn') && (document.getElementById('note-add-btn').textContent = translations['fr']['note-add-btn']);

      populateMonthYearControls(currentYear, currentMonth);
      hookupCalendarControls();
      renderCalendar(currentYear, currentMonth);
    });
  </script>
</body>
</html>


