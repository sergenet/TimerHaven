<script>
    // Robust go-back: use history.back() only when referrer clearly indicates we came from the localized currency page.
    function goBackOrFallback(e) {
      try {
        const ref = (document.referrer || '').toLowerCase();
        const localized = '/currency-de.html';
        // If the previous page is the localized currency page on the same origin, prefer history.back()
        if (ref && (ref.endsWith(localized) || ref.indexOf(location.origin + localized) === 0)) {
          e.preventDefault();
          // Use back() so we preserve the user's history flow
          window.history.back();
          return false;
        }
      } catch (err) {
        // ignore and fallback to replace below
      }
      // Fallback: navigate to the localized currency page and replace history entry to avoid an extra history entry
      try {
        e.preventDefault();
        window.location.replace('/currency-de.html');
        return false;
      } catch (err) {
        // If replace fails for any reason, allow normal anchor navigation as last resort
        return true;
      }
    }
  </script>
