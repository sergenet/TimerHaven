<script>
  // Canonical conversion factors (keys are canonical English identifiers)
  const unitTypes = {
    length: { units: { "Meter":1,"Kilometer":1000,"Centimeter":0.01,"Millimeter":0.001,"Mile":1609.344,"Yard":0.9144,"Foot":0.3048,"Inch":0.0254 }, convert:(v,f,t)=> v*unitTypes.length.units[f]/unitTypes.length.units[t] },
    weight: { units: { "Kilogram":1,"Gram":0.001,"Milligram":0.000001,"Pound":0.45359237,"Ounce":0.028349523125,"Ton (metric)":1000 }, convert:(v,f,t)=> v*unitTypes.weight.units[f]/unitTypes.weight.units[t] },
    temperature: { units: {"Celsius":"C","Fahrenheit":"F","Kelvin":"K"}, convert:(val,from,to)=>{ if(from===to) return val; if(from==="Celsius"&&to==="Fahrenheit") return val*9/5+32; if(from==="Fahrenheit"&&to==="Celsius") return (val-32)*5/9; if(from==="Celsius"&&to==="Kelvin") return val+273.15; if(from==="Kelvin"&&to==="Celsius") return val-273.15; if(from==="Fahrenheit"&&to==="Kelvin") return (val-32)*5/9+273.15; if(from==="Kelvin"&&to==="Fahrenheit") return (val-273.15)*9/5+32 } },
    volume: { units: {"Liter":1,"Milliliter":0.001,"Cubic meter":1000,"US gallon":3.785411784,"US quart":0.946352946,"US pint":0.473176473,"Imperial gallon":4.54609,"Cubic inch":0.016387064,"Cubic foot":28.316846592}, convert:(v,f,t)=> v*unitTypes.volume.units[f]/unitTypes.volume.units[t] },
    area: { units: {"Square meter":1,"Square kilometer":1e6,"Hectare":10000,"Acre":4046.8564224,"Square mile":2589988.110336,"Square foot":0.09290304,"Square yard":0.83612736,"Square inch":0.00064516}, convert:(v,f,t)=> v*unitTypes.area.units[f]/unitTypes.area.units[t] },
    speed: { units: {"m/s":1,"km/h":1/3.6,"mph":0.44704,"knots":0.514444}, convert:(v,f,t)=> v*unitTypes.speed.units[f]/unitTypes.speed.units[t] },
    time: { units: {"Second":1,"Minute":60,"Hour":3600,"Day":86400,"Week":604800}, convert:(v,f,t)=> v*unitTypes.time.units[f]/unitTypes.time.units[t] },
    pressure: { units: {"Pascal":1,"kPa":1000,"Bar":100000,"atm":101325,"psi":6894.757293168}, convert:(v,f,t)=> v*unitTypes.pressure.units[f]/unitTypes.pressure.units[t] },
    energy: { units: {"Joule":1,"Kilojoule":1000,"Calorie":4.184,"kcal":4184,"Wh":3600}, convert:(v,f,t)=> v*unitTypes.energy.units[f]/unitTypes.energy.units[t] },
    power: { units: {"Watt":1,"Kilowatt":1000,"Horsepower (metric)":735.49875,"Horsepower (mechanical)":745.69987158227022}, convert:(v,f,t)=> v*unitTypes.power.units[f]/unitTypes.power.units[t] },
    data: {
      unitsSI: {"Byte":1,"KB":1e3,"MB":1e6,"GB":1e9,"TB":1e12},
      unitsBin: {"Byte":1,"KiB":1024,"MiB":1024**2,"GiB":1024**3,"TiB":1024**4},
      convert:(v,f,t,mode='SI')=>{
        const table = (mode==='Bin') ? unitTypes.data.unitsBin : unitTypes.data.unitsSI;
        if (!table[f] || !table[t]) return NaN;
        return v * table[f] / table[t];
      }
    },
    fuel: {
      units: {"L/100km":"L100","mpg (US)":"mpgus","mpg (UK)":"mpguk"},
      convert:(val,from,to)=>{
        if (from === to) return val;
        const toL100 = (v,src)=>{ if(src==="L/100km") return v; if(src==="mpg (US)") return 235.214583 / v; if(src==="mpg (UK)") return 282.480936 / v; };
        const fromL100 = (l100,dst)=>{ if(dst==="L/100km") return l100; if(dst==="mpg (US)") return 235.214583 / l100; if(dst==="mpg (UK)") return 282.480936 / l100; };
        const l100 = toL100(val,from);
        return fromL100(l100,to);
      }
    },
    angle: { units: {"Degree":1,"Radian":(180/Math.PI),"Gradian":0.9}, convert:(v,f,t)=> v*unitTypes.angle.units[f]/unitTypes.angle.units[t] },
    frequency: { units: {"Hz":1,"kHz":1e3,"MHz":1e6,"GHz":1e9}, convert:(v,f,t)=> v*unitTypes.frequency.units[f]/unitTypes.frequency.units[t] }
  };

  // Arabic display labels for units (keyed by canonical English key)
  const AR_LABELS = {
    "Meter":"Ù…ØªØ±","Kilometer":"ÙƒÙŠÙ„ÙˆÙ…ØªØ±","Centimeter":"Ø³Ù†ØªÙŠÙ…ØªØ±","Millimeter":"Ù…Ù„Ù„ÙŠÙ…ØªØ±","Mile":"Ù…ÙŠÙ„","Yard":"ÙŠØ§Ø±Ø¯","Foot":"Ù‚Ø¯Ù…","Inch":"Ø¨ÙˆØµØ©",
    "Kilogram":"ÙƒÙŠÙ„ÙˆØºØ±Ø§Ù…","Gram":"Ø¬Ø±Ø§Ù…","Milligram":"Ù…Ù„ÙŠØºØ±Ø§Ù…","Pound":"Ø±Ø·Ù„","Ounce":"Ø£ÙˆÙ‚ÙŠØ©","Ton (metric)":"Ø·Ù† Ù…ØªØ±ÙŠ",
    "Celsius":"Ø¯Ø±Ø¬Ø© Ù…Ø¦ÙˆÙŠØ©","Fahrenheit":"Ø¯Ø±Ø¬Ø© ÙÙ‡Ø±Ù†Ù‡Ø§ÙŠØª","Kelvin":"ÙƒÙ„ÙÙ†",
    "Liter":"Ù„ØªØ±","Milliliter":"Ù…Ù„Ù„ÙŠÙ„ØªØ±","Cubic meter":"Ù…ØªØ± Ù…ÙƒØ¹Ø¨","US gallon":"ØºØ§Ù„ÙˆÙ† Ø£Ù…Ø±ÙŠÙƒÙŠ","US quart":"Ø±Ø¨Ø¹ ØºØ§Ù„ÙˆÙ† (Ø£Ù…Ø±ÙŠÙƒÙŠ)","US pint":"Ø¨Ø§ÙŠÙ†Øª (Ø£Ù…Ø±ÙŠÙƒÙŠ)","Imperial gallon":"ØºØ§Ù„ÙˆÙ† Ø¥Ù…Ø¨Ø±Ø§Ø·ÙˆØ±ÙŠ","Cubic inch":"Ø¨ÙˆØµØ© Ù…ÙƒØ¹Ø¨Ø©","Cubic foot":"Ù‚Ø¯Ù… Ù…ÙƒØ¹Ø¨",
    "Square meter":"Ù…ØªØ± Ù…Ø±Ø¨Ø¹","Square kilometer":"ÙƒÙŠÙ„ÙˆÙ…ØªØ± Ù…Ø±Ø¨Ø¹","Hectare":"Ù‡ÙƒØªØ§Ø±","Acre":"ÙØ¯Ø§Ù†","Square mile":"Ù…ÙŠÙ„ Ù…Ø±Ø¨Ø¹","Square foot":"Ù‚Ø¯Ù… Ù…Ø±Ø¨Ø¹","Square yard":"ÙŠØ§Ø±Ø¯ Ù…Ø±Ø¨Ø¹","Square inch":"Ø¨ÙˆØµØ© Ù…Ø±Ø¨Ø¹Ø©",
    "m/s":"Ù…ØªØ±/Ø«Ø§Ù†ÙŠØ©","km/h":"ÙƒÙ…/Ø³Ø§Ø¹Ø©","mph":"Ù…ÙŠÙ„/Ø³Ø§Ø¹Ø©","knots":"Ø¹Ù‚Ø¯Ø©",
    "Second":"Ø«Ø§Ù†ÙŠØ©","Minute":"Ø¯Ù‚ÙŠÙ‚Ø©","Hour":"Ø³Ø§Ø¹Ø©","Day":"ÙŠÙˆÙ…","Week":"Ø£Ø³Ø¨ÙˆØ¹",
    "Pascal":"Ø¨Ø§Ø³ÙƒØ§Ù„","kPa":"ÙƒÙŠÙ„Ùˆ Ø¨Ø§Ø³ÙƒØ§Ù„","Bar":"Ø¨Ø§Ø±","atm":"Ø¬Ùˆ (atm)","psi":"Ø±Ø·Ù„/Ø¨ÙˆØµØ©Â²",
    "Joule":"Ø¬ÙˆÙ„","Kilojoule":"ÙƒÙŠÙ„ÙˆØ¬ÙˆÙ„","Calorie":"Ø³Ø¹Ø± Ø­Ø±Ø§Ø±ÙŠ","kcal":"ÙƒÙŠÙ„Ùˆ ÙƒØ§Ù„ÙˆØ±ÙŠ","Wh":"ÙˆØ§Ø· Ø³Ø§Ø¹Ø©",
    "Watt":"ÙˆØ§Ø·","Kilowatt":"ÙƒÙŠÙ„ÙˆÙˆØ§Ø·","Horsepower (metric)":"Ø­ØµØ§Ù† (Ù…ØªØ±ÙŠ)","Horsepower (mechanical)":"Ø­ØµØ§Ù† Ù…ÙŠÙƒØ§Ù†ÙŠÙƒÙŠ",
    "Byte":"Ø¨Ø§ÙŠØª","KB":"ÙƒÙŠÙ„ÙˆØ¨Ø§ÙŠØª","MB":"Ù…ÙŠØºØ§Ø¨Ø§ÙŠØª","GB":"ØºÙŠØºØ§Ø¨Ø§ÙŠØª","TB":"ØªÙŠØ±Ø§Ø¨Ø§ÙŠØª",
    "KiB":"ÙƒÙŠØ¨ÙŠØ¨Ø§ÙŠØª","MiB":"Ù…ÙŠØ¨ÙŠØ¨Ø§ÙŠØª","GiB":"Ø¬ÙŠØ¨ÙŠØ¨Ø§ÙŠØª","TiB":"ØªÙŠØ¨ÙŠØ¨Ø§ÙŠØª",
    "L/100km":"Ù„ØªØ±/100ÙƒÙ…","mpg (US)":"Ù…ÙŠÙ„/ØºØ§Ù„ÙˆÙ† (Ø£Ù…Ø±ÙŠÙƒÙŠ)","mpg (UK)":"Ù…ÙŠÙ„/ØºØ§Ù„ÙˆÙ† (Ø¨Ø±ÙŠØ·Ø§Ù†ÙŠØ§)",
    "Degree":"Ø¯Ø±Ø¬Ø©","Radian":"Ø±Ø§Ø¯ÙŠØ§Ù†","Gradian":"ØºØ±Ø§Ø¯ÙŠØ§Ù†",
    "Hz":"Ù‡Ø±ØªØ²","kHz":"ÙƒÙŠÙ„ÙˆÙ‡Ø±ØªØ²","MHz":"Ù…ÙŠØºØ§Ù‡Ø±ØªØ²","GHz":"ØºÙŠØºØ§Ù‡Ø±ØªØ²"
  };

  // Persistence keys
  const LS_KEYS = { lastType:'th_unit_lastType_ar', lastFrom:'th_unit_lastFrom_ar', lastTo:'th_unit_lastTo_ar', lastValue:'th_unit_lastValue_ar', lastPrecision:'th_unit_lastPrecision_ar', dataMode:'th_unit_dataMode_ar' };
  function saveState(k,v){ try{ localStorage.setItem(k,v); }catch(e){} }
  function loadState(k,def){ try{ const v=localStorage.getItem(k); return v!==null? v: def;}catch(e){ return def;} }

  // UI references
  const typeSelectEl = document.getElementById('typeSelect');
  const fromUnit = document.getElementById('fromUnit');
  const toUnit = document.getElementById('toUnit');
  const inputValue = document.getElementById('inputValue');
  const unitFilter = document.getElementById('unitFilter');
  const precisionSelect = document.getElementById('precisionSelect');
  const unitResult = document.getElementById('unitResult');
  const dataModeContainer = document.getElementById('dataModeContainer');
  const dataModeSI = document.getElementById('dataModeSI');
  const dataModeBin = document.getElementById('dataModeBin');
  const copyBtn = document.getElementById('copyBtn');
  const swapBtn = document.getElementById('swapBtn');

  let currentDataMode = loadState(LS_KEYS.dataMode, 'SI');

  function setDataModeUI(){
    if (currentDataMode === 'SI') { dataModeSI.style.opacity = '1'; dataModeBin.style.opacity = '0.6'; }
    else { dataModeBin.style.opacity = '1'; dataModeSI.style.opacity = '0.6'; }
  }

  function toggleDataModeVisibility(){
    // show data-mode controls only for the "data" category
    const show = (typeSelectEl.value === 'data');
    dataModeContainer.style.display = show ? 'flex' : 'none';
  }

  function getUnitsForType(type){
    if (type === 'data') return (currentDataMode === 'Bin') ? Object.keys(unitTypes.data.unitsBin) : Object.keys(unitTypes.data.unitsSI);
    if (unitTypes[type] && unitTypes[type].units) return Object.keys(unitTypes[type].units);
    if (unitTypes[type] && unitTypes[type].unitsSI) return Object.keys(unitTypes[type].unitsSI);
    return [];
  }

  function displayLabel(key){
    return AR_LABELS[key] || key;
  }

  function populateUnits(type){
    const units = getUnitsForType(type);
    fromUnit.innerHTML = ''; toUnit.innerHTML = '';
    units.forEach(k=>{
      const opt1 = document.createElement('option'); opt1.value=k; opt1.textContent = displayLabel(k); fromUnit.appendChild(opt1);
      const opt2 = document.createElement('option'); opt2.value=k; opt2.textContent = displayLabel(k); toUnit.appendChild(opt2);
    });
    applyUnitFilter();
    setDataModeUI();
    toggleDataModeVisibility();
    // restore last selections if available
    const lf = loadState(LS_KEYS.lastFrom,''); const lt = loadState(LS_KEYS.lastTo,'');
    if (lf && Array.from(fromUnit.options).some(o=>o.value===lf)) fromUnit.value = lf;
    if (lt && Array.from(toUnit.options).some(o=>o.value===lt)) toUnit.value = lt;
    if (!fromUnit.value && fromUnit.options.length) fromUnit.selectedIndex = 0;
    if (!toUnit.value && toUnit.options.length) toUnit.selectedIndex = Math.min(1,toUnit.options.length-1);
  }

  function applyUnitFilter(){
    const q = (unitFilter.value || '').toLowerCase().trim();
    const type = typeSelectEl.value;
    const all = getUnitsForType(type);
    const filtered = q ? all.filter(k => (displayLabel(k) + ' ' + k).toLowerCase().includes(q)) : all.slice();
    const final = filtered.length ? filtered : all;
    fromUnit.innerHTML = ''; toUnit.innerHTML = '';
    final.forEach(k=>{
      const o1 = document.createElement('option'); o1.value=k; o1.textContent = displayLabel(k); fromUnit.appendChild(o1);
      const o2 = document.createElement('option'); o2.value=k; o2.textContent = displayLabel(k); toUnit.appendChild(o2);
    });
  }

  function fmtNumber(n, prec){
    if (!isFinite(n)) return String(n);
    return Number(n).toFixed(prec).replace(/\.?0+$/,'');
  }

  function doConvert(){
    const type = typeSelectEl.value;
    const val = parseFloat(inputValue.value);
    const from = fromUnit.value;
    const to = toUnit.value;
    const prec = parseInt(precisionSelect.value,10);
    if (!isFinite(val)){
      unitResult.innerHTML = `<span style="direction:rtl;text-align:right;">Ø§Ù„Ø±Ø¬Ø§Ø¡ Ø¥Ø¯Ø®Ø§Ù„ Ù‚ÙŠÙ…Ø© ØµØ­ÙŠØ­Ø©.</span>`;
      return;
    }
    let result;
    try {
      if (type === 'data') result = unitTypes.data.convert(val, from, to, currentDataMode === 'Bin' ? 'Bin' : 'SI');
      else if (type === 'fuel') result = unitTypes.fuel.convert(val, from, to);
      else if (type === 'temperature') result = unitTypes.temperature.convert(val, from, to);
      else if (unitTypes[type] && typeof unitTypes[type].convert === 'function') result = unitTypes[type].convert(val, from, to);
      else result = NaN;
    } catch(e){ console.error('convert error', e); result = NaN; }

    if (!isFinite(result)){
      unitResult.innerHTML = `<span style="direction:rtl;text-align:right;">Ø§Ù„ØªØ­ÙˆÙŠÙ„ ØºÙŠØ± Ù…ØªØ§Ø­ Ù„Ù‡Ø°Ù‡ Ø§Ù„ÙˆØ­Ø¯Ø§Øª.</span>`;
      return;
    }

    // Compose result using LTR numbers and RTL unit labels to avoid bidi issues
    const valStr = fmtNumber(val, prec);
    const resStr = fmtNumber(result, prec);
    const fromLabel = displayLabel(from);
    const toLabel = displayLabel(to);
    const html = `<span dir="ltr">${valStr}</span>&nbsp;<span dir="rtl">${fromLabel}</span>&nbsp;=&nbsp;<span dir="ltr">${resStr}</span>&nbsp;<span dir="rtl">${toLabel}</span>`;
    const rawNote = (Number(resStr) !== result) ? `&nbsp;<span style="color:#6b7280;font-weight:400;">(raw ${result})</span>` : '';
    unitResult.innerHTML = html + rawNote;

    // persist
    saveState(LS_KEYS.lastType, type);
    saveState(LS_KEYS.lastFrom, from);
    saveState(LS_KEYS.lastTo, to);
    saveState(LS_KEYS.lastValue, inputValue.value);
    saveState(LS_KEYS.lastPrecision, precisionSelect.value);
  }

  // Event wiring
  document.getElementById('unitForm').addEventListener('submit', function(e){ e.preventDefault(); doConvert(); });
  typeSelectEl.addEventListener('change', function(){ unitFilter.value=''; populateUnits(this.value); });
  unitFilter.addEventListener('input', applyUnitFilter);
  precisionSelect.addEventListener('change', doConvert);
  fromUnit.addEventListener('change', doConvert);
  toUnit.addEventListener('change', doConvert);
  swapBtn.addEventListener('click', function(){ const a = fromUnit.value, b = toUnit.value; fromUnit.value = b; toUnit.value = a; doConvert(); });
  copyBtn.addEventListener('click', function(){
    const text = unitResult.innerText || unitResult.textContent || '';
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(()=>{ copyBtn.innerHTML = '<i class="fa fa-check"></i>'; setTimeout(()=>{ copyBtn.innerHTML = '<i class="fa fa-copy"></i>'; }, 900); }).catch(()=>{ alert('ÙØ´Ù„ Ø§Ù„Ù†Ø³Ø®'); });
    } else {
      const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); copyBtn.innerHTML = '<i class="fa fa-check"></i>'; setTimeout(()=>{ copyBtn.innerHTML = '<i class="fa fa-copy"></i>'; }, 900); } catch(e){ alert('Ø§Ù„Ù†Ø³Ø® ØºÙŠØ± Ù…Ø¯Ø¹ÙˆÙ…'); }
      ta.remove();
    }
  });

  dataModeSI.addEventListener('click', ()=>{ currentDataMode = 'SI'; saveState(LS_KEYS.dataMode,'SI'); setDataModeUI(); if (typeSelectEl.value === 'data') populateUnits('data'); });
  dataModeBin.addEventListener('click', ()=>{ currentDataMode = 'Bin'; saveState(LS_KEYS.dataMode,'Bin'); setDataModeUI(); if (typeSelectEl.value === 'data') populateUnits('data'); });

  // keyboard shortcut to focus value (Ctrl+K)
  document.addEventListener('keydown', function(e){ if (e.ctrlKey && (e.key === 'k' || e.key === 'K')){ e.preventDefault(); inputValue.focus(); inputValue.select(); } });

  // Initialization
  (function init(){
    setDataModeUI();
    const lastType = loadState(LS_KEYS.lastType, 'length');
    if (Array.from(typeSelectEl.options).some(o=>o.value===lastType)) typeSelectEl.value = lastType;
    populateUnits(typeSelectEl.value);
    const lastFrom = loadState(LS_KEYS.lastFrom, ''); const lastTo = loadState(LS_KEYS.lastTo, '');
    if (lastFrom && Array.from(fromUnit.options).some(o=>o.value===lastFrom)) fromUnit.value = lastFrom;
    if (lastTo && Array.from(toUnit.options).some(o=>o.value===lastTo)) toUnit.value = lastTo;
    const lastVal = loadState(LS_KEYS.lastValue, ''); if (lastVal) inputValue.value = lastVal;
    const lastPrecision = loadState(LS_KEYS.lastPrecision, '4'); if (lastPrecision && Array.from(precisionSelect.options).some(o=>o.value===lastPrecision)) precisionSelect.value = lastPrecision;
    if (inputValue.value) doConvert();
  })();

  // language selector redirect (markup hidden but behavior preserved)
  (function(){ var sel = document.getElementById('language-select-top'); if (sel) sel.addEventListener('change', function(){ window.location.href = 'unit-converter-' + (this.value || 'en') + '.html'; }); })();
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>


