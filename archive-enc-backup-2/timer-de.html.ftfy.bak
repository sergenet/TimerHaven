<script>
  (function(){
    // focus-on-hash behavior so /timer-de.html#startBtn focuses Start
    window.addEventListener('load', function() {
      try {
        var id = (location.hash || '').substring(1);
        if (!id) return;
        var el = document.getElementById(id);
        if (el && typeof el.focus === 'function') {
          setTimeout(function(){ el.focus({preventScroll:false}); }, 50);
        }
      } catch (e) {}
    });

    // Timer logic (keeps timer behaviour, removed session/export UI)
    var timer = null;
    var totalSeconds = 25*60;
    var running = false;

    function updateTimerDisplay() {
      var min = Math.floor(totalSeconds/60);
      var sec = totalSeconds % 60;
      document.getElementById('timerDisplay').textContent = String(min).padStart(2,'0') + ':' + String(sec).padStart(2,'0');
    }

    function setTimerLengths() {
      var min = parseInt(document.getElementById('minutes').value,10) || 0;
      var sec = parseInt(document.getElementById('seconds').value,10) || 0;
      totalSeconds = Math.max(0, min*60 + sec);
      updateTimerDisplay();
    }

    document.getElementById('minutes').addEventListener('change', setTimerLengths);
    document.getElementById('seconds').addEventListener('change', setTimerLengths);

    document.getElementById('startBtn').addEventListener('click', function() {
      if (running) return;
      running = true;
      timer = setInterval(function() {
        if (totalSeconds > 0) {
          totalSeconds--;
          updateTimerDisplay();
        } else {
          clearInterval(timer);
          running = false;
          try { alert("Zeit ist um!"); } catch(e){}
        }
      }, 1000);
    });

    document.getElementById('pauseBtn').addEventListener('click', function() {
      if (timer) clearInterval(timer);
      running = false;
    });

    document.getElementById('resetBtn').addEventListener('click', function() {
      if (timer) clearInterval(timer);
      running = false;
      setTimerLengths();
    });

    // initialize display
    setTimerLengths();
  })();
  </script>
