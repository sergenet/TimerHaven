<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title data-i18n="pageTitle">World Clock أ¢â‚¬â€‌ TimerHaven</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="See the time anywhere in the world, instantly." />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/luxon@3.4.3/build/global/luxon.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.min.js"></script>
  <style>
    body { background: #f4f7fb; font-family: 'Montserrat', Arial, sans-serif; }
    .main-container { max-width: 1200px; margin: 2em auto; display: flex; justify-content: center; align-items: center; min-height: 90vh; }
    .center-row { display: flex; flex-direction: row; justify-content: center; align-items: flex-start; gap: 2em; width: 100%; }
    .article-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px #e0e7ef; width: 330px; min-width: 200px; min-height: 340px; height: 340px; display:flex; flex-direction:column; padding:1em; box-sizing:border-box; }
    .tool-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px #e0e7ef; width: 560px; min-width: 300px; min-height: 340px; padding:1em; box-sizing:border-box; }
    .clock-form { margin-bottom: 1em; display:flex; gap:0.5em; flex-wrap:wrap; }
    .clock-list { margin-bottom: 1em; }
    .clock-item { background:#f7fafc; border-radius:7px; padding:0.6em 0.8em; margin-bottom:0.6em; display:flex; align-items:center; justify-content:space-between; }
    .clock-meta { font-size: 1em; color: #185a9d; margin-right: .5em; }
    .error-msg { color:#b00; margin-bottom: .6em; }
    @media (max-width:1100px) { .main-container{padding:0 8px;} .tool-card,.article-card{width:97vw;max-width:540px;height:auto;} }
  </style>
<script>

</script>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <div class="main-container">
    <div class="center-row">
      <div class="article-card">
        <h2><i class="fa fa-globe"></i> <span data-i18n="howToHeading">How to Use World Clock</span></h2>
        <ol>
          <li data-i18n="howTo1">Select city or region: Choose a location to see the current time.</li>
          <li data-i18n="howTo2">Compare times: Add multiple clocks to compare zones.</li>
          <li data-i18n="howTo3">Plan events: Schedule meetings across time zones.</li>
        </ol>
        <a id="howto-link" href="world-how-to.html" class="btn btn-outline-primary btn-sm" data-i18n="readFull">Read Full Article</a>
      </div>

      <div class="tool-card" role="region" aria-labelledby="wc-title">
        <a href="index.html" class="back-link" data-i18n="back">Back to Main Menu</a>
        <h3 id="wc-title"><i class="fa fa-globe"></i> <span data-i18n="toolTitle">World Clock</span></h3>

        <div class="world-section">
          <form class="clock-form" id="clockForm" aria-label="Add clock">
            <select id="cityDropdown" class="form-select city-dropdown" aria-label="Select city">
              <option value="">Select city...</option>
            </select>
            <input type="text" id="cityInput" class="form-control awesomplete" placeholder="" autocomplete="off" aria-label="City or time zone" />
            <button type="submit" class="btn btn-success btn-sm" id="addClockBtn"><span data-i18n="addClock">Add Clock</span></button>
          </form>

          <div id="errorMsg" class="error-msg" role="status" aria-live="polite"></div>
          <div id="clockList" class="clock-list" aria-live="polite"></div>
        </div>

        <details class="faq-section">
          <summary data-i18n="faqs">FAQs</summary>
          <ul>
            <li data-i18n="faq1">Can I add multiple clocks? Yes, compare several time zones.</li>
            <li data-i18n="faq2">Is the time live? Yes, updates automatically.</li>
            <li data-i18n="faq3">Can I plan meetings? Yes, use the tool to find the best time.</li>
          </ul>
        </details>
      </div>

      <div class="article-card">
        <h2><i class="fa fa-lightbulb" style="color:#43cea2;"></i> <span data-i18n="tipsHeading">World Clock Productivity Tips</span></h2>
        <ul>
          <li data-i18n="tip1">Plan calls: Avoid scheduling at awkward hours for others.</li>
          <li data-i18n="tip2">Watch daylight changes: Check for region-specific daylight saving.</li>
          <li data-i18n="tip3">Compare at a glance: Add clocks for all your key locations.</li>
        </ul>
        <a id="tips-link" href="world-tips.html" class="btn btn-outline-primary btn-sm" data-i18n="readFull">Read Full Article</a>
      </div>
    </div>
  </div>

  <script>
    const { DateTime } = luxon;
    let cityList = [], cityToZone = {}, cityNames = [], awesompleteInstance;

    // load cities from world-cities.json if present (keeps original behavior)
    fetch('world-cities.json')
      .then(r => r.json())
      .then(data => {
        cityList = data;
        cityToZone = {};
        cityNames = [];
        data.forEach(city => { cityToZone[city.name.toLowerCase()] = city.timezone; cityNames.push(city.name); });
        const dropdown = document.getElementById('cityDropdown');
        cityList.forEach(city => {
          const opt = document.createElement('option');
          opt.value = city.timezone;
          opt.textContent = city.name;
          dropdown.appendChild(opt);
        });
        awesompleteInstance = new Awesomplete(document.getElementById('cityInput'), { list: cityNames, minChars: 1, maxItems: 12, autoFirst: true });
      })
      .catch(() => { /* world-cities.json optional */ });

    let clocks = JSON.parse(localStorage.getItem('worldClocks') || '[]');
    function saveClocks(){ localStorage.setItem('worldClocks', JSON.stringify(clocks)); }
    function renderClocks(){
      const list = document.getElementById('clockList'); list.innerHTML = '';
      if (clocks.length === 0) { list.innerHTML = '<div style="color:#888;">No clocks added yet.</div>'; return; }
      clocks.forEach((clock, idx) => {
        let timeStr = '...'; let error = false;
        try {
          const now = DateTime.now().setZone(clock.tz);
          if (!now.isValid) throw new Error('Invalid zone');
          timeStr = now.toFormat('cccc, dd LLL yyyy<br>HH:mm:ss');
        } catch {
          timeStr = 'Invalid time zone';
          error = true;
        }
        list.innerHTML += `
          <div class="clock-item">
            <span class="clock-meta"><i class="fa fa-clock"></i></span>
            <span><b>${clock.label}</b><br>${timeStr}${error?'<span style="color:#b00;"> (Check spelling or use a valid IANA time zone)</span>':''}</span>
            <button class="btn btn-outline-danger btn-sm clock-btn" onclick="deleteClock(${idx})"><i class="fa fa-trash"></i></button>
          </div>
        `;
      });
    }

    function normalizeInput(s){ return s.trim().toLowerCase().replace(/[\s\-_]+/g, ' '); }
    function addClock(label, tz){ clocks.push({label,tz}); saveClocks(); renderClocks(); }

    document.getElementById('clockForm').addEventListener('submit', function(e){
      e.preventDefault();
      document.getElementById('errorMsg').textContent = '';
      const cityInput = document.getElementById('cityInput').value.trim();
      const dropdownVal = document.getElementById('cityDropdown').value;
      let label = '', zone = '';
      if (dropdownVal) {
        zone = dropdownVal;
        label = document.getElementById('cityDropdown').options[document.getElementById('cityDropdown').selectedIndex].text;
      } else if (cityInput) {
        label = cityInput;
        if (/^[A-Za-z]+\/[A-Za-z_]+$/.test(cityInput)) {
          zone = cityInput;
        } else {
          const norm = normalizeInput(cityInput);
          if (cityToZone[norm]) zone = cityToZone[norm];
          else { document.getElementById('errorMsg').innerHTML = 'City not recognized.'; return; }
        }
      } else {
        document.getElementById('errorMsg').textContent = 'Please select or enter a city or time zone.';
        return;
      }
      addClock(label, zone);
      document.getElementById('cityInput').value = '';
      document.getElementById('cityDropdown').selectedIndex = 0;
    });

    window.deleteClock = function(idx){ clocks.splice(idx,1); saveClocks(); renderClocks(); }
    setInterval(renderClocks, 1000);
    renderClocks();

    // i18n translations (expanded)
    const translations = {
      en: {
        pageTitle: "World Clock أ¢â‚¬â€‌ TimerHaven",
        back: "Back to Main Menu",
        howToHeading: "How to Use World Clock",
        howTo1: "Select city or region: Choose a location to see the current time.",
        howTo2: "Compare times: Add multiple clocks to compare zones.",
        howTo3: "Plan events: Schedule meetings across time zones.",
        readFull: "Read Full Article",
        toolTitle: "World Clock",
        addClock: "Add Clock",
        faqs: "FAQs",
        faq1: "Can I add multiple clocks? Yes, compare several time zones.",
        faq2: "Is the time live? Yes, updates automatically.",
        faq3: "Can I plan meetings? Yes, use the tool to find the best time.",
        tipsHeading: "World Clock Productivity Tips",
        tip1: "Plan calls: Avoid scheduling at awkward hours for others.",
        tip2: "Watch daylight changes: Check for region-specific daylight saving.",
        tip3: "Compare at a glance: Add clocks for all your key locations."
      },
      fr: {
        pageTitle: "Horloge mondiale أ¢â‚¬â€‌ TimerHaven",
        back: "Retour au menu principal",
        howToHeading: "Comment utiliser l'horloge mondiale",
        howTo1: "Sأƒآ©lectionnez une ville ou une rأƒآ©gion : Choisissez un emplacement pour voir l'heure actuelle.",
        howTo2: "Comparez les heures : Ajoutez plusieurs horloges pour comparer les fuseaux.",
        howTo3: "Planifiez des أƒآ©vأƒآ©nements : Programmez des rأƒآ©unions entre fuseaux horaires.",
        readFull: "Lire l'article complet",
        toolTitle: "Horloge mondiale",
        addClock: "Ajouter une horloge",
        faqs: "FAQ",
        faq1: "Puis-je ajouter plusieurs horloges ? Oui, comparez plusieurs fuseaux.",
        faq2: "L'heure est-elle en direct ? Oui, elle se met أƒآ  jour automatiquement.",
        faq3: "Puis-je planifier des rأƒآ©unions ? Oui, utilisez l'outil pour trouver le meilleur horaire.",
        tipsHeading: "Conseils Horloge mondiale",
        tip1: "Planifiez les appels : أƒآ©vitez les heures inopportunes.",
        tip2: "Surveillez les changements d'heure : vأƒآ©rifiez l'heure d'أƒآ©tأƒآ© locale.",
        tip3: "Comparez rapidement : ajoutez les villes importantes."
      }
    };

    function getLang(){ try{ const l = localStorage.getItem('timerhavenLang') || 'en'; return translations[l] ? l : 'en'; } catch(e){ return 'en'; } }
    function applyLanguage(lang){
      if (!translations[lang]) lang = 'en';
      const d = translations[lang];
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const k = el.getAttribute('data-i18n');
        if (d[k] !== undefined) el.textContent = d[k];
      });
      // placeholder text for inputs (if needed)
      const cityInput = document.getElementById('cityInput');
      if (cityInput) cityInput.placeholder = d['cityPlaceholder'] || 'Or enter city or time zone';
      document.title = d.pageTitle || document.title;
    }

    document.addEventListener('DOMContentLoaded', () => applyLanguage(getLang()));
    window.addEventListener('storage', (e) => { if (e.key === 'timerhavenLang') applyLanguage(e.newValue || 'en'); });
    window._applyTimerHavenLang = function(lang){ localStorage.setItem('timerhavenLang', lang); applyLanguage(lang); };
  </script>

  <footer>
    &copy; 2025 TimerHaven. All tools are free and privacy-friendly.<br />
    <a href="privacy.html">Privacy Policy</a> &bull; <a href="terms.html">Terms</a> &bull; <a href="contact.html">Contact</a>
  </footer>
</body>
</html>


