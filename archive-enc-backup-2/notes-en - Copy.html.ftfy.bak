<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Notes â€” TimerHaven</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Take quick notes and organize your thoughts. Learn how to use Notes, get productivity tips, FAQs, and read expert articles.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="canonical" href="https://timerhaven.com/notes-en.html" />
  
  <style>
    body { background: #f4f7fb; font-family: 'Montserrat', Arial, sans-serif; }
    .main-container { max-width: 1200px; margin: 2rem auto; display:flex; justify-content:center; align-items:flex-start; min-height:90vh; padding:0 1rem; box-sizing:border-box; }
    .tool-card {
      background:#fff;
      border-radius:16px;
      box-shadow:0 2px 12px #e0e7ef;
      width:420px;
      padding:1.6rem 1.5rem;
      box-sizing:border-box;
    }
    .back-link { display:inline-block; margin-bottom:.75rem; color:var(--brand,#0d6efd) !important; text-decoration:none; font-weight:700; }
    .tool-title { font-size:1.35rem; margin:0 0 .4rem 0; display:flex; align-items:center; gap:.4rem; color:#185a9d; }
    .read-guide { display:inline-block; margin:.35rem 0 .8rem 0; padding:.45rem .7rem; border-radius:8px; background:var(--brand,#0d6efd); color:#fff; text-decoration:none; font-weight:700; font-size:.95rem; border:none; }
    .notes-form { margin-bottom:1rem; display:flex; gap:.5rem; align-items:center; }
    .notes-list { margin-bottom:1rem; }
    .note-item { background:#f7fafc; border-radius:7px; padding:0.6rem 0.8rem; margin-bottom:0.6rem; display:flex; align-items:center; justify-content:space-between; }
    .note-meta { font-size:0.9em; color:#888; margin-right:1em; }
    .note-pinned { font-weight:700; color:#185a9d; margin-right:0.6em; }
    .faq-section { margin-top:1.1rem; margin-bottom:0.3rem; font-size:1rem; background:#f7fafc; border-radius:8px; padding:1rem; box-shadow:0 1px 4px #e0e7ef; }
    .faq-section summary { font-weight:700; font-size:1.02rem; cursor:pointer; }
    @media (max-width:900px){ .tool-card{ width:98vw; padding:1rem; } }
  </style>
<script>

</script>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <main class="main-container" role="main">
    <section class="tool-card" aria-labelledby="tool-title">
      <a href="index.html" class="back-link" id="back-link">&larr; Back to Main Menu</a>

      <h3 id="tool-title" class="tool-title"><i class="fa fa-note-sticky"></i> Notes</h3>

      <a id="read-guide-btn" class="read-guide" href="/en/notes/notes-index.html" role="button">Read full guide</a>

      <div class="notes-section">
        <form class="notes-form" id="notesForm">
          <input type="text" id="noteInput" class="form-control" placeholder="Type your note..." style="max-width:220px;">
          <button type="submit" class="btn btn-success btn-sm">Add Note</button>
        </form>
        <div id="notesList" class="notes-list"></div>
      </div>

      <details class="faq-section">
        <summary id="faq-title">FAQs</summary>
        <ul style="padding-left:1em;" id="faq-list">
          <li><b>Are notes saved?</b> Yes, in your browser until you clear them.</li>
          <li><b>Can I pin important notes?</b> Yes, use the pin feature if available.</li>
          <li><b>Is there a limit?</b> No, add as many notes as you need.</li>
        </ul>
      </details>
    </section>
  </main>

<script>
  let notes = JSON.parse(localStorage.getItem('notesData') || '[]');
  function saveNotes() { localStorage.setItem('notesData', JSON.stringify(notes)); }
  function renderNotes() {
    const list = document.getElementById('notesList');
    list.innerHTML = '';
    if (notes.length === 0) {
      list.innerHTML = '<div style="color:#888;">No notes yet.</div>';
      return;
    }
    notes.forEach((note, idx) => {
      const pinned = note.pinned ? '<span class="note-pinned"><i class="fa fa-thumbtack"></i></span>' : '';
      const div = document.createElement('div');
      div.className = 'note-item';
      div.innerHTML = `
        <div style="display:flex;align-items:center;gap:.6rem;">
          ${pinned}
          <span>${escapeHtml(note.text)}</span>
        </div>
        <div style="display:flex;align-items:center;gap:.5rem;">
          <span class="note-meta">${escapeHtml(note.date)}</span>
          <button class="btn btn-outline-${note.pinned ? 'secondary' : 'info'} btn-sm" onclick="pinNote(${idx})" title="Pin/unpin"><i class="fa fa-thumbtack"></i></button>
          <button class="btn btn-outline-danger btn-sm" onclick="deleteNote(${idx})"><i class="fa fa-trash"></i></button>
        </div>
      `;
      list.appendChild(div);
    });
  }
  function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

  document.getElementById('notesForm').addEventListener('submit', function(e){
    e.preventDefault();
    const text = document.getElementById('noteInput').value.trim();
    if (!text) return;
    notes.unshift({ text, date: new Date().toLocaleString(), pinned: false });
    saveNotes();
    document.getElementById('noteInput').value = "";
    renderNotes();
  });
  window.deleteNote = function(idx){ notes.splice(idx, 1); saveNotes(); renderNotes(); }
  window.pinNote = function(idx){
    notes[idx].pinned = !notes[idx].pinned;
    if (notes[idx].pinned) {
      const pinnedNote = notes.splice(idx, 1)[0];
      notes.unshift(pinnedNote);
    }
    saveNotes();
    renderNotes();
  }
  renderNotes();
</script>

