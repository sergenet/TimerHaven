    // language display names for the indicator (kept for internal use if needed)
    const langNames = { en: "English", fr: "FranÃ§ais", de: "Deutsch", ru: "Ð ÑƒÑÑÐºÐ¸Ð¹", el: "Î•Î»Î»Î·Î½Î¹ÎºÎ¬", es: "EspaÃ±ol", ar: "Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©" };

    // Source-of-truth language (set by index.html) stored under 'timerhavenLang'
    function getLang() {
      try {
        const l = localStorage.getItem('timerhavenLang') || 'en';
        return (l && l.slice(0,2)) || 'en';
      } catch (e) {
        return 'en';
      }
    }

    // Apply translations to the page based on timerhavenLang
    function applyLanguage(lang) {
      lang = (lang || getLang()).slice(0,2);
      const t = focusMusicTranslations[lang] || focusMusicTranslations['en'];

      // RTL support
      document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';

      // Main UI
      const back = document.getElementById('back-link');
      if (back) back.textContent = t['back-link'] || '';

      const toolTitle = document.getElementById('tool-title');
      if (toolTitle) toolTitle.innerHTML = `<i class="fa fa-music"></i> ${t['tool-title'] || ''}`;

      const help = document.getElementById('tool-help');
      if (help) help.textContent = t['tool-help'] || '';

      // Music selector labels
      const musicLabel = document.getElementById('music-label');
      if (musicLabel) musicLabel.textContent = t['music-label'] || '';

      const ms = document.getElementById('music-select');
      if (ms && ms.options) {
        ms.options[0].text = t['music-white'] || 'White Noise';
        ms.options[1].text = t['music-rain'] || 'Rain';
        ms.options[2].text = t['music-alpha'] || 'Alpha Waves';
        ms.options[3].text = t['music-classical'] || 'Classical';
        ms.options[4].text = t['music-ocean'] || 'Ocean Waves';
        ms.options[5].text = t['music-cafe'] || 'Cafe Ambience';
      }

      const loopText = document.getElementById('loop-label-text');
      if (loopText) loopText.textContent = t['loop-label'] || 'Loop track';

      // Buttons
      const playBtn = document.getElementById('play-btn');
      const stopBtn = document.getElementById('stop-btn');
      if (playBtn) playBtn.textContent = t['play'] || 'Play';
      if (stopBtn) stopBtn.textContent = t['stop'] || 'Stop';

      // FAQ / Howto / Tips
      const faqTitle = document.getElementById('faq-title');
      if (faqTitle) faqTitle.textContent = t['faq-title'] || '';
      const faqList = document.getElementById('faq-list');
      if (faqList) faqList.innerHTML = t['faq-list'] || '';

      const howtoTitle = document.getElementById('howto-title');
      const howtoSteps = document.getElementById('howto-steps');
      if (howtoTitle) howtoTitle.innerHTML = t['howto-title'] || '';
      if (howtoSteps) howtoSteps.innerHTML = t['howto-steps'] || '';
      const howtoBtn = document.getElementById('howto-article-btn');
      if (howtoBtn) { howtoBtn.textContent = t['howto-article-btn'] || ''; howtoBtn.href = t['howto-article-link'] || ''; }

      const tipsTitle = document.getElementById('tips-title');
      const tipsList = document.getElementById('tips-list');
      const tipsBtn = document.getElementById('tips-article-btn');
      if (tipsTitle) tipsTitle.innerHTML = t['tips-title'] || '';
      if (tipsList) tipsList.innerHTML = t['tips-list'] || '';
      if (tipsBtn) { tipsBtn.textContent = t['tips-article-btn'] || ''; tipsBtn.href = t['tips-article-link'] || ''; }
    }

    // React to language changes made on the main index (other tabs)
    window.addEventListener('storage', function(e) {
      if (e.key === 'timerhavenLang') {
        applyLanguage((e.newValue || 'en').slice(0,2));
      }
    });

    // Playback controls
    function playMusic() {
      const sel = document.getElementById("music-select").value;
      const audio = document.getElementById("focus-audio");
      audio.src = tracks[sel];
      audio.loop = document.getElementById("music-loop").checked;
      audio.style.display = "block";
      audio.load();
      audio.play().catch(()=>{ /* ignore play errors (autoplay policies) */ });
    }
    function stopMusic() {
      const audio = document.getElementById("focus-audio");
      audio.pause();
      audio.currentTime = 0;
      audio.style.display = "none";
    }

    document.addEventListener('DOMContentLoaded', function() {
      // Apply language chosen on main index (timerhavenLang)
      applyLanguage(getLang());

      // Wire up play/stop and loop checkbox
      const playBtn = document.getElementById('play-btn');
      const stopBtn = document.getElementById('stop-btn');
      const loopCb = document.getElementById('music-loop');
      if (playBtn) playBtn.addEventListener('click', playMusic);
      if (stopBtn) stopBtn.addEventListener('click', stopMusic);
      if (loopCb) loopCb.addEventListener('change', function() {
        document.getElementById("focus-audio").loop = this.checked;
      });
    });
  </script>

