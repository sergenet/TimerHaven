  <style>
    body { background: #f4f7fb; font-family: 'Montserrat', Arial, sans-serif; color:var(--text-dark,#102a43); }
    .main-container { max-width: 1200px; margin: 2rem auto; padding:0 1rem; display:flex; justify-content:center; align-items:flex-start; min-height:90vh; box-sizing:border-box; }
    .tool-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 2px 12px #e0e7ef;
      width: 420px;
      padding: 1.6rem 1.5rem;
      box-sizing: border-box;
    }
    .back-link {
      display:inline-block;
      margin-bottom:.75rem;
      /* force brand color */
      color:var(--brand,#0d6efd) !important;
      text-decoration:none;
      font-weight:700;
    }
    /* Tool title set to original dark blue */
    .tool-title { font-size:1.35rem; margin:0 0 .4rem 0; display:flex; align-items:center; gap:.4rem; color:#185a9d; }
    .read-guide {
      display:inline-block;
      margin:.35rem 0 .8rem 0;
      padding:.45rem .7rem;
      border-radius:8px;
      background:var(--brand,#0d6efd);
      color:#fff;
      text-decoration:none;
      font-weight:700;
      font-size:.95rem;
      border:none;
    }
    .tool-help { color:var(--muted,#6b7c89); margin-bottom:.8rem; }
    .converter-form { display:flex; gap:.5rem; margin-bottom:1rem; flex-wrap:wrap; align-items:center; }
    .converter-result { font-weight:700; font-size:1.12rem; margin-bottom:1rem; color:var(--text-dark,#102a43); }
    details.faq-section summary { cursor:pointer; padding:.2rem 0; font-weight:700; }
    details.faq-section ul { margin-top:.5rem; color:var(--muted,#6b7c89); padding-left:1rem; }
    @media (max-width:900px) { .tool-card { width:98vw; padding:1rem; } }
