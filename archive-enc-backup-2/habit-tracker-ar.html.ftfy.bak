<style>
    /* consistent layout with other language files */
    body { background:#f4f7fb; font-family:'Montserrat', Arial, sans-serif; direction: rtl; }
    .main-container { max-width:1200px; margin:2em auto; display:flex; justify-content:center; align-items:center; min-height:90vh; }
    .center-row { display:flex; gap:2em; width:100%; justify-content:center; align-items:flex-start; }
    .article-card, .tool-card {
      background:#fff; border-radius:16px; box-shadow:0 2px 12px #e0e7ef;
      width:340px; min-width:220px; max-width:340px; min-height:500px;
      flex:1 1 340px; display:flex; flex-direction:column; padding:2em 1.3em 1em; box-sizing:border-box;
      text-align:right; overflow:hidden;
    }
    .tool-card { max-width:410px; min-width:240px; padding:2em 1.5em 1em; position:relative; z-index:1; }
    .tool-card h3 { font-size:1.45em; font-weight:700; margin-bottom:0.1em; display:flex; align-items:center; gap:.4em; justify-content:flex-end; }
    .article-card h2, .tool-card h3 { font-size:1.35em; font-weight:700; margin-bottom:.4em; }
    .habit-form { margin-bottom:1em; display:flex; gap:.5em; justify-content:stretch; align-items:center; }
    .habit-form input { direction: ltr; } /* input text direction handled by browser; keep placeholder localized */
    .habit-list { margin-bottom:1em; }
    .habit-item { background:#f7fafc; border-radius:7px; padding:.6em .8em; margin-bottom:.6em; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; }
    .habit-meta { font-size:0.9em; color:#888; margin-right:0.6em; margin-left:1em; }
    .habit-history { display:flex; gap:3px; margin-right:1em; align-items:center; }
    .dot { width:15px; height:15px; border-radius:50%; display:inline-block; background:#e0e7ef; border:1px solid #d0d0d0; }
    .dot.done { background:#43cea2; border:1.5px solid #185a9d; }
    .dot.today { border:2px solid #43cea2; }
    .stats-bar { background:#f6fbfa; border-radius:10px; margin-bottom:1.2em; padding:.7em 1em; font-size:1.05em; font-weight:600; color:#185a9d; display:flex; gap:2em; align-items:center; justify-content:space-between; direction:ltr; }
    .archive-btn { font-size:0.9em; margin-left:0.6em; background:#fff; border:1px solid #43cea2; color:#43cea2; border-radius:6px; padding:0.15em 0.7em; }
    .archive-btn.archived { opacity:0.65; color:#888; border-color:#d0d0d0; }
    .banner { background:linear-gradient(90deg,#43cea2 0%,#185a9d 100%); color:#fff; border-radius:10px; font-size:1.11em; font-weight:600; text-align:center; margin-bottom:1em; padding:.7em .8em; }
    .faq-section { margin-top:1.1em; margin-bottom:0.3em; font-size:1em; background:#f7fafc; border-radius:8px; padding:1em; box-shadow:0 1px 4px #e0e7ef; direction:rtl; text-align:right; }
    /* language-indicator removed */
    @media (max-width:1100px){ .main-container{padding:0 8px;} .center-row{gap:1em;} .tool-card,.article-card{width:97vw;max-width:540px;height:auto;} }
    @media (max-width:800px){ .main-container{padding:0;} .center-row{flex-direction:column;align-items:center;} .tool-card,.article-card{width:98vw;max-width:540px;height:auto;} .article-card{display:none!important;} .howto-mobile, .tips-mobile{ display:block !important; margin-bottom:1em; } }
    @media (min-width:801px){ .howto-mobile, .tips-mobile { display:none !important; } }
    details[open] summary::after{ content:" â–²"; font-size:.9em; } details summary{ cursor:pointer; padding:.35em 0; font-weight:700; font-size:1.09em; } details:not([open]) summary::after{ content:" â–¼"; font-size:.9em; }
