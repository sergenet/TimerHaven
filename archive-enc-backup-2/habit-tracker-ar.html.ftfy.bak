      "howto-article-btn":"Ø§Ù‚Ø±Ø£ Ø§Ù„Ù…Ù‚Ø§Ù„","howto-article-link":"habit-how-to-ar.html",
      "tips-title":'<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Ù†ØµØ§Ø¦Ø­',
      "tips-list":`<li><b>Ø§Ø¨Ø¯Ø£ ØµØºÙŠØ±Ø§Ù‹:</b> Ø§Ø®ØªØ± Ø¹Ø§Ø¯Ø§Øª Ø³Ù‡Ù„Ø© Ø¨Ø§Ù„Ø¨Ø¯Ø§ÙŠØ©.</li>
        <li><b>ØªØªØ¨Ø¹ ÙŠÙˆÙ…ÙŠØ§Ù‹:</b> Ø§Ù„Ø«Ø¨Ø§Øª Ù‡Ùˆ Ù…ÙØªØ§Ø­ Ø§Ù„Ù†Ø¬Ø§Ø­.</li>
        <li><b>Ø§Ø­ØªÙÙ„ Ø¨Ø§Ù„ØªÙ‚Ø¯Ù…:</b> Ø§Ù„Ø§Ù†ØªØµØ§Ø±Ø§Øª Ø§Ù„ØµØºÙŠØ±Ø© ØªØ­Ø§ÙØ¸ Ø¹Ù„Ù‰ Ø§Ù„Ø¯Ø§ÙØ¹.</li>`,
      "tips-article-btn":"Ø§Ù‚Ø±Ø£ Ø§Ù„Ù…Ù‚Ø§Ù„","tips-article-link":"habit-tips-ar.html",
      "tips-mobile-title":'<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Ù†ØµØ§Ø¦Ø­',
      "tips-mobile-list":`<li><b>Ø§Ø¨Ø¯Ø£ ØµØºÙŠØ±Ù‹Ø§:</b> Ø§Ø¨Ø¯Ø£ Ø¨Ø¹Ø§Ø¯Ø§Øª Ø¨Ø³ÙŠØ·Ø© ÙˆØ³Ù‡Ù„Ø©.</li>
        <li><b>Ø±Ø§Ø¬Ø¹ Ø§Ù„Ø³Ù„Ø§Ø³Ù„:</b> Ø±Ø§Ø¬Ø¹ ØªÙ‚Ø¯Ù…Ùƒ Ù„Ù„Ø¨Ù‚Ø§Ø¡ Ù…ØªØ­ÙØ²Ù‹Ø§.</li>
        <li><b>Ø§Ø¶Ù ØªØ°ÙƒÙŠØ±Ø§Øª:</b> Ø§Ø³ØªØ®Ø¯Ù… ØªØ°ÙƒÙŠØ±Ø§Øª Ø§Ù„ØªÙ‚ÙˆÙŠÙ….</li>`,
      "faq-title":"Ø§Ù„Ø£Ø³Ø¦Ù„Ø© Ø§Ù„Ø´Ø§Ø¦Ø¹Ø©",
      "faq-list":`<li><b>Ù‡Ù„ ØªÙØ­ÙØ¸ Ø§Ù„Ø¹Ø§Ø¯Ø§ØªØŸ</b> Ù†Ø¹Ù…ØŒ ÙÙŠ Ù…ØªØµÙØ­Ùƒ Ø­ØªÙ‰ ØªÙ…Ø³Ø­Ù‡Ø§.</li>
        <li><b>Ù‡Ù„ Ø£Ø³ØªØ·ÙŠØ¹ ØªØªØ¨Ø¹ Ø¹Ø¯Ø© Ø¹Ø§Ø¯Ø§ØªØŸ</b> Ù†Ø¹Ù….</li>
        <li><b>Ù‡Ù„ ØªÙØ¹Ø±Ø¶ Ø§Ù„Ø³Ù„Ø§Ø³Ù„ØŸ</b> Ù†Ø¹Ù… Ù„ÙƒÙ„ Ø¹Ø§Ø¯Ø©.</li>`,
      "mark-done":"ØªÙ…","done-today":"ØªÙ… Ø§Ù„ÙŠÙˆÙ…","streak":"Ø§Ù„Ø³Ù„Ø³Ù„Ø©: ","longest":"Ø§Ù„Ø£ÙØ¶Ù„: ",
      "archive":"Ø£Ø±Ø´ÙØ©","unarchive":"Ø§Ø³ØªØ¹Ø§Ø¯Ø©","delete":"Ø­Ø°Ù","no-habits":"Ù„Ø§ ØªÙˆØ¬Ø¯ Ø¹Ø§Ø¯Ø§Øª Ø¨Ø¹Ø¯."
    }
  };

  const langNames = { en:"English", fr:"FranÃ§ais", de:"Deutsch", ru:"Ð ÑƒÑÑÐºÐ¸Ð¹", el:"Î•Î»Î»Î·Î½Î¹ÎºÎ¬", es:"EspaÃ±ol", ar:"Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©" };

  function getTodayStr() {
    const d = new Date();
    return d.getFullYear() + "-" + (d.getMonth()+1).toString().padStart(2,"0") + "-" + d.getDate().toString().padStart(2,"0");
  }
  function lastNDays(n) {
    const arr = [];
    for (let i = n-1; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      arr.push(d.getFullYear() + "-" + (d.getMonth()+1).toString().padStart(2,"0") + "-" + d.getDate().toString().padStart(2,"0"));
    }
    return arr;
  }

  // Load habits from localStorage
  let habits = JSON.parse(localStorage.getItem('habits') || '[]');

  // Use the main index language selection (timerhavenLang) when available, default to 'ar' for this file.
  function getLang() {
    try {
      const l = localStorage.getItem('timerhavenLang') || 'ar';
      return (l && l.slice(0,2)) || 'ar';
    } catch (e) {
      return 'ar';
    }
  }

  // Apply translations and re-render
  function applyLanguage(lang) {
    lang = (lang || getLang()).slice(0,2);
    const t = habitTranslations[lang] || habitTranslations['ar'];
    // RTL support
    document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';

    const back = document.getElementById('back-link'); if (back) back.textContent = t['back-link'] || '';
    const toolTitle = document.getElementById('tool-title'); if (toolTitle) toolTitle.innerHTML = `<i class="fa fa-check-double"></i> ${t['tool-title'] || ''}`;
    const input = document.getElementById('habitInput'); if (input) input.placeholder = t['habitInput'] || '';
    const addBtn = document.getElementById('add-btn'); if (addBtn) addBtn.textContent = t['add-btn'] || '';
    const faqTitle = document.getElementById('faq-title'); if (faqTitle) faqTitle.textContent = t['faq-title'] || '';
    const faqList = document.getElementById('faq-list'); if (faqList) faqList.innerHTML = t['faq-list'] || '';
    const howtoTitle = document.getElementById('howto-title'); if (howtoTitle) howtoTitle.innerHTML = t['howto-title'] || '';
    const howtoSteps = document.getElementById('howto-steps'); if (howtoSteps) howtoSteps.innerHTML = t['howto-steps'] || '';
    const howtoBtn = document.getElementById('howto-article-btn'); if (howtoBtn) { howtoBtn.textContent = t['howto-article-btn'] || ''; howtoBtn.href = t['howto-article-link'] || ''; }

    const tipsTitle = document.getElementById('tips-title'); if (tipsTitle) tipsTitle.innerHTML = t['tips-title'] || '';
    const tipsList = document.getElementById('tips-list'); if (tipsList) tipsList.innerHTML = t['tips-list'] || '';
    const tipsBtn = document.getElementById('tips-article-btn'); if (tipsBtn) { tipsBtn.textContent = t['tips-article-btn'] || ''; tipsBtn.href = t['tips-article-link'] || ''; }
    const tipsMobileTitle = document.getElementById('tips-mobile-title'); if (tipsMobileTitle) tipsMobileTitle.innerHTML = t['tips-mobile-title'] || '';
    const tipsMobileList = document.getElementById('tips-mobile-list'); if (tipsMobileList) tipsMobileList.innerHTML = t['tips-mobile-list'] || '';

    // show mobile-only tips control if viewport < 801px
    const mobileDetails = document.getElementById('tips-mobile');
    if (mobileDetails) {
      mobileDetails.style.display = (window.innerWidth < 801) ? 'block' : 'none';
    }

    renderHabits();
  }

  function saveHabits() { localStorage.setItem('habits', JSON.stringify(habits)); }

  function resetHabitsIfNeeded() {
    const today = getTodayStr();
    let changed = false;
    habits.forEach(habit => {
      if (!habit.history) habit.history = [];
      if (habit.lastChecked !== today) {
        habit.doneToday = false;
        habit.lastChecked = today;
        changed = true;
      }
    });
    if (changed) saveHabits();
  }

  function renderStats(tracked, done, best) {
    const lang = getLang();
    const t = habitTranslations[lang] || habitTranslations['ar'];
    const sb = document.getElementById("stats-bar");
    if (sb) sb.innerHTML = `${t["stats-tracked"]}${tracked} &bull; ${t["stats-done"]}${done} &bull; ${t["stats-best"]}${best}`;
  }

  function renderBanner(tracked, done) {
    const lang = getLang();
    const t = habitTranslations[lang] || habitTranslations['ar'];
    const banner = document.getElementById("banner");
    if (tracked > 0 && done === tracked) {
      banner.textContent = t["banner-all-done"] || habitTranslations["ar"]["banner-all-done"];
      banner.style.display = "block";
    } else {
      banner.style.display = "none";
    }
  }

  function renderHabits() {
    resetHabitsIfNeeded();
    const lang = getLang();
    const t = habitTranslations[lang] || habitTranslations['ar'];
    const list = document.getElementById('habitList');
    if (!list) return;
    list.innerHTML = '';
    const today = getTodayStr();
    let doneTodayCount = 0;
    let bestStreak = 0;
    let activeCount = 0;
    habits.forEach(h => { if (!h.archived) activeCount++; });
    if (habits.length === 0 || activeCount === 0) {
      list.innerHTML = `<div style="color:#888;">${t["no-habits"] || habitTranslations["ar"]["no-habits"]}</div>`;
    }
    habits.forEach((habit, idx) => {
      if (habit.archived) return;
      let streak = habit.streak || 0;
      let longest = habit.longest || streak;
      bestStreak = Math.max(bestStreak, longest);
      if (!habit.history) habit.history = [];
      let historyDots = "";
      lastNDays(7).forEach((date) => {
        const done = habit.history.includes(date);
        historyDots += `<span class="dot${done ? ' done' : ''}${date === today ? ' today' : ''}" title="${date}"></span>`;
      });
      const isDone = habit.doneToday;
      if (isDone) doneTodayCount++;
      list.innerHTML += `
        <div class="habit-item">
          <span style="display:flex; flex-direction:column; align-items:flex-end;">
            <b>${habit.name}</b>
            <span class="habit-meta">${t["streak"]}${streak} ${t["longest"]}${longest}</span>
            <span class="habit-history">${historyDots}</span>
          </span>
          <div style="display:flex; gap:0.5em; align-items:center;">
            <button class="btn btn-outline-${isDone ? 'secondary' : 'success'} btn-sm habit-btn" onclick="markDone(${idx})" ${isDone ? 'disabled' : ''}>
              ${isDone ? t["done-today"] : t["mark-done"]}
            </button>
            <button class="archive-btn${habit.archived ? ' archived' : ''}" onclick="archiveHabit(${idx})">
              ${habit.archived ? t["unarchive"] : t["archive"]}
            </button>
            <button class="btn btn-outline-danger btn-sm habit-btn" onclick="deleteHabit(${idx})"><i class="fa fa-trash"></i> ${t["delete"]}</button>
          </div>
        </div>
      `;
    });
    renderStats(activeCount, doneTodayCount, bestStreak);
    renderBanner(activeCount, doneTodayCount);
  }

  // Form submit: add habit
  document.addEventListener('DOMContentLoaded', function() {
    // Ensure local testing picks Arabic
    try { localStorage.setItem('timerhavenLang','ar'); } catch(e) {}
    applyLanguage(getLang());

    const form = document.getElementById('habitForm');
    if (form) {
      form.addEventListener('submit', function(e){
        e.preventDefault();
        const name = document.getElementById('habitInput').value.trim();
        if (!name) return;
        habits.push({
          name,
          streak: 0,
          longest: 0,
          doneToday: false,
          lastChecked: getTodayStr(),
          history: [],
          archived: false
        });
        saveHabits();
        document.getElementById('habitInput').value = "";
        renderHabits();
      });
    }

    // Wire up storage event (language changes from other tabs)
    window.addEventListener('storage', function(e) {
      if (e.key === 'timerhavenLang') {
        const lang = (e.newValue || getLang()).slice(0,2);
        applyLanguage(lang);
      }
    });

    // Wire resize to show/hide mobile tips
    window.addEventListener('resize', function(){ applyLanguage(getLang()); });

    // Initial render
    renderHabits();
  });

  // Actions accessible from HTML
  window.markDone = function(idx){
    const today = getTodayStr();
    if (!habits[idx].doneToday) {
      habits[idx].doneToday = true;
      habits[idx].lastChecked = today;
      habits[idx].streak = (habits[idx].streak || 0) + 1;
      habits[idx].longest = Math.max(habits[idx].longest || 0, habits[idx].streak);
      if (!habits[idx].history) habits[idx].history = [];
      if (!habits[idx].history.includes(today)) habits[idx].history.push(today);
      saveHabits();
      renderHabits();
    }
  }
  window.archiveHabit = function(idx){
    habits[idx].archived = !habits[idx].archived;
    saveHabits();
    renderHabits();
  }
  window.deleteHabit = function(idx){
    habits.splice(idx, 1);
    saveHabits();
    renderHabits();
  }
</script>
