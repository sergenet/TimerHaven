    function populateCurrencySelects() {
      const from = document.getElementById('fromCurrency');
      const to = document.getElementById('toCurrency');
      from.innerHTML = '';
      to.innerHTML = '';
      currencyList.forEach(cur => {
        from.innerHTML += `<option value="${cur}">${cur}</option>`;
        to.innerHTML += `<option value="${cur}">${cur}</option>`;
      });
      from.value = "USD";
      to.value = "EUR";
    }
    populateCurrencySelects();

    function getLang() {
      try {
        const l = localStorage.getItem('timerhavenLang') || 'en';
        return (l && l.slice(0,2)) || 'en';
      } catch (e) {
        return 'en';
      }
    }

    function applyLanguage(lang) {
      lang = (lang || getLang()).slice(0,2);
      const t = currencyTranslations[lang] || currencyTranslations['en'];

      document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';

      const back = document.getElementById('back-link');
      if (back) back.textContent = t['back-link'] || '';

      const toolTitle = document.getElementById('tool-title');
      if (toolTitle) toolTitle.innerHTML = `<i class="fa fa-dollar-sign"></i> ${t['tool-title'] || ''}`;

      const help = document.getElementById('tool-help');
      if (help) help.textContent = t['tool-help'] || '';

      const amount = document.getElementById('amount');
      if (amount) amount.placeholder = t['amount'] || '';

      const convertBtn = document.getElementById('convert-btn');
      if (convertBtn) convertBtn.textContent = t['convert'] || 'Convert';

      const resultEl = document.getElementById('result');
      if (resultEl) resultEl.textContent = t['result-placeholder'] || '';

      const faqTitle = document.getElementById('faq-title');
      if (faqTitle) faqTitle.textContent = t['faq-title'] || '';
      const faqList = document.getElementById('faq-list');
      if (faqList) faqList.innerHTML = t['faq-list'] || '';

      const howtoTitle = document.getElementById('howto-title');
      const howtoSteps = document.getElementById('howto-steps');
      if (howtoTitle) howtoTitle.innerHTML = t['howto-title'] || '';
      if (howtoSteps) howtoSteps.innerHTML = t['howto-steps'] || '';

      const howtoBtn = document.getElementById('howto-article-btn');
      if (howtoBtn) { howtoBtn.textContent = t['howto-article-btn'] || ''; howtoBtn.href = t['howto-article-link'] || '#'; }

      const tipsTitle = document.getElementById('tips-title');
      const tipsList = document.getElementById('tips-list');
      const tipsBtn = document.getElementById('tips-article-btn');
      if (tipsTitle) tipsTitle.innerHTML = t['tips-title'] || '';
      if (tipsList) tipsList.innerHTML = t['tips-list'] || '';
      if (tipsBtn) { tipsBtn.textContent = t['tips-article-btn'] || ''; tipsBtn.href = t['tips-article-link'] || '#'; }

      const howtoMobileTitle = document.getElementById('howto-mobile-title');
      const howtoMobileSteps = document.getElementById('howto-mobile-steps');
      const tipsMobileTitle = document.getElementById('tips-mobile-title');
      const tipsMobileList = document.getElementById('tips-mobile-list');
      if (howtoMobileTitle) howtoMobileTitle.innerHTML = t['howto-title'] || '';
      if (howtoMobileSteps) howtoMobileSteps.innerHTML = t['howto-steps'] || '';
      if (tipsMobileTitle) tipsMobileTitle.innerHTML = t['tips-title'] || '';
      if (tipsMobileList) tipsMobileList.innerHTML = t['tips-list'] || '';

      // After language/apply, equalize left/right cards (how-to and tips).
      // Use a short delay to allow DOM reflow and font load.
      setTimeout(equalizeHowToAndTips, 60);
      setTimeout(equalizeHowToAndTips, 220);
    }

    // Equalize heights for only the How-to and Tips article cards (left & right).
    function equalizeHowToAndTips(){
      const left = document.getElementById('howto-article-card');
      const right = document.getElementById('tips-article-card');
      if (!left || !right) return;
      // reset
      left.style.height = '';
      right.style.height = '';
      // measure
      const lh = Math.ceil(left.getBoundingClientRect().height);
      const rh = Math.ceil(right.getBoundingClientRect().height);
      const max = Math.max(lh, rh);
      if (max > 0) {
        left.style.height = max + 'px';
        right.style.height = max + 'px';
      }
    }

    // React to language changes from other tabs
    window.addEventListener('storage', function(e) {
      if (e.key === 'timerhavenLang') {
        applyLanguage((e.newValue || 'en').slice(0,2));
      }
    });

    // Fallback observers to re-run equalization for dynamic content changes (e.g., translations)
    (function(){
      const container = document.getElementById('page-main');
      if (!container) return;
      const mo = new MutationObserver(() => {
        setTimeout(equalizeHowToAndTips, 80);
        setTimeout(equalizeHowToAndTips, 240);
      });
      mo.observe(container, { childList: true, subtree: true, characterData: true });
      window.addEventListener('resize', () => setTimeout(equalizeHowToAndTips, 80));
    })();

    // Currency select population & conversion logic (unchanged behavior)
    function populateCurrencySelects() {
      const from = document.getElementById('fromCurrency');
      const to = document.getElementById('toCurrency');
      from.innerHTML = '';
      to.innerHTML = '';
      currencyList.forEach(cur => {
        from.innerHTML += `<option value="${cur}">${cur}</option>`;
        to.innerHTML += `<option value="${cur}">${cur}</option>`;
      });
      from.value = "USD";
      to.value = "EUR";
    }
    populateCurrencySelects();

    function getLang() {
      try { const l = localStorage.getItem('timerhavenLang') || 'en'; return (l && l.slice(0,2)) || 'en'; } catch(e){ return 'en'; }
    }

    // Conversion form handler
    document.getElementById('currencyForm').addEventListener('submit', function(e){
      e.preventDefault();
      const amountVal = parseFloat(document.getElementById('amount').value);
      const fromCur = document.getElementById('fromCurrency').value;
      const toCur = document.getElementById('toCurrency').value;
      const lang = getLang();
      const t = currencyTranslations[lang] || currencyTranslations['en'];

      if (isNaN(amountVal) || amountVal <= 0) {
        document.getElementById('result').innerText = t['amount-error'] || ((lang === "ar") ? "ÙŠØ±Ø¬Ù‰ Ø¥Ø¯Ø®Ø§Ù„ Ù…Ø¨Ù„Øº ØµØ­ÙŠØ­." : "Please enter a valid amount.");
        return;
      }

      document.getElementById('result').innerText = t['fetching'] || ((lang === "ar") ? "Ø¬Ø§Ø±Ù Ø¬Ù„Ø¨ Ø§Ù„Ø³Ø¹Ø±..." : "Fetching rate...");

      fetch(`https://v6.exchangerate-api.com/v6/${apiKey}/pair/${fromCur}/${toCur}/${amountVal}`)
        .then(r => r.json())
        .then(data => {
          if (data && typeof data.conversion_result !== 'undefined') {
            const conv = (Math.round((data.conversion_result + Number.EPSILON) * 100000) / 100000);
            const rate = (Math.round((data.conversion_rate + Number.EPSILON) * 100000) / 100000);
            document.getElementById('result').innerText = `${amountVal} ${fromCur} = ${conv} ${toCur} (Rate: ${rate})`;
          } else {
            document.getElementById('result').innerText = t['conversion-unavailable'] || ((lang === "ar") ? "Ø§Ù„ØªØ­ÙˆÙŠÙ„ ØºÙŠØ± Ù…ØªØ§Ø­." : "Conversion not available.");
          }
        })
        .catch(() => {
          document.getElementById('result').innerText = t['fetch-error'] || ((lang === "ar") ? "ØªØ¹Ø°Ø± Ø¬Ù„Ø¨ Ø§Ù„ØªØ­ÙˆÙŠÙ„." : "Could not fetch conversion.");
        });
    });

    // Initialize
    document.addEventListener('DOMContentLoaded', function(){
      // Remove the legacy language indicator element (defensive)
      try {
        const li = document.getElementById('language-indicator');
        if (li && li.parentNode) li.parentNode.removeChild(li);
      } catch(e){}

      applyLanguage(getLang());
      populateCurrencySelects();
      // ensure equalization after everything settles
      setTimeout(equalizeHowToAndTips, 120);
      setTimeout(equalizeHowToAndTips, 420);
    });
  </script>

