      "habitInput":"ÎŒÎ½Î¿Î¼Î± ÏƒÏ…Î½Î®Î¸ÎµÎ¹Î±Ï‚","add-btn":"Î ÏÎ¿ÏƒÎ¸Î®ÎºÎ·","banner-all-done":"ðŸŽ‰ ÎŒÎ»ÎµÏ‚ Î¿Î¹ ÏƒÏ…Î½Î®Î¸ÎµÎ¹ÎµÏ‚ Î¿Î»Î¿ÎºÎ»Î·ÏÏŽÎ¸Î·ÎºÎ±Î½ ÏƒÎ®Î¼ÎµÏÎ±! ÎœÏ€ÏÎ¬Î²Î¿!",
      "stats-tracked":"Î Î±ÏÎ±ÎºÎ¿Î»Î¿Ï…Î¸Î¿ÏÎ½Ï„Î±Î¹: ","stats-done":"ÎŸÎ»Î¿ÎºÎ»Î·ÏÏŽÎ¸Î·ÎºÎ±Î½ ÏƒÎ®Î¼ÎµÏÎ±: ","stats-best":"ÎšÎ±Î»ÏÏ„ÎµÏÎ· ÏƒÎµÎ¹ÏÎ¬: ",
      "howto-title":'<i class="fa fa-check-double"></i> Î ÏŽÏ‚ Î½Î± Ï‡ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÎµÏ„Îµ Ï„Î¿ Habit Tracker',
      "howto-steps":`<li><b>Î ÏÎ¿ÏƒÎ¸Î­ÏƒÏ„Îµ ÏƒÏ…Î½Î®Î¸ÎµÎ¹Î±:</b> Î Î»Î·ÎºÏ„ÏÎ¿Î»Î¿Î³Î®ÏƒÏ„Îµ Ï„Î·Î½ ÎºÎ±Î¸Î·Î¼ÎµÏÎ¹Î½Î® ÏƒÎ±Ï‚ ÏƒÏ…Î½Î®Î¸ÎµÎ¹Î± ÎºÎ±Î¹ Ï€Î±Ï„Î®ÏƒÏ„Îµ Î ÏÎ¿ÏƒÎ¸Î®ÎºÎ·.</li>
        <li><b>Î£Î·Î¼ÎµÎ¹ÏŽÏƒÏ„Îµ Ï‰Ï‚ Î¿Î»Î¿ÎºÎ»Î·ÏÏ‰Î¼Î­Î½Î·:</b> ÎŒÏ„Î±Î½ Î¿Î»Î¿ÎºÎ»Î·ÏÏŽÏƒÎµÏ„Îµ Î¼Î¹Î± ÏƒÏ…Î½Î®Î¸ÎµÎ¹Î±, Ï€Î±Ï„Î®ÏƒÏ„Îµ ÎŸÎ»Î¿ÎºÎ»Î·ÏÏŽÎ¸Î·ÎºÎµ.</li>
        <li><b>Î”Î¹Î±Î³ÏÎ±Ï†Î®/Î‘ÏÏ‡ÎµÎ¹Î¿Î¸Î­Ï„Î·ÏƒÎ·:</b> Î”Î¹Î±Î³ÏÎ¬ÏˆÏ„Îµ Î® Î±ÏÏ‡ÎµÎ¹Î¿Î¸ÎµÏ„Î®ÏƒÏ„Îµ ÏƒÏ…Î½Î®Î¸ÎµÎ¹ÎµÏ‚ Ï€Î¿Ï… Î´ÎµÎ½ Î¸Î­Î»ÎµÏ„Îµ Ï€Î»Î­Î¿Î½.</li>
        <li><b>Î•Ï€Î±Î½Î±Î»Î¬Î²ÎµÏ„Îµ ÎºÎ±Î¸Î·Î¼ÎµÏÎ¹Î½Î¬:</b> Î•Ï€Î¹ÏƒÏ„ÏÎ­ÏˆÏ„Îµ ÎºÎ±Î¸Î·Î¼ÎµÏÎ¹Î½Î¬ Î³Î¹Î± Î½Î± ÎµÎ½Î·Î¼ÎµÏÏŽÏƒÎµÏ„Îµ Ï„Î·Î½ Ï€ÏÏŒÎ¿Î´ÏŒ ÏƒÎ±Ï‚.</li>`,
      "howto-article-btn":"Î”Î¹Î±Î²Î¬ÏƒÏ„Îµ Ï„Î¿ Î¬ÏÎ¸ÏÎ¿","howto-article-link":"habit-how-to-el.html",
      "tips-title":'<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Î£Ï…Î¼Î²Î¿Ï…Î»Î­Ï‚',
      "tips-list":`<li><b>ÎžÎµÎºÎ¹Î½Î®ÏƒÏ„Îµ Î¼Î¹ÎºÏÎ¬:</b> Î•Ï€Î¹Î»Î­Î¾Ï„Îµ ÎµÏÎºÎ¿Î»ÎµÏ‚ ÏƒÏ…Î½Î®Î¸ÎµÎ¹ÎµÏ‚ ÏƒÏ„Î·Î½ Î±ÏÏ‡Î®.</li>
        <li><b>Î Î±ÏÎ±ÎºÎ¿Î»Î¿Ï…Î¸Î®ÏƒÏ„Îµ ÎºÎ±Î¸Î·Î¼ÎµÏÎ¹Î½Î¬:</b> Î— ÏƒÏ…Î½Î­Ï€ÎµÎ¹Î± ÎµÎ¯Î½Î±Î¹ ÏƒÎ·Î¼Î±Î½Ï„Î¹ÎºÎ®.</li>
        <li><b>Î“Î¹Î¿ÏÏ„Î¬ÏƒÏ„Îµ Ï€ÏÏŒÎ¿Î´Î¿:</b> ÎœÎ¹ÎºÏÎ­Ï‚ Î½Î¯ÎºÎµÏ‚ Î´Î¹Î±Ï„Î·ÏÎ¿ÏÎ½ Ï„Î·Î½ ÎºÎ¯Î½Î·Ï„ÏÎ¿.</li>`,
      "tips-article-btn":"Î”Î¹Î±Î²Î¬ÏƒÏ„Îµ","tips-article-link":"habit-tips-el.html",
      "tips-mobile-title":'<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Î£Ï…Î¼Î²Î¿Ï…Î»Î­Ï‚',
      "tips-mobile-list":`<li><b>ÎžÎµÎºÎ¹Î½Î®ÏƒÏ„Îµ Î¼Î¹ÎºÏÎ¬:</b> ÎŸÎ¹ÎºÎ¿Î´Î¿Î¼Î®ÏƒÏ„Îµ ÏƒÏ„Î±Î´Î¹Î±ÎºÎ¬.</li>
        <li><b>Î Î±ÏÎ±ÎºÎ¿Î»Î¿Ï…Î¸Î®ÏƒÏ„Îµ ÏƒÎµÎ¹ÏÎ­Ï‚:</b> Î’Î»Î­Ï€Î¿Î½Ï„Î±Ï‚ Ï€ÏÏŒÎ¿Î´Î¿Ï…Ï‚, Î¼Î­Î½ÎµÏ„Îµ ÎºÎ¹Î½Î·Ï„Î¿Ï€Î¿Î¹Î·Î¼Î­Î½Î¿Î¹.</li>
        <li><b>ÎŸÏÎ¯ÏƒÏ„Îµ Ï…Ï€ÎµÎ½Î¸Ï…Î¼Î¯ÏƒÎµÎ¹Ï‚:</b> Î§ÏÎ·ÏƒÎ¹Î¼Î¿Ï€Î¿Î¹Î®ÏƒÏ„Îµ Ï…Ï€ÎµÎ½Î¸Ï…Î¼Î¯ÏƒÎµÎ¹Ï‚ Î·Î¼ÎµÏÎ¿Î»Î¿Î³Î¯Î¿Ï….</li>`,
      "faq-title":"Î£Ï…Ï‡Î½Î­Ï‚ Î•ÏÏ‰Ï„Î®ÏƒÎµÎ¹Ï‚",
      "faq-list":`<li><b>Î‘Ï€Î¿Î¸Î·ÎºÎµÏÎ¿Î½Ï„Î±Î¹ Î¿Î¹ ÏƒÏ…Î½Î®Î¸ÎµÎ¹ÎµÏ‚;</b> ÎÎ±Î¹, ÏƒÏ„Î¿ Ï€ÏÏŒÎ³ÏÎ±Î¼Î¼Î± Ï€ÎµÏÎ¹Î®Î³Î·ÏƒÎ·Ï‚.</li>
        <li><b>Î Î¿Î»Î»Î­Ï‚ ÏƒÏ…Î½Î®Î¸ÎµÎ¹ÎµÏ‚;</b> ÎÎ±Î¹.</li>
        <li><b>ÎŸÏÎ±Ï„Î­Ï‚ ÏƒÎµÎ¹ÏÎ­Ï‚;</b> ÎÎ±Î¹.</li>`,
      "mark-done":"Î£Î·Î¼ÎµÎ¹ÏŽÏƒÏ„Îµ","done-today":"ÎŸÎ»Î¿ÎºÎ»Î·ÏÏŽÎ¸Î·ÎºÎµ ÏƒÎ®Î¼ÎµÏÎ±","streak":"Î£ÎµÎ¹ÏÎ¬: ","longest":"ÎšÎ±Î»ÏÏ„ÎµÏÎ¿: ",
      "archive":"Î‘ÏÏ‡ÎµÎ¹Î¿Î¸Î­Ï„Î·ÏƒÎ·","unarchive":"Î•Ï€Î±Î½Î±Ï†Î¿ÏÎ¬","delete":"Î”Î¹Î±Î³ÏÎ±Ï†Î®","no-habits":"Î”ÎµÎ½ Ï…Ï€Î¬ÏÏ‡Î¿Ï…Î½ ÏƒÏ…Î½Î®Î¸ÎµÎ¹ÎµÏ‚ Î±ÎºÏŒÎ¼Î±."
    }
  };

  const langNames = { en: "English", fr: "FranÃ§ais", de: "Deutsch", ru: "Ð ÑƒÑÑÐºÐ¸Ð¹", el: "Î•Î»Î»Î·Î½Î¹ÎºÎ¬", es: "EspaÃ±ol", ar: "Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©" };
  function getLang(){ try{ const l=localStorage.getItem('timerhavenLang')||'el'; return (l && l.slice(0,2))||'el'; }catch(e){ return 'el'; } }

  function applyLanguage(lang){ 
    lang=(lang||getLang()).slice(0,2); 
    const t=habitTranslations[lang]||habitTranslations['el']; 
    document.body.dir=(lang==="ar")?"rtl":"ltr"; 

    // language indicator not present â€” calls are guarded
    const labelEl=document.getElementById('language-label'); if(labelEl) labelEl.textContent=t['language-label']; 
    const nameEl=document.getElementById('language-name'); if(nameEl) nameEl.textContent='Î•Î»Î»Î·Î½Î¹ÎºÎ¬'; 

    const back=document.getElementById('back-link'); if(back) back.textContent=t['back-link']; 
    const toolTitle=document.getElementById('tool-title'); if(toolTitle) toolTitle.innerHTML=`<i class="fa fa-check-double"></i> ${t['tool-title']}`; 
    const input=document.getElementById('habitInput'); if(input) input.placeholder=t['habitInput']; 
    const addBtn=document.getElementById('add-btn'); if(addBtn) addBtn.textContent=t['add-btn']; 
    const faqTitle=document.getElementById('faq-title'); if(faqTitle) faqTitle.textContent=t['faq-title']; 
    const faqList=document.getElementById('faq-list'); if(faqList) faqList.innerHTML=t['faq-list']; 
    const howtoTitle=document.getElementById('howto-title'); if(howtoTitle) howtoTitle.innerHTML=t['howto-title']; 
    const howtoSteps=document.getElementById('howto-steps'); if(howtoSteps) howtoSteps.innerHTML=t['howto-steps']; 
    const howtoBtn=document.getElementById('howto-article-btn'); if(howtoBtn){ howtoBtn.textContent=t['howto-article-btn']; howtoBtn.href=t['howto-article-link']; } 
    const tipsTitle=document.getElementById('tips-title'); if(tipsTitle) tipsTitle.innerHTML=t['tips-title']; 
    const tipsList=document.getElementById('tips-list'); if(tipsList) tipsList.innerHTML=t['tips-list']; 
    const tipsBtn=document.getElementById('tips-article-btn'); if(tipsBtn){ tipsBtn.textContent=t['tips-article-btn']; tipsBtn.href=t['tips-article-link']; }
    const tipsMobileTitle=document.getElementById('tips-mobile-title'); if(tipsMobileTitle) tipsMobileTitle.innerHTML=t['tips-mobile-title']; 
    const tipsMobileList=document.getElementById('tips-mobile-list'); if(tipsMobileList) tipsMobileList.innerHTML=t['tips-mobile-list']; 

    renderHabits();

    const mobileDetails = document.getElementById('tips-mobile');
    if (mobileDetails) mobileDetails.style.display = (window.innerWidth < 801) ? 'block' : 'none';
  }

  function getTodayStr(){ const d=new Date(); return d.getFullYear()+"-"+(d.getMonth()+1).toString().padStart(2,"0")+"-"+d.getDate().toString().padStart(2,"0"); }
  function lastNDays(n){ const arr=[]; for(let i=n-1;i>=0;i--){ const d=new Date(); d.setDate(d.getDate()-i); arr.push(d.getFullYear()+"-"+(d.getMonth()+1).toString().padStart(2,"0")+"-"+d.getDate().toString().padStart(2,"0")); } return arr; }

  let habits = JSON.parse(localStorage.getItem('habits') || '[]');
  function saveHabits(){ localStorage.setItem('habits', JSON.stringify(habits)); }
  function resetHabitsIfNeeded(){ const today=getTodayStr(); let changed=false; habits.forEach(h=>{ if(!h.history) h.history=[]; if(h.lastChecked!==today){ h.doneToday=false; h.lastChecked=today; changed=true; }}); if(changed) saveHabits(); }

  function renderHabits(){ resetHabitsIfNeeded(); const lang=getLang(); const t=habitTranslations[lang]||habitTranslations['el']; const list=document.getElementById('habitList'); list.innerHTML=''; const today=getTodayStr(); let doneTodayCount=0; let bestStreak=0; let activeCount=0; habits.forEach(h=>{ if(!h.archived) activeCount++; }); if(habits.length===0||activeCount===0){ list.innerHTML=`<div style="color:#888;">${t["no-habits"]}</div>`; } habits.forEach((habit, idx)=>{ if(habit.archived) return; let streak=habit.streak||0; let longest=habit.longest||streak; bestStreak=Math.max(bestStreak,longest); if(!habit.history) habit.history=[]; let historyDots=''; lastNDays(7).forEach(date=>{ const done=habit.history.includes(date); historyDots+=`<span class="dot${done?' done':''}${date===today?' today':''}" title="${date}"></span>`; }); const isDone=habit.doneToday; if(isDone) doneTodayCount++; list.innerHTML+=`<div class="habit-item"><span><b>${habit.name}</b><span class="habit-meta">${t["streak"]}${streak} ${t["longest"]}${longest}</span><span class="habit-history">${historyDots}</span></span><button class="btn btn-outline-${isDone?'secondary':'success'} btn-sm habit-btn" onclick="markDone(${idx})" ${isDone?'disabled':''}>${isDone? t["done-today"]: t["mark-done"]}</button><button class="archive-btn${habit.archived?' archived':''}" onclick="archiveHabit(${idx})">${habit.archived? t["unarchive"]: t["archive"]}</button><button class="btn btn-outline-danger btn-sm habit-btn" onclick="deleteHabit(${idx})"><i class="fa fa-trash"></i> ${t["delete"]}</button></div>`; }); renderStats(activeCount, doneTodayCount, bestStreak); renderBanner(activeCount, doneTodayCount); }
  function renderStats(tracked, done, best){ const t=habitTranslations[getLang()]; document.getElementById("stats-bar").innerHTML=`${t["stats-tracked"]}${tracked} &bull; ${t["stats-done"]}${done} &bull; ${t["stats-best"]}${best}`; }
  function renderBanner(tracked, done){ const t=habitTranslations[getLang()]; const banner=document.getElementById("banner"); if(tracked>0 && done===tracked){ banner.textContent=t["banner-all-done"]; banner.style.display="block"; } else { banner.style.display="none"; } }

  document.getElementById('habitForm').addEventListener('submit', function(e){ e.preventDefault(); const name=document.getElementById('habitInput').value.trim(); if(!name) return; habits.push({ name, streak:0, longest:0, doneToday:false, lastChecked:getTodayStr(), history:[], archived:false }); saveHabits(); document.getElementById('habitInput').value=''; renderHabits(); });

  window.markDone=function(idx){ const today=getTodayStr(); if(!habits[idx].doneToday){ habits[idx].doneToday=true; habits[idx].lastChecked=today; habits[idx].streak=(habits[idx].streak||0)+1; habits[idx].longest=Math.max(habits[idx].longest||0,habits[idx].streak); if(!habits[idx].history) habits[idx].history=[]; if(!habits[idx].history.includes(today)) habits[idx].history.push(today); saveHabits(); renderHabits(); } }
  window.archiveHabit=function(idx){ habits[idx].archived=!habits[idx].archived; saveHabits(); renderHabits(); }
  window.deleteHabit=function(idx){ habits.splice(idx,1); saveHabits(); renderHabits(); }

  window.addEventListener('storage', function(e){ if(e.key==='timerhavenLang'){ const lang=(e.newValue||getLang()).slice(0,2); applyLanguage(lang); }});
  document.addEventListener('DOMContentLoaded', function(){ applyLanguage(getLang()); renderHabits(); window.addEventListener('resize', function(){ applyLanguage(getLang()); }); });
</script>
