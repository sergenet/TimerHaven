      {value:"Europe/London", label:"Ù„Ù†Ø¯Ù† ðŸ‡¬ðŸ‡§"},
      {value:"Europe/Paris", label:"Ø¨Ø§Ø±ÙŠØ³ ðŸ‡«ðŸ‡·"},
      {value:"Europe/Berlin", label:"Ø¨Ø±Ù„ÙŠÙ† ðŸ‡©ðŸ‡ª"},
      {value:"Europe/Moscow", label:"Ù…ÙˆØ³ÙƒÙˆ ðŸ‡·ðŸ‡º"},
      {value:"Europe/Istanbul", label:"Ø¥Ø³Ø·Ù†Ø¨ÙˆÙ„ ðŸ‡¹ðŸ‡·"},
      {value:"Asia/Dubai", label:"Ø¯Ø¨ÙŠ ðŸ‡¦ðŸ‡ª"},
      {value:"Asia/Kolkata", label:"ÙƒÙˆÙ„ÙƒØ§ØªØ§ ðŸ‡®ðŸ‡³"},
      {value:"Asia/Shanghai", label:"Ø´Ù†ØºÙ‡Ø§ÙŠ ðŸ‡¨ðŸ‡³"},
      {value:"Asia/Tokyo", label:"Ø·ÙˆÙƒÙŠÙˆ ðŸ‡¯ðŸ‡µ"},
      {value:"Asia/Singapore", label:"Ø³Ù†ØºØ§ÙÙˆØ±Ø© ðŸ‡¸ðŸ‡¬"},
      {value:"Asia/Jakarta", label:"Ø¬Ø§ÙƒØ±ØªØ§ ðŸ‡®ðŸ‡©"},
      {value:"Australia/Sydney", label:"Ø³ÙŠØ¯Ù†ÙŠ ðŸ‡¦ðŸ‡º"},
      {value:"Pacific/Auckland", label:"Ø£ÙˆÙƒÙ„Ø§Ù†Ø¯ ðŸ‡³ðŸ‡¿"},
      {value:"America/Sao_Paulo", label:"Ø³Ø§Ùˆ Ø¨Ø§ÙˆÙ„Ùˆ ðŸ‡§ðŸ‡·"},
      {value:"America/Mexico_City", label:"Ù…ÙƒØ³ÙŠÙƒÙˆ Ø³ÙŠØªÙŠ ðŸ‡²ðŸ‡½"},
      {value:"Africa/Johannesburg", label:"Ø¬ÙˆÙ‡Ø§Ù†Ø³Ø¨Ø±Øº ðŸ‡¿ðŸ‡¦"},
      {value:"Africa/Cairo", label:"Ø§Ù„Ù‚Ø§Ù‡Ø±Ø© ðŸ‡ªðŸ‡¬"},
      {value:"Africa/Nairobi", label:"Ù†ÙŠØ±ÙˆØ¨ÙŠ ðŸ‡°ðŸ‡ª"},
      {value:"Asia/Seoul", label:"Ø³ÙŠÙˆÙ„ ðŸ‡°ðŸ‡·"},
      {value:"Asia/Hong_Kong", label:"Ù‡ÙˆÙ†Øº ÙƒÙˆÙ†Øº ðŸ‡­ðŸ‡°"},
      {value:"Asia/Bangkok", label:"Ø¨Ø§Ù†ÙƒÙˆÙƒ ðŸ‡¹ðŸ‡­"},
      {value:"Asia/Manila", label:"Ù…Ø§Ù†ÙŠÙ„Ø§ ðŸ‡µðŸ‡­"},
      {value:"Europe/Madrid", label:"Ù…Ø¯Ø±ÙŠØ¯ ðŸ‡ªðŸ‡¸"},
      {value:"Europe/Rome", label:"Ø±ÙˆÙ…Ø§ ðŸ‡®ðŸ‡¹"},
      {value:"Europe/Warsaw", label:"ÙˆØ§Ø±Ø³Ùˆ ðŸ‡µðŸ‡±"},
      {value:"Europe/Amsterdam", label:"Ø£Ù…Ø³ØªØ±Ø¯Ø§Ù… ðŸ‡³ðŸ‡±"},
      {value:"Europe/Athens", label:"Ø£Ø«ÙŠÙ†Ø§ ðŸ‡¬ðŸ‡·"},
      {value:"America/Vancouver", label:"ÙØ§Ù†ÙƒÙˆÙØ± ðŸ‡¨ðŸ‡¦"}
    ];

    function populateCities() {
      const sel = document.getElementById('participantCity');
      sel.innerHTML = '';
      cities.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.value;
        opt.textContent = c.label;
        sel.appendChild(opt);
      });
    }

    const LS_KEY = 'meetingPlannerParticipants';
    function loadParticipants() {
      try {
        const raw = localStorage.getItem(LS_KEY);
        window.participants = raw ? JSON.parse(raw) : [];
      } catch(e) {
        window.participants = [];
      }
    }
    function saveParticipants() {
      try { localStorage.setItem(LS_KEY, JSON.stringify(window.participants || [])); } catch(e) {}
    }
    function renderParticipants() {
      const container = document.getElementById('participantList');
      container.innerHTML = '';
      if (!window.participants || window.participants.length === 0) {
        container.innerHTML = '<div style="color:#888;">Ù„Ø§ ÙŠÙˆØ¬Ø¯ Ù…Ø´Ø§Ø±ÙƒÙˆÙ† Ø­ØªÙ‰ Ø§Ù„Ø¢Ù†.</div>';
        return;
      }
      window.participants.forEach((p, idx) => {
        const el = document.createElement('div');
        el.className = 'participant-item';
        el.innerHTML = `<div style="min-width:0; text-align:right;"><div style="font-weight:700;">${escapeHtml(p.name)}</div><div style="font-size:.9em;color:#666;">${escapeHtml(p.city)}</div></div>
          <div style="display:flex;gap:.5rem;"><button class="btn btn-outline-danger btn-sm" onclick="removeParticipant(${idx})" aria-label="Ø­Ø°Ù Ø§Ù„Ù…Ø´Ø§Ø±Ùƒ"><i class="fa fa-trash"></i></button></div>`;
        container.appendChild(el);
      });
    }
    function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

    document.getElementById('addParticipant').addEventListener('click', function(){
      const name = document.getElementById('participantName').value.trim();
      const city = document.getElementById('participantCity').value;
      if (!name) { alert('ÙŠØ±Ø¬Ù‰ Ø¥Ø¯Ø®Ø§Ù„ Ø§Ø³Ù… Ø§Ù„Ù…Ø´Ø§Ø±Ùƒ.'); return; }
      if (!city) { alert('ÙŠØ±Ø¬Ù‰ Ø§Ø®ØªÙŠØ§Ø± Ù…Ø¯ÙŠÙ†Ø© / Ù…Ù†Ø·Ù‚Ø© Ø²Ù…Ù†ÙŠØ©.'); return; }
      window.participants = window.participants || [];
      window.participants.push({ name, city });
      saveParticipants();
      document.getElementById('participantName').value = '';
      document.getElementById('participantCity').selectedIndex = 0;
      renderParticipants();
      updateMeetingTimes();
    });

    document.getElementById('clearParticipants').addEventListener('click', function(){
      if (!window.participants || window.participants.length === 0) return;
      if (!confirm('Ù‡Ù„ ØªØ±ÙŠØ¯ Ù…Ø³Ø­ ÙƒÙ„ Ø§Ù„Ù…Ø´Ø§Ø±ÙƒÙŠÙ†ØŸ')) return;
      window.participants = [];
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    });

    window.removeParticipant = function(idx){
      if (!window.participants) return;
      window.participants.splice(idx,1);
      saveParticipants();
      renderParticipants();
      updateMeetingTimes();
    };

    // Luxon usage
    const { DateTime } = luxon;
    function updateMeetingTimes(){
      const date = document.getElementById('meetingDate').value;
      const time = document.getElementById('meetingTime').value;
      const out = document.getElementById('meetingTimes');
      const tlang = {
        noDateTime: "ÙŠØ±Ø¬Ù‰ Ø§Ø®ØªÙŠØ§Ø± Ø§Ù„ØªØ§Ø±ÙŠØ® ÙˆØ§Ù„ÙˆÙ‚Øª.",
        noParticipants: "Ù„Ø§ ÙŠÙˆØ¬Ø¯ Ù…Ø´Ø§Ø±ÙƒÙˆÙ† Ø­ØªÙ‰ Ø§Ù„Ø¢Ù†.",
        heading: "Ø£ÙˆÙ‚Ø§Øª Ø§Ù„Ø§Ø¬ØªÙ…Ø§Ø¹ (Ø§Ù„Ù…Ù†Ø¸Ù… Ù…Ø­Ù„ÙŠ â†’ Ø§Ù„Ù…Ø´Ø§Ø±ÙƒÙˆÙ† Ù…Ø­Ù„ÙŠØ§Ù‹)"
      };
      if (!date || !time) { out.innerHTML = `<div style="color:#888;">${tlang.noDateTime}</div>`; return; }
      if (!window.participants || window.participants.length === 0) { out.innerHTML = `<div style="color:#888;">${tlang.noParticipants}</div>`; return; }
      const localISO = `${date}T${time}`;
      let organizer = DateTime.fromISO(localISO);
      if (!organizer.isValid) { out.innerHTML = `<div style="color:#b00;">${tlang.noDateTime}</div>`; return; }
      let html = `<div style="font-weight:700;margin-bottom:.4rem;">${tlang.heading}</div>`;
      html += `<div class="meeting-times-grid">`;
      html += `<div class="time-suggestion"><div style="text-align:right;"><b>Ø§Ù„Ù…Ù†Ø¸Ù…</b> (${escapeHtml(organizer.zoneName)})</div><div>${escapeHtml(organizer.toLocaleString(DateTime.DATETIME_FULL))}</div></div>`;
      window.participants.forEach(p => {
        let dt;
        try { dt = organizer.setZone(p.city); } catch(e) { dt = null; }
        const label = dt ? dt.toLocaleString(DateTime.DATETIME_FULL) : 'Ù…Ù†Ø·Ù‚Ø© Ø²Ù…Ù†ÙŠØ© ØºÙŠØ± ØµØ§Ù„Ø­Ø©';
        html += `<div class="time-suggestion"><div style="text-align:right;"><b>${escapeHtml(p.name)}</b> <span style="color:#666;">(${escapeHtml(p.city)})</span></div><div>${escapeHtml(label)}</div></div>`;
      });
      html += `</div>`;
      out.innerHTML = html;
    }

    document.getElementById('calcTimes').addEventListener('click', updateMeetingTimes);

    // Init
    document.addEventListener('DOMContentLoaded', function(){
      populateCities();
      loadParticipants();
      renderParticipants();
      try {
        const savedDate = localStorage.getItem('meetingPlannerDate');
        const savedTime = localStorage.getItem('meetingPlannerTime');
        if (savedDate) document.getElementById('meetingDate').value = savedDate;
        if (savedTime) document.getElementById('meetingTime').value = savedTime;
      } catch(e){}
    });

    document.getElementById('meetingDate').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerDate', this.value); }catch(e){} });
    document.getElementById('meetingTime').addEventListener('input', function(){ try{ localStorage.setItem('meetingPlannerTime', this.value); }catch(e){} });
  </script>
