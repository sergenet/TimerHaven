<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="google" content="notranslate">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Calendar â€” TimerHaven</title>
  <meta name="description" content="Easily save and manage multiple calendar notes. Learn how to use Calendar, get productivity tips, FAQs, and read expert articles.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    /* Avoid page shift when scrollbar appears/disappears */
    html { overflow-y: scroll; }

    :root {
      --card-bg: #fff;
      --muted: #6b7c89;
      --brand: #185a9d;
    }

    body {
      background: #f4f7fb;
      margin: 0;
      color: #102a43;
      font-family: "Inter", "Montserrat", Arial, sans-serif;
    }

    .main-container {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 0 1rem;
      min-height: 90vh;
    }

    .center-row {
      display: flex;
      gap: 2rem;
      align-items: flex-start; /* top align cards so headers line up */
      justify-content: center;
    }

    .card-base {
      background: var(--card-bg);
      border-radius: 16px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      padding: 2rem 1.3rem 1rem 1.3rem;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: .6rem;
      min-height: 500px;
      width: 340px;
      min-width: 220px;
      max-width: 360px;
      flex: 1 1 340px;
    }

    .tool-card {
      max-width: 640px;
      min-width: 320px;
      flex: 1 1 640px;
      padding: 1.8rem 1.3rem;
    }

    h2, h3 {
      margin: 0 0 .5rem 0;
      font-weight: 700;
      color: #102a43;
    }

    .calendar-header {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:.4rem;
      margin-bottom:.6rem;
      flex-wrap: nowrap;
    }

    .calendar-nav {
      display:flex;
      gap:.2rem;
      align-items:center;
      flex-shrink:0;
    }

    /* slightly tighter buttons so selects have room */
    .calendar-nav .btn {
      min-width: 36px;
      padding: .18rem .4rem;
      height: 32px;
      line-height: 1;
      display:inline-flex;
      align-items:center;
      justify-content:center;
    }

    .calendar-select {
      border-radius: 8px;
      padding: .18rem .32rem;
      border: 1px solid #e4edf5;
      background: #fff;
      box-shadow: none;
      font-size: .92rem;
      height: 32px;
      line-height: 1;
      box-sizing: border-box;
      -webkit-appearance:none;
      appearance:none;
    }

    /* narrower month/year to guarantee full visibility inside the card */
    .calendar-select.month { width: 95px; }
    .calendar-select.year  { width: 56px; }

    /* KEY FIX: force equal-width columns and consistent cell alignment */
    .calendar-table {
      width: 100%;
      margin-top: .6rem;
      border-collapse: collapse;
      background: #fff;
      border-radius: 8px;
      overflow: hidden;
      min-height: 360px; /* reserve enough height for up to 6 rows */
      transition: min-height .12s ease;
      box-sizing: border-box;
      table-layout: fixed; /* distribute columns evenly */
    }

    /* evenly distribute columns and center headings/dates */
    .calendar-table thead th {
      width: 14.2857%;
      text-align: center;
      font-weight: 700;
      padding: .6rem .3rem;
      border-bottom: 1px solid #eef2f6;
      background: #fff;
    }

    .calendar-table tbody td {
      width: 14.2857%;
      text-align: center;
      vertical-align: middle;
      padding: .5rem .25rem;
      border: none;
      height: 52px; /* consistent row height so dates align */
    }

    /* center the day content inside each td */
    .day-cell {
      cursor: pointer;
      border-radius: 6px;
      transition: background .12s;
      outline: none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width: 34px;
      height: 34px;
      line-height: 1;
      margin: 0 auto; /* center horizontally in td */
      padding: 0;
      box-sizing: border-box;
      background: transparent;
    }

    .day-cell:hover, .day-cell:focus { background: #eef6fb; }

    .has-note { background: #fff5d6 !important; }

    /* today circle centered and fixed size */
    .calendar-today {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width: 34px;
      height: 34px;
      background: linear-gradient(180deg,#e6f7ff 0%,#cfefff 100%);
      color:#004e73;
      border-radius: 50%;
      font-weight:700;
      border:1px solid rgba(0,126,204,0.18);
      box-shadow: 0 4px 12px rgba(24,144,255,0.08);
      padding: 0;
      margin: 0;
    }

    details.faq-section summary { cursor:pointer; padding: .2rem 0; font-weight:600; }
    details.faq-section ul { margin-top:.5rem; color:var(--muted); padding-left:1rem; }

    .note-list { list-style:none; padding:0; margin:0 0 1rem 0; }
    .note-list li { display:flex; gap:.5rem; align-items:center; justify-content:space-between; padding:.4rem .6rem; border-radius:6px; background:#f7fafc; margin-bottom:.5rem; }
    .note-text { word-break:break-word; flex:1; }
    .note-meta { color:var(--muted); font-size:.85rem; margin-left:.6rem; white-space:nowrap; }

    .delete-note-btn { background:none; border:none; color:#c00; cursor:pointer; font-size:1rem; padding:.15rem; }

    @media (max-width: 900px) {
      .center-row { flex-direction: column; gap:1rem; align-items:stretch; }
      .calendar-header { flex-wrap: wrap; }
      .calendar-select.month { width: 100%; }
      .calendar-select.year { width: 120px; }
      .calendar-table thead th, .calendar-table tbody td { height: 44px; }
      .calendar-today { width: 30px; height: 30px; }
    }

    footer { padding:1rem; text-align:center; color:var(--muted); font-size:.95rem; }
  </style>
<script>

</script>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <main class="main-container" id="main">
    <div class="center-row">
      <aside class="card-base article-card" id="left-card">
        <h2 id="howto-title"></h2>
        <ol id="howto-steps"></ol>
        <div style="margin-top:auto;">
          <a id="howto-article-btn" class="btn btn-outline-primary" href="calendar-how-to.html">Read Full Article</a>
        </div>
      </aside>

      <section class="card-base tool-card" id="center-card" aria-labelledby="tool-title">
        <a id="back-link" class="back-link" href="index.html" style="margin-bottom:.25rem;display:inline-block;color:var(--brand);font-weight:600;text-decoration:none;">Back to Main Menu</a>

        <h3 id="tool-title"></h3>
        <div id="tool-help" style="color:var(--muted);margin-bottom:.25rem;"></div>

        <div class="calendar-header" aria-label="Calendar navigation">
          <div class="calendar-nav" role="toolbar" aria-label="Month and year navigation">
            <button id="nav-prev-year" class="btn btn-sm btn-outline-secondary" aria-label="Previous year">Â«</button>
            <button id="nav-prev-month" class="btn btn-sm btn-outline-secondary" aria-label="Previous month">â€¹</button>
            <button id="nav-today" class="btn btn-sm btn-outline-secondary" aria-label="Today">Today</button>
            <button id="nav-next-month" class="btn btn-sm btn-outline-secondary" aria-label="Next month">â€º</button>
            <button id="nav-next-year" class="btn btn-sm btn-outline-secondary" aria-label="Next year">Â»</button>
          </div>

          <div style="display:flex;align-items:center;gap:.4rem;flex-shrink:0;">
            <select id="calendar-month-select" class="calendar-select month" aria-label="Select month"></select>
            <select id="calendar-year-select" class="calendar-select year" aria-label="Select year"></select>
          </div>
        </div>

        <table id="calendar-table" class="calendar-table table" role="grid" aria-describedby="tool-help"></table>

        <details class="faq-section" id="faq-section">
          <summary id="faq-title">FAQs â–¾</summary>
          <ul id="faq-list"></ul>
        </details>
      </section>

      <aside class="card-base article-card" id="right-card">
        <h2 id="tips-title"></h2>
        <ul id="tips-list"></ul>
        <div style="margin-top:auto;">
          <a id="tips-article-btn" class="btn btn-outline-primary" href="calendar-tips.html">Read Full Article</a>
        </div>
      </aside>
    </div>
  </main>

  <!-- Notes Modal -->
  <div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form id="noteForm" autocomplete="off">
          <div class="modal-header">
            <h5 class="modal-title" id="noteModalLabel"></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <ul id="noteList" class="note-list" aria-live="polite"></ul>
            <textarea id="noteInput" class="form-control" rows="3" placeholder=""></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="note-close-btn"></button>
            <button type="submit" class="btn btn-success" id="note-add-btn"></button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <footer>&copy; 2025 TimerHaven. All tools are free and privacy-friendly. <br><a href="privacy.html">Privacy Policy</a> Â· <a href="contact.html">Contact</a></footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Persistent notes and calendar state
    let notes = {};
    try { notes = JSON.parse(localStorage.getItem('calendarNotes') || '{}'); } catch(e) { notes = {}; }

    let currentYear, currentMonth, selectedDay;

    function getLang() { return localStorage.getItem('timerhavenLang') || 'en'; }

    // translations (English + small set of examples)
    const translations = {
      en: {
        "back-link":"Back to Main Menu",
        "tool-title":"Calendar",
        "tool-help":"Click any day to add/view/edit your notes. Multiple notes per day are supported and persist!",
        "faq-title":"FAQs",
        "faq-list": `<li><strong>Are my notes saved?</strong> Yes â€” notes are saved in your browser and remain until you delete them.</li>
                     <li><strong>Can I add more than one note?</strong> Yes â€” you can add multiple notes per day.</li>
                     <li><strong>How to backup?</strong> Use your browser to download/export and re-import a backup file (if available).</li>`,
        "howto-title":"<i class='fa fa-calendar-check'></i> How to Use Calendar",
        "howto-steps": `<li><strong>Click a day:</strong> Open the modal to add/view multiple notes for each day.</li>
                        <li><strong>Organize events:</strong> Every note is timestamped and can be deleted individually.</li>
                        <li><strong>Persistent:</strong> Notes are saved in your browser and remain until you remove them.</li>`,
        "howto-article-link":"calendar-how-to.html",
        "tips-title":"<i class='fa fa-lightbulb'></i> Calendar Productivity Tips",
        "tips-list": `<li><strong>Color code your notes:</strong> Use emojis or tags for quick visual organization.</li>
                      <li><strong>Review regularly:</strong> Remove outdated notes.</li>
                      <li><strong>Plan ahead:</strong> Add notes for future dates.</li>`,
        "tips-article-link":"calendar-tips.html",
        "noteModalLabel":"Notes for",
        "noteInput":"Add a new note for this day...",
        "note-none":"No notes yet for this day.",
        "note-delete":"Delete this note",
        "note-close-btn":"Close",
        "note-add-btn":"Add Note",
        "days":["Sun","Mon","Tue","Wed","Thu","Fri","Sat"]
      }
    };

    function t(lang, key) {
      if (translations[lang] && translations[lang][key]) return translations[lang][key];
      if (translations['en'] && translations['en'][key]) return translations['en'][key];
      return '';
    }

    // Populate month/year selects with wide range +/-100
    function populateMonthYearControls(year, month, lang) {
      lang = lang || getLang();
      const monthSelect = document.getElementById('calendar-month-select');
      const yearSelect = document.getElementById('calendar-year-select');
      if (!monthSelect || !yearSelect) return;
      const locale = (lang === 'ar') ? 'ar-SA' : lang;
      const mf = new Intl.DateTimeFormat(locale, { month:'long' });

      monthSelect.innerHTML = '';
      for (let m=0;m<12;m++){
        const opt = document.createElement('option'); opt.value = String(m); opt.textContent = mf.format(new Date(2000,m,1));
        if (m===month) opt.selected = true; monthSelect.appendChild(opt);
      }

      const now = new Date(); const base = now.getFullYear();
      const start = base - 100; const end = base + 100;
      yearSelect.innerHTML = '';
      for (let y=start; y<=end; y++){
        const opt = document.createElement('option'); opt.value = String(y); opt.textContent = String(y);
        if (y===year) opt.selected = true; yearSelect.appendChild(opt);
      }
    }

    // Render calendar grid (equal columns)
    function renderCalendar(year, month, lang) {
      currentYear = year; currentMonth = month; lang = lang || getLang();

      const table = document.getElementById('calendar-table');
      if (table) {
        const maxRows = 6, rowHeight = 44, headerHeight = 48;
        table.style.minHeight = (maxRows*rowHeight + headerHeight) + 'px';
      }

      populateMonthYearControls(year, month, lang);

      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month+1, 0).getDate();

      let html = '<thead><tr>';
      const dayNames = (translations[lang] && translations[lang].days) ? translations[lang].days : translations['en'].days;
      dayNames.forEach(d => html += `<th scope="col">${d}</th>`);
      html += '</tr></thead><tbody><tr>';

      for (let i=0;i<firstDay;i++) html += '<td></td>';

      const now = new Date(); const todayY = now.getFullYear(), todayM = now.getMonth(), todayD = now.getDate();

      for (let d=1; d<=daysInMonth; d++){
        const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const dayNotes = notes[dateStr] || [];
        const hasNote = dayNotes.length > 0;
        if ((firstDay + d - 1) % 7 === 0 && d !== 1) html += '</tr><tr>';
        const isToday = (d===todayD && month===todayM && year===todayY);
        const classes = ['day-cell', hasNote ? 'has-note' : '', isToday ? 'calendar-today' : ''].join(' ').trim();
        html += `<td class="${classes ? '' : ''}" role="gridcell" tabindex="0" data-date="${dateStr}" aria-label="${dateStr}"><div class="${classes}" ${isToday ? 'aria-current="date"' : ''}>${d}</div></td>`;
      }

      html += '</tr></tbody>';
      if (table) table.innerHTML = html;

      // attach handlers
      Array.from(document.querySelectorAll('.day-cell')).forEach(cell => {
        cell.addEventListener('click', function() {
          const td = cell.closest('td');
          if (!td) return;
          selectedDay = td.getAttribute('data-date');
          showNoteModal(selectedDay);
        });
        cell.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const td = cell.closest('td');
            if (!td) return;
            selectedDay = td.getAttribute('data-date');
            showNoteModal(selectedDay);
          }
        });
      });
    }

    function showNoteModal(dateStr){
      const ml = document.getElementById('modal-date-label'); if (ml) ml.textContent = dateStr;
      renderNoteList(dateStr);
      const input = document.getElementById('noteInput'); if (input) input.value = '';
      const modal = new bootstrap.Modal(document.getElementById('noteModal')); modal.show();
      setTimeout(()=>{ try{ input && input.focus(); }catch(e){} }, 120);
    }

    function renderNoteList(dateStr){
      const list = document.getElementById('noteList'); if (!list) return; list.innerHTML = '';
      const dayNotes = notes[dateStr] || [];
      if (!dayNotes.length) { list.innerHTML = `<li style="color:#888;">${t(getLang(),'note-none')}</li>`; return; }
      dayNotes.forEach((note, idx) => {
        const li = document.createElement('li');
        const span = document.createElement('span'); span.className = 'note-text'; span.innerHTML = escapeHtml(note.text);
        const meta = document.createElement('span'); meta.className = 'note-meta'; meta.textContent = new Date(note.ts).toLocaleString();
        const btn = document.createElement('button'); btn.className = 'delete-note-btn'; btn.title = t(getLang(),'note-delete'); btn.innerHTML = '<i class="fa fa-trash"></i>';
        btn.addEventListener('click', ()=> deleteNote(dateStr, idx));
        li.appendChild(span); li.appendChild(meta); li.appendChild(btn);
        list.appendChild(li);
      });
    }

    function escapeHtml(s){ if (!s) return ''; return s.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;'); }

    const noteFormEl = document.getElementById('noteForm');
    noteFormEl && noteFormEl.addEventListener('submit', function(e) {
      e.preventDefault();
      if (!selectedDay) return;
      const text = (document.getElementById('noteInput').value || '').trim();
      if (!text) return;
      if (!notes[selectedDay]) notes[selectedDay] = [];
      notes[selectedDay].push({ text, ts: Date.now() });
      try { localStorage.setItem('calendarNotes', JSON.stringify(notes)); } catch(e) {}
      renderNoteList(selectedDay);
      renderCalendar(currentYear, currentMonth, getLang());
    });

    window.deleteNote = function(dateStr, idx) {
      if (!notes[dateStr]) return;
      notes[dateStr].splice(idx,1);
      if (!notes[dateStr].length) delete notes[dateStr];
      try { localStorage.setItem('calendarNotes', JSON.stringify(notes)); } catch(e) {}
      renderNoteList(dateStr);
      renderCalendar(currentYear, currentMonth, getLang());
    };

    function updateCalendarFromSelects(){
      const m = document.getElementById('calendar-month-select');
      const y = document.getElementById('calendar-year-select');
      if (!m || !y) return;
      renderCalendar(parseInt(y.value,10), parseInt(m.value,10), getLang());
    }

    function hookupCalendarControls(){
      const prevYear = document.getElementById('nav-prev-year');
      const prevMonth = document.getElementById('nav-prev-month');
      const nextMonth = document.getElementById('nav-next-month');
      const nextYear = document.getElementById('nav-next-year');
      const todayBtn = document.getElementById('nav-today');

      if (prevYear) prevYear.addEventListener('click', ()=> renderCalendar(currentYear - 1, currentMonth, getLang()));
      if (nextYear) nextYear.addEventListener('click', ()=> renderCalendar(currentYear + 1, currentMonth, getLang()));
      if (prevMonth) prevMonth.addEventListener('click', ()=> { let y=currentYear, m=currentMonth-1; if(m<0){m=11;y--;} renderCalendar(y,m,getLang()); });
      if (nextMonth) nextMonth.addEventListener('click', ()=> { let y=currentYear, m=currentMonth+1; if(m>11){m=0;y++;} renderCalendar(y,m,getLang()); });
      if (todayBtn) todayBtn.addEventListener('click', ()=> { const now = new Date(); renderCalendar(now.getFullYear(), now.getMonth(), getLang()); });

      const mSel = document.getElementById('calendar-month-select');
      const ySel = document.getElementById('calendar-year-select');
      if (mSel) mSel.addEventListener('change', updateCalendarFromSelects);
      if (ySel) ySel.addEventListener('change', updateCalendarFromSelects);
    }

    function updateLanguage(lang){
      lang = lang || getLang();
      document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';
      const obj = translations[lang] || translations['en'];
      const back = document.getElementById('back-link'); back && (back.textContent = obj['back-link']);
      const toolTitle = document.getElementById('tool-title'); toolTitle && (toolTitle.innerHTML = `<i class="fa fa-calendar-days"></i> ${obj['tool-title']}`);
      const toolHelp = document.getElementById('tool-help'); toolHelp && (toolHelp.textContent = obj['tool-help']);
      const howtoTitle = document.getElementById('howto-title'); howtoTitle && (howtoTitle.innerHTML = obj['howto-title']);
      const howtoSteps = document.getElementById('howto-steps'); howtoSteps && (howtoSteps.innerHTML = obj['howto-steps']);
      const tipsTitle = document.getElementById('tips-title'); tipsTitle && (tipsTitle.innerHTML = obj['tips-title']);
      const tipsList = document.getElementById('tips-list'); tipsList && (tipsList.innerHTML = obj['tips-list']);
      const faqList = document.getElementById('faq-list'); faqList && (faqList.innerHTML = obj['faq-list']);
      const nm = document.getElementById('noteModalLabel'); nm && (nm.innerHTML = `${obj['noteModalLabel']} <span id="modal-date-label"></span>`);
      const ni = document.getElementById('noteInput'); ni && (ni.placeholder = obj['noteInput']);
      const nc = document.getElementById('note-close-btn'); nc && (nc.textContent = obj['note-close-btn']);
      const na = document.getElementById('note-add-btn'); na && (na.textContent = obj['note-add-btn']);
      const howtoBtn = document.getElementById('howto-article-btn'); howtoBtn && (howtoBtn.href = obj['howto-article-link'] || 'calendar-how-to.html');
      const tipsBtn = document.getElementById('tips-article-btn'); tipsBtn && (tipsBtn.href = obj['tips-article-link'] || 'calendar-tips.html');
    }

    document.addEventListener('DOMContentLoaded', function(){
      const now = new Date();
      currentYear = now.getFullYear();
      currentMonth = now.getMonth();

      updateLanguage(getLang());
      populateMonthYearControls(currentYear, currentMonth, getLang());
      hookupCalendarControls();
      renderCalendar(currentYear, currentMonth, getLang());
    });
  </script>
</body>
</html>


