    .faq-section { margin-top:1.1rem; margin-bottom:0.3rem; font-size:1rem; background:#f7fafc; border-radius:8px; padding:1rem; box-shadow:0 1px 4px #e0e7ef; }
    .faq-section summary { font-weight:700; font-size:1.02rem; cursor:pointer; }

    /* Mobile-specific compact summary and ordering */
    .mobile-summary { display:none; margin-bottom:.6rem; color:#51606b; font-size:.95rem; }
    @media (max-width:520px) {
      .mobile-summary { display:block; }
