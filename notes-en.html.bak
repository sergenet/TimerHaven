<body>
  <main class="main-container" role="main">
    <section class="tool-card" aria-labelledby="tool-title">
      <a href="index.html" class="back-link" id="back-link">&larr; Back to Main Menu</a>

      <h3 id="tool-title" class="tool-title"><i class="fa fa-note-sticky"></i> Notes</h3>

      <div class="mobile-summary">Quick notes â€” <a href="/en/notes/notes-index.html">Read full guide</a></div>

      <a id="read-guide-btn" class="read-guide" href="/en/notes/notes-index.html" role="button">Read full guide</a>

      <!-- server-rendered intro preserved -->
      <div class="tool-intro" id="tool-help" data-preserve="true" style="margin-top:.6rem;margin-bottom:.9rem;color:#374151;line-height:1.45;">
        <p><strong>Quick notes that stay with you</strong> â€” Use Notes for short reminders, ideas or session logs. Notes are saved locally in your browser so they remain private to your device unless you export them. Pin important items to keep them at the top.</p>
        <p style="margin-top:.6rem;color:#51606b;font-size:.95rem;"><strong>By Serge Shammas</strong> Â· Last updated: <time datetime="2026-01-06">Jan 6, 2026</time></p>
      </div>

      <div class="notes-section">
        <form class="notes-form" id="notesForm">
          <input type="text" id="noteInput" class="form-control" placeholder="Type your note..." style="max-width:220px;">
          <button type="submit" class="btn btn-success btn-sm">Add Note</button>
        </form>
        <div id="notesList" class="notes-list"></div>
      </div>

      <details class="faq-section">
        <summary id="faq-title">FAQs</summary>
        <ul style="padding-left:1em;" id="faq-list">
          <li><b>Are notes saved?</b> Yes, in your browser until you clear them.</li>
          <li><b>Can I pin important notes?</b> Yes â€” pin/unpin moves notes to the top.</li>
          <li><b>Is there a limit?</b> No, add as many notes as you need.</li>
        </ul>
      </details>
    </section>
  </main>

<script>
  // Notes persistence & UI - unchanged behavior but safe DOM checks
  function $id(id){ return document.getElementById(id); }
  var notes = JSON.parse(localStorage.getItem('notesData') || '[]');

  function saveNotes() { try{ localStorage.setItem('notesData', JSON.stringify(notes)); }catch(e){} }

  function escapeHtml(s){ if(!s) return ''; return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'", '&#39;'); }

  function renderNotes() {
    var list = $id('notesList');
    if (!list) return;
    list.innerHTML = '';
    if (notes.length === 0) {
      list.innerHTML = '<div style="color:#888;">No notes yet.</div>';
      return;
    }
    notes.forEach(function(note, idx){
      var pinned = note.pinned ? '<span class="note-pinned"><i class="fa fa-thumbtack"></i></span>' : '';
      var div = document.createElement('div');
      div.className = 'note-item';
      div.innerHTML = '<div style="display:flex;align-items:center;gap:.6rem;">' + pinned + '<span>' + escapeHtml(note.text) + '</span></div>' +
                      '<div style="display:flex;align-items:center;gap:.5rem;">' +
                      '<span class="note-meta">' + escapeHtml(note.date) + '</span>' +
                      '<button class="btn btn-outline-' + (note.pinned ? 'secondary' : 'info') + ' btn-sm" onclick="pinNote(' + idx + ')" title="Pin/unpin"><i class="fa fa-thumbtack"></i></button>' +
                      '<button class="btn btn-outline-danger btn-sm" onclick="deleteNote(' + idx + ')"><i class="fa fa-trash"></i></button>' +
                      '</div>';
      list.appendChild(div);
    });
  }

  if ($id('notesForm')) $id('notesForm').addEventListener('submit', function(e){
    e.preventDefault();
    var input = $id('noteInput');
    if (!input) return;
    var text = input.value.trim();
    if (!text) return;
    notes.unshift({ text: text, date: new Date().toLocaleString(), pinned: false });
    saveNotes();
    input.value = "";
    renderNotes();
  });

  window.deleteNote = function(idx){ notes.splice(idx, 1); saveNotes(); renderNotes(); }
  window.pinNote = function(idx){
    notes[idx].pinned = !notes[idx].pinned;
    if (notes[idx].pinned) {
      var pinnedNote = notes.splice(idx, 1)[0];
      notes.unshift(pinnedNote);
    }
    saveNotes();
    renderNotes();
  }

  // initial render
  renderNotes();
</script>

