<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Focus Music â€” TimerHaven</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Listen to music that helps you concentrate. Choose white noise, rain, alpha waves, classical, ocean waves, or cafe ambience.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/tool-theme.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="canonical" href="https://timerhaven.com/focus-music-en.html" />
  
  <style>
    body { background: #f4f7fb; font-family: 'Montserrat', Arial, sans-serif; color:var(--text-dark,#102a43); }
    .main-container { max-width: 1200px; margin: 2rem auto; padding:0 1rem; display:flex; justify-content:center; align-items:flex-start; min-height:90vh; box-sizing:border-box; }
    .tool-card { background:#fff; border-radius:16px; box-shadow:0 2px 12px #e0e7ef; width:420px; padding:1.6rem 1.5rem; box-sizing:border-box; }
    .back-link { display:inline-block; margin-bottom:.75rem; color:var(--brand,#0d6efd) !important; text-decoration:none; font-weight:700; }
    /* tool title restored to dark blue */
    .tool-title { font-size:1.35rem; margin:0 0 .4rem 0; display:flex; align-items:center; gap:.4rem; color:#185a9d; }
    .read-guide { display:inline-block; margin:.35rem 0 .8rem 0; padding:.45rem .7rem; border-radius:8px; background:var(--brand,#0d6efd) !important; color:#fff !important; text-decoration:none; font-weight:700; font-size:.95rem; border:none; }
    .help-section { color:var(--muted,#6b7c89); margin-bottom:.8rem; }
    .music-player label { margin-left:.5rem; display:block; margin-bottom:.3rem; font-weight:600; }
    .faq-section { margin-top: 1.1rem; margin-bottom: 0.3rem; font-size: 1rem; background:#f7fafc; border-radius:8px; padding:1rem; box-shadow:0 1px 4px #e0e7ef; }
    .faq-section summary { font-weight:700; font-size:1.02rem; cursor:pointer; }
    .faq-section ul { padding-left:1em; margin-top:.5rem; color:var(--muted,#6b7c89); }
    @media (max-width:900px) { .tool-card { width:98vw; padding:1rem; } }
  </style>
<script>
window.__timerhaven_ad_client = "ca-pub-0467059729557007";
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <script>try{ localStorage.setItem('timerhavenLang','en'); }catch(e){};</script>

  <main class="main-container" role="main">
    <section class="tool-card" aria-labelledby="tool-title">
      <a href="index.html" class="back-link" id="back-link" style="color:var(--brand,#0d6efd) !important;">â† Back to Main Menu</a>

      <div id="tool-title" class="tool-title"><i class="fa fa-music"></i> Focus Music</div>

      <a id="read-guide-btn" class="read-guide" href="focus-music-how-to.html" role="button"
         style="background:var(--brand,#0d6efd) !important; border-color:var(--brand,#0d6efd) !important; color:#fff !important;">
        Read full guide
      </a>

      <div class="help-section" id="tool-help">Enhance your concentration and productivity with music scientifically shown to help focus. Choose soothing sounds: white noise, rain, alpha waves, classical, ocean waves, or cafe ambience.</div>

      <div class="music-player">
        <label for="music-select" id="music-label">Select a playlist:</label>
        <select id="music-select" class="form-select mb-2">
          <option value="white">White Noise</option>
          <option value="rain">Rain</option>
          <option value="alpha">Alpha Waves</option>
          <option value="classical">Classical</option>
          <option value="ocean">Ocean Waves</option>
          <option value="cafe">Cafe Ambience</option>
        </select>

        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" id="music-loop">
          <label class="form-check-label" for="music-loop" id="loop-label-text">Loop track</label>
        </div>

        <button class="btn btn-primary w-100 mb-2" id="play-btn">Play</button>
        <button class="btn btn-danger w-100 mb-2" id="stop-btn">Stop</button>
        <audio id="focus-audio" style="display:none;" controls></audio>
      </div>

      <details class="faq-section">
        <summary id="faq-title">FAQs</summary>
        <ul id="faq-list">
          <li><b>Can I loop tracks?</b> Yes â€” enable the "Loop track" checkbox or use the audio player's loop control after pressing Play.</li>
          <li><b>Does this work offline?</b> No â€” tracks stream from remote servers, so an internet connection is required.</li>
          <li><b>Can I add my own music?</b> Not yet. If you'd like this feature, tell us and we'll evaluate adding user uploads or playlist imports.</li>
        </ul>
      </details>
    </section>
  </main>

  <script>
    const tracks = {
      white:    "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
      rain:     "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3",
      alpha:    "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3",
      classical:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3",
      ocean:    "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3",
      cafe:     "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-6.mp3"
    };

    const focusMusicTranslations = {
  en: {
    "language-label": "Language:",
    "back-link": "â† Back to Main Menu",
    "tool-title": "Focus Music",
    "tool-help": "Enhance your concentration and productivity with music scientifically shown to help focus. Choose soothing sounds: white noise, rain, alpha waves, classical, ocean waves, or cafe ambience.",
    "music-label": "Select a playlist:",
    "music-white": "White Noise",
    "music-rain": "Rain",
    "music-alpha": "Alpha Waves",
    "music-classical": "Classical",
    "music-ocean": "Ocean Waves",
    "music-cafe": "Cafe Ambience",
    "loop-label": "Loop track",
    "play": "Play",
    "stop": "Stop",
    "faq-title": "FAQs",
    "faq-list": `<li><b>Can I loop tracks?</b> Yes â€” enable the "Loop track" checkbox or use the audio player's loop control after pressing Play.</li>
      <li><b>Does this work offline?</b> No â€” tracks stream from remote servers, so an internet connection is required.</li>
      <li><b>Can I add my own music?</b> Not yet. If you'd like this feature, tell us and we'll evaluate adding user uploads or playlist imports.</li>`,
    "howto-article-btn": "Read full guide",
    "howto-article-link": "focus-music-how-to.html",
    "tips-title": '<i class="fa fa-lightbulb" style="color:#43cea2;"></i> Focus Music Productivity Tips',
    "tips-list": `<li><b>Experiment with genres:</b> Try different playlists to find what suits your work.</li>
      <li><b>Use headphones:</b> They help block distractions and improve focus.</li>
      <li><b>Keep volume moderate:</b> Low volume is better for concentration than loud playback.</li>`,
    "tips-article-btn": "Read full guide",
    "tips-article-link": "focus-music-tips.html"
  }
};

    function getLang() {
      try { return (localStorage.getItem('timerhavenLang') || 'en').slice(0,2); } catch (e) { return 'en'; }
    }

    function applyLanguage(lang) {
      lang = (lang || getLang()).slice(0,2);
      const t = focusMusicTranslations[lang] || focusMusicTranslations['en'];
      document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';

      const back = document.getElementById('back-link');
      if (back) back.textContent = t['back-link'] || '';

      const toolTitle = document.getElementById('tool-title');
      if (toolTitle) toolTitle.innerHTML = `<i class="fa fa-music"></i> ${t['tool-title'] || ''}`;

      const help = document.getElementById('tool-help');
      if (help) help.textContent = t['tool-help'] || '';

      const musicLabel = document.getElementById('music-label');
      if (musicLabel) musicLabel.textContent = t['music-label'] || '';

      const ms = document.getElementById('music-select');
      if (ms && ms.options) {
        ms.options[0].text = t['music-white'] || 'White Noise';
        ms.options[1].text = t['music-rain'] || 'Rain';
        ms.options[2].text = t['music-alpha'] || 'Alpha Waves';
        ms.options[3].text = t['music-classical'] || 'Classical';
        ms.options[4].text = t['music-ocean'] || 'Ocean Waves';
        ms.options[5].text = t['music-cafe'] || 'Cafe Ambience';
      }

      const loopText = document.getElementById('loop-label-text');
      if (loopText) loopText.textContent = t['loop-label'] || 'Loop track';

      const playBtn = document.getElementById('play-btn');
      if (playBtn) playBtn.textContent = t['play'] || 'Play';

      const stopBtn = document.getElementById('stop-btn');
      if (stopBtn) stopBtn.textContent = t['stop'] || 'Stop';

      const faqTitle = document.getElementById('faq-title');
      if (faqTitle) faqTitle.textContent = t['faq-title'] || '';

      const faqList = document.getElementById('faq-list');
      if (faqList) faqList.innerHTML = t['faq-list'] || '';

      const readBtn = document.getElementById('read-guide-btn');
      if (readBtn) { readBtn.textContent = t['howto-article-btn'] || 'Read full guide'; readBtn.href = t['howto-article-link'] || 'focus-music-how-to.html'; }
    }

    window.addEventListener('storage', function(e) {
      if (e.key === 'timerhavenLang') applyLanguage((e.newValue || 'en').slice(0,2));
    });

    function playMusic() {
      const sel = document.getElementById("music-select").value;
      const audio = document.getElementById("focus-audio");
      audio.src = tracks[sel];
      audio.loop = document.getElementById("music-loop").checked;
      audio.style.display = "block";
      audio.load();
      audio.play().catch(()=>{});
    }
    function stopMusic() {
      const audio = document.getElementById("focus-audio");
      audio.pause();
      audio.currentTime = 0;
      audio.style.display = "none";
    }

    document.addEventListener('DOMContentLoaded', function() {
      applyLanguage(getLang());
      const playBtn = document.getElementById('play-btn');
      const stopBtn = document.getElementById('stop-btn');
      const loopCb = document.getElementById('music-loop');
      if (playBtn) playBtn.addEventListener('click', playMusic);
      if (stopBtn) stopBtn.addEventListener('click', stopMusic);
      if (loopCb) loopCb.addEventListener('change', function() { document.getElementById("focus-audio").loop = this.checked; });
    });
  </script>

  <footer style="text-align:center;margin-top:1.2rem;color:var(--muted,#6b7c89);">
    &copy; 2025 TimerHaven. All tools are free and privacy-friendly.<br>
    <a href="privacy.html">Privacy Policy</a> &bull;
    <a href="terms.html">Terms</a> &bull;
    <a href="contact.html">Contact</a>
  </footer>
</body>
</html>

