<div class="center-row">

<div aria-label="Password generator" class="tool-card" role="region">
<!-- Use localized back label from translations (text kept but unchanged) -->
<a class="d-block mb-2" href="index.html" style="text-decoration:none; color:#0d6efd; font-weight:600;">â† Retour au menu principal</a>
<div class="password-section" style="flex:1 1 auto;">
<form aria-label="Password generator form" class="password-form" id="passwordForm" onsubmit="return false;">
<label style="font-weight:600;">Longueur du mot de passe:</label>
<input class="form-control" id="pwLength" max="128" min="4" style="max-width:90px;" type="number" value="16"/>
<label><input checked="" id="pwUpper" type="checkbox"/> Majuscules</label>
<label><input checked="" id="pwLower" type="checkbox"/> Minuscules</label>
<label><input checked="" id="pwDigits" type="checkbox"/> Chiffres</label>
<label><input id="pwSymbols" type="checkbox"/> Symboles</label>
<button class="btn btn-success btn-sm" id="generateBtn" type="button">GÃ©nÃ©rer</button>
<button class="btn btn-outline-secondary btn-sm" id="copyBtn" style="display:none;" type="button">Copier</button>
<button class="btn btn-outline-danger btn-sm" id="clearBtn" style="display:none; margin-left:6px;" type="button">Effacer</button>
</form>
<div aria-live="polite" class="password-result" id="pwResult"></div>
