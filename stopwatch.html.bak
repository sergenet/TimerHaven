<body>
  <div class="main-container">
    <div class="center-row">
      <div class="article-card" aria-label="How to">
        <div>
          <h2><i class="fa fa-clock"></i> <span data-i18n="howToHeading">How to Use Stopwatch</span></h2>
          <ol>
            <li data-i18n="howTo1"><b>Start the timer:</b> Click "Start" to begin tracking time.</li>
            <li data-i18n="howTo2"><b>Pause or reset:</b> Use pause and reset as needed.</li>
            <li data-i18n="howTo3"><b>Track laps:</b> Record lap times for activities.</li>
          </ol>
        </div>
        <!-- default hrefs kept for safety; script will rewrite to language-specific files on load -->
        <a id="howto-link" href="stopwatch-how-to.html" class="btn btn-outline-primary btn-sm" style="margin-bottom:0;" data-i18n="readFull">Read Full Article</a>
      </div>

      <div class="tool-card" role="region" aria-labelledby="sw-title">
        <a href="index.html" class="back-link" data-i18n="back">Back to Main Menu</a>
        <h3 id="sw-title"><i class="fa fa-clock"></i> <span data-i18n="toolTitle">Stopwatch</span></h3>

        <div class="stopwatch-section">
          <div class="stopwatch-display" id="swDisplay">00:00:00</div>
          <div class="stopwatch-btns">
            <button id="swStartBtn" class="btn btn-success btn-sm"><i class="fa fa-play"></i> <span data-i18n="start">Start</span></button>
            <button id="swPauseBtn" class="btn btn-secondary btn-sm"><i class="fa fa-pause"></i> <span data-i18n="pause">Pause</span></button>
            <button id="swResetBtn" class="btn btn-danger btn-sm"><i class="fa fa-refresh"></i> <span data-i18n="reset">Reset</span></button>
            <button id="swLapBtn" class="btn btn-info btn-sm"><i class="fa fa-flag"></i> <span data-i18n="lap">Lap</span></button>
          </div>
          <div id="lapList" class="lap-list" aria-live="polite"></div>
        </div>

        <details class="faq-section">
          <summary data-i18n="faqs">FAQs</summary>
          <ul>
            <li data-i18n="faq1"><b>Can I track multiple laps?</b> Yes, use the lap button.</li>
            <li data-i18n="faq2"><b>Will the time persist?</b> No, it resets after page reload.</li>
            <li data-i18n="faq3"><b>Is this free?</b> Yes, all TimerHaven tools are free.</li>
          </ul>
        </details>
      </div>

      <div class="article-card" aria-label="Tips">
        <div>
          <h2><i class="fa fa-lightbulb" style="color:#43cea2;"></i> <span data-i18n="tipsHeading">Stopwatch Productivity Tips</span></h2>
          <ul>
            <li data-i18n="tip1"><b>Use for workouts:</b> Track sets and rest intervals.</li>
            <li data-i18n="tip2"><b>Time tasks:</b> Measure work sessions for productivity.</li>
            <li data-i18n="tip3"><b>Review laps:</b> Analyze lap times to improve efficiency.</li>
          </ul>
        </div>
        <!-- default href; will be rewritten to language-specific variant on load -->
        <a id="tips-link" href="stopwatch-tips.html" class="btn btn-outline-primary btn-sm" style="margin-bottom:0;" data-i18n="readFull">Read Full Article</a>
      </div>
    </div>
  </div>

  <script>
    // Preserve original stopwatch logic (unchanged behavior)
    let swTimer = null, swStart = null, swElapsed = 0, swRunning = false, laps = [];
    function swFormat(ms) {
      let t = Math.floor(ms / 1000);
      let h = Math.floor(t / 3600);
      let m = Math.floor((t % 3600) / 60);
      let s = t % 60;
      return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    }
    function swUpdateDisplay() {
      const disp = document.getElementById('swDisplay');
      if (disp) disp.textContent = swFormat(swElapsed);
      let lapList = document.getElementById('lapList');
      if (lapList) lapList.innerHTML = laps.map((lap,i) => `<div class="lap-item">Lap ${i+1}: ${swFormat(lap)}</div>`).join('');
    }
    document.getElementById('swStartBtn').onclick = function() {
      if(swRunning) return;
      swRunning = true;
      swStart = Date.now() - swElapsed;
      swTimer = setInterval(function(){
        swElapsed = Date.now() - swStart;
        swUpdateDisplay();
      },100);
    };
    document.getElementById('swPauseBtn').onclick = function() {
      swRunning = false;
      clearInterval(swTimer);
    };
    document.getElementById('swResetBtn').onclick = function() {
      swRunning = false;
      clearInterval(swTimer);
      swElapsed = 0;
      laps = [];
      swUpdateDisplay();
    };
    document.getElementById('swLapBtn').onclick = function() {
      if(swRunning) laps.push(swElapsed);
      swUpdateDisplay();
    };
    swUpdateDisplay();

