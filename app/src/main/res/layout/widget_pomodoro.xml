<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_pomodoro_bg"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/widget_phase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WORK"
        android:letterSpacing="0.14"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#CCFFFFFF" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="44dp">

        <Chronometer
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:format="%s" />

        <TextView
            android:id="@+id/widget_clock_paused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="25:00"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_cycles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 done"
        android:textSize="11sp"
        android:textColor="#CCFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/widget_toggle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Pause"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button" />

        <TextView
            android:id="@+id/widget_reset"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="Reset"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button" />
    </LinearLayout>
</LinearLayout>
