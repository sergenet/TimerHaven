    <shortcut
        android:shortcutId="tool_pomodoro"
        android:enabled="true"
        android:icon="@drawable/ic_tool_pomodoro"
        android:shortcutShortLabel="@string/shortcut_pomodoro_short"
        android:shortcutLongLabel="@string/shortcut_pomodoro_long"
        android:shortcutDisabledMessage="@string/shortcut_disabled">
