<style>
  :root{--brand:#0b63a0;--muted:#6b7280}
  body { background:#f4f7fb; font-family:'Montserrat', Arial, sans-serif; color:#0b2545; }
  .page-wrap { max-width:920px; margin:2rem auto; padding:0 1rem; }
