  .unit-filter { max-width:260px; }
  .swap-btn, .copy-btn, .mode-btn { border-radius:8px; border:1px solid #e6eef5; background:#fff; padding:.35rem .6rem; cursor:pointer; }
  input[type="number"] { direction:ltr; text-align:left; }
  .top-row { display:none !important; }
  #dataModeContainer { display:none; gap:.6rem; align-items:center; margin-top:.4rem; justify-content:flex-end; }
  .cta { color:var(--brand); font-weight:700; text-decoration:none; }
  @media (max-width:640px){ .controls{justify-content:stretch;} .converter-form{justify-content:stretch;} }
