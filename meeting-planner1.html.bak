<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0467059729557007" crossorigin="anonymous"></script>
</head>
<body>
  <div class="main-container">
    <div class="center-row">
      <div class="tool-card">
        <div class="language-selector-row">
          <label for="languageSelector">Language</label>
          <select id="languageSelector" class="form-select" onchange="onLanguageChange()">
            <option value="en">English</option><option value="fr">FranÃ§ais</option><option value="de">Deutsch</option><option value="ru">Ð ÑƒÑÑÐºÐ¸Ð¹</option><option value="el">Î•Î»Î»Î·Î½Î¹ÎºÎ¬</option><option value="es">EspaÃ±ol</option><option value="ar">Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©</option>
          </select>
