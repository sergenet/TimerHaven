        <a href="index.html" class="back-link"><i class="fa fa-arrow-left"></i> Back to Main Menu</a>
        <h3><i class="fa fa-users"></i> Meeting Planner</h3>
        <form id="meetingForm">
          <div class="meeting-form-row">
            <label for="participantName">Participant Name</label>
            <input type="text" id="participantName" class="form-control" placeholder="Enter name (e.g. John)" autocomplete="off">
          </div>
          <div class="meeting-form-row">
            <label for="participantCity">Time Zone / City</label>
            <select id="participantCity" class="form-select" autocomplete="off">
              <option value="" disabled selected>Choose a city/time zone</option>
              <option value="America/New_York">New York ðŸ‡ºðŸ‡¸</option><option value="America/Chicago">Chicago ðŸ‡ºðŸ‡¸</option><option value="America/Los_Angeles">Los Angeles ðŸ‡ºðŸ‡¸</option><option value="America/Toronto">Toronto ðŸ‡¨ðŸ‡¦</option><option value="Europe/London">London ðŸ‡¬ðŸ‡§</option><option value="Europe/Paris">Paris ðŸ‡«ðŸ‡·</option><option value="Europe/Berlin">Berlin ðŸ‡©ðŸ‡ª</option><option value="Europe/Moscow">Moscow ðŸ‡·ðŸ‡º</option><option value="Europe/Istanbul">Istanbul ðŸ‡¹ðŸ‡·</option><option value="Asia/Dubai">Dubai ðŸ‡¦ðŸ‡ª</option><option value="Asia/Kolkata">Kolkata ðŸ‡®ðŸ‡³</option><option value="Asia/Shanghai">Shanghai ðŸ‡¨ðŸ‡³</option><option value="Asia/Tokyo">Tokyo ðŸ‡¯ðŸ‡µ</option><option value="Asia/Singapore">Singapore ðŸ‡¸ðŸ‡¬</option><option value="Asia/Jakarta">Jakarta ðŸ‡®ðŸ‡©</option><option value="Australia/Sydney">Sydney ðŸ‡¦ðŸ‡º</option><option value="Pacific/Auckland">Auckland ðŸ‡³ðŸ‡¿</option><option value="America/Sao_Paulo">SÃ£o Paulo ðŸ‡§ðŸ‡·</option><option value="America/Mexico_City">Mexico City ðŸ‡²ðŸ‡½</option><option value="Africa/Johannesburg">Johannesburg ðŸ‡¿ðŸ‡¦</option><option value="Africa/Cairo">Cairo ðŸ‡ªðŸ‡¬</option><option value="Africa/Nairobi">Nairobi ðŸ‡°ðŸ‡ª</option><option value="Asia/Seoul">Seoul ðŸ‡°ðŸ‡·</option><option value="Asia/Hong_Kong">Hong Kong ðŸ‡­ðŸ‡°</option><option value="Asia/Bangkok">Bangkok ðŸ‡¹ðŸ‡­</option><option value="Asia/Manila">Manila ðŸ‡µðŸ‡­</option><option value="Europe/Madrid">Madrid ðŸ‡ªðŸ‡¸</option><option value="Europe/Rome">Rome ðŸ‡®ðŸ‡¹</option><option value="Europe/Warsaw">Warsaw ðŸ‡µðŸ‡±</option><option value="Europe/Amsterdam">Amsterdam ðŸ‡³ðŸ‡±</option><option value="Europe/Athens">Athens ðŸ‡¬ðŸ‡·</option><option value="America/Vancouver">Vancouver ðŸ‡¨ðŸ‡¦</option>
            </select>
          </div>
          <button type="button" class="btn btn-success btn-participant" id="addParticipant"><i class="fa fa-plus"></i> Add Participant</button>
        </form>
        <div class="participant-list" id="participantList"></div>
        <div class="meeting-form-row">
          <label for="meetingDate">Select Meeting Date</label>
          <input type="date" id="meetingDate" class="form-control">
        </div>
        <div class="meeting-form-row">
          <label for="meetingTime">Select Meeting Time</label>
          <input type="time" id="meetingTime" class="form-control">
          <button type="button" class="btn btn-primary btn-sm" style="margin-top:0.6em;" id="calcTimes"><i class="fa fa-clock"></i> Show Times</button>
        </div>
        <div>
          <div id="meetingTimes"></div>
        </div>
        <details class="faq-section">
          <summary>FAQs</summary>
          <ul style="padding-left: 1em;">
            <li><b>How many participants?</b> Add as many as you need.</li><li><b>What time zones?</b> Pick from 30+ popular global cities or time zones.</li><li><b>How do I share?</b> Copy the meeting times and share with your participants.</li>
          </ul>
        </details>
      </div>
    </div>
  </div>
  <script>
    function onLanguageChange() {
      var lang = document.getElementById("languageSelector").value;
      window.location.href = "meeting-planner-" + lang + ".html";
    }
  </script>
</body>
</html>

