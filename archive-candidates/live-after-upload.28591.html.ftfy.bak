  "resources-book-desc": "âÃ³ÎÃ©Â¼ÎÃÂ£ âÃ¿â¬ÂºâÃÎÃâ§âÃâÃâÃ¿â¬Â¬âÃ¿â¬ÂºâÃ¿â¬Â¿ âÃ¿â¬ÂºâÃÎÃâ§âÃâÃâÃÎÃâ§âÃ¿â¬ÂºâÃ¿â¬ââÃâ¼Ã¡âÃâÃâÃâ¼Ã¡ âÃ¿â¬Â¡âÃâ¦Ã¥âÃÎÃâ§ âÃ¿â¬ÂºâÃÎÃâ§âÃ¿â¬Â¬âÃ¿â¬ââÃâÃâÃâ¼Ã¡âÃ¿â¬â âÃâ¦Ã¥âÃ¿â¬ÂºâÃÎÃâ§âÃ¿â¬ÃâÃÎÃÃ¡âÃ¿â¬Â¬âÃ¿â¬ÂºâÃ¿â¬Â¼âÃâ¼Ã¡âÃ¿â¬â.",
  "resources-planner-desc": "âÃ³ÎÃ©Â¼ÎÃÂ£ âÃÎÃÃ¡âÃ¿â¬ââÃÎÃÂª âÃ¿â¬Â¡âÃâ¼Ã¡âÃ¿â¬ÂºâÃ¿â¬Â¬âÃâÃ âÃÎÃÂªâÃ¿â¬â£ âÃÎÃÃ­âÃ¿â¬ââÃ¿â¬Âº âÃ¿â¬ÂºâÃÎÃâ§âÃÎÃÂªâÃ¿â¬Â«âÃ¿â¬ââÃ¿â¬â âÃ¿â¬ÂºâÃÎÃâ§âÃâ¦Ã¥âÃ¿â¬ââÃÎÃÃâÃâ¼Ã¡ âÃ¿â¬ÂºâÃÎÃâ§âÃ¿â¬ÃºâÃ¿â¬ââÃ¿â¬ââÃâ¦Ã¥âÃ¿â¬ââÃâ¼Ã¡.",
  "resources-keyboard-desc": "âÃ³ÎÃ©Â¼ÎÃÂ£ âÃ¿â¬ÂºâÃâÃâÃ¿â¬Â¬âÃ¿â¬Â¿ âÃâ¬Ã¼âÃâ¼Ã¡ âÃ¿â¬ÃºâÃâ¼Ã¡ âÃÎÃÂªâÃâÃâÃ¿â¬ÂºâÃÎÃÃ¡âÃ¿â¼Ã âÃâ¦Ã¥âÃâÃâÃÎÃÃ¡ âÃÎÃÂªâÃÎÃÃ¡âÃ¿â¬Â¬âÃ¿â¬Â¼âÃÎÃâ£âÃ¿â¬Âº!",
  "resources-affiliate": "âÃ¿â¬Â¿âÃ¿â¬â¡âÃâ¬Ã¼âÃ¿â¬Â¬âÃÎÃÃ¡âÃ¿â¬Âº âÃ¿â¬â¤âÃ¿â¬ââÃâÃâÃ¿â¬ÂºâÃ¿â¬Ã­ âÃ¿â¬ÃºâÃÎÃÂªâÃ¿â¬ÂºâÃ¿â¬ââÃâ¦Ã¥âÃÎÃÃ¡âÃ¿â¼Ã âÃâ¼Ã¡âÃ¿â¬Â¡âÃ¿â¬â¡âÃÎÃâ§ âÃ¿â¬Â¬âÃ¿â¬ÂºâÃâ¼Ã¡âÃÎÃÂªâÃ¿â¬ââÃÎÃÃ­âÃ¿â¬ÂºâÃâ¬Ã¼âÃÎÃÃ¡ âÃ¿â¬â£âÃÎÃâ§âÃÎÃâ âÃ¿â¬ÃºâÃ¿â¬ââÃ¿â¬Â¿âÃ¿â¬ÂºâÃ¿â¬Â¡ âÃÎÃÂªâÃÎÃÃ¡ âÃ¿â¬ÂºâÃÎÃâ§âÃÎÃÂªâÃ¿â¬â¤âÃ¿â¬Â¬âÃ¿â¬ââÃâ¼Ã¡âÃ¿â¬ÂºâÃ¿â¬Â¬ âÃ¿â¬ÂºâÃÎÃâ§âÃÎÃÂªâÃ¿â¬Ã±âÃÎÃÃ­âÃÎÃâ§âÃ¿â¬â. âÃ¿â¬â¤âÃâÃâÃ¿â¬ââÃÎÃâ£âÃ¿â¬Âº âÃÎÃâ§âÃ¿â¬Â»âÃ¿â¬â£âÃÎÃÂªâÃâÃâÃÎÃÂª!",
  "footer-copyright": "&copy; 2025 âÃ¿â¬Â¬âÃ¿â¬ÂºâÃâ¼Ã¡âÃÎÃÂªâÃ¿â¬ââÃÎÃÃ­âÃ¿â¬ÂºâÃâ¬Ã¼âÃÎÃÃ¡. âÃ¿â¬Â¼âÃÎÃÂªâÃâ¼Ã¡âÃ¿â¬â£ âÃ¿â¬ÂºâÃÎÃâ§âÃ¿â¬ÃºâÃ¿â¬Â»âÃâ¦Ã¥âÃ¿â¬ÂºâÃ¿â¬Â¬ âÃÎÃÂªâÃ¿â¬Â¼âÃ¿â¬ÂºâÃÎÃÃ¡âÃâ¼Ã¡âÃ¿â¬â âÃâ¦Ã¥âÃ¿â¬Â¬âÃ¿â¬Â¡âÃ¿â¬Â¬âÃ¿â¬ââÃÎÃÂª âÃ¿â¬ÂºâÃÎÃâ§âÃ¿â¬Â«âÃ¿â¬â¡âÃâ¦Ã¥âÃ¿â¬â¡âÃâ¼Ã¡âÃ¿â¬â.",
  "footer-about": "âÃ¿â¬Â¡âÃâ¦Ã¥âÃÎÃâ§",
  "footer-privacy": "âÃ¿â¬ÂºâÃÎÃâ§âÃ¿â¬Â«âÃ¿â¬â¡âÃâ¦Ã¥âÃ¿â¬â¡âÃâ¼Ã¡âÃ¿â¬â",
  "footer-contact": "âÃ¿â¬ÂºâÃ¿â¬Â¬âÃ¿â¬â¡âÃÎÃâ§ âÃ¿â¬Â¿âÃÎÃÃ¡âÃ¿â¬Âº",
  "footer-credit": "âÃ¿â¬Â¬âÃÎÃÂª âÃ¿â¬ÂºâÃÎÃâ§âÃ¿â¬ÃâÃÎÃÃ¡âÃ¿â¬â¤âÃ¿â¬ÂºâÃ¿â¬Ã­ âÃ¿â¬Â¿âÃâ¦Ã¥âÃ¿â¬ÂºâÃ¿â¬ââÃ¿â¬ââÃ¿â¬â <a href=\"https://github.com/sergenet\" target=\"_blank\">sergenet</a>"
      }
    };

    // Ensure all locales at least inherit English keys to avoid missing properties
    ["es","de","ru","el","ar","fr"].forEach(l => {
      try {
        translations[l] = Object.assign({}, translations.en, translations[l] || {});
      } catch(e){}
    });

    // Helper to read stored language; central single source of truth
    function getStoredLang() {
      try {
        const s = localStorage.getItem('timerhavenLang');
        if (s && typeof s === 'string') return s.slice(0,2);
      } catch(e){}
      return 'en';
    }

    // Update UI texts from translations; accept lang param to avoid race conditions
    function updateLanguage(lang) {
      if (!lang) lang = document.getElementById("lang-select")?.value || getStoredLang();
      if (!translations[lang]) lang = 'en';
      Object.keys(translations[lang]).forEach(function(id) {
        const el = document.getElementById(id);
        if (el) {
          try {
            if (id === "footer-credit" || id === "footer-copyright") {
              el.innerHTML = translations[lang][id];
            } else {
              el.textContent = translations[lang][id];
            }
          } catch(e){ /* ignore per-element errors */ }
        }
      });
      try { document.title = translations[lang]["page-title"] || document.title; } catch(e){}
      console.info('[i18n] applied language ->', lang);
    }

    // Rewrite tool links so they point to language-specific tool pages when appropriate.
    // Behavior desired:
    //  - Always produce tool-<lang>.html for every language, including English (tool-en.html).
    //  - Defensive: sanitize existing data-tool values that may already include a trailing '-xx' or '.html'.
    //  - This avoids producing double-suffixed filenames like "countdown-en-el.html".
    function rewriteToolLinks() {
      try {
        const lang = getStoredLang() || 'en';
        const anchors = document.querySelectorAll('a[data-tool]');
        anchors.forEach(a => {
          try {
            // Read the data-tool value and canonicalize it:
            //  - Trim whitespace
            //  - Remove any trailing language suffix like "-en" or "-fr"
            //  - Remove any trailing ".html" if present
            let tool = (a.getAttribute('data-tool') || '').trim();

            // Strip trailing .html if present
            tool = tool.replace(/\.html$/i, '');

            // Strip trailing -xx (two-letter language) if present
            tool = tool.replace(/-([a-z]{2})$/i, '');

            if (!tool) return;

            // Always append selected language code to produce tool-<lang>.html
            const newHref = `${tool}-${lang}.html`;

            // Update href attribute (relative) and absolute href for the anchor element
            a.setAttribute('href', newHref);
            a.href = location.origin.replace(/\/$/,'') + '/' + newHref;
          } catch(e){
            // ignore per-anchor errors
          }
        });
        console.info('[index] rewriteToolLinks applied for lang ->', getStoredLang());
      } catch(e) {
        console.warn('[index] rewriteToolLinks failed', e);
      }
    }

    // Previous currency-specific rewrite is kept for backward compatibility (defensive)
    function localizeGenericCurrencyAnchors() {
      try {
        const lang = getStoredLang() || 'en';
        const replacements = {
          'currency.html': `currency-${lang}.html`,
          '/currency.html': `currency-${lang}.html`,
          'currency-how-to.html': `currency-how-to-${lang}.html`,
          '/currency-how-to.html': `currency-how-to-${lang}.html`,
          'currency-tips.html': `currency-tips-${lang}.html`,
          '/currency-tips.html': `currency-tips-${lang}.html`
        };

        Object.keys(replacements).forEach(function(key){
          const nodes = document.querySelectorAll('a[href="' + key + '"]');
          nodes.forEach(function(a){
            try {
              a.setAttribute('href', replacements[key]);
              a.href = replacements[key];
            } catch(e){}
          });
        });

        document.querySelectorAll('a[href]').forEach(function(a){
          try {
            const attr = a.getAttribute('href') || '';
            if (attr.match(/(^|\/)currency(\.html)?($|\?)/i)) {
              a.href = '/' + replacements['currency.html'];
            } else if (attr.match(/(^|\/)currency-how-to(\.html)?($|\?)/i)) {
              a.href = '/' + replacements['currency-how-to.html'];
            } else if (attr.match(/(^|\/)currency-tips(\.html)?($|\?)/i)) {
              a.href = '/' + replacements['currency-tips.html'];
            }
          } catch(e){}
        });

        console.info('[index] localized currency anchors for lang ->', lang);
      } catch(e) {
        console.warn('[index] localizeGenericCurrencyAnchors error', e);
      }
    }

    // Wire up language select and initialization in a robust order
    document.addEventListener("DOMContentLoaded", function() {
      // initialize select from stored language
      const saved = getStoredLang() || 'en';
      const select = document.getElementById('lang-select');
      if (select) {
        select.value = saved;
        // when user changes selection, save and apply immediately
        select.addEventListener('change', function() {
          const v = this.value?.slice(0,2) || 'en';
          try { localStorage.setItem('timerhavenLang', v); } catch(e){}
          updateLanguage(v);
          // rewrite menu tool links to selected language
          try { rewriteToolLinks(); } catch(e){}
          // maintain defensive currency-specific rewrite
          try { localizeGenericCurrencyAnchors(); } catch(e){}
        });
      }

      // First apply language from saved (so UI labels are filled)
      updateLanguage(saved);

      // ensure menu links point to localized tool pages
      try { rewriteToolLinks(); } catch(e){}

      // ensure any generic anchors pointing to currency.html are rewritten for chosen lang
      try { localizeGenericCurrencyAnchors(); } catch(e){}

      // Debug: show some values if the tool titles are blank
      try {
        console.info('debug: header-title ->', document.getElementById('header-title')?.textContent);
        console.info('debug: tool-currency-title ->', document.getElementById('tool-currency-title')?.textContent);
      } catch(e){}
    });

    // Also respond to storage events (other tab changed language)
    window.addEventListener('storage', function(e) {
      if (e.key === 'timerhavenLang') {
        const lang = (e.newValue || 'en').slice(0,2);
        updateLanguage(lang);
        rewriteToolLinks();
        localizeGenericCurrencyAnchors();
      }
    });
  </script>
</body>
</html>


