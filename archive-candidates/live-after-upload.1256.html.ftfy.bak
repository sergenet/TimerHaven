  "tool-task-desc": "â”œأ؟â”¬آ¬â”œأ؟â”¬آ؛â”œأ؟â”¬آ؟â”œأ؟â”¬â•£ â”œأ؟â”¬آ¼â”œأ–خ“أ‡â‚§â”œأ؟â”¬â”‚â”œأ؟â”¬آ؛â”œأ؟â”¬آ¬ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬â•£â”œأ–خ“أ‡آھâ”œأ–خ“أ‡â‚§ â”œأ–â•¦أ¥â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھâ”œأ–خ“أ‡أ­â”œأ؟â”¬آ؛â”œأ–خ“أ‡آھ â”œأ–â•¦أ¥â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬آ؛â”œأ؟â”¬â”‚â”œأ؟â”¬آ¬â”œأ؟â”¬â–’â”œأ؟â”¬آ؛â”œأ؟â”¬آ،â”œأ؟â”¬آ؛â”œأ؟â”¬آ¬.",
  "tool-unit-title": "â”œأ–خ“أ‡آھâ”œأ؟â”¬آ،â”œأ–â•¦أ¥â”œأ–خ“أ‡â‚§ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–â•¦أ¥â”œأ؟â”¬آ،â”œأ؟â”¬آ»â”œأ؟â”¬آ؛â”œأ؟â”¬آ¬",
  "tool-unit-desc": "â”œأ؟â”¬آ،â”œأ–â•¦أ¥â”œأ–خ“أ‡أ؟â”œأ–خ“أ‡â‚§ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬â•–â”œأ–â•¦أ¥â”œأ–خ“أ‡â‚§ â”œأ–â•¦أ¥â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–â•¦أ¥â”œأ؟â”¬â–“â”œأ–خ“أ‡أ، â”œأ–â•¦أ¥â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬آ،â”œأ؟â”¬â–’â”œأ؟â”¬آ؛â”œأ؟â”¬â–’â”œأ؟â”¬âŒگ â”œأ–â•¦أ¥â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھâ”œأ؟â”¬â–“â”œأ–â”¼أ،â”œأ؟â”¬آ».",
  "tool-weather-title": "â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬â•–â”œأ–خ“أ‡أœâ”œأ؟â”¬â”‚",
  "tool-weather-desc": "â”œأ؟â”¬آ؛â”œأ؟â”¬â•£â”œأ؟â”¬â–’â”œأ–â”¬أ¼ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬â•–â”œأ–خ“أ‡أœâ”œأ؟â”¬â”‚ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬آ،â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–â”¼أ، â”œأ–â”¬أ¼â”œأ–â”¼أ، â”œأ؟â”¬أ؛â”œأ–â”¼أ، â”œأ–خ“أ‡آھâ”œأ–â•‍أ†â”œأ؟â”¬آ؛â”œأ–خ“أ‡أ، â”œأ–â”¬أ¼â”œأ–â”¼أ، â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬â•£â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھ.",
  "tool-world-title": "â”œأ؟â”¬â”‚â”œأ؟â”¬آ؛â”œأ؟â”¬â•£â”œأ؟â”¬âŒگ â”œأ؟â”¬â•£â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھâ”œأ–â”¼أ،â”œأ؟â”¬âŒگ",
  "tool-world-desc": "â”œأ؟â”¬آ؛â”œأ؟â”¬â•£â”œأ؟â”¬â–’â”œأ؟â”¬â•¢ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–â•¦أ¥â”œأ–خ“أ‡أœâ”œأ؟â”¬آ¬ â”œأ–â”¬أ¼â”œأ–â”¼أ، â”œأ؟â”¬أ؛â”œأ–â”¼أ، â”œأ–خ“أ‡آھâ”œأ–â•‍أ†â”œأ؟â”¬آ؛â”œأ–خ“أ‡أ، â”œأ–â”¬أ¼â”œأ–â”¼أ، â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬â•£â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھ â”œأ–â”¬أ¼â”œأ–â•¦أ¥â”œأ؟â”¬â–’â”œأ–خ“أ‡â•£â”œأ؟â”¬آ؛.",
  "resources-title": "â”œأ؟â”¬أ؛â”œأ؟â”¬آ»â”œأ–â•¦أ¥â”œأ؟â”¬آ؛â”œأ؟â”¬آ¬ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬أ‘â”œأ–خ“أ‡أ،â”œأ؟â”¬آ¬â”œأ؟â”¬آ؛â”œأ؟â”¬آ¼â”œأ–â”¼أ،â”œأ؟â”¬âŒگ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھâ”œأ–â•¦أ¥â”œأ؟â”¬â•،â”œأ–خ“أ‡â–‘ â”œأ؟â”¬آ؟â”œأ–خ“أ‡أ­â”œأ؟â”¬آ؛",
  "resources-timer-desc": "â”œأ³خ“أ©آ¼خ“أ‡آ£ â”œأ؟â”¬أ؛â”œأ–â”¬أ¼â”œأ؟â”¬â•¢â”œأ–خ“أ‡â‚§ â”œأ–خ“أ‡آھâ”œأ؟â”¬أ±â”œأ–خ“أ‡أœâ”œأ؟â”¬آ¬ â”œأ–خ“أ‡آھâ”œأ؟â”¬â–’â”œأ؟â”¬آھâ”œأ–â”¼أ، â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡â‚§â”œأ؟â”¬â•£â”œأ–خ“أ‡آھâ”œأ–خ“أ‡â‚§ â”œأ؟â”¬أ؛â”œأ–â•¦أ¥ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھâ”œأ؟â”¬آ»â”œأ؟â”¬â–’â”œأ؟â”¬â”‚â”œأ؟â”¬âŒگ â”œأ؟â”¬أ؛â”œأ–â•¦أ¥ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھâ”œأ–خ“أ‡أ،â”œأ؟â”¬â–“â”œأ–خ“أ‡â‚§.",
  "resources-book-desc": "â”œأ³خ“أ©آ¼خ“أ‡آ£ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–â•‍أ†â”œأ؟â”¬آ¬â”œأ؟â”¬آ؛â”œأ؟â”¬آ؟ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–â•‍أ†â”œأ–خ“أ‡â‚§â”œأ؟â”¬آ؛â”œأ؟â”¬â”‚â”œأ–â”¼أ،â”œأ–â•‍أ†â”œأ–â”¼أ، â”œأ؟â”¬آ،â”œأ–â•¦أ¥â”œأ–خ“أ‡â‚§ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬آ¬â”œأ؟â”¬â–’â”œأ–â•‍أ†â”œأ–â”¼أ،â”œأ؟â”¬â–“ â”œأ–â•¦أ¥â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬أ‘â”œأ–خ“أ‡أ،â”œأ؟â”¬آ¬â”œأ؟â”¬آ؛â”œأ؟â”¬آ¼â”œأ–â”¼أ،â”œأ؟â”¬âŒگ.",
  "resources-planner-desc": "â”œأ³خ“أ©آ¼خ“أ‡آ£ â”œأ–خ“أ‡أ،â”œأ؟â”¬â••â”œأ–خ“أ‡آھ â”œأ؟â”¬آ،â”œأ–â”¼أ،â”œأ؟â”¬آ؛â”œأ؟â”¬آ¬â”œأ–â•‍أ† â”œأ–خ“أ‡آھâ”œأ؟â”¬â•£ â”œأ–خ“أ‡أ­â”œأ؟â”¬â–‘â”œأ؟â”¬آ؛ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھâ”œأ؟â”¬آ«â”œأ؟â”¬â•–â”œأ؟â”¬â•– â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–â•¦أ¥â”œأ؟â”¬â–’â”œأ–خ“أ‡أœâ”œأ–â”¼أ، â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬أ؛â”œأ؟â”¬â”‚â”œأ؟â”¬â•–â”œأ–â•¦أ¥â”œأ؟â”¬â–’â”œأ–â”¼أ،.",
  "resources-keyboard-desc": "â”œأ³خ“أ©آ¼خ“أ‡آ£ â”œأ؟â”¬آ؛â”œأ–â•‍أ†â”œأ؟â”¬آ¬â”œأ؟â”¬آ؟ â”œأ–â”¬أ¼â”œأ–â”¼أ، â”œأ؟â”¬أ؛â”œأ–â”¼أ، â”œأ–خ“أ‡آھâ”œأ–â•‍أ†â”œأ؟â”¬آ؛â”œأ–خ“أ‡أ،â”œأ؟â”¼أ† â”œأ–â•¦أ¥â”œأ–â•‍أ†â”œأ–خ“أ‡أ، â”œأ–خ“أ‡آھâ”œأ–خ“أ‡أ،â”œأ؟â”¬آ¬â”œأ؟â”¬آ¼â”œأ–خ“أ‡â•£â”œأ؟â”¬آ؛!",
  "resources-affiliate": "â”œأ؟â”¬آ؟â”œأ؟â”¬â•،â”œأ–â”¬أ¼â”œأ؟â”¬آ¬â”œأ–خ“أ‡أ،â”œأ؟â”¬آ؛ â”œأ؟â”¬â”¤â”œأ؟â”¬â–’â”œأ–â•‍أ†â”œأ؟â”¬آ؛â”œأ؟â”¬أ­ â”œأ؟â”¬أ؛â”œأ–خ“أ‡آھâ”œأ؟â”¬آ؛â”œأ؟â”¬â–“â”œأ–â•¦أ¥â”œأ–خ“أ‡أ،â”œأ؟â”¼أ† â”œأ–â”¼أ،â”œأ؟â”¬آ،â”œأ؟â”¬â•،â”œأ–خ“أ‡â‚§ â”œأ؟â”¬آ¬â”œأ؟â”¬آ؛â”œأ–â”¼أ،â”œأ–خ“أ‡آھâ”œأ؟â”¬â–’â”œأ–خ“أ‡أ­â”œأ؟â”¬آ؛â”œأ–â”¬أ¼â”œأ–خ“أ‡أ، â”œأ؟â”¬â•£â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡â–‘ â”œأ؟â”¬أ؛â”œأ؟â”¬â–’â”œأ؟â”¬آ؟â”œأ؟â”¬آ؛â”œأ؟â”¬آ، â”œأ–خ“أ‡آھâ”œأ–خ“أ‡أ، â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھâ”œأ؟â”¬â”¤â”œأ؟â”¬آ¬â”œأ؟â”¬â–’â”œأ–â”¼أ،â”œأ؟â”¬آ؛â”œأ؟â”¬آ¬ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ–خ“أ‡آھâ”œأ؟â”¬أ±â”œأ–خ“أ‡أ­â”œأ–خ“أ‡â‚§â”œأ؟â”¬âŒگ. â”œأ؟â”¬â”¤â”œأ–â•‍أ†â”œأ؟â”¬â–’â”œأ–خ“أ‡â•£â”œأ؟â”¬آ؛ â”œأ–خ“أ‡â‚§â”œأ؟â”¬آ»â”œأ؟â”¬â•£â”œأ–خ“أ‡آھâ”œأ–â•‍أ†â”œأ–خ“أ‡آھ!",
  "footer-copyright": "&copy; 2025 â”œأ؟â”¬آ¬â”œأ؟â”¬آ؛â”œأ–â”¼أ،â”œأ–خ“أ‡آھâ”œأ؟â”¬â–’â”œأ–خ“أ‡أ­â”œأ؟â”¬آ؛â”œأ–â”¬أ¼â”œأ–خ“أ‡أ،. â”œأ؟â”¬آ¼â”œأ–خ“أ‡آھâ”œأ–â”¼أ،â”œأ؟â”¬â•£ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬أ؛â”œأ؟â”¬آ»â”œأ–â•¦أ¥â”œأ؟â”¬آ؛â”œأ؟â”¬آ¬ â”œأ–خ“أ‡آھâ”œأ؟â”¬آ¼â”œأ؟â”¬آ؛â”œأ–خ“أ‡أ،â”œأ–â”¼أ،â”œأ؟â”¬âŒگ â”œأ–â•¦أ¥â”œأ؟â”¬آ¬â”œأ؟â”¬آ،â”œأ؟â”¬آ¬â”œأ؟â”¬â–’â”œأ–خ“أ‡آھ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬آ«â”œأ؟â”¬â•،â”œأ–â•¦أ¥â”œأ؟â”¬â•،â”œأ–â”¼أ،â”œأ؟â”¬âŒگ.",
  "footer-about": "â”œأ؟â”¬آ،â”œأ–â•¦أ¥â”œأ–خ“أ‡â‚§",
  "footer-privacy": "â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬آ«â”œأ؟â”¬â•،â”œأ–â•¦أ¥â”œأ؟â”¬â•،â”œأ–â”¼أ،â”œأ؟â”¬âŒگ",
  "footer-contact": "â”œأ؟â”¬آ؛â”œأ؟â”¬آ¬â”œأ؟â”¬â•،â”œأ–خ“أ‡â‚§ â”œأ؟â”¬آ؟â”œأ–خ“أ‡أ،â”œأ؟â”¬آ؛",
  "footer-credit": "â”œأ؟â”¬آ¬â”œأ–خ“أ‡آھ â”œأ؟â”¬آ؛â”œأ–خ“أ‡â‚§â”œأ؟â”¬أ‘â”œأ–خ“أ‡أ،â”œأ؟â”¬â”¤â”œأ؟â”¬آ؛â”œأ؟â”¬أ­ â”œأ؟â”¬آ؟â”œأ–â•¦أ¥â”œأ؟â”¬آ؛â”œأ؟â”¬â”‚â”œأ؟â”¬â•–â”œأ؟â”¬âŒگ <a href=\"https://github.com/sergenet\" target=\"_blank\">sergenet</a>"
      }
    };

    // Ensure all locales at least inherit English keys to avoid missing properties
    ["es","de","ru","el","ar","fr"].forEach(l => {
      try {
        translations[l] = Object.assign({}, translations.en, translations[l] || {});
      } catch(e){}
    });

    // Helper to read stored language; central single source of truth
    function getStoredLang() {
      try {
        const s = localStorage.getItem('timerhavenLang');
        if (s && typeof s === 'string') return s.slice(0,2);
      } catch(e){}
      return 'en';
    }

    // Update UI texts from translations; accept lang param to avoid race conditions
    function updateLanguage(lang) {
      if (!lang) lang = document.getElementById("lang-select")?.value || getStoredLang();
      if (!translations[lang]) lang = 'en';
      Object.keys(translations[lang]).forEach(function(id) {
        const el = document.getElementById(id);
        if (el) {
          try {
            if (id === "footer-credit" || id === "footer-copyright") {
              el.innerHTML = translations[lang][id];
            } else {
              el.textContent = translations[lang][id];
            }
          } catch(e){ /* ignore per-element errors */ }
        }
      });
      try { document.title = translations[lang]["page-title"] || document.title; } catch(e){}
      console.info('[i18n] applied language ->', lang);
    }

    // Rewrite tool links so they point to language-specific tool pages when appropriate.
    // Behavior desired:
    //  - Always produce tool-<lang>.html for every language, including English (tool-en.html).
    //  - Defensive: sanitize existing data-tool values that may already include a trailing '-xx' or '.html'.
    //  - This avoids producing double-suffixed filenames like "countdown-en-el.html".
    function rewriteToolLinks() {
      try {
        const lang = getStoredLang() || 'en';
        const anchors = document.querySelectorAll('a[data-tool]');
        anchors.forEach(a => {
          try {
            // Read the data-tool value and canonicalize it:
            //  - Trim whitespace
            //  - Remove any trailing language suffix like "-en" or "-fr"
            //  - Remove any trailing ".html" if present
            let tool = (a.getAttribute('data-tool') || '').trim();

            // Strip trailing .html if present
            tool = tool.replace(/\.html$/i, '');

            // Strip trailing -xx (two-letter language) if present
            tool = tool.replace(/-([a-z]{2})$/i, '');

            if (!tool) return;

            // Always append selected language code to produce tool-<lang>.html
            const newHref = `${tool}-${lang}.html`;

            // Update href attribute (relative) and absolute href for the anchor element
            a.setAttribute('href', newHref);
            a.href = location.origin.replace(/\/$/,'') + '/' + newHref;
          } catch(e){
            // ignore per-anchor errors
          }
        });
        console.info('[index] rewriteToolLinks applied for lang ->', getStoredLang());
      } catch(e) {
        console.warn('[index] rewriteToolLinks failed', e);
      }
    }

    // Previous currency-specific rewrite is kept for backward compatibility (defensive)
    function localizeGenericCurrencyAnchors() {
      try {
        const lang = getStoredLang() || 'en';
        const replacements = {
          'currency.html': `currency-${lang}.html`,
          '/currency.html': `currency-${lang}.html`,
          'currency-how-to.html': `currency-how-to-${lang}.html`,
          '/currency-how-to.html': `currency-how-to-${lang}.html`,
          'currency-tips.html': `currency-tips-${lang}.html`,
          '/currency-tips.html': `currency-tips-${lang}.html`
        };

        Object.keys(replacements).forEach(function(key){
          const nodes = document.querySelectorAll('a[href="' + key + '"]');
          nodes.forEach(function(a){
            try {
              a.setAttribute('href', replacements[key]);
              a.href = replacements[key];
            } catch(e){}
          });
        });

        document.querySelectorAll('a[href]').forEach(function(a){
          try {
            const attr = a.getAttribute('href') || '';
            if (attr.match(/(^|\/)currency(\.html)?($|\?)/i)) {
              a.href = '/' + replacements['currency.html'];
            } else if (attr.match(/(^|\/)currency-how-to(\.html)?($|\?)/i)) {
              a.href = '/' + replacements['currency-how-to.html'];
            } else if (attr.match(/(^|\/)currency-tips(\.html)?($|\?)/i)) {
              a.href = '/' + replacements['currency-tips.html'];
            }
          } catch(e){}
        });

        console.info('[index] localized currency anchors for lang ->', lang);
      } catch(e) {
        console.warn('[index] localizeGenericCurrencyAnchors error', e);
      }
    }

    // Wire up language select and initialization in a robust order
    document.addEventListener("DOMContentLoaded", function() {
      // initialize select from stored language
      const saved = getStoredLang() || 'en';
      const select = document.getElementById('lang-select');
      if (select) {
        select.value = saved;
        // when user changes selection, save and apply immediately
        select.addEventListener('change', function() {
          const v = this.value?.slice(0,2) || 'en';
          try { localStorage.setItem('timerhavenLang', v); } catch(e){}
          updateLanguage(v);
          // rewrite menu tool links to selected language
          try { rewriteToolLinks(); } catch(e){}
          // maintain defensive currency-specific rewrite
          try { localizeGenericCurrencyAnchors(); } catch(e){}
        });
      }

      // First apply language from saved (so UI labels are filled)
      updateLanguage(saved);

      // ensure menu links point to localized tool pages
      try { rewriteToolLinks(); } catch(e){}

      // ensure any generic anchors pointing to currency.html are rewritten for chosen lang
      try { localizeGenericCurrencyAnchors(); } catch(e){}

      // Debug: show some values if the tool titles are blank
      try {
        console.info('debug: header-title ->', document.getElementById('header-title')?.textContent);
        console.info('debug: tool-currency-title ->', document.getElementById('tool-currency-title')?.textContent);
      } catch(e){}
    });

    // Also respond to storage events (other tab changed language)
    window.addEventListener('storage', function(e) {
      if (e.key === 'timerhavenLang') {
        const lang = (e.newValue || 'en').slice(0,2);
        updateLanguage(lang);
        rewriteToolLinks();
        localizeGenericCurrencyAnchors();
      }
    });
  </script>
</body>
</html>


