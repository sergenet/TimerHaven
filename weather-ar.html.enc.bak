  <script>
  // Full AR-ready JS with robust mobile-friendly geolocation helper and Monday-first weekday ordering
  const DEFAULT_PAGE_LANG = 'ar';
  const SUPPORTED_LANGS = ['en','fr','de','es','ru','el','ar'];
  const PAGE_LANG = 'ar';

  const UI_STRINGS = {
    ar: {
      PLEASE_SELECT:"ÙŠØ±Ø¬Ù‰ ØªØ­Ø¯ÙŠØ¯ Ù…Ø¯ÙŠÙ†Ø© Ø£Ùˆ Ø¥Ø¯Ø®Ø§Ù„Ù‡Ø§.",
      GEO_UNSUPPORTED:"Ø§Ù„Ù…ÙˆÙ‚Ø¹ Ø§Ù„Ø¬ØºØ±Ø§ÙÙŠ ØºÙŠØ± Ù…Ø¯Ø¹ÙˆÙ….",
      UNABLE_LOCATION:"ØªØ¹Ø°Ø± Ø§Ù„Ø­ØµÙˆÙ„ Ø¹Ù„Ù‰ Ù…ÙˆÙ‚Ø¹Ùƒ.",
      FETCH_ERROR:"Ø®Ø·Ø£ ÙÙŠ Ø¬Ù„Ø¨ Ø¨ÙŠØ§Ù†Ø§Øª Ø§Ù„Ø·Ù‚Ø³.",
      NOT_FOUND_TEMPLATE:"ØªØ¹Ø°Ø± Ø§Ù„Ø¹Ø«ÙˆØ± Ø¹Ù„Ù‰ Ø§Ù„Ø·Ù‚Ø³ Ù„Ù€ \"{city}\".",
      SELECT_CITY_PLACEHOLDER:"Ø§Ø®ØªØ± Ù…Ø¯ÙŠÙ†Ø©...",
      OR_ENTER_CITY_PLACEHOLDER:"Ø£Ùˆ Ø§Ø¯Ø®Ù„ Ø§Ù„Ù…Ø¯ÙŠÙ†Ø©..."
    }
  };

  const WEATHERCODE_DESC = {
    0:{ ar:"Ø³Ù…Ø§Ø¡ ØµØ§ÙÙŠØ©" },1:{ ar:"ØºØ§Ù„Ø¨Ù‹Ø§ ØµØ§ÙÙŠ" },2:{ ar:"ØºØ§Ø¦Ù… Ø¬Ø²Ø¦ÙŠÙ‹Ø§" },3:{ ar:"ØºØ§Ø¦Ù…" },
    45:{ ar:"Ø¶Ø¨Ø§Ø¨" },48:{ ar:"Ø¶Ø¨Ø§Ø¨ Ù…ØªØ¬Ù…Ø¯" },51:{ ar:"Ø±Ø°Ø§Ø° Ø®ÙÙŠÙ" },53:{ ar:"Ø±Ø°Ø§Ø° Ù…ØªÙˆØ³Ø·" },
    55:{ ar:"Ø±Ø°Ø§Ø° ÙƒØ«ÙŠÙ" },56:{ ar:"Ø±Ø°Ø§Ø° Ù…ØªØ¬Ù…Ø¯ Ø®ÙÙŠÙ" },57:{ ar:"Ø±Ø°Ø§Ø° Ù…ØªØ¬Ù…Ø¯ ÙƒØ«ÙŠÙ" },
    61:{ ar:"Ù…Ø·Ø± Ø®ÙÙŠÙ" },63:{ ar:"Ù…Ø·Ø± Ù…Ø¹ØªØ¯Ù„" },65:{ ar:"Ù…Ø·Ø± ØºØ²ÙŠØ±" },
    71:{ ar:"Ø«Ù„ÙˆØ¬ Ø®ÙÙŠÙØ©" },73:{ ar:"Ø«Ù„ÙˆØ¬ Ù…ØªÙˆØ³Ø·Ø©" },75:{ ar:"Ø«Ù„ÙˆØ¬ ØºØ²ÙŠØ±Ø©" },
    80:{ ar:"Ø²Ø®Ø§Øª Ù…Ø·Ø± Ø®ÙÙŠÙØ©" },81:{ ar:"Ø²Ø®Ø§Øª Ù…Ø·Ø± Ù…ØªÙˆØ³Ø·Ø©" },82:{ ar:"Ø²Ø®Ø§Øª Ù…Ø·Ø± Ø¹Ù†ÙŠÙØ©" },
    95:{ ar:"Ø¹Ø§ØµÙØ© Ø±Ø¹Ø¯ÙŠØ©" },96:{ ar:"Ø¹Ø§ØµÙØ© Ø±Ø¹Ø¯ÙŠØ© Ù…Ø¹ Ø¨Ø±Ø¯ Ø®ÙÙŠÙ" },99:{ ar:"Ø¹Ø§ØµÙØ© Ø±Ø¹Ø¯ÙŠØ© Ù…Ø¹ Ø¨Ø±Ø¯ ØºØ²ÙŠØ±" }
  };

  const TEMP_UNIT_KEY = 'timerhavenTempUnit';
  const DEFAULT_UNIT = 'C';
  let LAST_QUERY = null;

  function getStoredUnit() { try { const u = localStorage.getItem(TEMP_UNIT_KEY); if (u === 'C' || u === 'F') return u; } catch(e) {} return DEFAULT_UNIT; }
  function setStoredUnit(u) { try { localStorage.setItem(TEMP_UNIT_KEY, u); } catch(e) {} }

  // Enhanced applyUnitUI: toggles class, aria-pressed consistently
  function applyUnitUI() {
    try {
      const u = getStoredUnit();
      const c = document.getElementById('unitC');
      const f = document.getElementById('unitF');
      if (!c || !f) return;
      if (u === 'C') {
        c.classList.add('active'); c.setAttribute('aria-pressed','true');
        f.classList.remove('active'); f.setAttribute('aria-pressed','false');
      } else {
        f.classList.add('active'); f.setAttribute('aria-pressed','true');
        c.classList.remove('active'); c.setAttribute('aria-pressed','false');
      }
      if (window.console && console.debug) console.debug('applyUnitUI ->', u);
    } catch (err) {
      console.warn('applyUnitUI error', err);
    }
  }

  function reapplyLastQuery() {
    if (!LAST_QUERY) return;
    if (LAST_QUERY.type === 'coords' && LAST_QUERY.lat != null && LAST_QUERY.lon != null) {
      fetchOpenMeteoForecast(LAST_QUERY.lat, LAST_QUERY.lon).then(fore => { try { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(fore, LAST_QUERY.placeName || ''); } catch(e){} });
    } else if (LAST_QUERY.type === 'city' && LAST_QUERY.city) {
      fetchWeather(LAST_QUERY.city);
    } else if (LAST_QUERY.type === 'backend' && LAST_QUERY.city) {
      fetchBackendCity(LAST_QUERY.city);
    }
  }

  // Robust unit toggle binder â€” tolerant of markup differences and late insertion
  (function bindUnitToggles() {
    function findButtons() {
      // 1) direct by ID
      const cById = document.getElementById('unitC');
      const fById = document.getElementById('unitF');
      if (cById || fById) return { c: cById, f: fById };

      // 2) by data-unit attribute
      const cByData = document.querySelector('button[data-unit="C"], button[data-unit="Â°C"], button[data-unit="c"]');
      const fByData = document.querySelector('button[data-unit="F"], button[data-unit="Â°F"], button[data-unit="f"]');
      if (cByData || fByData) return { c: cByData, f: fByData };

      // 3) search inside .unit-toggle or document for buttons whose text contains Â°C/Â°F or localized labels
      const container = document.querySelector('.unit-toggle') || document.body;
      let c = null, f = null;
      container.querySelectorAll('button, [role="button"]').forEach(btn => {
        const txt = (btn.textContent || '').trim();
        if (!c && /Â°\s*C|Celsius|C$/i.test(txt)) c = btn;
        if (!f && /Â°\s*F|Fahrenheit|F$/i.test(txt)) f = btn;
      });
      return { c, f };
    }

    function attach(btn, unit) {
      if (!btn) return;
      const handler = function(e) {
        try {
          setStoredUnit(unit);
          applyUnitUI();
          setTimeout(function(){ if (typeof reapplyLastQuery === 'function') reapplyLastQuery(); }, 50);
        } catch (err) {
          console.warn('unit toggle handler error', err);
        }
      };
      // Try to avoid duplicate handlers
      try { btn.removeEventListener && btn.removeEventListener('click', handler); } catch(e){}
      btn.addEventListener('click', handler);
      // touch fallback for some WebViews
      try { btn.addEventListener('touchend', function(e){ e.preventDefault(); handler(); }, { passive: false }); } catch(e){}
      btn.addEventListener('keydown', function(ev){ if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); handler(); } });
      btn.setAttribute('tabindex', '0');
    }

    function init() {
      const { c, f } = findButtons();
      attach(c, 'C');
      attach(f, 'F');
      try { applyUnitUI(); } catch(e){}
      // If not found yet, retry shortly (handles DOM insertion order differences)
      if (!(c && f)) {
        setTimeout(function(){
          const again = findButtons();
          if (again.c) attach(again.c, 'C');
          if (again.f) attach(again.f, 'F');
          try { applyUnitUI(); } catch(e){}
        }, 350);
      }

      // Document-level delegated fallback (extra safety)
      document.addEventListener('click', function(e){
        try {
          const t = e.target;
          const unitBtn = t.closest && t.closest('#unitC, #unitF');
          if (unitBtn) {
            e.preventDefault();
            const id = unitBtn.id;
            const unit = (id === 'unitC') ? 'C' : (id === 'unitF') ? 'F' : null;
            if (unit) {
              setStoredUnit(unit);
              applyUnitUI();
              setTimeout(reapplyLastQuery, 50);
            }
          }
        } catch(err){}
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();

  // --- The rest of weather logic (renderOpenMeteo, geocoding, fetching, geolocation helper) ---
  function t(key, vars) {
    const dict = UI_STRINGS[PAGE_LANG] || UI_STRINGS[DEFAULT_PAGE_LANG] || {};
    let s = dict[key] || '';
    if (vars && typeof vars === 'object') { Object.keys(vars).forEach(k => { s = s.replace('{'+k+'}', vars[k]); }); }
    return s;
  }

  function describeWeatherCode(code) {
    const obj = WEATHERCODE_DESC[code];
    if (!obj) return String(code);
    return obj[PAGE_LANG] || obj['ar'] || String(code);
  }

  function localizedWeekday(dateStr) {
    try { const d = new Date(dateStr); return new Intl.DateTimeFormat(PAGE_LANG, { weekday: 'short' }).format(d); } catch(e){ return dateStr; }
  }

  function getWeatherEmoji(code) {
    if (code === null || code === undefined) return 'â€¢';
    if (code === 0) return 'â˜€ï¸';
    if (code === 1 || code === 2) return 'ðŸŒ¤ï¸';
    if (code === 3) return 'â˜ï¸';
    if ([45,48].includes(code)) return 'ðŸŒ«ï¸';
    if ([51,53,55,56,57].includes(code)) return 'ðŸŒ¦ï¸';
    if ([61,63,65,80,81,82].includes(code)) return 'ðŸŒ§ï¸';
    if ([71,73,75].includes(code)) return 'â„ï¸';
    if ([95,96,99].includes(code)) return 'â›ˆï¸';
    return 'ðŸŒ¤ï¸';
  }

  function renderOpenMeteo(forecast, placeName) {
    const unit = getStoredUnit();
    const tempSymbol = (unit === 'F') ? 'Â°F' : 'Â°C';
    const speedUnit = (unit === 'F') ? 'mph' : 'm/s';
    const cw = forecast.current_weather || {};
    const daily = forecast.daily || {};
    const parts = [];
    const title = `<div style="font-weight:700; margin-bottom:6px;">${placeName || ''}</div>`;
    const weatherLabel = describeWeatherCode(cw.weathercode);

    const currentHtml = `<div style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;">
      <div style="flex:1"><div style="font-weight:700;font-size:1.05rem;">${weatherLabel}</div></div>
      <div style="min-width:110px;text-align:left;">
        <div style="font-size:1.45rem;font-weight:700;">${typeof cw.temperature === 'number' ? Math.round(cw.temperature) + tempSymbol : 'N/A'}</div>
        <div style="color:#6b7280;">Ø§Ù„Ø±ÙŠØ§Ø­ ${typeof cw.windspeed === 'number' ? Math.round(cw.windspeed) + ' ' + speedUnit : 'N/A'}</div>
      </div>
    </div>`; 
    parts.push(title + currentHtml);

    if (daily.time && daily.time.length) {
      // Build day objects
      let days = daily.time.map((d,i) => {
        const maxT = daily.temperature_2m_max && daily.temperature_2m_max[i] !== undefined ? Math.round(daily.temperature_2m_max[i]) : 'â€”';
        const minT = daily.temperature_2m_min && daily.temperature_2m_min[i] !== undefined ? Math.round(daily.temperature_2m_min[i]) : 'â€”';
        const code = daily.weathercode && daily.weathercode[i] !== undefined ? daily.weathercode[i] : null;
        const desc = code !== null ? describeWeatherCode(code) : '';
        return { date: d, maxT, minT, code, desc };
      }).slice(0,7);

      // Sort days so Monday -> Sunday (ISO), so when rendered RTL top-right is Monday.
      days.sort((a,b) => {
        const da = new Date(a.date), db = new Date(b.date);
        const wa = da.getDay() === 0 ? 7 : da.getDay(); // JS: 0=Sun -> 7
        const wb = db.getDay() === 0 ? 7 : db.getDay();
        const ka = (wa + 6) % 7; // Monday->0 ... Sunday->6
        const kb = (wb + 6) % 7;
        return ka - kb;
      });

      let grid = '<div class="forecast-grid">';
      days.forEach(day => {
        grid += `<div class="forecast-day">
                    <div class="day">${localizedWeekday(day.date)}</div>
                    <div class="weather-icon">${getWeatherEmoji(day.code)}</div>
                    <div class="desc">${day.desc}</div>
                    <div class="temp"><span style="font-weight:700;">${day.maxT}${tempSymbol}</span> / ${day.minT}${tempSymbol}</div>
                 </div>`;
      });
      grid += '</div>';
      parts.push(grid);
    }

    return parts.join('');
  }

  function geocodeCity(city) {
    const url = `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=${PAGE_LANG}`;
    return fetch(url).then(r => r.json()).then(j => {
      if (j && Array.isArray(j.results) && j.results.length > 0) {
        const r0 = j.results[0];
        return { latitude: r0.latitude, longitude: r0.longitude, name: r0.name + (r0.country ? ', ' + r0.country : '') };
      }
      return null;
    }).catch(()=>null);
  }

  function fetchOpenMeteoForecast(lat, lon) {
    const unit = getStoredUnit();
    const temperature_unit = (unit === 'F') ? 'fahrenheit' : 'celsius';
    const windspeed_unit = (unit === 'F') ? 'mph' : 'ms';
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&daily=temperature_2m_max,temperature_2m_min,weathercode&current_weather=true&timezone=auto&forecast_days=7&temperature_unit=${temperature_unit}&windspeed_unit=${windspeed_unit}`;
    return fetch(url).then(r => r.json());
  }

  function fetchBackendCity(city) {
    const resultEl = document.getElementById('weatherResult');
    return fetch(`/weather?city=${encodeURIComponent(city)}`)
      .then(r => r.json())
      .then(data => {
        if (!data || (data.cod && parseInt(data.cod,10) !== 200)) {
          const err = (data && (data.error || data.message)) || t('NOT_FOUND_TEMPLATE', { city });
          resultEl.innerHTML = `<span style="color:#b00;">${err}</span>`;
          return null;
        }
        LAST_QUERY = { type: 'backend', city };
        resultEl.innerHTML = renderWeatherData(data);
        return data;
      })
      .catch(() => {
        resultEl.innerHTML = '<span style="color:#b00;">' + t('FETCH_ERROR') + '</span>';
        return null;
      });
  }

  function renderWeatherData(data) {
    const unit = getStoredUnit();
    let tempStr = (data.main && typeof data.main.temp === 'number') ? Math.round(data.main.temp) + 'Â°C' : 'N/A';
    if (unit === 'F' && data.main && typeof data.main.temp === 'number') tempStr = Math.round((data.main.temp * 9/5)+32) + 'Â°F';
    const windUnit = (unit === 'F') ? 'mph' : 'm/s';
    let wind = data.wind ? data.wind.speed : 'N/A';
    if (unit === 'F' && data.wind && typeof data.wind.speed === 'number') wind = Math.round(data.wind.speed * 2.23694);
    return `<b>${data.name}${data.sys && data.sys.country ? ', ' + data.sys.country : ''}</b><br>
            Ø§Ù„Ø·Ù‚Ø³: ${data.weather && data.weather[0] ? data.weather[0].description : 'N/A'}<br>
            Ø¯Ø±Ø¬Ø© Ø§Ù„Ø­Ø±Ø§Ø±Ø©: ${tempStr}<br>
            Ø§Ù„Ø±Ø·ÙˆØ¨Ø©: ${data.main ? data.main.humidity : 'N/A'}%<br>
            Ø§Ù„Ø±ÙŠØ§Ø­: ${wind} ${windUnit}`;
  }

  function fetchWeather(city) {
    const resultEl = document.getElementById('weatherResult');
    if (!city) {
      resultEl.innerHTML = '<span style="color:#b00;">' + t('PLEASE_SELECT') + '</span>';
      return;
    }
    resultEl.innerHTML = 'Ø¬Ø§Ø±Ù Ø§Ù„ØªØ­Ù…ÙŠÙ„...';
    geocodeCity(city).then(geo => {
      if (geo && geo.latitude != null && geo.longitude != null) {
        LAST_QUERY = { type: 'city', city };
        fetchOpenMeteoForecast(geo.latitude, geo.longitude).then(fore => {
          if (!fore) return fetchBackendCity(city);
          try {
            LAST_QUERY = { type: 'coords', lat: geo.latitude, lon: geo.longitude, placeName: geo.name, city: city };
            resultEl.innerHTML = renderOpenMeteo(fore, geo.name || city);
          } catch (e) {
            console.error('renderOpenMeteo error', e);
            resultEl.innerHTML = '<span style="color:#b00;">' + t('FETCH_ERROR') + '</span>';
          }
        }).catch(()=> fetchBackendCity(city));
      } else {
        fetchBackendCity(city);
      }
    }).catch(()=> fetchBackendCity(city));
  }

  // UI wiring (city dropdown, input, form)
  try {
    document.getElementById('cityDropdown').addEventListener('change', function () {
      document.getElementById('cityInput').value = this.value;
      if (this.value) fetchWeather(this.value);
    });

    document.getElementById('cityInput').addEventListener('input', function () {
      const val = this.value.trim();
      const dd = document.getElementById('cityDropdown');
      let found = false;
      for (let i = 0; i < dd.options.length; i++) {
        if (dd.options[i].value.toLowerCase() === val.toLowerCase()) { dd.selectedIndex = i; found = true; break; }
      }
      if (!found) dd.selectedIndex = 0;
    });

    document.getElementById('weatherForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const city = document.getElementById('cityInput').value.trim() || document.getElementById('cityDropdown').value;
      fetchWeather(city);
    });
  } catch(e){ console.warn(e); }

  try { if (!localStorage.getItem(TEMP_UNIT_KEY)) localStorage.setItem(TEMP_UNIT_KEY, DEFAULT_UNIT); } catch(e){}
  applyUnitUI();

  // Injected/native coordinates fetch helper
  window._injectedFetchByCoords = window._injectedFetchByCoords || function(lat, lon, placeName){
    try {
      if (typeof fetchOpenMeteoForecast === 'function' && typeof renderOpenMeteo === 'function') {
        fetchOpenMeteoForecast(lat, lon).then(fore => {
          try {
            const q = { type:'coords', lat: lat, lon: lon, placeName: placeName || '' };
            LAST_QUERY = q;
            window.LAST_QUERY = q;
            document.getElementById('weatherResult').innerHTML = renderOpenMeteo(fore, placeName || '');
          } catch(e) {
            console.error('renderOpenMeteo error', e);
            document.getElementById('weatherResult').innerHTML = '<span style="color:#b00;">Ø®Ø·Ø£ ÙÙŠ Ø¹Ø±Ø¶ Ø§Ù„Ø·Ù‚Ø³</span>';
          }
        }).catch(err => {
          console.error('fetchOpenMeteoForecast error', err);
          document.getElementById('weatherResult').innerHTML = '<span style="color:#b00;">Ø®Ø·Ø£ ÙÙŠ Ø¬Ù„Ø¨ Ø§Ù„ØªÙˆÙ‚Ø¹Ø§Øª</span>';
        });
      } else {
        console.log('Coordinates available:', lat, lon);
      }
    } catch(e){ console.error(e); }
  };

  // Robust mobile-friendly geolocation helper (Arabic localized messages)
  (function(){
    const TIMEOUT_MS = 25000; // mobile can be slow
    const useBtn = document.getElementById('useLocationBtn');
    const resultEl = document.getElementById('weatherResult');

    function log(msg){ try { console.debug('[geo] '+msg); } catch(e){} }
    function show(msg, isError){
      if (!resultEl) return;
      resultEl.innerHTML = isError ? ('<span style="color:#b00;">' + msg + '</span>') : msg;
    }

    function getPositionWithTimeout(opts){
      return new Promise((resolve, reject) => {
        if (!navigator.geolocation) {
          const err = new Error('No geolocation');
          err.code = 0;
          return reject(err);
        }
        let done = false;
        const timer = setTimeout(()=> {
          if (done) return;
          done = true;
          const err = new Error('Timeout');
          err.code = 3;
          reject(err);
        }, TIMEOUT_MS);
        navigator.geolocation.getCurrentPosition(pos => {
          if (done) return;
          done = true; clearTimeout(timer); resolve(pos);
        }, err => {
          if (done) return;
          done = true; clearTimeout(timer); reject(err);
        }, opts || { enableHighAccuracy: false, maximumAge: 0, timeout: TIMEOUT_MS });
      });
    }

    async function queryPermission(){
      if (!navigator.permissions || !navigator.permissions.query) return null;
      try { const p = await navigator.permissions.query({ name: 'geolocation' }); return p.state; } catch(e){ log('permissions.query failed: '+e); return null; }
    }

    function permissionHelpText(){
      return `
        <div style="font-size:0.95rem;line-height:1.3;">
          ÙŠØ¨Ø¯Ùˆ Ø£Ù† Ø§Ù„ÙˆØµÙˆÙ„ Ù„Ù„Ù…ÙˆÙ‚Ø¹ Ù…Ø­Ø¸ÙˆØ±. Ù„ØªØ´ØºÙŠÙ„Ù‡:
          <ul>
            <li>Ø§ÙØªØ­ Ù‚Ø§Ø¦Ù…Ø© Ø§Ù„Ù…ØªØµÙØ­ â†’ Ø¥Ø¹Ø¯Ø§Ø¯Ø§Øª Ø§Ù„Ù…ÙˆÙ‚Ø¹ â†’ Ø§Ù„Ø³Ù…Ø§Ø­ Ù„Ù…ÙˆÙ‚Ø¹ timerhaven.com</li>
            <li>ØªØ£ÙƒØ¯ Ø£Ù† Ø¥Ø¹Ø¯Ø§Ø¯Ø§Øª Ù†Ø¸Ø§Ù… Android > Ø§Ù„Ù…ÙˆÙ‚Ø¹ Ù…ÙØ¹Ù‘Ù„Ø©</li>
            <li>Ù„Ø§ ØªØ³ØªØ®Ø¯Ù… ÙˆØ¶Ø¹ Ø§Ù„ØªØµÙØ­ Ø§Ù„Ø®ÙÙŠ</li>
          </ul>
          Ø£Ùˆ Ø§Ù†Ø³Ø® Ø§Ù„Ø¥Ø­Ø¯Ø§Ø«ÙŠØ§Øª ÙŠØ¯ÙˆÙŠØ§Ù‹ Ù…Ù† ØªØ·Ø¨ÙŠÙ‚ Ø§Ù„Ø®Ø±Ø§Ø¦Ø· (Ø´ï¿½ï¿½Ø±Ùƒ Ø§Ù„Ù…ÙˆÙ‚Ø¹ â†’ Ù†Ø³Ø® Ø§Ù„Ø¥Ø­Ø¯Ø§Ø«ÙŠØ§Øª).
        </div>
      `;
    }

    async function handleUseLocation(e){
      e && e.preventDefault && e.preventDefault();
      show('Ø¬Ø§Ø±Ù ØªØ­Ø¯ÙŠØ¯ Ø§Ù„Ù…ÙˆÙ‚Ø¹...');
      log('User requested location');

      const perm = await queryPermission().catch(()=>null);
      log('permission state: '+perm);

      if (perm === 'denied'){
        show(permissionHelpText(), true);
        return;
      }

      try {
        // Try cached position quickly
        const pos = await getPositionWithTimeout({ enableHighAccuracy: false, maximumAge: 60 * 1000, timeout: TIMEOUT_MS });
        log('got coords quick: '+pos.coords.latitude+','+pos.coords.longitude);
        show('' + pos.coords.latitude.toFixed(4)+', '+pos.coords.longitude.toFixed(4) + ' â€” Ø¬Ø§Ø±ÙŠ Ø¬Ù„Ø¨ Ø§Ù„ØªÙˆÙ‚Ø¹Ø§Øª...');
        if (typeof window._injectedFetchByCoords === 'function') window._injectedFetchByCoords(pos.coords.latitude, pos.coords.longitude);
        else fetchOpenMeteoForecast(pos.coords.latitude, pos.coords.longitude).then(f => { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(f, ''); }).catch(err => { log(err); show('Ø®Ø·Ø£ ÙÙŠ Ø¬Ù„Ø¨ Ø§Ù„ØªÙˆÙ‚Ø¹Ø§Øª', true); });
        return;
      } catch(err) {
        log('quick attempt failed: ' + (err && err.code) + ' / ' + err.message);
      }

      try {
        // Fresh high-accuracy attempt
        const pos = await getPositionWithTimeout({ enableHighAccuracy: true, maximumAge: 0, timeout: TIMEOUT_MS + 5000 });
        log('got coords after prompt: '+pos.coords.latitude+','+pos.coords.longitude);
        show('' + pos.coords.latitude.toFixed(4)+', ' + pos.coords.longitude.toFixed(4) + ' â€” Ø¬Ø§Ø±ÙŠ Ø¬Ù„Ø¨ Ø§Ù„ØªÙˆÙ‚Ø¹Ø§Øª...');
        if (typeof window._injectedFetchByCoords === 'function') window._injectedFetchByCoords(pos.coords.latitude, pos.coords.longitude);
        else fetchOpenMeteoForecast(pos.coords.latitude, pos.coords.longitude).then(f => { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(f, ''); }).catch(err => { log(err); show('Ø®Ø·Ø£ ÙÙŠ Ø¬Ù„Ø¨ Ø§Ù„ØªÙˆÙ‚Ø¹Ø§Øª', true); });
        return;
      } catch(err) {
        log('final attempt failed: ' + (err && err.code) + ' / ' + err.message);
        if (err && err.code === 1) {
          show(permissionHelpText(), true);
        } else if (err && err.code === 3) {
          show('Ø§Ù†ØªÙ‡Øª Ù…Ù‡Ù„Ø© Ø·Ù„Ø¨ Ø§Ù„Ù…ÙˆÙ‚Ø¹. ØªØ£ÙƒØ¯ Ù…Ù† ØªØ´ØºÙŠÙ„ GPS ÙˆØ­Ø§ÙˆÙ„ Ù…Ø±Ø© Ø£Ø®Ø±Ù‰.', true);
        } else {
          show('Ø§Ù„Ù…ÙˆÙ‚Ø¹ ØºÙŠØ± Ù…ØªØ§Ø­ Ø¹Ù„Ù‰ Ù‡Ø°Ø§ Ø§Ù„Ø¬Ù‡Ø§Ø² Ø£Ùˆ Ø§Ù„Ù…ØªØµÙØ­. ÙŠÙ…ÙƒÙ†Ùƒ Ø¥Ø¯Ø®Ø§Ù„ Ø§Ù„Ø¥Ø­Ø¯Ø§Ø«ÙŠØ§Øª ÙŠØ¯ÙˆÙŠØ§Ù‹.', true);
        }
      }
    }

    if (useBtn) {
      try { useBtn.removeEventListener && useBtn.removeEventListener('click', handleUseLocation); } catch(e){}
      useBtn.addEventListener('click', handleUseLocation);
    } else {
      log('useLocationBtn not present');
    }

    // Exposed receiver for native apps
    window.receiveNativeLocation = function(obj){
      try {
        const lat = parseFloat(obj.latitude || obj.lat);
        const lon = parseFloat(obj.longitude || obj.lon || obj.lng);
        if (!isNaN(lat) && !isNaN(lon)) {
          show('Location from app: ' + lat + ', ' + lon + ' â€” fetching...');
          if (typeof window._injectedFetchByCoords === 'function') window._injectedFetchByCoords(lat, lon);
          else fetchOpenMeteoForecast(lat, lon).then(f => { document.getElementById('weatherResult').innerHTML = renderOpenMeteo(f, ''); }).catch(err => { log(err); show('Ø®Ø·Ø£ ÙÙŠ Ø¬Ù„Ø¨ Ø§Ù„ØªÙˆÙ‚Ø¹Ø§Øª', true); });
        }
      } catch(e){ log(e); }
    };
  })();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js"></script>
