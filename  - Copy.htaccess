# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGINPassengerAppRoot "/home/sergbcqk/TimerHavenWeatherProxy"PassengerBaseURI "/"PassengerNodejs "/home/sergbcqk/nodevenv/TimerHavenWeatherProxy/18/bin/node"PassengerAppType nodePassengerStartupFile server.js# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END# ---- Canonical redirect rules (force https + non-www) ----<IfModule mod_rewrite.c>  RewriteEngine On  # If the host starts with "www.", redirect to non-www canonical at https://timerhaven.com  RewriteCond %{HTTP_HOST} ^www\. [NC]  RewriteRule ^ https://timerhaven.com%{REQUEST_URI} [L,R=301]  # If request is not HTTPS, redirect to https://timerhaven.com (covers http://non-www)  RewriteCond %{HTTPS} !=on  RewriteRule ^ https://timerhaven.com%{REQUEST_URI} [L,R=301]</IfModule># Preserve the specific world-clock redirect you previously had:Redirect 301 /world-clock.html https://timerhaven.com/world-clock-en.html# ensure HTML files are served as UTF-8AddDefaultCharset UTF-8<IfModule mod_mime.c>  AddCharset UTF-8 .html .htm</IfModule># DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN<IfModule Litespeed></IfModule># DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END