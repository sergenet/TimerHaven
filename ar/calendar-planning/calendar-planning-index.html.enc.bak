            var template = document.getElementById('icsTemplate').textContent;
            var now = new Date();
            var uid = 'ph-' + Math.floor(Math.random()*900000+100000) + '@timerhaven.com';
            var stamp = now.toISOString().replace(/[-:]/g,'').split('.')[0] + 'Z';
            var content = template.replace('{{UID}}', uid).replace('{{UTC_NOW}}', stamp);
            var blob = new Blob([content], {type:'text/calendar;charset=utf-8'});
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'pomodoro-block-template.ics';
            document.body.appendChild(a);
            a.click();
            setTimeout(function(){ URL.revokeObjectURL(url); a.remove(); }, 150);
          });
        </script>
      </section>

