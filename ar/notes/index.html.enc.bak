      <script>
        // Notes storage and UI
        (function(){
          var notes = JSON.parse(localStorage.getItem('notesData_ar') || '[]');
          var notesList = document.getElementById('notesList');
          function save(){ localStorage.setItem('notesData_ar', JSON.stringify(notes)); }
          function render(){
            notesList.innerHTML = '';
            if(!notes.length){ notesList.innerHTML = '<div style="color:#888;text-align:right;">Ù„Ø§ ØªÙˆØ¬Ø¯ Ù…Ù„Ø§Ø­Ø¸Ø§Øª Ø¨Ø¹Ø¯.</div>'; return; }
            notes.forEach(function(n,i){
              var pinned = n.pinned ? '<strong style="color:#125a9c;margin-left:0.5rem;">ðŸ“Œ</strong>' : '';
              var item = document.createElement('div');
              item.style.background = '#f7fafc';
              item.style.borderRadius = '8px';
              item.style.padding = '0.6rem';
              item.style.marginBottom = '0.6rem';
              item.style.display = 'flex';
              item.style.justifyContent = 'space-between';
              item.style.alignItems = 'center';
              item.innerHTML = '<div style="text-align:right;flex:1;">' + 
                '<div style="margin-bottom:0.25rem;">' + pinned + '<span>' + escapeHtml(n.text) + '</span></div>' +
                '<div style="color:#888;font-size:0.85rem;">' + n.date + '</div></div>' +
                '<div style="margin-left:0.5rem;display:flex;gap:0.4rem;">' +
                '<button onclick="pinNote_ar(' + i + ')" title="ØªØ«Ø¨ÙŠØª/Ø¥Ù„ØºØ§Ø¡ Ø§Ù„ØªØ«Ø¨ÙŠØª" style="border-radius:6px;border:1px solid #0b63a0;background:white;padding:0.25rem 0.5rem;cursor:pointer;">ðŸ“Œ</button>' +
                '<button onclick="deleteNote_ar(' + i + ')" title="Ø­Ø°Ù" style="border-radius:6px;border:1px solid #c00;background:white;padding:0.25rem 0.5rem;cursor:pointer;">ðŸ—‘ï¸</button>' +
                '</div>';
              notesList.appendChild(item);
            });
          }
          function escapeHtml(s){ return (s||'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;'); }

          window.deleteNote_ar = function(i){ notes.splice(i,1); save(); render(); };
          window.pinNote_ar = function(i){
            notes[i].pinned = !notes[i].pinned;
            if(notes[i].pinned){ var p = notes.splice(i,1)[0]; notes.unshift(p); }
            save(); render();
          };

          document.getElementById('notesForm').addEventListener('submit', function(e){
            e.preventDefault();
            var v = document.getElementById('noteInput').value.trim();
            if(!v) return;
            notes.unshift({ text:v, date:new Date().toLocaleString(), pinned:false });
            save();
            document.getElementById('noteInput').value = '';
            render();
          });

          // checklist download
          document.getElementById('downloadChecklist').addEventListener('click', function(e){
            e.preventDefault();
            var text = document.getElementById('checkTemplate').textContent;
            var blob = new Blob([text], {type:'text/plain;charset=utf-8'});
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'notes-checklist-ar.txt';
            document.body.appendChild(a);
            a.click();
            setTimeout(function(){ URL.revokeObjectURL(url); a.remove(); }, 100);
          });

          render();
        })();
      </script>
