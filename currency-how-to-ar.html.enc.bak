<script>
    // Safety: rewrite any lingering generic currency.html hrefs to the localized page
    (function rewriteBackLinks() {
      try {
        document.querySelectorAll('a[href]').forEach(a => {
          const h = (a.getAttribute('href') || '').toLowerCase();
          if (h === 'currency.html' || h === '/currency.html' || h.endsWith('/currency.html')) {
            a.setAttribute('href', 'currency-ar.html');
            a.href = location.origin + '/currency-ar.html';
          }
        });
      } catch (e) { /* ignore */ }
    })();

    // Robust go-back: use history.back() only when referrer is the localized currency page.
    function goBackOrFallback(e) {
      try {
        const ref = (document.referrer || '').toLowerCase();
        const localized = '/currency-ar.html';
        if (ref && (ref.endsWith(localized) || ref.indexOf(location.origin + localized) === 0)) {
          e.preventDefault();
          window.history.back();
          return false;
        }
      } catch (err) { /* ignore */ }
      try {
        e.preventDefault();
        window.location.replace('/currency-ar.html');
        return false;
      } catch (err) {
        return true;
      }
    }
  </script>
